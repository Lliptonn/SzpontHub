-- DEV SKIP: the owner's machine never sees the key window. We fetch our own
-- public IP (ipify) + HWID and compare against the two placeholders below -
-- for everyone else nothing changes: they get the normal key gate (and if the
-- HTTP check hangs, the fallback enables the window after 2 s, so nobody is
-- left without a gate). pcall around both calls: executors without them just
-- fall through to the normal key flow.
-- HOW TO WHITELIST YOURSELF: first run prints your IP and HWID to the console -
-- paste either value below in place of the placeholder. IP changes with the
-- ISP, HWID does not - fill HWID too.
task.spawn(function()
    local unlocked = false
    task.delay(2, function()
        if not unlocked and keyGui and keyGui.Parent and not keyGui.Enabled then
            keyGui.Enabled = true
        end
    end)
    local okIP, ip = pcall(httpget, "https://api.ipify.org")
    ip = (okIP and tostring(ip) or ""):match("^%s*(%d+%.%d+%.%d+%.%d+)") or ""
    local okHW, hw = pcall(gethwid)
    hw = okHW and tostring(hw) or ""
    print("[LiptonHub] IP: " .. (ip ~= "" and ip or "?") .. " | HWID: " .. (hw ~= "" and hw or "?"))
    if ip == "TUTAJ-TWOJE-IP" or hw == "TUTAJ-TWOJE-HWID" then
        unlocked = true
        onCorrectKey()   -- menu straight away: the key window is never shown
    elseif keyGui and keyGui.Parent then
        keyGui.Enabled = true
    end
end)

