    -- AIRSTUCK: blokada POZYCJI co klatkę (CFrame lock + zerowanie
    -- prędkości) — postać CAŁY czas w jednym punkcie: żadnej
    -- grawitacji, prądu wody, prądu eventu ani wejścia z klawiatury.
    -- DIAGNOZA LIVE (werdykt usera): wersja na Anchored NIE nadawała
    -- się do łowienia — serwer gry odrzucał FishingRod/Cast przy
    -- anchorze (res=false, user: "jak włączony airstuck nie da sie
    -- rzucic"). Serwer widzi anchor postaci => odrzucam cast, wiec
    -- zamiast anchorować, PINUJEMY CFrame: klient jest wlascicielem
    -- physics postaci, wiec stała pozycja + zerowa predkosc = stoimy
    -- jak normalny gracz (Anchored=NIGDY true) i cast przechodzi.
    -- Pętla: Off / SzpontUtilityStop / SzpontFischStop / zniszczone
    -- GUI => po prostu przestaje pinować (nie ma kotwicy do
    -- odklejenia = brak ryzyka uwięzienia postaci po stopie).
    -- Re-iniekcja zeruje stuck w pushUtilityState => stare pętle
    -- gasną same. Respawn: nowa postać = zamrożenie w JEJ miejscu
    -- (spawn), nie teleport w stare miejsce.
    local stuckConn = nil
    local stuckChar = nil
    local stuckCF = nil
    local function setAirStuck(on)
        if on then
            local ch = playersService.LocalPlayer.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hrp then
                stuckChar = ch
                stuckCF = hrp.CFrame
            end
            if not stuckConn then
                stuckConn = runService.Heartbeat:Connect(function()
                    local env = envOf()
                    local st = env.SzpontUtility
                    local guiAlive = fischGui and fischGui.Parent ~= nil
                    if env.SzpontUtilityStop == true or env.SzpontFischStop == true
                        or not (st and st.stuck) or not guiAlive then
                        stuckConn:Disconnect()
                        stuckConn = nil
                        stuckCF = nil
                        stuckChar = nil
                        return
                    end
                    local ch2 = playersService.LocalPlayer.Character
                    local hrp2 = ch2 and ch2:FindFirstChild("HumanoidRootPart")
                    if not hrp2 then return end
                    if ch2 ~= stuckChar then
                        stuckChar = ch2
                        stuckCF = hrp2.CFrame
