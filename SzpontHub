    ------------------------------------------------------------
    -- NO SPREAD (as in BloxStrike - there we swapped the Bullet module;
    -- Rivals has no such module, so we zero the spread stats where the game
    -- keeps them): fields "spread*/bloom*/deviation*/cone*/inaccuracy*"
    -- in the weapon config modules (require = the same table the game reads),
    -- in instance attributes and Value* fields; arrays under such
    -- keys (e.g. spread curves) are zeroed too. Enforced EVERY FRAME
    -- (reassert) - the game has no time to restore spread between shots 
    -- + a full scan every 2s for fresh instances. Effect: EVERY bullet flies
    -- + a full scan every 2s for fresh instances. On top of that, HOOK GetSpread
    -- (see below) = guarantee: EVERY bullet flies exactly to the same
    -- place you are aiming at.
    ------------------------------------------------------------
    local noSpreadRestoreAttr = {} -- [instance] = {[attribute]=oldValue}
    local noSpreadRestoreTbl = {}  -- [table] = {[key]=oldValue}
    local noSpreadRestoreVal = {}  -- [ValueBase] = oldValue
    local noSpreadPrinted = 0
    local noSpreadConn = nil
    local noSpreadGuModule = nil    -- needed to restore GetSpread
    local noSpreadSpreadOrig = nil  -- original GetSpread (to turn it off)
    local noSpreadGuPatched = {}    -- [table]=true  all copies with GetSpread

    local function isSpreadName(name)
        local n = tostring(name):lower()
        return n:find("spread", 1, true) ~= nil
            or n:find("bloom", 1, true) ~= nil
            or n:find("deviation", 1, true) ~= nil
            or n:find("cone", 1, true) ~= nil
            or n:find("inaccuracy", 1, true) ~= nil
            or n:find("scatter", 1, true) ~= nil
            or n:find("spray", 1, true) ~= nil
    end

    -- Returns the correct spread value, or nil = leave it alone
    local function spreadWantValue(name, v)
        local negated = (tostring(name):lower():sub(1, 2) == "no") -- "NoSpread" = flag
        local t = typeof(v)
        if t == "number" then
            if negated then return nil end
            return 0
        elseif t == "boolean" then
            return negated -- Spread*=false, NoSpread*=true
        elseif t == "Vector3" then
            if negated then return nil end
            return Vector3.zero
        end
        return nil
    end

    local function noSpreadLog(msg)
        if noSpreadPrinted < 20 then
            noSpreadPrinted = noSpreadPrinted + 1
            print("[SzpontHub] NoSpread: " .. msg)
        end
    end

    -- We always remember the FIRST original value (for turning it off)
    local function noSpreadRemember(map, key, sub, old)
        local m = map[key]
        if not m then m = {}; map[key] = m end
        if m[sub] == nil then m[sub] = old end
    end

    -- Arrays under a spread key (e.g. curves) - copy for turning it off,
    -- and in the live table we zero out all numbers
    local function deepCopy(v, depth)
        if type(v) ~= "table" or (depth or 0) > 5 then return v end
        local c = {}
        for k, val in pairs(v) do c[k] = deepCopy(val, (depth or 0) + 1) end
        return c
    end

    local function zeroNumbers(t, depth)
        if type(t) ~= "table" or (depth or 0) > 5 then return end
        for k, v in pairs(t) do
            if type(v) == "number" then
                t[k] = 0
            elseif type(v) == "table" then
                zeroNumbers(v, (depth or 0) + 1)
            end
        end
    end

    local function tableHasNumber(t, depth)
        if type(t) ~= "table" or (depth or 0) > 5 then return false end
        for _, v in pairs(t) do
            if type(v) == "number" then return true end
            if type(v) == "table" and tableHasNumber(v, (depth or 0) + 1) then return true end
        end
        return false
    end

    local gunModuleWords = {"gun","weapon","item","rifle","sniper","pistol","shotgun","smg","revolver","loadout","arsenal","config","stat","shop","case","crate","bullet","ballistic","ammo","recoil","spread","shoot","firing"}

    local function isGunModule(name)
        local n = name:lower()
        for _, w in ipairs(gunModuleWords) do
            if n:find(w, 1, true) then return true end
        end
        return false
    end

    local function noSpreadWalkTable(t, depth, seen, path)
        if type(t) ~= "table" or depth > 5 or seen[t] then return end
        seen[t] = true
        for k, v in pairs(t) do
            if type(k) == "string" and isSpreadName(k) then
                if type(v) == "table" then
                    -- spread as an array (curve / ranges) - zero out
                    -- all numbers inside; the original (copy) is kept for turning off
                    if tableHasNumber(v) then
                        noSpreadRemember(noSpreadRestoreTbl, t, k, deepCopy(v))
                        zeroNumbers(v)
                        noSpreadLog(path .. "." .. k .. ": number table -> 0")
                    end
                else
                    local want = spreadWantValue(k, v)
                    if want ~= nil and want ~= v then
                        noSpreadRemember(noSpreadRestoreTbl, t, k, v)
                        t[k] = want
                        noSpreadLog(path .. "." .. k .. ": " .. tostring(v) .. "  " .. tostring(want))
                    end
                end
            end
            if type(v) == "table" then
                noSpreadWalkTable(v, depth + 1, seen, path .. "." .. tostring(k))
            end
        end
    end

    local function noSpreadScanInstance(d)
        local attrs = d:GetAttributes()
        for name, v in pairs(attrs) do
            if isSpreadName(name) then
                local want = spreadWantValue(name, v)
                if want ~= nil and want ~= v then
                    noSpreadRemember(noSpreadRestoreAttr, d, name, v)
                    d:SetAttribute(name, want)
                    noSpreadLog("attribute " .. d:GetFullName() .. "." .. name .. ": " .. tostring(v) .. "  " .. tostring(want))
                end
            end
        end
        if d:IsA("ValueBase") and isSpreadName(d.Name) then
            local v = d.Value
            local want = spreadWantValue(d.Name, v)
            if want ~= nil and want ~= v then
                if noSpreadRestoreVal[d] == nil then noSpreadRestoreVal[d] = v end
                d.Value = want
                noSpreadLog("value " .. d:GetFullName() .. ": " .. tostring(v) .. "  " .. tostring(want))
            end
        end
    end

    local function noSpreadPass()
        local rs = game:GetService("ReplicatedStorage")
        local rsDesc = rs:GetDescendants()

        -- 1) Weapon config modules - require gives the SAME table the game reads
        local function scanModules(desc)
            for _, d in ipairs(desc) do
                if d:IsA("ModuleScript") and isGunModule(d.Name) then
                    local ok, mod = pcall(require, d)
                    if ok and type(mod) == "table" then
                        noSpreadWalkTable(mod, 0, {}, d:GetFullName())
                    end
                end
            end
        end
        pcall(function() scanModules(rsDesc) end)
        local sps = game:GetService("StarterPlayer"):FindFirstChild("StarterPlayerScripts")
        if sps then pcall(function() scanModules(sps:GetDescendants()) end) end

        -- 2) Attributes/Value* in instances (configs, viewmodel, character)
        local roots = {rs, game:GetService("StarterPack"), workspace.CurrentCamera, plr.Character, plr.Backpack}
        local budget = 10000
        for _, root in ipairs(roots) do
            if root then
                pcall(function()
                    noSpreadScanInstance(root)
                    for _, d in ipairs(root:GetDescendants()) do
                        if budget <= 0 then return end
                        budget = budget - 1
                        noSpreadScanInstance(d)
                    end
                end)
            end
        end
    end

    -- MOST IMPORTANT: Rivals computes spread in GameplayUtility:GetSpread()
    -- (random cone + speed penalty) and composes it as
    -- camera * spread * direction. We replace GetSpread with a constant
    -- CFrame.identity - EVERY bullet (thrown ones too) flies exactly
    -- in the crosshair direction - always to the same place.
    local function noSpreadHookSpread()
        if noSpreadSpreadOrig then return true end
        local rs = game:GetService("ReplicatedStorage")
        local m = rs and rs:FindFirstChild("Modules")
        local gm = m and m:FindFirstChild("GameplayUtility")
        if not gm then
            warn("[SzpontHub] NoSpread: GameplayUtility module missing - only field zeroing remains")
            return false
        end
        local ok, gu = pcall(require, gm)
        if not ok or type(gu) ~= "table" or type(gu.GetSpread) ~= "function" then
            warn("[SzpontHub] NoSpread: GetSpread unavailable - only field zeroing remains")
            return false
        end
        local origFn = gu.GetSpread
        local newFn = function() return CFrame.identity end
        noSpreadGuModule = gu
        noSpreadSpreadOrig = origFn
        noSpreadGuPatched = {}
        -- require returns a wrapper (metatable), and the game may keep its own copies
        -- of the table - we swap EVERY one that resolves GetSpread to the same
        -- original function, so that no call slips through.
        local function patch(v)
            if type(v) ~= "table" then return end
            local cur = rawget(v, "GetSpread")
            if cur == nil then
                if getmetatable(v) == nil then return end
                local okI, val = pcall(function() return v.GetSpread end)
                if not okI then return end
                cur = val
            end
            if cur == origFn then
                local done = pcall(function() v.GetSpread = newFn end)
                if done then noSpreadGuPatched[v] = true end
            end
        end
        patch(gu)
        local okGc, all = pcall(getgc, true)
        if okGc and type(all) == "table" then
            for _, v in pairs(all) do patch(v) end
        end
        local n = 0
        for _ in pairs(noSpreadGuPatched) do n = n + 1 end
        print("[SzpontHub] NoSpread: GetSpread swapped in " .. n .. " table(s) - every bullet flies exactly in the crosshair direction")
        return true
    end

    local function noSpreadUnhookSpread()
        if noSpreadSpreadOrig then
            for v in pairs(noSpreadGuPatched or {}) do
                pcall(function() v.GetSpread = noSpreadSpreadOrig end)
            end
        end
        noSpreadGuPatched = {}
        noSpreadGuModule, noSpreadSpreadOrig = nil, nil
    end

    -- Every frame: the game can recompute spread on every shot 
    -- we immediately set the saved fields back to zero (a few assignments/frame).
    local function noSpreadReassert()
        for inst, attrs in pairs(noSpreadRestoreAttr) do
            for name, old in pairs(attrs) do
                local want = spreadWantValue(name, old)
                if want ~= nil then
                    pcall(function()
                        if inst:GetAttribute(name) ~= want then inst:SetAttribute(name, want) end
                    end)
                end
            end
        end
        for t, kvs in pairs(noSpreadRestoreTbl) do
            for k, old in pairs(kvs) do
                pcall(function()
                    local cur = t[k]
                    if type(old) == "table" then
                        if type(cur) == "table" then zeroNumbers(cur) end
                    else
                        local want = spreadWantValue(k, old)
                        if want ~= nil and cur ~= want then t[k] = want end
                    end
                end)
            end
        end
        for d, old in pairs(noSpreadRestoreVal) do
            local want = spreadWantValue(d.Name, old)
            if want ~= nil then
                pcall(function()
                    if d.Value ~= want then d.Value = want end
                end)
            end
        end
    end

    local function noSpreadEnable()
        noSpreadPrinted = 0
        pcall(noSpreadPass)
        if noSpreadPrinted == 0 then
            warn("[SzpontHub] NoSpread: no spread fields found yet - try again after changing weapons; if it is still empty, paste me the console")
        end
        noSpreadHookSpread()
        if noSpreadConn then noSpreadConn:Disconnect() end
        noSpreadConn = runService.RenderStepped:Connect(function()
            pcall(noSpreadReassert)
        end)
        task.spawn(function()
            if not isCurrentGen() then return end
            while noSpread do
                task.wait(2) -- full scan: fresh instances after a weapon change
                if not noSpread then break end
                pcall(noSpreadPass)
            end
        end)
    end

    local function noSpreadDisable()
        noSpreadUnhookSpread()
        if noSpreadConn then noSpreadConn:Disconnect(); noSpreadConn = nil end
        for inst, attrs in pairs(noSpreadRestoreAttr) do
            for name, v in pairs(attrs) do
                pcall(function() inst:SetAttribute(name, v) end)
            end
        end
        for t, kvs in pairs(noSpreadRestoreTbl) do
            for k, v in pairs(kvs) do
                pcall(function() t[k] = v end)
            end
        end
        for d, v in pairs(noSpreadRestoreVal) do
            pcall(function() d.Value = v end)
        end
        noSpreadRestoreAttr, noSpreadRestoreTbl, noSpreadRestoreVal = {}, {}, {}
    end

