    -- Aplikacja kamery TPS z DWU kotwic: bind na NAJPOZNIJSZYM etapie rendera
    -- + polaczenie RenderStepped (gra podlaczyla swoje wczesniej, wiec nasze —
    -- dodane pozniej — biegnie po nich). Kierunek bierzemy z biezacej kamery
    -- gry (mysz juz obrocila modul domyslny), wiec widok reaguje na mysz,
    -- a strzaly (ray z CFrame kamery) leca dokladnie tam, gdzie patrzy krzyzyk.
    local function tpApply()
        if not thirdPerson then return end
        -- Caly korpus w pcall + kody na przycisku: zaden powod stopu nie jest cichy.
        -- BloxStrike ma WLASNE postacie (brak Humanoida) — zywotnosc bierzemy
        -- z atrybutu Dead tak jak gra, nie z Health.
        local ok, code, visN, totN = pcall(function()
            if not tpBindOK then return "NOBIND:" .. tpBindErr end
            local ch = plr.Character
            if not ch then return "NOCHAR" end
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            if not hrp then return "NOHRP" end
            if ch:GetAttribute("Dead") then return "DEAD" end
            local cam = workspace.CurrentCamera
            if not cam then return "NOCAM" end
            if cam.CameraType ~= Enum.CameraType.Scriptable then
                cam.CameraType = Enum.CameraType.Scriptable
            end
            -- Viewmodel (rece + bron w kamerze) niewidzialny w TPS — tak jak
            -- gra w spectate: cache oryginalnej przezroczystosci i ustaw 1
            -- (lapie tez nowe modele po zmianie broni, bo skan co klatke)
            for _, m in ipairs(cam:GetChildren()) do
                if m:IsA("Model") then
                    for _, v in ipairs(m:GetDescendants()) do
                        if (v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture")) and vmCache[v] == nil then
                            vmCache[v] = v.Transparency
                            v.Transparency = 1
                        end
                    end
                end
            end
            -- Postac: gra chowa wlasne cialo w FPS — w TPS wymuszamy widocznosc
            -- czesci (cache + restore jak viewmodel; oprocz HumanoidRootPart,
            -- ktory jest z natury niewidzialny). Licznik body na przycisk.
            -- Fallback: gdyby wizualne cialo bylo w osobnym modelu (custom
            -- postacie BS), bierzemy workspace[Nick] z wlasnym HRP.
            local vis, total = 0, 0
            local function showBody(root)
                for _, bp in ipairs(root:GetDescendants()) do
                    if bp:IsA("BasePart") and bp.Name ~= "HumanoidRootPart" then
                        total = total + 1
                        if bp.Transparency >= 1 then
                            if bodyCache[bp] == nil then bodyCache[bp] = bp.Transparency end
                            bp.Transparency = 0
                        else
                            vis = vis + 1
                        end
                    end
                end
            end
            showBody(ch)
            if total == 0 then
                local alt = workspace:FindFirstChild(plr.Name)
                if alt and alt ~= ch and alt:IsA("Model") then
                    local ahrp = alt:FindFirstChild("HumanoidRootPart")
                    if ahrp then
                        hrp = ahrp
                        showBody(alt)
                    end
                end
            end
            if total == 0 then return "NOBODY" end
            local focus = hrp.Position + Vector3.new(0, 2.2, 0)
            local look = cam.CFrame.LookVector
            -- Kamera NAD postacia: do tylu + w gore, patrzy w nia z gory
            local pos = focus - look * tpDist + Vector3.new(0, tpDist * 0.4, 0)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { ch }
            local res = workspace:Raycast(focus, pos - focus, params)
            if res and not res.Instance:IsDescendantOf(cam) and (focus - res.Position).Magnitude > 0.01 then
