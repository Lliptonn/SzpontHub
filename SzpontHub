    -- SLIDER DRAG identical to MM2: drag = the value changes
    local draggingFly, draggingWalk = false, false
    sbFly.MouseButton1Down:Connect(function() draggingFly = true end)
    sbWalk.MouseButton1Down:Connect(function() draggingWalk = true end)
    uis.InputEnded:Connect(function(i)
        if not isCurrentGen() then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingFly, draggingWalk = false, false
        end
    end)
    uis.InputChanged:Connect(function(i)
        if not isCurrentGen() then return end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if draggingFly then
            local rel = math.clamp((i.Position.X - sbFly.AbsolutePosition.X) / sbFly.AbsoluteSize.X, 0, 1)
            sfFly.Size = UDim2.new(rel, 0, 1, 0)
            uFlySpeed = math.floor(10 + rel * 4990)
            slFly.Text = "Fly Speed: " .. uFlySpeed
            pushUtilityState()
        elseif draggingWalk then
            local rel = math.clamp((i.Position.X - sbWalk.AbsolutePosition.X) / sbWalk.AbsoluteSize.X, 0, 1)
            sfWalk.Size = UDim2.new(rel, 0, 1, 0)
            uWalkSpeed = math.floor(16 + rel * 134)
            slWalk.Text = "Walk Speed: " .. uWalkSpeed
            pushUtilityState()
        end
    end)

    createNote("Fly: WASD + Space up, Shift down (as in MM2); Fly Speed slider up to 5000. Speed Hack: WalkSpeed from the slider. Noclip: through walls. Fullbright: bright everywhere.", 9, "Utility")
end

