local function showGameSelect()
    -- keyGui może być już zniszczony przy powrocie z menu
    if keyGui and keyGui.Parent then keyGui:Destroy() end

    gameSelectGui = Instance.new("ScreenGui")
    gameSelectGui.Name = "LiptonHubGameSelect"
    gameSelectGui.ResetOnSpawn = false
    gameSelectGui.Parent = targetParent
    gameSelectGui.IgnoreGuiInset = true
    -- WAŻNE: domyślnie ScreenGui ma ZIndexBehavior.Global, przez co dzieci
    -- gsFrame (domyślny ZIndex 1) lądowały POD falami (ZIndex 2-3) i pod
    -- czarnym canvas — panel i tekst wyglądały na wygaszone. Sibling =
    -- ZIndex sortuje tylko wśród rodzeństwa, więc gsFrame (5) wygrywa
    -- z gsCanvas (1) wraz ze wszystkimi swoimi dziećmi.
    gameSelectGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    ------------------------------------------------------------
    -- TŁO WEDŁUG SHADERA GLSL (fancy waves)
    -- Shader: y = 0.5 + Σ_{k=1..i} sin(x*k + t + k/2)*0.1 dla i = 1..5,
    -- a kolor fali to vec3(f*(10-i)/10, f*i/10, f^1.5*1.5) — czyli od
    -- magenty do błękitu. GUI nie ma shaderów, więc rysujemy każdą falę
    -- jako łańcuch obracanych segmentów (frame'ów) ustawianych co klatkę.
    ------------------------------------------------------------
    local gsCanvas = Instance.new("Frame")
    gsCanvas.Name = "ShaderBG"
    gsCanvas.Size = UDim2.new(1, 0, 1, 0)
    gsCanvas.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    gsCanvas.BackgroundTransparency = 0.3
    gsCanvas.BorderSizePixel = 0
    gsCanvas.ClipsDescendants = true
    gsCanvas.ZIndex = 1
    gsCanvas.Parent = gameSelectGui

    local WAVE_COLORS = {
        Color3.fromRGB(255, 26, 255),   -- i=1: magenta
        Color3.fromRGB(204, 51, 255),
        Color3.fromRGB(178, 76, 255),
        Color3.fromRGB(153, 102, 255),
        Color3.fromRGB(128, 128, 255),  -- i=5: błękit
    }
    local WAVES = #WAVE_COLORS
    local SEGS = 24            -- segmentów na jedną falę
    local THICK = 3            -- grubość linii
    local GLOW_THICK = 12      -- grubość "bloomu" pod linią (efekt poświaty)

    -- pozycje x w jednostkach 0..1 (jak gl_FragCoord/resolution), liczone raz
    local xs = {}
    for j = 0, SEGS do xs[j + 1] = j / SEGS end

    local lines, glows = {}, {}
    for w = 1, WAVES do
        lines[w], glows[w] = {}, {}
        for j = 1, SEGS do
            local glow = Instance.new("Frame")
            glow.AnchorPoint = Vector2.new(0.5, 0.5)
            glow.Size = UDim2.fromOffset(10, GLOW_THICK)
            glow.BackgroundColor3 = WAVE_COLORS[w]
            glow.BackgroundTransparency = 0.72
            glow.BorderSizePixel = 0
            glow.ZIndex = 2
            glow.Parent = gsCanvas
            glows[w][j] = glow

            local line = Instance.new("Frame")
            line.AnchorPoint = Vector2.new(0.5, 0.5)
            line.Size = UDim2.fromOffset(10, THICK)
            line.BackgroundColor3 = WAVE_COLORS[w]
            line.BorderSizePixel = 0
            line.ZIndex = 3
            line.Parent = gsCanvas
            lines[w][j] = line
        end
    end

    local gsClock = os.clock()
    local gsConn
    gsConn = runService.RenderStepped:Connect(function()
        if not gsCanvas.Parent then
            gsConn:Disconnect() -- menu zamknięte — sprzątamy
            return
        end
        local W, H = gsCanvas.AbsoluteSize.X, gsCanvas.AbsoluteSize.Y
        if W <= 0 or H <= 0 then return end
        local t = (os.clock() - gsClock) * 0.9 -- time*0.9 z shadera
        local amp = 0.1 * H                    -- 0.1 z shadera
        local midY = 0.5 * H                   -- uPos.y -= 0.5

        -- wysokości punktów każdej fali (suma sinusów jak w shaderze)
        local ys = {}
        for w = 1, WAVES do
            local row = {}
            for j = 1, SEGS + 1 do
                local x = xs[j]
                local y = midY
                for k = 1, w do
                    y = y + math.sin(x * k + t + k / 2) * amp
                end
                row[j] = y
            end
            ys[w] = row
        end

        -- ustawiamy segmenty: pozycja w połowie odcinka, obrót wg nachylenia
        for w = 1, WAVES do
            local row = ys[w]
            for j = 1, SEGS do
                local x0, x1 = xs[j] * W, xs[j + 1] * W
                local y0, y1 = row[j], row[j + 1]
                local dx, dy = x1 - x0, y1 - y0
                local mid = UDim2.fromOffset((x0 + x1) * 0.5, (y0 + y1) * 0.5)
                local rot = math.deg(math.atan2(dy, dx))
                local len = math.sqrt(dx * dx + dy * dy) + 1.5 -- lekkie nałożenie, bez szwów
                local ln, gl = lines[w][j], glows[w][j]
                ln.Position = mid
                ln.Size = UDim2.fromOffset(len, THICK)
                ln.Rotation = rot
                gl.Position = mid
                gl.Size = UDim2.fromOffset(len, GLOW_THICK)
                gl.Rotation = rot
            end
        end
    end)

    local gsFrame = Instance.new("Frame")
    gsFrame.Size = UDim2.new(0, 300, 0, 360)
    gsFrame.ZIndex = 5 -- ramka menu zawsze nad falami
    gsFrame.Position = UDim2.new(0.5, -150, 0.5, -180)
