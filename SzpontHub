        if not hum or not hrp or hum.Health <= 0 then return false end
        if char:FindFirstChildOfClass("ForceField") then return false end
        -- kto siedzi w lobby (zabici/poczekalnia) — nie ruszamy, tylko na mapie
        if isInLobby(hrp.Position, 25) then return false end
        return true
    end

