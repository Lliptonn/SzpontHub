    -- TRIGGERBOT: fires only when the FIRST ray hit from the center of the
    -- screen is a live enemy (no firing through walls, not at corpses, not at
    -- teammates). Click at most every 0.12s via VirtualUser - the same pattern as
    -- in BloxStrike; the weapon limits RPM itself. Knife/katana in hand = skipped
    -- (the click would turn into a melee swing instead of a shot).
    local trigLastFire = 0
    local function triggerCrosshairEnemy()
        local ch = plr.Character
        if not ch then return false end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filter = {ch}
        for _, m in ipairs(cam:GetChildren()) do table.insert(filter, m) end
        params.FilterDescendantsInstances = filter
        local ray = cam:ViewportPointToRay(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
        if not result or not result.Instance then return false end
        -- walk up the hierarchy to the player Model (accessories are Models too)
        local obj = result.Instance
        local owner, model = nil, nil
        while obj and obj ~= workspace do
            local p = playersService:GetPlayerFromCharacter(obj)
            if p then owner, model = p, obj; break end
            obj = obj.Parent
        end
        if not owner or owner == plr then return false end
        if model and isEnemy(owner) and isAliveTarget(owner, model) then
            return true
        end
        return false
    end

