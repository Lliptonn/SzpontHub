        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = fovFrame
    end)
    if not fovFrame then
        pcall(function()
            fovCircle = Drawing.new("Circle")
            fovCircle.Visible = false
            fovCircle.Thickness = 1.5
            fovCircle.NumSides = 64
            fovCircle.Radius = 100
            fovCircle.Color = Color3.fromRGB(170, 50, 255)
            fovCircle.Filled = false
            fovCircle.Transparency = 0.15
        end)
    end

    -- STEROWANIE AIMBOTEM (pętla adaptacyjna): co klatkę mierzymy realny
    -- obrót kamery po wysłaniu pikseli → rad/piksel myszy. Stary wzór
    -- px = rad * (speed*50) przy wysokim suwaku dawał wzmocnienie >2
    -- (przeskok obok celu i bujanie „w inne miejsce"); teraz suwak steruje
    -- TYLKO ułamkiem błędu na klatkę (0.15–0.95) → zawsze dojazd na głowę.
    local aimCtl = { dx = 0, yawSent = nil, sens = 0.004 }

    -- Aimbot + FOV Circle — RenderStepped (PO kamerze gry)
    runService.RenderStepped:Connect(function()
        -- Aktualizacja FOV Circle
        if aimbotEnabled then
            local viewportSize = cam.ViewportSize
            -- Koło = prawdziwy stożek selekcji (tan), nie proporcja liniowa:
            -- stara wersja przy FOV 50° pokazywała realnie ~26°, więc celownik
            -- szedł do celów spoza koła = „snap tam gdzie nikogo nie ma".
            local fovDraw = math.min(aimbotFov, 85)
            local tanHalf = math.tan(math.rad(math.max(cam.FieldOfView, 1) / 2))
            local screenRadius = (viewportSize.Y / 2) * math.tan(math.rad(fovDraw)) / math.max(tanHalf, 1e-4)
            -- Przycinamy, żeby CAŁE koło było w kadrze (jak w BloxStrike).
            local maxR = math.min(viewportSize.X, viewportSize.Y) / 2 - 24
            screenRadius = math.clamp(screenRadius, 24, math.max(maxR, 24))
            local cx = viewportSize.X / 2
            -- Wyrównanie jak w BloxStrike: GUI (IgnoreGuiInset) → H/2 = pozycja
            -- krzyża gry; Drawing (awaryjny) ze starą korektą +21.
            local cy = viewportSize.Y / 2
            local cyDraw = viewportSize.Y / 2 + 21
            local col = ppm and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(170, 50, 255)
            if fovCircle then
                fovCircle.Radius = screenRadius
                fovCircle.Position = Vector2.new(cx, cyDraw)
                fovCircle.Visible = true
                fovCircle.Color = col
            elseif fovFrame then
                local d = math.floor(screenRadius * 2 + 0.5)
                fovFrame.Size = UDim2.fromOffset(d, d)
                fovFrame.Position = UDim2.fromOffset(math.floor(cx - screenRadius + 0.5), math.floor(cy - screenRadius + 0.5))
                fovFrame.Visible = true
                if fovStroke then
                    fovStroke.Color = col
                    fovStroke.Enabled = true
                end
            end
        else
            if fovCircle then fovCircle.Visible = false end
            if fovFrame then
                fovFrame.Visible = false
                if fovStroke then fovStroke.Enabled = false end
            end
        end

        -- Snap na celownik gdy PPM trzymany
        if aimbotEnabled and ppm and plr.Character then
            local camPos = cam.CFrame.Position
            local camDir = cam.CFrame.LookVector
            local best = nil
            local bestAngle = aimbotFov

            for _, p in pairs(playersService:GetPlayers()) do
                if p ~= plr and p.Character and isEnemy(p) then
                    if isAliveTarget(p, p.Character) then
                        -- Szukaj najlepszego punktu: Head > UpperTorso > HumanoidRootPart
                        local parts = {"Head", "UpperTorso", "HumanoidRootPart"}
                        for _, partName in ipairs(parts) do
                            local part = p.Character:FindFirstChild(partName)
                            if part then
                                local toTarget = part.Position - camPos
                                local dist = toTarget.Magnitude
                                if dist > 0 and dist < 800 then
                                    local ang = math.deg(math.acos(math.clamp(camDir:Dot(toTarget.Unit), -1, 1)))
                                    if ang < bestAngle then
                                        bestAngle = ang
                                        best = part.Position
                                    end
                                end
                                break -- wystarczy pierwsza znaleziona część
                            end
                        end
                    end
                end
            end

            if best then
                -- Symulacja ruchu myszy: kontroler gry sam obraca kamerę I postać,
                -- strzały trafiają w cel, a widok nie wraca po puszczeniu PPM.
                local dir = (best - camPos).Unit
                local look = cam.CFrame.LookVector
                local ang = math.acos(math.clamp(look:Dot(dir), -1, 1))
                if ang > math.rad(0.3) and mousemoverel and iswindowactive() then
                    -- ADAPTACJA: mierzymy, o ile stopni kamera faktycznie
                    -- obróciła się po ostatnich pikselach → rad/piksel myszy.
                    local yawNow = math.atan2(look.X, -look.Z)
                    if aimCtl.yawSent ~= nil and aimCtl.dx ~= 0 then
                        local d = yawNow - aimCtl.yawSent
                        while d > math.pi do d = d - 2 * math.pi end
                        while d < -math.pi do d = d + 2 * math.pi end
                        local s = math.abs(d) / math.abs(aimCtl.dx)
                        if s > 0.0002 and s < 0.05 then
                            aimCtl.sens = aimCtl.sens * 0.6 + s * 0.4
                        end
                    end
                    aimCtl.yawSent = yawNow
                    local yawErr, pitchErr = 0, 0
                    local flatLook = Vector3.new(look.X, 0, look.Z)
                    local flatDir = Vector3.new(dir.X, 0, dir.Z)
                    if flatLook.Magnitude > 1e-4 and flatDir.Magnitude > 1e-4 then
                        flatLook = flatLook.Unit
                        flatDir = flatDir.Unit
                        yawErr = math.atan2(flatDir:Cross(flatLook).Y, flatLook:Dot(flatDir))
                    end
                    -- Pion względem OSI kamery (nie horyzontu): stary wzór
                    -- asin(dir.Y)-asin(look.Y) dawał ODWROCONY ZNAK dla celów
                    -- poza środkiem → celownik szedł w górę zamiast w dół.
                    pitchErr = math.asin(math.clamp(dir:Dot(cam.CFrame.UpVector), -1, 1))
                    local k = 0.15 + (math.clamp(aimbotSpeed, 1, 125) - 1) / 124 * 0.8
                    local degPerPx = math.max(aimCtl.sens * (180 / math.pi), 1e-5)
                    local dx = math.clamp(math.floor(math.deg(yawErr) * k / degPerPx + 0.5), -500, 500)
                    local dy = math.clamp(math.floor(-math.deg(pitchErr) * k / degPerPx + 0.5), -500, 500)
                    aimCtl.dx = dx
                    if dx ~= 0 or dy ~= 0 then
                        pcall(mousemoverel, dx, dy)
                    end
                elseif not mousemoverel then
                    -- fallback gdy brak mousemoverel: obrót samej kamery
                    local goal = CFrame.new(camPos, best)
                    local alpha = math.clamp(aimbotSpeed / 30, 0.05, 1)
                    cam.CFrame = cam.CFrame:Lerp(goal, alpha)
                end
            end
        end
    end)

    -- ESP (Highlight + tabliczka: wrogowie na czerwono, team na zielono)
    -- Nazwy Rivals* nie kolidują z ESP BloxStrike (BS*), gdyby oba były włączone.
    runService.RenderStepped:Connect(function()
        for _, player in pairs(playersService:GetPlayers()) do
            if player ~= plr and player.Character then
                local char = player.Character
                local head = char:FindFirstChild("Head")
                local enemy = isEnemy(player)
                local teammate = not enemy
                if espEnabled and head then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local espColor = teammate and Color3.fromRGB(40, 255, 80) or Color3.fromRGB(255, 40, 40)

                    local highlight = char:FindFirstChild("RivalsHighlight") or Instance.new("Highlight", char)
                    highlight.Name = "RivalsHighlight"
                    highlight.Adornee = char
                    highlight.FillColor = espColor
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0

                    local billboard = head:FindFirstChild("RivalsBillboard") or Instance.new("BillboardGui", head)
                    billboard.Name = "RivalsBillboard"
                    billboard.Size = UDim2.new(0, 120, 0, 50)
                    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                    billboard.AlwaysOnTop = true

                    local txt = billboard:FindFirstChild("RivalsText") or Instance.new("TextLabel", billboard)
                    txt.Name = "RivalsText"
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.TextColor3 = espColor
                    txt.TextStrokeTransparency = 0
                    txt.TextSize = 13
                    txt.Font = Enum.Font.SourceSansBold
                    local hp = math.floor((hum and hum.Health) or tonumber(char:GetAttribute("Health")) or 0)
                    local dist = math.floor((head.Position - cam.CFrame.Position).Magnitude)
                    txt.Text = player.Name .. "\nHP: " .. hp .. " | " .. dist .. "m"
                else
                    local highlight = char:FindFirstChild("RivalsHighlight")
                    if highlight then highlight:Destroy() end
                    if head then
                        local billboard = head:FindFirstChild("RivalsBillboard")
                        if billboard then billboard:Destroy() end
                    end
                end
            end
        end
    end)

    -- Pokaż/ukryj menu (klawisz P)
    uis.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == Enum.KeyCode.P then
            local show = not mainFrame.Visible
            mainFrame.Visible = show
            cheatsPanel.Visible = show
        end
    end)

    updateActiveCheatsList()
end

