        scrollFrame.ScrollBarImageColor3 = primary

        cheatsPanel.BackgroundColor3 = t.Dark
        cheatsPanel.BorderColor3 = primary
        cheatsTitle.BackgroundColor3 = primary
        cheatsTitle.TextColor3 = t.Dark
        cheatsScroll.ScrollBarImageColor3 = primary

        for _, btn in ipairs(allButtons) do
            btn.BorderColor3 = primary
            -- przycisk w stanie ON ma kolor akcentu (odkrywamy to po
            -- kolorze, bo przełączniki ustawiają go ręcznie)
            local c = btn.BackgroundColor3
            local isOn = math.abs(c.R - primary.R) < 0.1
                and math.abs(c.G - primary.G) < 0.1
                and math.abs(c.B - primary.B) < 0.1
            if btn == bThemeToggle or isOn then
                btn.BackgroundColor3 = primary
                btn.TextColor3 = t.Dark
            else
                btn.BackgroundColor3 = t.ButtonBg
                btn.TextColor3 = Color3.fromRGB(235, 235, 235)
            end
        end

        for _, sl in ipairs(allSliders) do
            sl.BackgroundColor3 = t.Dark
            sl.BorderColor3 = primary
        end

        for _, frm in ipairs(allFrames) do
            frm.BackgroundColor3 = primary
        end

        for _, lbl in ipairs(allLabels) do
            lbl.TextColor3 = t.TextCol
        end

        playerListFrame.BackgroundColor3 = t.Dark
        playerListFrame.BorderColor3 = primary
        playerListFrame.ScrollBarImageColor3 = primary

        themeListFrame.BackgroundColor3 = t.Dark
        themeListFrame.BorderColor3 = primary
        themeListFrame.ScrollBarImageColor3 = primary

        -- Przemalowanie paska zakładek i stron po zmianie motywu
        for n, tb in pairs(tabButtons) do
            local isActive = (n == activeTab)
            tb.BackgroundColor3 = isActive and primary or t.ButtonBg
            tb.TextColor3 = isActive and t.Dark or Color3.fromRGB(235, 235, 235)
            tb.BorderColor3 = primary
        end
        for _, pg in pairs(pages) do
            pg.ScrollBarImageColor3 = primary
        end
    end

