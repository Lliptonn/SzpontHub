-- SAFE ACCESS TO THE CHARACTER
-- On respawn the character model is REPLACED: the old Model disappears,
-- and for a moment the new one has no HumanoidRootPart/Humanoid. Then
-- plr.Character.HumanoidRootPart throws
-- "HumanoidRootPart is not a valid member of Model ..." and kills the script.
-- That is why we NEVER reach for those fields directly - only through these
-- getters (FindFirstChild + type check = nil instead of an exception).
------------------------------------------------------------
local function getHRP(model)
    if not model then return nil end
    local h = model:FindFirstChild("HumanoidRootPart")
    if h and h:IsA("BasePart") then return h end
    return nil
end

local function getHum(model)
    if not model then return nil end
    return model:FindFirstChildOfClass("Humanoid")
end

