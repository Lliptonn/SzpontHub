    -- TP Farm loop: teleport to the nearest coin every tp.sec seconds.
    -- ALL the logic INSIDE the loop is deliberate - Lua has a limit of 200 registers
    -- per chunk, and a separate local for a helper breaks compilation of the file.
    task.spawn(function()
        while true do
            if not isCurrentGen() then return end
            if not isCurrentGen() then return end
            local ok, err = pcall(function()
                task.wait(0.02)
                if tp.on then
                    -- reset at the start of the tick: if the previous tick died
                    -- while walking, the flag would not block Auto Farm
                    tp.walking = false
                    local now = os.clock()

                    -- own coin list refresher - we do NOT tick coinScanClock,
                    -- because it is the old farm counter and sharing it would spoil both
                    if now >= tp.scanAt then
                        refreshCoinCache(false)
                        tp.scanAt = now + (#coinCache > 0 and 1.5 or 0.75)
                    end

                    if now >= tp.nextAt then
                        -- FARM COORDINATION: Auto Farm has priority, BUT when it has
                        -- nothing to collect (farmIdle), TP Farm takes over the character. NEITHER
                        -- farm turns the other off - both can be enabled at once.
                        if killBusy or gunDropRef or annoyEnabled or farmBag.full or (autoFarmCoins and not farmIdle) then
                            tp.nextAt = now + 0.3  -- skip it now, check again in a moment
                        else
                        local char = plr.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        local hum = char and char:FindFirstChildOfClass("Humanoid")

                        if hrp and hum and hum.Health > 0 then
                            local nearest, bestDist = nil, tp.range
                            for i = #coinCache, 1, -1 do
                                local c = coinCache[i]
                                if not isCoinAlive(c) then
                                    table.remove(coinCache, i)
                                elseif not coinBlacklist[c] then
                                    local d = (hrp.Position - c.Position).Magnitude
                                    if d < bestDist then
                                        bestDist, nearest = d, c
                                    end
                                end
                            end

                            if nearest then
                                local target = nearest.Position

                                -- ANTI-KICK "Invalid position" (Error 267): teleporting
                                -- via CFrame gets kicked EVEN after a tick and even on
                                -- the "safest" settings - MM2 watches
                                -- the raw speed of the character, not the way it moves.
                                -- So we do the "teleport" as ORDINARY WALKING with
                                -- an increased WalkSpeed: the movement goes through the game engine,
                                -- so the server accepts it, and we still fly extremely fast
                                -- (200 studs/s = 12x normal walk). We control ONLY
                                -- rotation - a CFrame without translation is not validated
                                -- as a position change, so it does not kick.
                                local starySpeed = hum.WalkSpeed
                                local staryRot = hum.AutoRotate
                                hum.WalkSpeed = tp.walk
                                hum.AutoRotate = false

                                local koniec = os.clock() + 4
                                tp.walking = true
                                while os.clock() < koniec do
                                    task.wait(0.05)
                                    -- after task.wait the character can die / respawn:
                                    -- the model is DESTROYED, and .Position/.CFrame on a
                                    -- destroyed instance = an error, which used to
                                    -- kill the WHOLE farm loop (the farm stayed silent
                                    -- until the script was restarted). So we re-fetch the
                                    -- fresh character after every wait.
                                    char = plr.Character
                                    hrp = char and char:FindFirstChild("HumanoidRootPart")
                                    hum = char and char:FindFirstChildOfClass("Humanoid")
                                    if not (hrp and hum) then break end
                                    if not tp.on or hum.Health <= 0 then break end
                                    local off = target - hrp.Position
                                    if off.Magnitude <= 3.2 then break end
                                    hrp.CFrame = CFrame.lookAt(
                                        hrp.Position,
                                        Vector3.new(target.X, hrp.Position.Y, target.Z))
                                end
                                tp.walking = false

                                -- we restore speed/rotation only for a live
                                -- character (after respawn hum is a new instance)
                                if hum and hum.Parent then
                                    hum.WalkSpeed = starySpeed
                                    hum.AutoRotate = staryRot
                                end

                                -- Touched fires at the START of a collision, so just
                                -- standing next to a coin sometimes does not count. BEFORE: teleport
                                -- CFrame by 2.4 studs and back = sudden position jump = 
                                -- "Invalid position" (Error 267) and a kick from the server.
                                -- NOW: we do both moves WITH THE ENGINE (Humanoid:Move). The engine
                                -- changes the position gradually, so the server velocity
                                -- validation passes - and Touched still fires, because the character
                                -- really does move past the coin.
                                if hrp and hrp.Parent then
                                    local pos = hrp.Position
                                    local kierunek = (target - pos)
                                    kierunek = Vector3.new(kierunek.X, 0, kierunek.Z)
                                    if kierunek.Magnitude > 0.1 then
                                        kierunek = kierunek.Unit
                                    else
                                        kierunek = Vector3.new(1, 0, 0)
                                    end
                                    local starySpeedHop = hum.WalkSpeed
                                    local staryRotHop = hum.AutoRotate
                                    hum.WalkSpeed = 18
                                    hum.AutoRotate = false
                                    -- phase 1: bounce to the side (jump + walking, the engine does the physics)
                                    hrp.CFrame = CFrame.lookAt(pos, pos - kierunek)
                                    hum:Move(-kierunek, false)
                                    task.wait(0.12)
                                    hrp = getHRP(plr.Character)
                                    hum = getHum(plr.Character)
                                    -- phase 2: back to the coin
                                    if hrp and hrp.Parent and hum then
                                        hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + kierunek)
                                        hum:Move(kierunek, false)
                                        task.wait(0.12)
                                    end
                                    if hum and hum.Parent then
                                        hum.WalkSpeed = starySpeedHop
                                        hum.AutoRotate = staryRotHop
                                    end
                                end

                                tp.nextAt = os.clock() + math.max(tp.sec, tp.minGap)
                            else
                                tp.nextAt = now + 0.5 -- no coins: check more often
                            end
                        else
                            tp.nextAt = now + 0.5
                        end
                        end -- end of the "can move" branch (killBusy/gunDropRef)
                    end
                end
            end)
            if not ok then
                -- AN ERROR IN ONE TICK MUST NOT KILL THE FARM LOOP:
                -- without pcall an exception ends task.spawn and the farm
                -- stayed silent until the script was restarted
                warn("[SzpontHub] TP Farm tick error: " .. tostring(err))
                task.wait(0.5)
            end
        end
    end)

