    -- LOAD THE CONFIG LIST FROM DISK (old format = a single config)
    function cfg.loadAll()
        local ok, data = pcall(function()
            if type(readfile) ~= "function" then return nil end
            local raw = readfile(cfg.file)
            if type(raw) ~= "string" or raw == "" then return nil end
            return cfg.http:JSONDecode(raw)
        end)
        if not (ok and type(data) == "table") then
            cfg.configs = {}
            return false
        end
        if type(data.configs) == "table" then
            cfg.configs = data.configs
        else
            -- old file (flat config) -> import as "Config 1"
            cfg.configs = { { name = "Config 1", data = data } }
        end
        -- MIGRACJA STARYCH CONFIGOW: zapisy sprzed dodania anti-fLing nie maja
        -- pola "antiFling" wcale. Bez tego ladowanie takiego configu ZDEJMIOWALO
        -- ochrone (brak pola = false). Uzupełniamy pole = true, bo ochrona ma
        -- przetrwac ladowanie starego configu.
        for _, entry in ipairs(cfg.configs) do
            if type(entry) == "table" and type(entry.data) == "table"
                and entry.data.antiFling == nil then
                entry.data.antiFling = true
            end
        end
        return true
    end

    -- SAVE THE CONFIG LIST TO THE USER'S DISK
    function cfg.saveAll()
        local ok, err = pcall(function()
            if type(writefile) ~= "function" then error("writefile missing") end
            writefile(cfg.file, cfg.http:JSONEncode({ configs = cfg.configs }))
        end)
        return ok, err
    end

    -- SAVE A CONFIG UNDER A NAME (same name = overwrite)
    function cfg.saveNamed(name)
        if type(name) ~= "string" or name == "" then
            name = "Config " .. tostring(#cfg.configs + 1)
        end
        local data = cfg.collect()
        local replaced = false
        for i, entry in ipairs(cfg.configs) do
            if entry.name == name then
                cfg.configs[i] = { name = name, data = data }
                replaced = true
                break
            end
        end
        if not replaced then
            table.insert(cfg.configs, { name = name, data = data })
        end
        local ok, err = cfg.saveAll()
        cfg.refreshList()
        return ok, err
    end

    -- DELETE A CONFIG BY NAME
    function cfg.delete(name)
        for i, entry in ipairs(cfg.configs) do
            if entry.name == name then
                table.remove(cfg.configs, i)
                break
            end
        end
        local ok, err = cfg.saveAll()
        cfg.refreshList()
        return ok, err
    end

