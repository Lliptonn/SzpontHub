    -- Serwer wyrzuca broń z eq przy zbyt szybkich strzałach (próg między 3x a 4x):
    -- - twarda podłoga 0.03s między strzałami,
    -- - auto-redukcja mnożnika, gdy serwer wyrzuci broń tuż po strzalach.
    local invCtl = nil
    local rfLastShotTick, rfGuardTick = 0, 0
    local function getEquipped()
        if not invCtl then
            local ok, m = pcall(require, game:GetService("ReplicatedStorage").Controllers.InventoryController)
            if ok then invCtl = m end
        end
        if not invCtl then return nil end
        local ok, w = pcall(invCtl.getCurrentEquipped)
        if ok then return w end
        return nil
    end

    local function rfDiag(msg)
        local store = invCtl
        if not store then store = (type(getgenv) == "function" and getgenv()) or _G end
        store._rfDiag = store._rfDiag or {}
        table.insert(store._rfDiag, msg)
        while #store._rfDiag > 30 do table.remove(store._rfDiag, 1) end
    end

    runService.Heartbeat:Connect(function()
        if not rapidfire or not plr.Character then return end
        local w = getEquipped()
        if not w or not w.IsShooting or w.IsReloading or w.IsAdjustingSuppressor then return end
        local props = w.Properties
        if not props or props.Class ~= "Weapon" or not props.FireRate then return end
        local minDelay = math.max(0.03, props.FireRate / rapidMult)
        if tick() - (w.ShootRequestTick or 0) < minDelay then return end
        if not (w.IsFireHeld or (triggerbot and crosshairEnemy())) then return end
        if w.ShootDelayThread then
            pcall(task.cancel, w.ShootDelayThread)
            w.ShootDelayThread = nil
        end
        w.IsShooting = false
        local okS, errS = pcall(function() w:shoot() end)
        rfLastShotTick = tick()
        rfDiag(okS and ("SHOT m" .. tostring(rapidMult) .. " r" .. tostring(w.Rounds)) or ("ERR " .. tostring(errS):sub(1, 120)))
    end)

