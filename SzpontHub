-- CLEANUP AFTER OLD INSTANCES (why): the name lists below were not enough -
-- gethui() can hand out a DIFFERENT root on every call, so the windows of an
-- earlier execution live in a container this run never scans. That is exactly
-- how TWO "LiptonHub Game Select" windows ended up stacked on screen. So we
-- remember the container of the last run in getgenv and destroy the whole old
-- root at once (the ~= check protects our own root - and CoreGui too when
-- there is no gethui). On top of that a name sweep of every container
-- (CoreGui/PlayerGui/RobloxGui) catches generations that put windows elsewhere.
pcall(function()
    local genv = type(getgenv) == "function" and getgenv() or nil
    if genv then
        if genv.__LiptonGuiRoot and genv.__LiptonGuiRoot ~= targetParent then
            pcall(function() genv.__LiptonGuiRoot:Destroy() end)
        end
        genv.__LiptonGuiRoot = targetParent
    end
end)
pcall(function()
    local cs = {targetParent, game.CoreGui}
    local pg = game:GetService("Players").LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg then table.insert(cs, pg) end
    local rg = game.CoreGui:FindFirstChild("RobloxGui")
    if rg then table.insert(cs, rg) end
    local EXTRA = { BSFovCircle = true, BSCrosshair = true, RivalsFovCircle = true, MM2FovCircle = true }
    for _, c in ipairs(cs) do
        for _, ch in ipairs(c:GetChildren()) do
            if ch:IsA("ScreenGui") then
                local nm = ch.Name
                if nm:find("LiptonHub", 1, true) == 1 or nm:find("Szpont", 1, true) == 1 or EXTRA[nm] then
                    ch:Destroy()
                end
            end
        end
    end
end)
