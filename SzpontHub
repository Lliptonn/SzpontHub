    -- the game hides frames outside the selected tab (Current/Classic/Event) and by
    -- its own search - after its handlers we force our frames visible,
    -- otherwise an event item would stay invisible on the default tab
    refreshInjected = function()
        local list, _, searchBox = gameInv()
        if not list then return end
        local q = (searchBox and string.lower(searchBox.Text or "")) or ""
        for fr, info in pairs(injected) do
            local ok = pcall(function()
                if fr.Parent ~= list then fr.Parent = list end
                if q == "" then
                    fr.Visible = true
                else
                    fr.Visible = (string.find(string.lower(info.name), q, 1, true) ~= nil)
                        or (string.find(string.lower(info.key), q, 1, true) ~= nil)
                end
            end)
            if not ok then injected[fr] = nil end   -- frame died (the game rebuilt its GUI)
        end
    end

    szpInv.hookedList = nil
    szpInv.hookGameInv = function()
        local list, tabs, searchBox = gameInv()
        if not list or szpInv.hookedList == list then return end
        szpInv.hookedList = list
        for _, tabName in ipairs({ "Current", "Classic", "Event" }) do
            local tab = tabs and tabs:FindFirstChild(tabName)
            local view = tab and tab:FindFirstChild("View")
            if view then
                view.Activated:Connect(function()
                    task.wait()   -- let the game run its own filter; we fix it afterwards
                    refreshInjected()
                end)
            end
        end
        if searchBox then
            searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                task.wait()
                refreshInjected()
            end)
        end
    end

    -- keys added by the user - the game inventory has ResetOnSpawn=true,
    -- so MM2 wipes it on every respawn (and that is every round). Without this
    -- list our frames would vanish a few seconds after SPAWN and the "OK" status
    -- would hold only until the next respawn.

    szpInv.reqIS = function()
        local ok, IS = pcall(function()
            return require(game:GetService("ReplicatedStorage")
                :WaitForChild("ClientServices", 5):WaitForChild("InventoryService", 5))
        end)
        return ok and IS or nil
    end

    -- recreates missing frames after a respawn / inventory screen rebuild
    szpInv.ensureSpawned = function()
        szpInv.ensureScript()   -- without it the game does not even build its own frames
        if #szpInv.spawned == 0 then return end
        local list = gameInv()
        if not list then return end
        local IS = szpInv.reqIS()
        if not IS then return end
        local dodane = 0
        for _, e in ipairs(szpInv.spawned) do
            if not list:FindFirstChild("SzpHub_" .. e.key) then
                local ok, res = pcall(function()
                    return IS:CreateItemFrame(e.key, "Weapons", 1)
                end)
                if ok and type(res) == "table" and res.Frame then
                    res.Frame.Name = "SzpHub_" .. e.key
                    res.Frame.Parent = list
                    injected[res.Frame] = { key = e.key, name = tostring(e.name) }
                    szpInv.wireFrame(res.Frame, e)
                    dodane = dodane + 1
                end
            end
        end
        if dodane > 0 then
            szpInv.hookGameInv()
            refreshInjected()
            -- after a respawn the game can leave the whole Weapons panel hidden
            -- (its own initialization did not finish) - without this reveal
            -- the recreated frames would be there, but the player would not see them
            szpInv.showPanel()
        end
    end

    -- the inventory open button in the game dock: after a respawn it is a NEW object,
    -- so the hook must be attached again (attribute = "already hooked" marker)
    szpInv.hookOpenButton = function()
        local g = plr:FindFirstChildOfClass("PlayerGui")
        g = g and g:FindFirstChild("MainGUI")
        g = g and g:FindFirstChild("Game")
        g = g and g:FindFirstChild("Dock")
        local btn = g and g:FindFirstChild("Inventory")
        if btn and not btn:GetAttribute("SzpHooked") then
            btn:SetAttribute("SzpHooked", true)
            btn.Activated:Connect(function()
                task.wait(0.4)
                szpInv.ensureSpawned()
                -- opening the inventory = the perfect moment to enable the inventory
                -- script the game disabled and reveal the panel
                if szpInv.ensureScript() then task.wait(0.5) end
                szpInv.showPanel()
                refreshInjected()
            end)
        end
    end

    addToInventory = function(entry)
        -- first we give the game back its OWN inventory script (it can be
        -- Disabled=true) - otherwise the screen would look empty after SPAWN anyway
        szpInv.ensureScript()
        local list = gameInv()
        if not list then
            return false, "cannot see the game inventory screen"
        end
        -- is the same entry already in the list? (we check the LIST itself, not
        -- the hub's memory - after a respawn the memory is there but the frame is not)
        local mamy = list:FindFirstChild("SzpHub_" .. entry.key)
        if mamy then
            pcall(function()
                mamy.Visible = true
                injected[mamy] = { key = entry.key, name = tostring(entry.name) }
            end)
            szpInv.showPanel()
            refreshInjected()
            -- adoption = also register it to recreate after respawn
            local found = false
            for _, e in ipairs(szpInv.spawned) do
                if e.key == entry.key then found = true break end
            end
            if not found then
                table.insert(szpInv.spawned, {
                    key = entry.key, name = tostring(entry.name),
                    id = entry.id, slot = entry.slot,
                })
            end
            szpInv.wireFrame(mamy, entry)
            if szpInv.frameVisible(mamy) then return true, "already in the inventory (visible)" end
            return true, "in the list, but the game hides the panel - refresh the screen"
        end
        local IS = szpInv.reqIS()
        if not IS then return false, "InventoryService module missing" end
        local ok, res = pcall(function()
            -- THE PARAMETER ORDER IS REVERSED compared to the decompilation:
            -- the real signature is CreateItemFrame(key, table, count),
            -- not (table, key) - in the wrong order the game returns "Error"
            return IS:CreateItemFrame(entry.key, "Weapons", 1)
        end)
        if not ok or type(res) ~= "table" or not res.Frame then
            return false, "CreateItemFrame: " .. tostring(res):sub(1, 60)
        end
        local fr = res.Frame
        fr.Name = "SzpHub_" .. entry.key
        fr.Parent = list
        injected[fr] = { key = entry.key, name = tostring(entry.name) }
        szpInv.wireFrame(fr, entry)   -- click a tile = we pick it up
        local found = false
        for _, e in ipairs(szpInv.spawned) do
            if e.key == entry.key then found = true break end
        end
        if not found then
            -- id (mesh asset) and slot must survive a respawn, because without them
            -- hold-in-hand has nothing to build the Tool from
            table.insert(szpInv.spawned, {
                key = entry.key, name = tostring(entry.name),
                id = entry.id, slot = entry.slot,
            })
        end
        szpInv.hookGameInv()
        refreshInjected()
        -- we force the game screen to reveal and only THEN report:
        -- the earlier "OK" was true only on paper, because the Weapons
        -- panel can be hidden (game initialization not finished)
        task.wait(0.3)   -- give the game a moment to initialize itself
        szpInv.showPanel()
        refreshInjected()
        if szpInv.frameVisible(fr) then
            return true, "added to inventory (VISIBLE)"
        end
        return false, "added, but the game screen hides the panel"
    end

    -- combined filter: type (all/skins/weapons) + search by name,
    -- key and rarity - that is why typing "godly" or "ancient" shows
    -- entries that were not on the list at all before
    applyFilter = function()
        local q = string.lower((skinSearch and skinSearch.Text) or "")
        for _, e in ipairs(skins) do
            local btn = skinButtons[e.key]
            if btn then
                local okTyp = (skinFilter == "ALL") or (e.kind == skinFilter)
                local okTxt = (q == "")
                    or (string.find(string.lower(e.name), q, 1, true) ~= nil)
                    or (string.find(string.lower(e.key), q, 1, true) ~= nil)
                    or (string.find(string.lower(e.rarity), q, 1, true) ~= nil)
                btn.Visible = okTyp and okTxt
            end
        end
    end

    loadSkins = function()
        if skinsLoaded then return end
        skinsLoaded = true
        skinStatus.Text = "Loading game database..."
        local ok, Sync = pcall(function()
            return require(game:GetService("ReplicatedStorage")
                :WaitForChild("Database", 5):WaitForChild("Sync", 5))
        end)
        -- Sync.Weapons is the full database (1004 entries); Item is a copy of it,
        -- so we take Weapons and Item stays as a fallback source
        local db = (ok and type(Sync) == "table" and (Sync.Weapons or Sync.Item)) or nil
        if not ok or type(db) ~= "table" then
            skinStatus.Text = "Error: Database.Sync missing"
            lbSkinCount.Text = "Game database unavailable"
            return
        end
        rarityColors = (type(Sync.Rarity) == "table" and Sync.Rarity) or {}
        -- rarity order: rarest at the top of the list (so Godly/Ancient
        -- are visible right away instead of hidden somewhere in the middle)
        local rarRank = {
            Ancient = 1, Godly = 2, Unique = 3, Legendary = 4, Rare = 5,
            Uncommon = 6, Common = 7, Classic = 8, Halloween = 9, Christmas = 10,
        }
        local nSkin, nWeapon = 0, 0
        for k, v in pairs(db) do
            if type(v) == "table" and v.ItemID and (v.ItemType == "Gun" or v.ItemType == "Knife") then
                local s = tostring(k)
                local kind = (s:find("_G_") or s:find("_K_")) and "Skin" or "Weapon"
                if kind == "Skin" then nSkin = nSkin + 1 else nWeapon = nWeapon + 1 end
                table.insert(skins, {
                    key = s,
                    id = v.ItemID,
                    kind = kind,
                    slot = v.ItemType,          -- "Gun" or "Knife"
                    name = v.ItemName or s,
                    rarity = v.Rarity or "Common",
                    year = v.Year,
                    event = v.Event,
                })
            end
        end
        table.sort(skins, function(a, b)
            local ra = rarRank[a.rarity] or 99
            local rb = rarRank[b.rarity] or 99
            if ra ~= rb then return ra < rb end
            return tostring(a.name):lower() < tostring(b.name):lower()
        end)
        lbSkinCount.Text = "Entries: " .. #skins .. " (skins " .. nSkin .. ", weapons " .. nWeapon .. ")"
        skinStatus.Text = "Select an item and click SPAWN."
        for i, e in ipairs(skins) do
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -8, 0, 18)
            b.BackgroundColor3 = themes[currentTheme].ButtonBg
            b.BackgroundTransparency = 0.3
            b.BorderSizePixel = 1
            b.BorderColor3 = themes[currentTheme].Primary
            b.TextColor3 = rarityColor(e.rarity)
            b.TextSize = 10
            b.Font = Enum.Font.SourceSans
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.Text = " " .. tostring(e.name) .. "  [" .. tostring(e.rarity) .. "]"
            b.LayoutOrder = i
            b.ZIndex = 4
            b.AutoButtonColor = false
            b.Visible = (skinFilter == "ALL" or e.kind == skinFilter)
            b.Parent = skinList
            b.MouseButton1Click:Connect(function()
                selectedSkin = e
                lbSkinSel.Text = "Item: " .. tostring(e.name) .. " [" .. tostring(e.rarity) .. "] "
                    .. ((e.kind == "Skin") and "(skin)" or "(weapon)")
                for _, other in pairs(skinButtons) do
                    other.BackgroundTransparency = 0.3
                end
                b.BackgroundTransparency = 0
                skinStatus.Text = "Selected: " .. tostring(e.name) .. " - SPAWN adds it to the game inventory."
            end)
            skinButtons[e.key] = b
        end
    end

