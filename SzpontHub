-- ESP BLOXSTRIKE v2 — napisane OD NOWA, bo v1 nie przeżyło updacie gry.
--
-- DLACZEGO v1 padało: BloxStrike ma WLASNY system postaci i po updacie
-- v1 wymagało player.Character + Head + świeżego bufora pozycji, przez
-- co dla każdego wypisywało "brak Character i brak świeżej pozycji"
-- i zostawała garstka ludzi z rysunkiem.
--
-- ROZGNIETANY SYSTEM GRY (sonda na żywo w client PID 8052):
--   Player.Team            = "Terrorists" / "Counter-Terrorists" (STRING)
--   Player.Health/MaxHealth= 0..100 / 100
--   Player.Dead            = true/false      Player.IsCrouching
--   Player.CurrentEquipped = JSON z "Name":"AK-47" — trzymana broń
--   Model = player.Character, wisi w Workspace.Characters pod nickiem:
--   Health/Dead/MaxHealth, PresentationOwnerUserId = UserId,
--   CharacterName — i ZERO Humanoida (tylko AnimationController),
--   więc wszelkie czytanie Humanoid.Health dawało 0 albo nil.
--
-- NOWY SPOSÓB:
--   1. Cel = model z player.Character ALBO z folderu gry (nazwa nicku,
--      a jak nie — po PresentationOwnerUserId). Listę celów
--      przebudowujemy co 0.4 s, a nie co klatkę (AGENTS: żadnych
--      skanów w RenderStepped).
--   2. Kotwica etykiety: Head → HumanoidRootPart → PrimaryPart →
--      najwyższa część. Brak Head ZMIENIA kotwicę, nie kasuje gracza.
--   3. Zero filtrów "nie żyje = nie rysujemy" — martwy z modelem
--      dostaje szary + [DOWN], bez modelu i tak nie ma czego oznaczyć.
--   4. Kolor z Player.Team (porównanie stringów) — team zielony,
--      wróg czerwony; brak teamu = czerwony (lepiej pokazać niż pominąć).
--   5. Pętla JEDNA w _G + getter z huba, bo _G przeżywa reiniekcję —
--      bez tego każdy insert = kolejny RenderStepped i dublowane GUI.
------------------------------------------------------------
function startBsEspNew(getOn)
    -- Getter z NAJNOWSZEJ instalacji huba zawsze nadpisuje stary,
    -- a samą pętlę spinamy tylko raz.
    _G.__liptonBsEspGetter = getOn
    if _G.__liptonBsEspLoop then return end
    _G.__liptonBsEspLoop = true

    local Players = game:GetService("Players")
    local RS = game:GetService("RunService")
    local me = Players.LocalPlayer

    local REBUILD = 0.4   -- sekundy między pełnym szukaniem celów
    local rebuildAt = 0
    local targets = {}    -- { {p=gracz, m=model, a=kotwica}, ... }

    -- Kotwica rysowania: Head jest najlepszy (nick nad głową), reszta to
    -- zabezpieczenie, gdy gra ukryje/zmieni budowę postaci po updacie.
    -- GetDescendants wychodzi TYLKO gdy Head/HRP/PrimaryPart padną.
    local function findAnchor(m)
        local a = m:FindFirstChild("Head")
            or m:FindFirstChild("HumanoidRootPart")
            or m.PrimaryPart
        if a then return a end
        local bestY, best = -math.huge, nil
        for _, d in ipairs(m:GetDescendants()) do
            if d:IsA("BasePart") and d.Position.Y > bestY then
                bestY, best = d.Position.Y, d
            end
        end
        return best
    end

    local function rebuild()
        local fresh = {}
        local cf = workspace:FindFirstChild("Characters")
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= me then
                local m = p.Character
                if not (m and m.Parent) and cf then
                    -- tu v1 umierało całkowicie: model jest w folderze
                    -- gry, nie zawsze podpięty jako player.Character
                    m = cf:FindFirstChild(p.Name)
                    if not m then
                        for _, c in ipairs(cf:GetChildren()) do
                            if c:IsA("Model")
                                and c:GetAttribute("PresentationOwnerUserId") == p.UserId then
                                m = c
                                break
                            end
                        end
                    end
                end
                if m then
                    fresh[#fresh + 1] = { p = p, m = m, a = findAnchor(m) }
                end
            end
        end
        targets = fresh
    end

    local function isTeammate(p)
        -- Ich Team to string w atrybucie — porównujemy 1:1.
        local t = p:GetAttribute("Team")
        local mine = me:GetAttribute("Team")
        if t ~= nil and mine ~= nil then return t == mine end
        if p.Team and me.Team then return p.Team == me.Team end
        return false  -- brak danych = wróg (czerwony zamiast pustego ekranu)
    end

    local function hpOf(p, m)
        -- Kolejność model → gracz → Humanoid: w ich systemie liczy się
        -- atrybut, a Humanoida u wrogów po prostu nie ma (nil).
        local hp = tonumber(m:GetAttribute("Health"))
            or tonumber(p:GetAttribute("Health"))
        if hp == nil then
            local hum = m:FindFirstChildOfClass("Humanoid")
            hp = hum and hum.Health or 0
        end
        return math.floor(hp)
    end

    local function isDead(p, m)
        local d = p:GetAttribute("Dead")
        if d == nil then d = m:GetAttribute("Dead") end
        if d == true or d == 1 or d == "true" then return true end
        local hp = tonumber(m:GetAttribute("Health"))
            or tonumber(p:GetAttribute("Health"))
        return hp == 0
    end

    -- Trzymana broń z ich JSON-a w atrybucie — wycinamy samą nazwę,
    -- bez parsowania obiektu (tanie string.match na atrybucie).
    local function weaponOf(p)
        local s = p:GetAttribute("CurrentEquipped")
        if type(s) ~= "string" then return nil end
        return s:match('"Name"%s*:%s*"([^"]+)"')
    end

    local function clearAll()
        for _, t in ipairs(targets) do
            local hl = t.m and t.m:FindFirstChild("BsEspHL")
            if hl then hl:Destroy() end
            local bb = t.a and t.a:FindFirstChild("BsEspBB")
            if bb then bb:Destroy() end
            -- ramka jest przypięta do kotwicy (nie do modelu), więc osobno
            local bx = t.a and t.a:FindFirstChild("BsEspBox")
            if bx then bx:Destroy() end
        end
        targets = {}
    end

    -- Start: sprzątnij po poprzedniej instalacji huba, żeby reiniekcja
    -- nie zostawiła osieroconych etykiet na postaciach.
    local cf0 = workspace:FindFirstChild("Characters")
    if cf0 then
        for _, c in ipairs(cf0:GetChildren()) do
            local hl = c:FindFirstChild("BsEspHL")
            if hl then hl:Destroy() end
            local h = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
            local bb = h and h:FindFirstChild("BsEspBB")
            if bb then bb:Destroy() end
            local bx = h and h:FindFirstChild("BsEspBox")
            if bx then bx:Destroy() end
        end
    end

    -- BindToRenderStep z priorytetem POWYŻEJ kamery, nie zwykły
    -- RenderStepped: ESP musi dopisać rozmiary/kolory po grze i po
    -- własnych pętlach huba. Przy zwykłym RenderStepped starsza pętla
    -- (np. z poprzedniej injekcji, jeszcze żyjąca) nadpisywała wartości
    -- w tej samej klatce i ramka wracała do starych, wadliwych rozmiarów.
    RS:UnbindFromRenderStep("SzpontHubBsEsp")
    RS:BindToRenderStep("SzpontHubBsEsp", Enum.RenderPriority.Camera.Value + 10, function()
        local getter = _G.__liptonBsEspGetter
        if not (getter and getter()) then
            if #targets > 0 then clearAll() end
            return
        end

        local now = tick()
        if now - rebuildAt >= REBUILD then
            rebuildAt = now
            rebuild()
        end

        local cam = workspace.CurrentCamera
        for i = #targets, 1, -1 do
            local t = targets[i]
            local m = t.m
            if not (m and m.Parent) then
                -- model zniknął (respawn/koniec rundy) — pełna przebudowa
                -- i tak go przyniesie, więc tylko odkładamy z listy
                table.remove(targets, i)
            else
                local a = t.a
                if not (a and a.Parent) then
                    a = findAnchor(m)
                    t.a = a
                end
                if a then
                    local dead = isDead(t.p, m)
                    local color = dead and Color3.fromRGB(150, 150, 150)
                        or (not isTeammate(t.p)
                            and Color3.fromRGB(255, 45, 45)
                            or Color3.fromRGB(45, 255, 90))

                    -- HIGHLIGHT tworzony raz, ale atrybuty wymuszane CO
                    -- klatkę: domyślny Occluded chowa ESP za ścianą, a gra
                    -- potrafi nadpisać DepthMode — dlatego wraca tu co tick.
                    local hl = m:FindFirstChild("BsEspHL")
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "BsEspHL"
                        hl.Parent = m
                    end
                    hl.Adornee = m
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.FillColor = color
                    -- 0.55 było niezauważalne: przy wrogach 100-250 m (a w
                    -- BloxStrike kamera bywa Scriptable/spectator) fill dawał
                    -- kilka ledwo widocznych pikseli. 0.28 = wyraźna sylwetka
                    -- przez ściany, dalej widać kto jest kto.
                    hl.FillTransparency = 0.28
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.OutlineTransparency = 0

                    -- RAMKA WOKÓŁ POSTACI (GUI, nie Highlight).
                    -- Dlaczego GUI: Highlight sam w sobie był dla użytkownika
                    -- niezauważalny, a BillboardGui + UIStroke rysuje się tą
                    -- samą ścieżką co nasze nazwy nad głowami, które w tej
                    -- grze działają. Rozmiar podany w STUDSACH, więc ramka
                    -- trzyma się sylwetki niezależnie od dystansu (im dalej,
                    -- tym mniejsza — jak prawdziwy box ESP), a AlwaysOnTop
                    -- daje widzenie przez ściany.
                    local bx = a:FindFirstChild("BsEspBox")
                    if not bx then
                        bx = Instance.new("BillboardGui")
                        bx.Name = "BsEspBox"
                        bx.Parent = a
                        bx.ResetOnSpawn = false
                        bx.AlwaysOnTop = true
                        bx.LightInfluence = 0
                        local fr = Instance.new("Frame")
                        fr.Name = "BsEspBoxFrame"
                        fr.Parent = bx
                        fr.BackgroundTransparency = 1
                        fr.Size = UDim2.new(1, 0, 1, 0)
                        local st = Instance.new("UIStroke")
                        st.Name = "BsEspStroke"
                        st.Parent = fr
                        st.Thickness = 2.5
                        st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    end
                    -- ROZMIAR W PIKSELACH, LICZONY Z DYSTANSU.
                    -- WAŻNE: offset UDim2 w BillboardGui to PIKSELE, nie
                    -- study — wcześniejsze 3.4 x 6.4 dało ramkę 3x6 px, czyli
                    -- niewidoczną kropkę (stąd "ESP nie podświetla"). Rozmiar
                    -- bierzemy z rzutu pinhole: px = stud * (wys. ekranu / 2) /
                    -- (tg(fov/2) * dystans), więc ramka trzyma się sylwetki i
                    -- przy 5 m, i przy 350 m (kamera w BS bywa spectatorem).
                    local dystans = (a.Position - cam.CFrame.Position).Magnitude
                    local pxPerStud = (cam.ViewportSize.Y * 0.5)
                        / (math.tan(math.rad(cam.FieldOfView) * 0.5) * math.max(dystans, 1))
                    bx.Size = UDim2.fromOffset(
                        math.clamp(2.6 * pxPerStud, 26, 900),
                        math.clamp(5.8 * pxPerStud, 52, 1600))
                    -- Kotwica to Head (góra sylwetki), a pivot modelu leży
                    -- mniej więcej w środku — przesuwamy ramkę o różnicę.
                    bx.StudsOffset = Vector3.new(
                        0, m:GetPivot().Position.Y - a.Position.Y, 0)
                    local frBox = bx:FindFirstChild("BsEspBoxFrame")
                    local stBox = frBox and frBox:FindFirstChild("BsEspStroke")
                    if stBox then stBox.Color = color end

                    local bb = a:FindFirstChild("BsEspBB")
                    if not bb then
                        bb = Instance.new("BillboardGui")
                        bb.Name = "BsEspBB"
                        bb.Parent = a
                        bb.ResetOnSpawn = false
                    end
                    bb.Size = UDim2.new(0, 180, 0, 48)
                    bb.StudsOffset = Vector3.new(0, 3.2, 0)
                    bb.AlwaysOnTop = true
                    bb.Enabled = true

                    local txt = bb:FindFirstChild("BsEspTxt")
                    if not txt then
                        txt = Instance.new("TextLabel")
                        txt.Name = "BsEspTxt"
                        txt.Parent = bb
                        txt.BackgroundTransparency = 1
                        txt.Font = Enum.Font.SourceSansBold
                        txt.TextStrokeTransparency = 0
                    end
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.TextSize = 13
                    txt.TextColor3 = color

                    local line = t.p.Name
                    if dead then line = line .. " [DOWN]" end
                    local w = weaponOf(t.p)
                    if w then line = line .. " [" .. w .. "]" end
                    if t.p:GetAttribute("IsCrouching") then
                        line = line .. " (kuca)"
                    end
                    local dist = ""
                    if cam then
                        dist = " | " .. math.floor(
                            (a.Position - cam.CFrame.Position).Magnitude) .. "m"
                    end
                    txt.Text = line .. "\nHP " .. hpOf(t.p, m) .. dist
                end
            end
        end
    end)
end

