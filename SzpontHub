    -- TELEPORT CORE shared by the location list and events:
    -- preload around, raycast looking for land (Sea Level 127), PivotTo.
    -- exact = true: NO land search (for player teleport) -
    -- a raycast from above would hit the cave/corridor ceiling and land
    -- ABOVE the target instead of in it; in this mode PivotTo 1:1 at the position.
    local function tpCore(x, y, z, name, status, exact)
        task.spawn(function()
            if not isCurrentGen() then return end
            local plr = game:GetService("Players").LocalPlayer
            local ch = plr.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then
                status.Text = "No live character."
                return
            end
            pcall(function()
                plr:RequestStreamAroundAsync(Vector3.new(x, y, z), 12)
            end)
            task.wait(0.4)
            local land = nil
            local naWodzie = false
            if exact then
                land = Vector3.new(x, y, z)
            else
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {ch}
                local startY = math.max(y + 500, 527)
                local dirs = {
                    {0, 0}, {1, 0}, {-1, 0}, {0, 1}, {0, -1},
                    {0.7, 0.7}, {-0.7, 0.7}, {0.7, -0.7}, {-0.7, -0.7}
                }
                -- look for land (y > 127 = Sea Level); island terrain may
                -- stream in AFTER the preload, so retry with waiting
                local function searchLand(radii)
                    for _, rr in ipairs(radii) do
                        for _, d in ipairs(dirs) do
                            local from = Vector3.new(x + d[1] * rr, startY, z + d[2] * rr)
                            local hit = workspace:Raycast(from, Vector3.new(0, -4000, 0), params)
                            if hit and hit.Position.Y > 127 then
                                local nm = string.lower(hit.Instance.Name)
                                if not (nm:find("tree") or nm:find("leaf")
                                    or nm:find("foliage") or nm:find("grass")) then
                                    return hit.Position + Vector3.new(0, 4, 0)
                                end
                            end
                        end
                    end
                    return nil
                end
                local radiiA = {0, 60, 120, 200, 300, 420}
                local radiiB = {0, 100, 250, 450, 700, 1000}
                for attempt = 1, 6 do
                    land = searchLand(attempt <= 3 and radiiA or radiiB)
                    if land then break end
                    task.wait(1.0)
                end
                if not land then
                    local hit = workspace:Raycast(
                        Vector3.new(x, startY, z),
                        Vector3.new(0, -4000, 0), params)
                    land = hit and (hit.Position + Vector3.new(0, 4, 0))
                        or Vector3.new(x, math.max(y, 140), z)
                    naWodzie = true
                end
            end
            ch:PivotTo(CFrame.new(land))
            task.wait(1.2)
            local hrp2 = ch and ch:FindFirstChild("HumanoidRootPart")
            if not hrp2 then
                status.Text = "Teleport: no character after the jump."
                return
            end
            local dx = hrp2.Position.X - land.X
            local dz = hrp2.Position.Z - land.Z
            if (dx * dx + dz * dz) ^ 0.5 < 120 then
                status.Text = naWodzie and ("Teleport (no land): " .. name)
                    or ("Teleport OK: " .. name)
            else
                status.Text = "Teleport ?? " .. name
            end
        end)
    end

