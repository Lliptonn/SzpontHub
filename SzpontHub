    -- INSTANT INTERACT (no hold): ProximityPrompt.HoldDuration = 0,
    -- więc E robi się od razu, bez przytrzymywania (gra trzyma hold
    -- na 13 z 79 promptach — Collect/Activate). Oryginały zapisane
    -- przy ON → OFF je przywraca. Sweep przy włączeniu + zdarzenie
    -- DescendantAdded (streaming tworzy nowe prompty) + pętla co 1 s
    -- (serwer/lokalny skrypt może podmienić HoldDuration).
    -- Handler i pętla czytają WSPÓLNY stan env.SzpontUtility.instant
    -- ORAZ SzpontUtilityStop — stare kopje po re-iniekcji albo po
    -- "usunięciu skryptu" gasną same (pushUtilityState przy starcie
    -- zeruje stan).
    local instantConn = nil
    local instantLoopAlive = false
    local instantSaved = {}
    local function instantSweep()
        pcall(function()
            for _, d in ipairs(workspace:GetDescendants()) do
                if d:IsA("ProximityPrompt") and (d.HoldDuration or 0) > 0 then
                    if instantSaved[d] == nil then instantSaved[d] = d.HoldDuration end
                    d.HoldDuration = 0
                end
            end
        end)
    end
    local function setInstantInteract(on)
        pcall(function()
            if on then
                if not instantConn then
                    instantConn = workspace.DescendantAdded:Connect(function(d)
                        if not d:IsA("ProximityPrompt") then return end
                        local env = envOf()
                        if env.SzpontUtilityStop == true then return end
                        local st = env.SzpontUtility
                        if not (st and st.instant) then return end
                        if (d.HoldDuration or 0) > 0 then
                            instantSaved[d] = d.HoldDuration
                            d.HoldDuration = 0
                        end
                    end)
                end
                instantSweep()
                if not instantLoopAlive then
                    instantLoopAlive = true
                    task.spawn(function()
                        while true do
                            task.wait(1)
                            local env = envOf()
                            if env.SzpontUtilityStop == true then break end
                            local st = env.SzpontUtility
                            if not (st and st.instant) then break end
                            instantSweep()
                        end
                        instantLoopAlive = false
                    end)
                end
            else
                if instantConn then
                    instantConn:Disconnect()
                    instantConn = nil
                end
                for d, h in pairs(instantSaved) do
                    pcall(function()
                        if d.Parent then d.HoldDuration = h end
                    end)
                end
                table.clear(instantSaved)
            end
        end)
    end

    -- FLY jak MM2: PlatformStand + AutoRotate, ruch CFrame po WSAD
    -- z prędkością z suwaka, Velocity zerowane. Pętla jedna na VM
    -- i sama gasnąca, gdy fly OFF.
    local utilityLoopAlive = false
    local function ensureUtilityLoop()
        if utilityLoopAlive then return end
        utilityLoopAlive = true
        task.spawn(function()
            while true do
                local dt = task.wait(0.01)
                local env = envOf()
                if env.SzpontUtilityStop == true then break end
                local st = env.SzpontUtility or {}
                if not st.fly then break end
                pcall(function()
                    local ch = playersService.LocalPlayer.Character
                    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                    if not (hrp and hum and hum.Health > 0) then return end
                    hum.PlatformStand = true
                    hum.AutoRotate = false
                    local moveDir = Vector3.new(0, 0, 0)
                    local camera = workspace.CurrentCamera
                    if camera then
                        if uis:IsKeyDown(Enum.KeyCode.W) then
                            moveDir = moveDir + camera.CFrame.LookVector
                        end
                        if uis:IsKeyDown(Enum.KeyCode.S) then
                            moveDir = moveDir - camera.CFrame.LookVector
                        end
                        if uis:IsKeyDown(Enum.KeyCode.A) then
                            moveDir = moveDir - camera.CFrame.RightVector
                        end
                        if uis:IsKeyDown(Enum.KeyCode.D) then
                            moveDir = moveDir + camera.CFrame.RightVector
                        end
                    end
                    if uis:IsKeyDown(Enum.KeyCode.Space) then
                        moveDir = moveDir + Vector3.new(0, 1, 0)
                    end
                    if uis:IsKeyDown(Enum.KeyCode.LeftShift) then
                        moveDir = moveDir - Vector3.new(0, 1, 0)
                    end
                    local nextPos = hrp.Position
                    if moveDir.Magnitude > 0 then
                        nextPos = hrp.Position + (moveDir.Unit * (st.flySpeed or 60) * dt)
                    end
                    local lookDir = camera and camera.CFrame.LookVector or hrp.CFrame.LookVector
                    hrp.CFrame = CFrame.new(nextPos, nextPos + lookDir)
                    hrp.Velocity = Vector3.new(0, 0, 0)
                end)
            end
            pcall(function()
                local hum = playersService.LocalPlayer.Character
                    and playersService.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.PlatformStand = false
                    hum.AutoRotate = true
                end
            end)
            utilityLoopAlive = false
        end)
    end

