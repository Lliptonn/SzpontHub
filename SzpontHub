    -- BloxStrike: team lookup via workspace.Characters
    -- Looks for the Characters folder -> Terrorists / Counter-Terrorists
    local function getCharactersFolder()
        local c = workspace:FindFirstChild("Characters")
        if c then return c end
        -- Try other locations
        for _, child in pairs(workspace:GetChildren()) do
            if child.Name:lower():find("character") or child.Name:lower():find("team") then
                if child:FindFirstChild("Terrorists") or child:FindFirstChild("Counter-Terrorists") then
                    return child
                end
            end
        end
        return nil
    end

    local Characters = getCharactersFolder()
    if not Characters then
        -- Wait a moment and try again (the game may still be loading)
        task.wait(3)
        Characters = getCharactersFolder()
    end

    -- Function: checks whether a player is in the given team folder
    -- Checks direct presence AND whether the character model is a child
    local function isInTeamFolder(player, folder)
        if not folder or not player then return false end
        -- 1. Direct child (e.g. a folder named "67Tri_pleT67")
        if folder:FindFirstChild(player.Name) then return true end
        -- 2. The character model is a child of the folder
        if player.Character and player.Character.Parent == folder then return true end
        -- 3. Search deeper (Descendants -> in case of nesting)
        for _, obj in pairs(folder:GetDescendants()) do
            if obj.Name == player.Name then return true end
            if player.Character and obj == player.Character then return true end
        end
        return false
    end

    -- Team source: before, ONLY the "Team" attribute = "Terrorists"/"CT". When the game
    -- renames/re-types the attribute (or moves it onto the character), getTeamOf
    -- returns nil -> isTeammate=false for EVERYONE -> hitbox expand ate
    -- teammates, and silent aim redirected bullets at the nearest players
    -- (often teammates) instead of enemies. Now: multiple sources + a source evaluated
    -- on ALL players and accepted ONLY if it actually DIFFERENTIATES
    -- players (an identical value = rejected). The chosen source is also
    -- REVALIDATED every 2s (after a map/mode change the game may alter it).
    -- No source, or no team for someone = that player is NOT targeted by
    -- any aiming. Old bug 'no team = enemy': after my death the game WIPES
    -- my "Team" attribute -> me=teamless -> EVERYONE=enemies -> expand ate
    -- teammates (confirmed live: a dead local player has no Team).
    local teamSources = {
        function(p) -- "Team" attribute of any type (string/number)
            local ok, v = pcall(function() return p:GetAttribute("Team") end)
            if ok and v ~= nil and tostring(v) ~= "" then return "attr:Team=" .. tostring(v) end
        end,
        function(p) -- other variants of attribute names on the player
            -- After a game update the team key list can change, so 
            -- we keep a broad set of variants (rule of thumb: attribute = team).
            for _, key in ipairs({
                "TeamName", "team", "TeamId", "Side", "Faction",
                "Role", "TeamRole", "TeamNum", "TeamIndex", "TeamString",
                "PlayerTeam", "Squad", "Alliance", "TeamColor",
                "IsCT", "IsTerrorist", "CT", "T",
            }) do
                local ok, v = pcall(function() return p:GetAttribute(key) end)
                if ok and v ~= nil and tostring(v) ~= "" then return "attr:" .. key .. "=" .. tostring(v) end
            end
        end,
        function(p) -- attributes on the CHARACTER (the game may move teams on spawn)
            local ch = p.Character
            if ch then
                for _, key in ipairs({"Team", "TeamName", "team", "Side", "Role", "TeamId", "Faction", "TeamIndex"}) do
                    local ok, v = pcall(function() return ch:GetAttribute(key) end)
                    if ok and v ~= nil and tostring(v) ~= "" then return "cattr:" .. key .. "=" .. tostring(v) end
                end
            end
        end,
        function(p) -- classic Roblox Team / TeamColor
            if p.Team then return "team:" .. p.Team.Name end
            if p.TeamColor then return "clr:" .. p.TeamColor.Name end
        end,
        function(p) -- team folders (old structure, usually empty)
            if Characters then
                local t = Characters:FindFirstChild("Terrorists")
                local ct = Characters:FindFirstChild("Counter-Terrorists")
                if t and isInTeamFolder(p, t) then return "Terrorists" end
                if ct and isInTeamFolder(p, ct) then return "Counter-Terrorists" end
            end
        end,
        function(p) -- leaderstats (classic games keep the team in values)
            local ok, ls = pcall(function() return p:FindFirstChild("leaderstats") end)
            if ok and ls then
                for _, key in ipairs({"Team", "TeamName", "team", "Role", "Side", "Faction"}) do
                    local v = ls:FindFirstChild(key)
                    if v and v.Value ~= nil and tostring(v.Value) ~= "" then
                        return "ls:" .. key .. "=" .. tostring(v.Value)
                    end
                end
            end
        end,
        -- SAFETY NET AFTER A PATCH: the game changes the team key NAME, but
        -- the values still look CS-like (T/CT/Terrorists/Red/Blue).
        -- We scan the player's and the character's attributes and match by VALUE,
        -- not by key -> this way we never accidentally latch onto "Kills"/
        -- "Score" (those differ between players!) and aiming still
        -- knows who the enemy is. Last source in the queue.
        function(p)
            local function classify(v)
                if type(v) ~= "string" then return nil end
                local s = v:lower():gsub("^%s+", ""):gsub("%s+$", "")
                if s == "t" or s:find("terror", 1, true) then return "Terrorists" end
                if s == "ct" or s:find("counter", 1, true) then return "Counter-Terrorists" end
                if s == "red" or s == "redteam" or s:find("allies", 1, true) then return "Red" end
                if s == "blue" or s == "blueteam" or s:find("axis", 1, true) then return "Blue" end
                return nil
            end
            local okA, attrs = pcall(function() return p:GetAttributes() end)
            if okA and type(attrs) == "table" then
                for k, v in pairs(attrs) do
                    local c = classify(v)
                    if c then return "auto:" .. tostring(k) .. "=" .. c end
                end
            end
            local okC, ch = pcall(function() return p.Character end)
            if okC and ch then
                local okCA, cattrs = pcall(function() return ch:GetAttributes() end)
                if okCA and type(cattrs) == "table" then
                    for k, v in pairs(cattrs) do
                        local c = classify(v)
                        if c then return "cauto:" .. tostring(k) .. "=" .. c end
                    end
                end
            end
        end,
    }

    -- src = chosen source (function), nil = not established, false = no usable one
    local chosenSource = nil
    local lastSourceScan = 0
    local warnedNoTeam = false
    -- Last known team PER PLAYER: when the source temporarily fails
    -- (Intermission -> the game wipes attributes between rounds), ESP and aiming
    -- keep running on the last known split instead of dropping to zero.
    -- Fresh values from the source overwrite the cache (revalidated every 2s).
    local lastKnownTeams = {}

    local function resolveTeamSource()
        local now = tick()
        if chosenSource then
            if (now - lastSourceScan) < 2 then
                return chosenSource
            end
            -- REVALIDATION every 2s: the source must STILL differentiate players. When the game
            -- changes or removes the attribute after a map/mode switch, the old source
            -- already returns nil/indistinguishable values, and a permanent cache =
            -- a dead source for the rest of the session. We drop it and look for a new one.
            local rFirst, rDiffers, rCount = nil, false, 0
            for _, p in ipairs(playersService:GetPlayers()) do
                local ok, v = pcall(chosenSource, p)
                if ok and v ~= nil then
                    rCount = rCount + 1
                    if rFirst == nil then rFirst = v
                    elseif v ~= rFirst then rDiffers = true end
                end
            end
            if rCount >= 2 and rDiffers then
                lastSourceScan = now
                return chosenSource
            end
            chosenSource = nil
            warnedNoTeam = false
            lastSourceScan = 0 -- fresh scan right away, in the same pass
        end
        if now - lastSourceScan < 2 then return false end -- do not scan every frame
        lastSourceScan = now
        for _, src in ipairs(teamSources) do
            local first, differs, count = nil, false, 0
            for _, p in ipairs(playersService:GetPlayers()) do
                local ok, v = pcall(src, p)
                if ok and v ~= nil then
                    count = count + 1
                    if first == nil then first = v
                    elseif v ~= first then differs = true end
                end
            end
            if count >= 2 and differs then
                chosenSource = src
                return src
            end
        end
        -- Warn only if we NEVER learned the teams (a real deadlock).
        -- A temporary loss of the source with a full cache = systems run on
        -- lastKnownTeams -> no fake "aiming suspended".
        if not warnedNoTeam and next(lastKnownTeams) == nil then
            warnedNoTeam = true
            warn("[SzpontHub] BS: no team source that differentiates players -> aiming (expand/silent/aimbot/trigger) suspended until teams return")
        end
        return false
    end

    local function getTeamOf(player)
        if not player then return nil end
        local src = resolveTeamSource()
        if src then
            local ok, v = pcall(src, player)
            if ok and v ~= nil then
                lastKnownTeams[player] = v
                return v
            end
        end
        -- No source OR no value for this player (it is wiped after
        -- death/Intermission) -> return the last known team instead of nil. Thanks
        -- to that, isEnemy/isTeammate do not fade out between rounds (old bug:
        -- the source dropped to zero -> ESP showed zero enemies, aiming
        -- suspended even though characters were alive).
        return lastKnownTeams[player]
    end

    -- Player team cache (refreshed every 0.5s so as not to overload it)
    -- We remember the last known value because the game REMOVES the "Team" attribute on death
    local myTeamCache = nil
    local lastKnownMyTeam = nil
    local lastTeamCheck = 0

    local function getMyTeam()
        local now = tick()
        if lastTeamCheck > 0 and (now - lastTeamCheck) < 0.5 then
            return myTeamCache
        end
        lastTeamCheck = now
        myTeamCache = getTeamOf(plr)
        if myTeamCache then
            lastKnownMyTeam = myTeamCache
        else
            myTeamCache = lastKnownMyTeam
        end
        return myTeamCache
    end

    -- The team relation must be known on BOTH sides. If either is missing (my death
    -- wipes my "Team" attribute, a new player has no team yet, a dead target
    -- lost the attribute) -> that player is NOT targeted by any aiming system.
    -- Old bug 'no team = enemy': after the local player died EVERYONE
    -- became an enemy and hitbox expand ate teammates (while silent aim/aimbot/
    -- trigger fired at the nearest players regardless of team).
    local function isTeammate(player)
        if player == plr then return false end
        local myTeam = getMyTeam()
        if not myTeam then return false end
        local theirTeam = getTeamOf(player)
        if not theirTeam then return false end
        return theirTeam == myTeam
    end

    local function isEnemy(player)
        if player == plr then return false end
        local myTeam = getMyTeam()
        if not myTeam then return false end
        local theirTeam = getTeamOf(player)
        if not theirTeam then return false end -- unknown team -> do not target
        return theirTeam ~= myTeam
    end

    -- BloxStrike does not use a Humanoid -> life is the Health/Dead attributes (character and player)
    -- The second return value = REASON for rejection (ESP diagnostics only;
    -- the existing aiming code ignores the extra return as before).
    local function isAliveTarget(player, char)
        -- CORPSES: Dead is sometimes true / 1 / "true" and lives on the player OR on the character
        local d1 = player:GetAttribute("Dead") or char:GetAttribute("Dead")
        local d2 = player:GetAttribute("IsDead") or char:GetAttribute("IsDead")
        if d1 == true or d1 == 1 or d1 == "true" or d2 == true or d2 == 1 or d2 == "true" then
            return false, "Dead/IsDead=" .. tostring(d1) .. "/" .. tostring(d2)
        end
        -- Humanoid: classic death (when the game uses one)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if hum.Health <= 0 then return false, "Humanoid.Health=" .. tostring(hum.Health) end
            if hum:GetState() == Enum.HumanoidStateType.Dead then return false, "HumanoidState=Dead" end
        end
        -- BS source of truth = the Health attribute (of the character, or of the player if missing)
        local hp = tonumber(char:GetAttribute("Health"))
        local hpSrc = "char.Health"
        if hp == nil then
            hp = tonumber(player:GetAttribute("Health"))
            hpSrc = "player.Health"
        end
        if hp ~= nil and hp <= 0 then return false, hpSrc .. "=" .. tostring(hp) end
        return true, nil
    end

