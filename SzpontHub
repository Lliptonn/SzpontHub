            b.AutoButtonColor = false
            b.Visible = (skinFilter == "ALL" or e.kind == skinFilter)
            b.Parent = skinList
            b.MouseButton1Click:Connect(function()
                selectedSkin = e
                lbSkinSel.Text = "Pozycja: " .. tostring(e.name) .. " [" .. tostring(e.rarity) .. "] "
                    .. ((e.kind == "Skin") and "(skin)" or "(broń)")
