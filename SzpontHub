    -- LOBBY: in MM2 it is a separate model in Workspace ("RegularLobby"), while round maps
    -- spawn far away (on this server: Z9100). The old filter searched for a part
    -- named "lobby"/SpawnLocation within 100 studs of a single part
    -- while the lobby is 226x157x120 studs, so people standing in the lobby (killed
    -- players respawn there, anyone who joined mid-round too) PASSED the
    -- filter and Auto Kill All flew to the dead and waved the knife at the air.
    -- Now: bounding boxes of ENTIRE *lobby* models, refreshed at most every 2 s,
    -- point-in-box test (O(1), zero GetDescendants per call).
    local lobbyBoxes, lobbyBoxesAt, lobbySpawns = nil, 0, nil
    local function getLobbyBoxes()
        if lobbyBoxes and tick() - lobbyBoxesAt < 2 then return lobbyBoxes end
        local found = {}
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj.Name:lower():find("lobby") then
                local ok, cf, size = pcall(function() return obj:GetBoundingBox() end)
                if ok and cf and size then
                    table.insert(found, { cf = cf, size = size })
                end
            end
        end
        -- lobby spawns are collected ALWAYS (not only when no models are found): needed
        -- for the teleport after a fatal fling and for the Teleport tab.
        -- GetDescendants runs at most once per 2 s (cache above), not every frame.
        lobbySpawns = {}
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("SpawnLocation") then table.insert(lobbySpawns, obj.Position) end
        end
        lobbyBoxes, lobbyBoxesAt = found, tick()
        return found
    end

    local function isInLobby(pos, margin)
        local boxes = getLobbyBoxes()
        if #boxes == 0 then
            for _, sp in pairs(lobbySpawns or {}) do
                if (sp - pos).Magnitude < 100 then return true end
            end
            return false
        end
        for _, box in pairs(boxes) do
            local rel = box.cf:PointToObjectSpace(pos)
            local half = box.size / 2 + Vector3.new(margin, margin, margin)
            if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z then
                return true
            end
        end
        return false
    end

