    -- Called right away, but from a SHADOWED function: Luau has a hard limit of 200
    -- registers PER FUNCTION. Keeping those ~15 locals directly in
    -- startMainScript filled the budget completely and the compilation broke
    -- already at the farm declarations (farmJumpAt). Own function = own limit.
    setupTeleportTab()
    local farmSideAt = 0            -- when we last switched the avoidance side
    local farmJumpAt = 0            -- jump cooldown (both farms) - without it we jumped every frame
    local farmRayParams = RaycastParams.new()  -- raycast parameters (obstacles in the path)
    farmRayParams.FilterType = Enum.RaycastFilterType.Exclude
    local wallPass = {}    -- wall -> time when the "pass through" expires (0.6 s)
    -- timer for "reaching the target" while fleeing: we keep it so the farm
    -- does not chase in circles after one unreachable pickup (the murderer would
    -- catch us). When the target disappears / we break off, the timer resets.
    -- the pickup currently chased in flee mode: when the target changes
    -- (new coin), the timer restarts  otherwise after 1.2 s we would stop
    -- chasing altogether, even though collecting works

    local function isCoinAlive(part)
        if not part or not part.Parent then return false end
        -- the game marks a collected coin with the Collected attribute (CoinVisualizer uses that),
        -- and the touch part can be invisible (Transparency=1) even while the coin is alive
        if part:GetAttribute("Collected") or part:GetAttribute("Delete") then return false end
        for _, d in ipairs(part:GetDescendants()) do
            if d:GetAttribute("Collected") or d:GetAttribute("Delete") then return false end
        end
        -- VISIBLE COIN PIECE = proof of life: the visual comes from a MainCoin child,
        -- and after collection the server hides it (Transparency=1 or deletes it) and OFTEN does not
        -- set the Collected attribute - without this check the farm saw "phantom"
        -- coins and once the blacklist expired it aimed at them again.
        -- Siblings are looked up ONLY as a direct child (no recursive search),
        -- because with a flat structure a recursive search would find the MainCoin of a DIFFERENT coin.
        local vis = part:FindFirstChild("MainCoin", true)
            or (part.Parent and part.Parent:FindFirstChild("MainCoin"))
        if vis then
            if vis:IsA("BasePart") then
                if vis.Transparency >= 1 then return false end
            else
                -- MainCoin can be a Model: we check whether any part of it is visible
                local widoczna = false
                for _, vp in ipairs(vis:GetDescendants()) do
                    if vp:IsA("BasePart") and vp.Transparency < 1 then
                        widoczna = true
                        break
                    end
                end
                if not widoczna then return false end
            end
        end
        return true
    end

    local function findTouchPart(server)
        -- it can happen that Coin_Server (the Part with the TouchTransmitter) is a direct
        -- child of CoinContainer, and sometimes it is nested in a Model - we check both
        if server:IsA("BasePart") and server:FindFirstChildOfClass("TouchTransmitter") then
            return server
        end
        for _, d in ipairs(server:GetDescendants()) do
            if d:IsA("BasePart") and d:FindFirstChildOfClass("TouchTransmitter") then
                return d
            end
        end
        return nil
    end

    local function collectCoinsFrom(container)
        for _, server in ipairs(container:GetChildren()) do
            local touchPart = findTouchPart(server)
            if touchPart and isCoinAlive(touchPart) then
                table.insert(coinCache, touchPart)
            end
        end
    end

    -- Container types with pickups. "CoinContainer" is coins (verified
    -- live), the other names we guess based on the candies - if the game does not
    -- use them, FindFirstChild returns nil and nothing changes (cost: one
    -- FindFirstChild per map, so practically zero).
    local FARM_PICKUP_CONTAINERS = {
        "CoinContainer", "CandyContainer", "SweetsContainer", "SweetContainer",
    }

    local function refreshCoinCache(full)
        coinCache = {}
        -- maps sit as direct children of workspace, so we search them quickly
        for _, map in ipairs(workspace:GetChildren()) do
            for _, cname in ipairs(FARM_PICKUP_CONTAINERS) do
                local container = map:FindFirstChild(cname)
                if container then
                    collectCoinsFrom(container)
                elseif map.Name == cname then
                    collectCoinsFrom(map)
                end
            end
        end
        -- full workspace scan (80k+ instances) only as a fallback: the old code
        -- ran it 30 times per second when there were no live coins - horrible lag
        if full and #coinCache == 0 then
            -- empty map = round change: the old coins (including rejects)
            -- disappeared and the new ones get new instances - we clear the blacklist
            coinBlacklist = {}
            -- fallback: coins in an unusual place
            for _, d in ipairs(workspace:GetDescendants()) do
                for _, cname in ipairs(FARM_PICKUP_CONTAINERS) do
                    if d.Name == cname then
                        collectCoinsFrom(d)
                    end
                end
            end
        end
    end

