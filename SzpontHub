    -- Czesc wystaje, gdy ray z pocisku trafia w NIĄ jako pierwsza
    -- (gra pomija akcesoria i kapsuly, wiec czapka nie zablokuje celu w glowe)
    -- NIEZALEŻNA weryfikacja ściany: vanilla workspace:Raycast (niezależna od
    -- Shared.Raycast gry). Cel uznajemy za widoczny tylko gdy promień trafia
    -- w NIC albo w SAMĄ postać celu (tors podczas celowania w głowę to nie
    -- ściana); wszystko inne na drodze = zasłona → cel pomijamy.
    local function clearOfWalls(origin, part, targetChar, ignoreList)
        local toPart = part.Position - origin
        if toPart.Magnitude < 0.5 then return false end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local list = {}
        if plr.Character then insertT(list, plr.Character) end
        local camNow = workspace.CurrentCamera
        if camNow then
            for _, m in ipairs(camNow:GetChildren()) do insertT(list, m) end
        end
        if ignoreList then
            for _, e in ipairs(ignoreList) do insertT(list, e) end
        end
        params.FilterDescendantsInstances = list
        local res = workspace:Raycast(origin, toPart, params)
        if res == nil then return true end
        if targetChar and res.Instance:IsDescendantOf(targetChar) then return true end
        return false
    end

    local function partExposed(origin, part, ignoreList)
        local toPart = part.Position - origin
        if toPart.Magnitude < 0.5 then
            return false
        end
        local res = RaycastLib.cast(origin, toPart, nil, ignoreList)
        return res.instance == nil or res.instance == part
    end

    -- Punkt celowania w glowie: srodek, 6 scian i 8 ROGOW pudla (15 punktow,
    -- w ukladzie czesci — glowa rotuje sie razem z postacia). Kazdy punkt
    -- osobno sprawdzany promieniem, wiec powiekszony hitbox expandera jest
    -- trafiany nawet gdy wystaje tylko krawedz albo rog, a srodek lezy za
    -- sciana. Strzal NIGDY nie wychodzi przez sciane — udowodnione dla
    -- dokladnie tego punktu (promien trafia w nic albo w te glowe).
    local function headAimPoint(origin, head, ignoreList)
        local hp = head.Position
        local hs = head.Size * 0.5
        local cf = head.CFrame
        local ox = cf.RightVector * hs.X
        local oy = cf.UpVector * hs.Y
        local oz = cf.LookVector * hs.Z
        local pts = {
            hp,
            hp + ox, hp - ox,
            hp + oy, hp - oy,
            hp + oz, hp - oz,
            hp + ox + oy + oz, hp + ox + oy - oz,
            hp + ox - oy + oz, hp + ox - oy - oz,
            hp - ox + oy + oz, hp - ox + oy - oz,
            hp - ox - oy + oz, hp - ox - oy - oz,
        }
        for i = 1, 15 do
            local pt = pts[i]
            local toPt = pt - origin
            if toPt.Magnitude >= 0.5 then
                local res = RaycastLib.cast(origin, toPt, nil, ignoreList)
                if res.instance == nil or res.instance == head then
                    return pt
                end
            end
        end
        return nil
    end

    -- Zwraca czesc do ktorej ma poleciec pocisk albo nil
    local function findSilentTarget(origin, ignoreList, maxDist)
        local enemies = {}
        for _, p in ipairs_(Players_svc:GetPlayers()) do
            if p ~= plr and isEnemy(p) then
                local ch = p.Character
                if ch and isAliveTarget(p, ch) then
                    local hrp = ch:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d = (hrp.Position - origin).Magnitude
                        if d <= maxDist then
                            local head, others = nil, {}
                            for _, bp in ipairs_(ch:GetDescendants()) do
                                if bp:IsA("BasePart") and bp.Name ~= "HumanoidRootPart" and bp.Transparency < 1 and not bp:FindFirstAncestorOfClass("Accessory") then
                                    if bp.Name == "Head" then
                                        head = bp
                                    else
                                        insertT(others, bp)
                                    end
                                end
                            end
                            insertT(enemies, {ch, d, head, others})
                        end
                    end
                end
            end
        end
        sortT(enemies, function(a, b) return a[2] < b[2] end)
        -- WALLBANG: cel zza zaslonia tez dozwolony — bierzemy najblizszego
        -- wroga z glowa (srodek glowy; priorytet jak w Fazie1) albo tors.
        -- ZADNYCH testow widocznosci (headAimPoint/clearOfWalls) — promien
        -- ma przejsc przez sciane. Filtry isEnemy/isAliveTarget zostaja.
        if G.__liptonWallbang then
            for _, e in ipairs_(enemies) do
                if e[3] then
                    return e[3], e[3].Position
                end
            end
            for _, e in ipairs_(enemies) do
                local bp = e[4][1]
                if bp then
                    return bp, bp.Position
                end
            end
        end
        -- Faza1: hitbox glowy (powieszony przez expander) MA priorytet —
        -- bez bramki na srodku pudla, bo srodek czesto lezy za sciana,
        -- gdy wystaje juz krawedz albo rog. Kazdy punkt z headAimPoint jest
        -- indywidualnie sprawdzany promieniem, wiec strzal wychodzi wylacznie
        -- na odsloniety fragment — nigdy przez sciane.
        for _, e in ipairs_(enemies) do
            if e[3] then
                local aim = headAimPoint(origin, e[3], ignoreList)
                if aim then
                    return e[3], aim
                end
            end
        end
        -- Faza2: nikt nie wystawia glowy -> dowolna wystajaca czesc
        for _, e in ipairs_(enemies) do
            for _, bp in ipairs_(e[4]) do
                if clearOfWalls(origin, bp, e[1], ignoreList) and partExposed(origin, bp, ignoreList) then
                    return bp, bp.Position
                end
            end
        end
        return nil
    end

    -- Przekierowanie jednego pocisku: Direction + przebudowa hitow jak gra
    local function doRedirect(wself, b)
        if not (RaycastLib and GetRayIgnore) then
            return
        end
        local pr = wself.Properties
        if not pr or pr.Class ~= "Weapon" then
            return
        end
        local origin = b.Origin
        if not origin then
            return
        end
        local range = pr.Range or 500
        G.__liptonLastRange = range
        local ignoreList = GetRayIgnore()
        local part, aim = findSilentTarget(origin, ignoreList, range)
        if not part then
            return
        end
        local dir = (aim or part.Position) - origin
        if dir.Magnitude < 0.5 then
            return
        end
        local unit = dir.Unit
        local hit = RaycastLib.cast(origin, unit * range, nil, ignoreList)
        b.Direction = unit
        if hit.instance then
            local wb = G.__liptonWallbang == true
            local toAim = (aim - origin).Magnitude
            if wb then
                b.Distance = toAim
            else
                b.Distance = (hit.position - origin).Magnitude
            end
            local pen = pr.Penetration or 0
            local reach, budget
            if wb then
                reach = toAim + 4
                budget = 1e9
            else
                reach = pen + 0.001
                budget = pen
            end
            local through = RaycastLib.castThrough(hit.position - unit * 0.001, unit * reach, budget, ignoreList)
            b.Hits = {}
            for i, h in ipairs_(through) do
                if h.instance and h.material then
                    insertT(b.Hits, {
                        Position = h.position,
                        Instance = h.instance,
                        Material = h.material.Name,
                        Normal = h.normal or v3zero,
                        Exit = i % 2 == 0
                    })
                end
            end
            if wb then
                -- Utnij przejscie za cialem celu: petla konczy sie na trafieniu
                -- w nic albo100 iteracji, wiec za wrogiem moga zostac jeszcze
                -- powierzchnie pokoju/terenu — pakiet ma sie konczyc na parze
                -- wejscie/wyjscie CELU (tak jak vanilla z budzetem broni).
                local tmodel = part:FindFirstAncestorWhichIsA("Model")
                if tmodel then
                    for i, hh in ipairs_(b.Hits) do
                        if hh.Instance and hh.Instance:IsDescendantOf(tmodel) then
                            local keep = i + 1
                            if keep > #b.Hits then
                                keep = #b.Hits
                            end
                            for j = #b.Hits, keep + 1, -1 do
                                b.Hits[j] = nil
                            end
                            break
                        end
                    end
                end
            end
        else
            b.Distance = range
            b.Hits = {}
        end
    end

    -- Instalacja wrapper na module klasy Bullet (odporny na re-ekskrypcje):
    -- wersja wrapa trzymana w __liptonWrappedVer — gdy w grze stoi juz
    -- STARY wrapper (np. z poprzedniej wersji pliku), docepiamy nowy NA
    -- starym: stary redirect odpala sie pierwszy, nasz DRUGI i nadpisuje
    -- wynik — obowiazuje zawsze najnowszy kod. Przy tej samej wersji nie
    -- dublujemy lancucha. Stan przelacznikow we wspoldzielonym _G.
    local WRAP_VER = "wb1"
    if BulletClass and BulletClass.__liptonWrappedVer ~= WRAP_VER then
        local origCreate = BulletClass.create
        local wrapper = function(wself, ao, ia)
            local b = origCreate(wself, ao, ia)
            if b and G.__liptonSilentAim then
                pcall_(doRedirect, wself, b)
            end
            return b
        end
        local okEnv = pcall(function()
            setfenv(wrapper, {})
            setfenv(doRedirect, {})
            setfenv(findSilentTarget, {})
            setfenv(partExposed, {})
            setfenv(headAimPoint, {})
            for _, f in ipairs({wrapper, doRedirect, findSilentTarget, partExposed, headAimPoint}) do
                local e = getfenv(f)
                if e.getgenv or e.hookfunction then
                    error("dirty env")
                end
            end
        end)
        if okEnv then
            pcall(function()
                BulletClass.create = wrapper
                BulletClass.__liptonWrapped = true
                BulletClass.__liptonWrappedVer = WRAP_VER
            end)
        else
            warn("[SzpontHub] BS Silent Aim: env check odrzucony — wrapper pocisków NIE zainstalowany")
        end
    end

