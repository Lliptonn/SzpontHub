-- z BloxStrike. Fishing: przełączniki Auto Cast / Auto Shake /
-- Auto Reel zapisują stan do getgenv().SzpontFisch; logika
-- podpięta na żywo po analizie remote'ów/minigier Fisch:
-- cast = RemoteFunction "FishingRod/Cast" (0..100, perfect),
-- shake = firesignal przycisku shakeui.safezone (własny
-- throttle gry), reel = podbicie core.minigame._progressModifier
-- (koniec holowania przy progresie >= 100).
-- Exploit/Utility: zostają PUSTE (bez żadnych cheatów w środku —
-- decyzja usera; funkcje tylko w zakładce Fishing).
------------------------------------------------------------
function startFischScript()
    -- Już wczytane? Pokaż ponownie zamiast budować drugie GUI
    if fischGui and fischGui.Parent then
        fischGui.Enabled = true
        if fischCheatsGui then fischCheatsGui.Enabled = true end
        return
    end

    if gameSelectGui then gameSelectGui:Destroy() end

    -- FLAGI (tylko Fishing)
    local autoCast = false
    local autoShake = false
    local autoReel = false
    local autoAppraise = false

    -- PĘTLA AUTOMATYCZNEGO ŁOWIENIA (etap 2 — na żywo w Fisch).
    -- Kolejność w ticku: shake najpierw (minigra tyka), potem
    -- reel, na końcu cast (InvokeServer może się zawiesić).
    -- Tick co 0.05 s — patrz komentarz w ensureFishingLoop.
    local fishingLoopAlive = false
    local castBackoff = 0
    -- cache handlera shake'a (upvalue `now` + okno v14) — resolved
    -- raz na przycisk minigry, dryfowany co tick (patrz AUTO SHAKE)
    local shakeCacheBtn, shakeCacheFn, shakeCacheIdx = nil, nil, nil
    local shakeCacheDrift = 0

    local function fishingTick()
        local plr = game:GetService("Players").LocalPlayer
        local RS = game:GetService("ReplicatedStorage")
        local char = plr.Character
        local tool = char and char:FindFirstChildWhichIsA("Tool")

        -- AUTO SHAKE: klikaj aktywny przycisk minigry; gra sama
        -- robi throttle (okno v14 = 0.25/ShakeScale na upvalue
        -- `now`) i liczy postęp; handler wysyła do serwera
        -- LureShake/Shake bez argumentów — serwer widzi tylko
        -- częstość pakietów.
        -- PRZYSPIESZENIE (decyzja usera): dryf `now` liczony
        -- adaptacyjnie pod CEL 0.10 s/klik (10/s): d = (okno-0.10)/2
        -- + marża. Pełne zbijanie `now` (= 20/s) zrywało łowienie,
        -- więc sufit to 0.10 s. Kryterium: >=1 złapana ryba;
        -- jeśli przestaje łapać → cofnąć (drift = 0).
        if autoShake then
            local shakeGui = plr.PlayerGui:FindFirstChild("shakeui")
            if shakeGui then
                local zone = shakeGui:FindFirstChild("safezone")
                local btn = zone and zone:FindFirstChildWhichIsA("GuiButton", true)
                if btn then
                    -- handler minigry (upvalue `now`, okno `v14`)
                    -- resolved raz na przycisk; nowy shake = nowy
                    -- przycisk, więc okno liczone od świeżej sesji
                    if btn ~= shakeCacheBtn then
                        shakeCacheBtn = btn
                        shakeCacheFn = nil
                        shakeCacheIdx = nil
                        shakeCacheDrift = 0
                        pcall(function()
                            for _, cn in ipairs(getconnections(btn.Activated)) do
                                local f = cn.Function
                                if type(f) == "function" then
                                    local nowIdx, win, i = nil, nil, 1
                                    while true do
                                        local nm, val = debug.getupvalue(f, i)
                                        if not nm then break end
                                        if nm == "now" and type(val) == "number" then
                                            nowIdx = i
                                        end
                                        -- okno gry: liczba (0, 0.5]; kolejność
                                        -- upvalue (v14 = idx 2) wygrywa z v11
                                        -- (InitialTimer), które teoretycznie może
                                        -- zejść nisko pod koniec minigry
                                        if not win and type(val) == "number"
                                            and val > 0 and val <= 0.5
                                            and nm ~= "now" then
                                            win = val
                                        end
                                        i = i + 1
                                    end
                                    if not nowIdx then
                                        -- fallback: `now` = jedyne duże "tick()"
                                        i = 1
                                        while true do
                                            local nm, val = debug.getupvalue(f, i)
                                            if not nm then break end
                                            if type(val) == "number" and val > 1e9
                                                and val < tick() + 10 then
                                                nowIdx = i
                                                break
                                            end
                                            i = i + 1
                                        end
                                    end
                                    if nowIdx then
                                        shakeCacheFn = f
                                        shakeCacheIdx = nowIdx
                                        if win then
                                            shakeCacheDrift =
                                                math.max(win - 0.10, 0) / 2 + 0.001
                                        end
                                        break
                                    end
                                end
                            end
                        end)
                    end
                    if shakeCacheFn and shakeCacheDrift > 0 then
                        pcall(function()
                            local nm, val = debug.getupvalue(shakeCacheFn, shakeCacheIdx)
                            if nm and type(val) == "number" then
                                debug.setupvalue(shakeCacheFn, shakeCacheIdx,
                                    val - shakeCacheDrift)
                            end
                        end)
                    end
                    pcall(function() firesignal(btn.Activated) end)
                end
            end
        end

        -- AUTO REEL: podbicie progressu do 10000 — komponent
        -- Core.Minigame.Tick widzi >= 100 i woła EndMinigame
        -- (to wysyła Reel/Finish do serwera).
        -- INSTANT PO SHAKINGU: StartReel czeka sztuczne task.wait(2)
        -- na atrybut postaci "Reeling" (sygnał startu walki od
        -- serwera), zanim ustawi active/ready — a Tick minigry ma
        -- gate `if not current.active then return`, więc bez tego
        -- nic się nie dzieje. Gdy atrybut JUŻ jest, odpalamy
        -- ready natychmiast (co tick = 0.05 s) zamiast czekać do
        -- końca 2 s; zostaje tylko realny czas serwera + replikacja
        -- (~ping). Preload szanujemy jak oryginał
        -- (_awaiting_preload → sam ustawi ready po preloadzie).
        -- Kryterium nadal: >=1 złapana ryba.
        if autoReel then
            pcall(function()
                local RC = require(RS.client.legacyControllers.ReelController)
                local reel = RC.ActiveReel
                if reel then
                    local mg = reel.core and reel.core.minigame
                    if mg and mg._progressModifier then
                        mg._progressModifier.Value = 10000
                    end
                    if not reel.ready then
                        local char = plr.Character
                        if char and char:GetAttribute("Reeling") then
                            if (reel._preload_tasks or 0) > 0 then
                                reel._awaiting_preload = true
                            else
                                reel.active = true
                                reel.ready = true
                                pcall(function() reel.OnReady:Fire() end)
                            end
                        end
                    end
                end
            end)
        end

        -- AUTO CAST: tylko gdy wędka gotowa (state < Casting = 4,
        -- casted = false, brak bobbera, postać żyje).
        -- Moc = 100 = pełny pasek zarzucania (decyzja usera;
        -- wcześniej losowe 55–95).
        if autoCast and tick() >= castBackoff then
            if tool and tool:FindFirstChild("values") then
                local v = tool.values
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if v.state.Value < 4 and not v.casted.Value
                    and not tool:FindFirstChild("bobber")
                    and hum and hum.Health > 0 then
                    local ok, res = pcall(function()
                        local Net = require(RS.packages.Net)
                        return Net:RemoteFunction("FishingRod/Cast")
                            :InvokeServer(100, false)
                    end)
                    if not ok or res ~= true then
                        -- odrzucone przez serwer: nie spamujemy, przerwa
                        castBackoff = tick() + 3
                    end
                end
            end
        end
    end

    local function ensureFishingLoop()
        if fishingLoopAlive then return end
        if not (autoCast or autoShake or autoReel) then return end
        fishingLoopAlive = true
        task.spawn(function()
            -- getgenv().SzpontFischStop = true => pilne zatrzymanie
            -- petli z poziomu konsoli (bez GUI). Co 0.05 s = shake
            -- klika w kazdym dozwolonym oknie throttle gry
            -- (0.25/ShakeScale) — wczesniej przy ShakeScale > 1
            -- petla 0.25 s przepuszczala polowe okien.
            while autoCast or autoShake or autoReel do
                local stop = false
                pcall(function()
                    local env = (type(getgenv) == "function" and getgenv()) or _G
                    stop = env.SzpontFischStop == true
                end)
                if stop then break end
                pcall(fishingTick)
                task.wait(0.05)
            end
            fishingLoopAlive = false
        end)
    end

    local function pushFishingState()
        pcall(function()
            local env = (type(getgenv) == "function" and getgenv()) or _G
            env.SzpontFisch = {
                autoCast = autoCast,
                autoShake = autoShake,
                autoReel = autoReel,
                appraise = autoAppraise
            }
        end)
        ensureFishingLoop()
    end
    pushFishingState()

    -- AUTO APPRAISE (Fisch): teleport pod Appraisera i spam
    -- dialogu Appraise z driftwoodem w rece (3 C$ / proba).
    -- Flow rozmowy rozwiazany na zywo: Talk -> „Can you appraise
    -- this fish?” -> „Sure! ... Ready?” -> „Yes!” (appraise) ->
    -- „Can you appraise it again?” -> petla. OptionPress gry
    -- laczy sie na MouseButton1Click (NIE Activated), po kliknieciu
    -- natychmiast niszczy opcje i czeka 0.6 s + RF, wiec po
    -- kliknieciu dajemy grace 2.5 s zanim ewentualnie otworzymy
    -- rozmowe od nowa (prompt w trakcie aktywnego dialogu to
    -- no-op serwera). Klik zawsze w task.spawn — run:InvokeServer
    -- moze sie zawiesic. petla czyta WSPOLNY stan
    -- env.SzpontFisch.appraise + SzpontFischStop, wiec stare kopie
    -- po re-iniekcji gasna same (pushFishingState przy starcie
    -- zeruje stan).
    local appraiseLoopAlive = false
    local appraiseNextOpen = 0

    local function appraiseTick()
        local plr = game:GetService("Players").LocalPlayer
        local WS = game:GetService("Workspace")
        local char = plr.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end
        local bp = plr:FindFirstChild("Backpack")
        local pg = plr.PlayerGui

        -- (1) driftwood musi byc w rece (serwer: „hold out the fish”)
        local held = char:FindFirstChildWhichIsA("Tool")
        if not (held and held.Name == "Driftwood") then
            local dw = bp and bp:FindFirstChild("Driftwood")
            if dw then
                hum:EquipTool(dw)
                appraiseNextOpen = tick() + 1.0
            end
            return
        end

        -- (2) pod Appraiserem (prompt ma maxDist=7, wiec stajemy
        -- w odleglosci <= 6)
        local npc = WS:FindFirstChild("Appraiser", true)
        if not npc then return end
        local np = npc:GetPivot().Position
        if (np - char:GetPivot().Position).Magnitude > 6 then
            pcall(function() plr:RequestStreamAroundAsync(np, 5) end)
            char:PivotTo(CFrame.new(np + Vector3.new(3, 3, 3)))
            appraiseNextOpen = tick() + 1.5
            return
        end

        -- (3) dialog: szukamy gotowych opcji
        local opt = pg:FindFirstChild("options")
        local zone = opt and opt:FindFirstChild("safezone")
        local pick, hasAny
        if zone then
            for i = 1, 6 do
                local f = zone:FindFirstChild(i .. "option")
                if f then
                    hasAny = true
                    local tl = f:FindFirstChild("text")
                    local t = tl and string.lower(tl.Text) or ""
                    if not pick and (
                        t:find("appraise this fish", 1, true)
                        or t:find("appraise it again", 1, true)
                        or t:find("yes!", 1, true)
                    ) then
                        pick = f
                    end
                end
            end
        end
        if not hasAny then
            -- brak opcji: po kliknieciu czekamy grace, potem
            -- otwieramy rozmowe od nowa
            if tick() < appraiseNextOpen then return end
            local prompt
            for _, d in ipairs(npc:GetDescendants()) do
                if d:IsA("ProximityPrompt") then prompt = d break end
            end
            if prompt then
                prompt:InputHoldBegin()
                task.wait(0.15)
                prompt:InputHoldEnd()
                appraiseNextOpen = tick() + 2.5
            end
            return
        end
        if not pick then return end
        local btn = pick:FindFirstChild("button")
        if not btn then return end
        task.spawn(function()
            pcall(function() firesignal(btn.MouseButton1Click) end)
        end)
        appraiseNextOpen = tick() + 2.5
    end

    local function ensureAppraiseLoop()
        if appraiseLoopAlive then return end
        appraiseLoopAlive = true
        task.spawn(function()
            while true do
                task.wait(0.5)
                local stop, on = false, false
                pcall(function()
                    local env = (type(getgenv) == "function" and getgenv()) or _G
                    stop = env.SzpontFischStop == true
                    local st = env.SzpontFisch
                    on = st ~= nil and st.appraise == true
                end)
                if stop or not on then break end
                pcall(appraiseTick)
            end
            appraiseLoopAlive = false
        end)
    end

