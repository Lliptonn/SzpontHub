            end
            cam.CFrame = CFrame.lookAt(pos, focus)
            cam.Focus = CFrame.new(focus)
            return "OK", vis, total
        end)
        if not ok then
            bTP.Text = "TP ERR:" .. tostring(code):sub(1, 25)
            return
        end
