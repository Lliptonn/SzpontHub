        -- which looked like fling (teleporting) instead of pushing.
        -- The pace comes from the "Annoy Speed" slider (10 = the old value).
        annoyPhase = annoyPhase + dt * annoyUi.speed
        local push = 3 - 2 * math.cos(annoyPhase) -- 1 - 5 studs behind him
        local goal = tHrp.Position - tHrp.CFrame.LookVector * push
        goal = Vector3.new(goal.X, goal.Y - 0.25, goal.Z) -- a bit lower (the butt)

        -- movement: smoothly, no teleporting. The step scales with the slider
        -- too, otherwise a fast phase would outrun the glide and look static.
        local offset = goal - myHrp.Position
        local len = offset.Magnitude
        if len > 0.02 then
