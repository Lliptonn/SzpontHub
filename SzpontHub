    -- LOBBY: w MM2 to osobny model w Workspace ("RegularLobby"), a mapy rund
    -- spawnują się daleko (w tym serwerze: Z≈9100). Stary filtr szukał partu
    -- o nazwie "lobby"/SpawnLocation w promieniu 100 studów od jednego partu —
    -- a lobby ma 226x157x120 studów, więc ludzie stojący w lobby (zabici
    -- respawnują się tam, kto wszedł w trakcie rundy też) PRZECHODZILI przez
    -- filtr i Auto Kill All latał do zabitych i machał nożem w powietrze.
    -- Teraz: bounding boxe'y CAŁYCH modeli *lobby*, odświeżane max co 2 s,
    -- test punkt-w-pudelku (O(1), zero GetDescendants na wywołanie).
    local lobbyBoxes, lobbyBoxesAt, lobbySpawns = nil, 0, nil
    local function getLobbyBoxes()
        if lobbyBoxes and tick() - lobbyBoxesAt < 2 then return lobbyBoxes end
        local found = {}
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj.Name:lower():find("lobby") then
                local ok, cf, size = pcall(function() return obj:GetBoundingBox() end)
                if ok and cf and size then
                    table.insert(found, { cf = cf, size = size })
                end
            end
        end
        -- zapas gdy lobby chwilowo nie ma (przeładowanie): pozycje spawnów,
        -- zbierane przy tym samym odświeżaniu, nie przy każdym wywołaniu
        if #found == 0 then
            lobbySpawns = {}
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("SpawnLocation") then table.insert(lobbySpawns, obj.Position) end
            end
        end
        lobbyBoxes, lobbyBoxesAt = found, tick()
        return found
    end

    local function isInLobby(pos, margin)
        local boxes = getLobbyBoxes()
        if #boxes == 0 then
            for _, sp in pairs(lobbySpawns or {}) do
                if (sp - pos).Magnitude < 100 then return true end
            end
            return false
        end
        for _, box in pairs(boxes) do
            local rel = box.cf:PointToObjectSpace(pos)
            local half = box.size / 2 + Vector3.new(margin, margin, margin)
            if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z then
                return true
            end
        end
        return false
    end

    local function isTargetValid(target)
