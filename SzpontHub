        b3.BackgroundColor3 = speedHack and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
        updateActiveCheatsList()
    end)

    runService.RenderStepped:Connect(function()
        -- Humanoid przez getHum: po respawnie model może go nie mieć
        local hum = getHum(plr.Character)
        if hum then
            hum.WalkSpeed = speedHack and walkSpeedVal or 16
        end
    end)

    local function getRoleColor(role)
        if role == "Murderer" then return Color3.fromRGB(255, 0, 0)
        elseif role == "Sheriff" then return Color3.fromRGB(0, 150, 255)
        else return Color3.fromRGB(0, 255, 0) end
    end

    b4.MouseButton1Click:Connect(function()
        espEnabled = not espEnabled
        b4.Text = espEnabled and "ESP: ON" or "ESP: OFF"
        b4.BackgroundColor3 = espEnabled and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
        updateActiveCheatsList()
    end)

    runService.RenderStepped:Connect(function()
        for _, player in pairs(playersService:GetPlayers()) do
            if player ~= plr and player.Character then
                local char = player.Character
                local head = char:FindFirstChild("Head")
                if espEnabled and head then
                    local role = getRole(player)
                    local color = getRoleColor(role)
                    local highlight = char:FindFirstChild("ESPHighlight") or Instance.new("Highlight", char)
                    highlight.Name = "ESPHighlight"
                    highlight.Adornee = char
                    highlight.FillColor = color
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0

                    local billboard = head:FindFirstChild("ESPBillboard") or Instance.new("BillboardGui", head)
                    billboard.Name = "ESPBillboard"
                    billboard.Size = UDim2.new(0, 100, 0, 40)
                    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                    billboard.AlwaysOnTop = true

                    local txt = billboard:FindFirstChild("ESPText") or Instance.new("TextLabel", billboard)
                    txt.Name = "ESPText"
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.TextColor3 = color
                    txt.TextStrokeTransparency = 0
                    txt.TextSize = 14
                    txt.Font = Enum.Font.SourceSansBold
                    txt.Text = player.Name .. "\n[" .. role .. "]"
                else
                    local highlight = char:FindFirstChild("ESPHighlight")
                    if highlight then highlight:Destroy() end
                    if head then
                        local billboard = head:FindFirstChild("ESPBillboard")
                        if billboard then billboard:Destroy() end
                    end
                end
            end
        end
    end)

    updateActiveCheatsList()
end

