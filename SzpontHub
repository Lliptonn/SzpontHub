    mm2Btn.BorderColor3 = Color3.fromRGB(170, 50, 255)
    mm2Btn.BorderSizePixel = 0
    do
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 8)
        c.Parent = mm2Btn
        local s = Instance.new("UIStroke")
        s.Color = Color3.fromRGB(170, 50, 255)
        s.Thickness = 2
        s.Transparency = 0.2
