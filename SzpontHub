    -- Kółko FOV + Aimbot — RenderStepped (PO kamerze gry)
    runService.RenderStepped:Connect(function()
        -- celuje dopiero przy PPM + rewolwer w ręce (jak BloxStrike)
        local armed = aimbotEnabled and mm2Ppm and getEquippedRevolver() ~= nil

        -- kółko FOV: widoczne gdy aimbot włączony, zielone gdy CELUJE,
        -- fioletowe gdy tylko czeka (bez PPM albo bez rewolweru)
        if fovFrame2 then
            if aimbotEnabled then
                local viewportSize = cam.ViewportSize
                -- koło = prawdziwy stożek selekcji (tan), jak w BloxStrike
                local fovDraw = math.min(aimbotFov, 85)
                local tanHalf = math.tan(math.rad(math.max(cam.FieldOfView, 1) / 2))
                local screenRadius = (viewportSize.Y / 2) * math.tan(math.rad(fovDraw)) / math.max(tanHalf, 1e-4)
                screenRadius = math.clamp(screenRadius, 24, math.max(viewportSize.X, viewportSize.Y) / 2)
                local d = math.floor(screenRadius * 2 + 0.5)
                fovFrame2.Size = UDim2.fromOffset(d, d)
                fovFrame2.Position = UDim2.fromOffset(
                    math.floor(viewportSize.X / 2 - screenRadius + 0.5),
                    math.floor(viewportSize.Y / 2 - screenRadius + 0.5))
                fovFrame2.Visible = true
                if fovStroke2 then
                    fovStroke2.Color = armed and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(170, 50, 255)
                    fovStroke2.Enabled = true
                end
            else
                fovFrame2.Visible = false
                if fovStroke2 then fovStroke2.Enabled = false end
            end
        end

        if not armed then return end
        -- sam szeryf nie strzela do siebie; bez rewolweru nie ma czego celować
        if getRole(plr) == "Murderer" then return end

        local camPos = cam.CFrame.Position
        local camDir = cam.CFrame.LookVector
        local best, bestAngle = nil, math.min(aimbotFov, 85)
        local now = tick()

        for _, p in pairs(playersService:GetPlayers()) do
            if p ~= plr and p.Character and getRole(p) == "Murderer" then
                local ok
                local cached = aimValidCache[p]
                if cached and (now - cached.t) < 0.25 then
                    ok = cached.ok
                else
                    ok = isTargetValid(p)
                    aimValidCache[p] = { t = now, ok = ok }
                end
                if ok then
                    -- Celowanie w CIAŁO: klatka/pas zamiast głowy
                    -- (UpperTorso R15 > Torso R6 > HumanoidRootPart; Head tylko
                    -- jako awaryjny punkt, gdyby korpusu nie było)
                    for _, partName in ipairs({"UpperTorso", "Torso", "HumanoidRootPart", "Head"}) do
                        local part = p.Character:FindFirstChild(partName)
                        if part then
                            local toTarget = part.Position - camPos
                            local dist = toTarget.Magnitude
                            if dist > 0 and dist < 800 then
                                local ang = math.deg(math.acos(math.clamp(camDir:Dot(toTarget.Unit), -1, 1)))
                                if ang < bestAngle then
                                    bestAngle = ang
                                    best = part.Position
                                end
                            end
                            break
                        end
                    end
                end
            end
        end

        if not best then return end

        -- STEROWANIE: symulacja ruchu myszy (adaptacja czułości co klatkę)
        local dir = (best - camPos).Unit
        local look = cam.CFrame.LookVector
        local ang = math.acos(math.clamp(look:Dot(dir), -1, 1))
        if ang > math.rad(0.3) and mousemoverel and (not iswindowactive or iswindowactive()) then
            local yawNow = math.atan2(look.X, -look.Z)
            if mm2AimCtl.yawSent ~= nil and mm2AimCtl.dx ~= 0 then
                local dYaw = yawNow - mm2AimCtl.yawSent
                while dYaw > math.pi do dYaw = dYaw - 2 * math.pi end
                while dYaw < -math.pi do dYaw = dYaw + 2 * math.pi end
                local s = math.abs(dYaw) / math.abs(mm2AimCtl.dx)
                if s > 0.0002 and s < 0.05 then
                    mm2AimCtl.sens = mm2AimCtl.sens * 0.6 + s * 0.4
                end
            end
            mm2AimCtl.yawSent = yawNow
            local yawErr, pitchErr = 0, 0
            local flatLook = Vector3.new(look.X, 0, look.Z)
            local flatDir = Vector3.new(dir.X, 0, dir.Z)
            if flatLook.Magnitude > 1e-4 and flatDir.Magnitude > 1e-4 then
                flatLook = flatLook.Unit
                flatDir = flatDir.Unit
                yawErr = math.atan2(flatDir:Cross(flatLook).Y, flatLook:Dot(flatDir))
            end
            -- pion względem OSI kamery (nie horyzontu) — inaczej znak się odwraca
            pitchErr = math.asin(math.clamp(dir:Dot(cam.CFrame.UpVector), -1, 1))
            local k = 0.15 + (math.clamp(aimbotSpeed, 1, 125) - 1) / 124 * 0.8
            local degPerPx = math.max(mm2AimCtl.sens * (180 / math.pi), 1e-5)
            local dx = math.clamp(math.floor(math.deg(yawErr) * k / degPerPx + 0.5), -500, 500)
            local dy = math.clamp(math.floor(-math.deg(pitchErr) * k / degPerPx + 0.5), -500, 500)
            mm2AimCtl.dx = dx
            if dx ~= 0 or dy ~= 0 then
                pcall(mousemoverel, dx, dy)
            end
        elseif not mousemoverel then
            -- fallback gdy brak mousemoverel: obrót samej kamery
            local goal = CFrame.new(camPos, best)
            cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(0.15 + aimbotSpeed / 125 * 0.8, 0.15, 0.95))
        end
    end)

