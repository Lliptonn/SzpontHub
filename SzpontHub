            end
        end

        -- Aimbot — Snap na celownik gdy PPM trzymany
        if aimbotEnabled and ppm and plr.Character then
            local camPos = cam.CFrame.Position
            local camDir = cam.CFrame.LookVector
            local best = nil
            local bestAngle = aimbotFov

            for _, p in pairs(game.Players:GetPlayers()) do
                if p ~= plr and p.Character and isEnemy(p) then
                    if isAliveTarget(p, p.Character) then
                        -- Szukaj najlepszego punktu: Head > UpperTorso > HumanoidRootPart
                        local parts = {"Head", "UpperTorso", "HumanoidRootPart"}
                        for _, partName in ipairs(parts) do
                            local part = p.Character:FindFirstChild(partName)
                            if part then
                                local toTarget = part.Position - camPos
                                local dist = toTarget.Magnitude
                                if dist > 0 and dist < 800 then
                                    local ang = math.deg(math.acos(math.clamp(camDir:Dot(toTarget.Unit), -1, 1)))
                                    if ang < bestAngle then
                                        bestAngle = ang
                                        best = part.Position
                                    end
                                end
                                break -- wystarczy pierwsza znaleziona część
                            end
                        end
                    end
                end
            end

            if best then
                -- Symulacja ruchu myszy: kontroler gry sam obraca kamerę I postać,
                -- strzały trafiają w cel, a widok nie wraca po puszczeniu PPM.
                local dir = (best - camPos).Unit
                local look = cam.CFrame.LookVector
                local ang = math.acos(math.clamp(look:Dot(dir), -1, 1))
                if ang > math.rad(0.3) and mousemoverel and iswindowactive() then
                    local yawErr, pitchErr = 0, 0
                    local flatLook = Vector3.new(look.X, 0, look.Z)
                    local flatDir = Vector3.new(dir.X, 0, dir.Z)
                    if flatLook.Magnitude > 1e-4 and flatDir.Magnitude > 1e-4 then
                        flatLook = flatLook.Unit
                        flatDir = flatDir.Unit
                        yawErr = math.atan2(flatDir:Cross(flatLook).Y, flatLook:Dot(flatDir))
                    end
                    pitchErr = math.asin(math.clamp(dir.Y, -1, 1)) - math.asin(math.clamp(look.Y, -1, 1))
                    local gain = math.clamp(aimbotSpeed * 50, 100, 600)
                    local dx = math.clamp(math.floor(yawErr * gain + 0.5), -500, 500)
                    local dy = math.clamp(math.floor(-pitchErr * gain + 0.5), -500, 500)
                    if dx ~= 0 or dy ~= 0 then
                        pcall(mousemoverel, dx, dy)
                    end
                elseif not mousemoverel then
                    -- fallback gdy brak mousemoverel: obrót samej kamery
                    local goal = CFrame.new(camPos, best)
                    local alpha = math.clamp(aimbotSpeed / 30, 0.05, 1)
                    cam.CFrame = cam.CFrame:Lerp(goal, alpha)
                end
            end
        end
    end)

