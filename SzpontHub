    -- BloxStrike: sprawdzenie teamów przez workspace.Characters
    -- Szuka folderu Characters → Terrorists / Counter-Terrorists
    local function getCharactersFolder()
        local c = workspace:FindFirstChild("Characters")
        if c then return c end
        -- Spróbuj inne lokalizacje
        for _, child in pairs(workspace:GetChildren()) do
            if child.Name:lower():find("character") or child.Name:lower():find("team") then
                if child:FindFirstChild("Terrorists") or child:FindFirstChild("Counter-Terrorists") then
                    return child
                end
            end
        end
        return nil
    end

    local Characters = getCharactersFolder()
    if not Characters then
        -- Czekaj chwilę i spróbuj ponownie (gra mogła się jeszcze ładować)
        task.wait(3)
        Characters = getCharactersFolder()
    end

    -- Funkcja: sprawdza czy gracz jest w podanym folderze teamu
    -- Sprawdza bezpośrednią obecność ORAZ czy model postaci jest dzieckiem
    local function isInTeamFolder(player, folder)
        if not folder or not player then return false end
        -- 1. Bezpośrednie dziecko (np. folder "67Tri_pleT67")
        if folder:FindFirstChild(player.Name) then return true end
        -- 2. Model postaci jest dzieckiem folderu
        if player.Character and player.Character.Parent == folder then return true end
        -- 3. Szukaj głębiej (Descendants — na wypadek zagnieżdżenia)
        for _, obj in pairs(folder:GetDescendants()) do
            if obj.Name == player.Name then return true end
            if player.Character and obj == player.Character then return true end
        end
        return false
    end

    -- Źródło prawdy: atrybut gracza "Team" = "Terrorists" / "Counter-Terrorists"
    -- (gra NIE trzyma postaci w folderach teamów — Characters/Terrorists jest puste,
    --  postacie są bezpośrednio w workspace.Characters)
    local function getTeamOf(player)
        if not player then return nil end

        local ok, attr = pcall(function() return player:GetAttribute("Team") end)
        if ok and type(attr) == "string" and attr ~= "" then
            return attr
        end

        -- Fallback: folder teamu (gdyby gra kiedyś zmieniła strukturę)
        if Characters then
            local t = Characters:FindFirstChild("Terrorists")
            local ct = Characters:FindFirstChild("Counter-Terrorists")
            if t and isInTeamFolder(player, t) then return "Terrorists" end
            if ct and isInTeamFolder(player, ct) then return "Counter-Terrorists" end
        end
        return nil
    end

    -- Cache teamu gracza (odświeża się co 0.5s żeby nie obciążać)
    -- Zapamiętujemy ostatnio znaną wartość, bo gra USUWA atrybut "Team" po śmierci
    local myTeamCache = nil
    local lastKnownMyTeam = nil
    local lastTeamCheck = 0

    local function getMyTeam()
        local now = tick()
        if lastTeamCheck > 0 and (now - lastTeamCheck) < 0.5 then
            return myTeamCache
        end
        lastTeamCheck = now
        myTeamCache = getTeamOf(plr)
        if myTeamCache then
            lastKnownMyTeam = myTeamCache
        else
            myTeamCache = lastKnownMyTeam
        end
        return myTeamCache
    end

    local function isTeammate(player)
        if player == plr then return false end
        local myTeam = getMyTeam()
        if not myTeam then return false end
        return getTeamOf(player) == myTeam
    end

    local function isEnemy(player)
        if player == plr then return false end
        -- Brak znanego teamu u nas lub u celu → bezpieczniejsze domyślnie: wróg
        return not isTeammate(player)
    end

