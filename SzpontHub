    -- FOV circle + Aimbot on RenderStepped (AFTER the game camera)
    runService.RenderStepped:Connect(function()
        if not isCurrentGen() then return end
        if not isCurrentGen() then return end
        -- armed = RMB aimbot OR Auto Kill Murder: the auto-kill needs the same
        -- persistent camera aim - every frame the camera is pinned on the
        -- murderer, so whenever the gun cycle lets a shot out it is already aimed
        local armed = getEquippedRevolver() ~= nil and ((aimbotEnabled and mm2Ppm) or autoKillMurder)

        -- FOV circle: visible when the aimbot is on, green when AIMING,
        -- purple when it is only waiting (no RMB or no revolver)
        if fovFrame2 then
            if aimbotEnabled then
                local viewportSize = cam.ViewportSize
                -- circle = the real selection cone (tan), as in BloxStrike
                local fovDraw = math.min(aimbotFov, 85)
                local tanHalf = math.tan(math.rad(math.max(cam.FieldOfView, 1) / 2))
                local screenRadius = (viewportSize.Y / 2) * math.tan(math.rad(fovDraw)) / math.max(tanHalf, 1e-4)
                screenRadius = math.clamp(screenRadius, 24, math.max(viewportSize.X, viewportSize.Y) / 2)
                local d = math.floor(screenRadius * 2 + 0.5)
                fovFrame2.Size = UDim2.fromOffset(d, d)
                fovFrame2.Position = UDim2.fromOffset(
                    math.floor(viewportSize.X / 2 - screenRadius + 0.5),
                    math.floor(viewportSize.Y / 2 - screenRadius + 0.5))
                fovFrame2.Visible = true
                if fovStroke2 then
                    fovStroke2.Color = armed and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(170, 50, 255)
                    fovStroke2.Enabled = true
                end
            else
                fovFrame2.Visible = false
                if fovStroke2 then fovStroke2.Enabled = false end
            end
        end

        if not armed then return end
        -- the sheriff does not shoot himself; without a revolver there is nothing to aim at
        if getRole(plr) == "Murderer" then return end

        local camPos = cam.CFrame.Position
        local camDir = cam.CFrame.LookVector
        local best, bestAngle = nil, math.min(aimbotFov, 85)
        local now = tick()

        for _, p in pairs(playersService:GetPlayers()) do
            if p ~= plr and p.Character and getRole(p) == "Murderer" then
                local ok
                local cached = aimValidCache[p]
                if cached and (now - cached.t) < 0.25 then
                    ok = cached.ok
                else
                    ok = isTargetValid(p)
                    aimValidCache[p] = { t = now, ok = ok }
                end
                if ok then
                    -- Aim at the BODY: chest/waist instead of the head
                    -- (UpperTorso R15 > Torso R6 > HumanoidRootPart; Head only
                    -- as a fallback point if there is no torso)
                    for _, partName in ipairs({"UpperTorso", "Torso", "HumanoidRootPart", "Head"}) do
                        local part = p.Character:FindFirstChild(partName)
                        if part then
                            -- LINE OF FIRE (why): the MM2 bullet dies on the first thing
                            -- in the ray - aiming through a wall or a bystander is a
                            -- wasted bullet (and a dead innocent). Only targets with a
                            -- clear ray from the camera are considered.
                            local rp = mm2AimCtl.rp
                            rp.FilterDescendantsInstances = { plr.Character }
                            local blocked = workspace:Raycast(camPos, part.Position - camPos, rp)
                            if not blocked then
                                -- LEAD (why): the pull converges over several frames while
                                -- the murderer keeps running - aim slightly ahead (capped
                                -- at 1.5 studs) so the lag lands ON the body, not behind it
                                local aimPoint = part.Position
                                local lead = part.AssemblyLinearVelocity * 0.06
                                if lead.Magnitude > 1.5 then lead = lead.Unit * 1.5 end
                                aimPoint = aimPoint + lead
                                local toTarget = aimPoint - camPos
                                local dist = toTarget.Magnitude
                                if dist > 0 and dist < 800 then
                                    local ang = math.deg(math.acos(math.clamp(camDir:Dot(toTarget.Unit), -1, 1)))
                                    if ang < bestAngle then
                                        bestAngle = ang
                                        best = aimPoint
                                    end
                                end
                            end
                            break
                        end
                    end
                end
            end
        end

        if not best then return end

        -- CONTROL: mouse movement simulation (sensitivity adapted every frame)
        local dir = (best - camPos).Unit
        local look = cam.CFrame.LookVector
        local ang = math.acos(math.clamp(look:Dot(dir), -1, 1))
        if autoKillMurder then
            -- Auto Kill Murder: camera-only snap, every frame, at ANY angle -
            -- the fire loop cannot wait for the mouse pull to converge (and the
            -- pull would drag the real cursor to the screen edge anyway)
            cam.CFrame = CFrame.new(camPos, best)
        elseif ang > math.rad(0.3) and mousemoverel and (not iswindowactive or iswindowactive()) then
            local yawNow = math.atan2(look.X, -look.Z)
            if mm2AimCtl.yawSent ~= nil and mm2AimCtl.dx ~= 0 then
                local dYaw = yawNow - mm2AimCtl.yawSent
                while dYaw > math.pi do dYaw = dYaw - 2 * math.pi end
                while dYaw < -math.pi do dYaw = dYaw + 2 * math.pi end
                local s = math.abs(dYaw) / math.abs(mm2AimCtl.dx)
                if s > 0.0002 and s < 0.05 then
                    mm2AimCtl.sens = mm2AimCtl.sens * 0.6 + s * 0.4
                end
            end
            mm2AimCtl.yawSent = yawNow
            local yawErr, pitchErr = 0, 0
            local flatLook = Vector3.new(look.X, 0, look.Z)
            local flatDir = Vector3.new(dir.X, 0, dir.Z)
            if flatLook.Magnitude > 1e-4 and flatDir.Magnitude > 1e-4 then
                flatLook = flatLook.Unit
                flatDir = flatDir.Unit
                yawErr = math.atan2(flatDir:Cross(flatLook).Y, flatLook:Dot(flatDir))
            end
            -- pitch relative to the CAMERA axis (not the horizon) - otherwise the sign flips
            pitchErr = math.asin(math.clamp(dir:Dot(cam.CFrame.UpVector), -1, 1))
            local k = 0.15 + (math.clamp(aimbotSpeed, 1, 125) - 1) / 124 * 0.8
            local degPerPx = math.max(mm2AimCtl.sens * (180 / math.pi), 1e-5)
            local dx = math.clamp(math.floor(math.deg(yawErr) * k / degPerPx + 0.5), -500, 500)
            local dy = math.clamp(math.floor(-math.deg(pitchErr) * k / degPerPx + 0.5), -500, 500)
            mm2AimCtl.dx = dx
            if dx ~= 0 or dy ~= 0 then
                pcall(mousemoverel, dx, dy)
            end
        elseif not mousemoverel then
            -- fallback when mousemoverel is missing: rotating the camera itself
            local goal = CFrame.new(camPos, best)
            cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(0.15 + aimbotSpeed / 125 * 0.8, 0.15, 0.95))
        end
        -- HARD SNAP (why): the shot is read from the camera THIS frame, while the
        -- mouse pull converges over several frames and trails a strafing murderer
        -- by ~3 deg at speed 6 (18% of the error per frame) - that trailing is
        -- exactly why the revolver missed the body. Below 5 deg we pin the camera
        -- ON the aim point (lead included), so every click lands dead-center.
        if ang < math.rad(5) then
            cam.CFrame = CFrame.new(camPos, best)
        end
    end)

