function startBloxStrikeScript()
    -- Już wczytane? Pokaż ponownie zamiast budować drugie GUI
    if bsGui and bsGui.Parent then
        bsGui.Enabled = true
        if bsCheatsGui then bsCheatsGui.Enabled = true end
        return
    end

    if gameSelectGui then gameSelectGui:Destroy() end

    local aimbotEnabled = false
    local espEnabled = false
    local triggerbot = false
    -- Triggerbot delay (ms): 0 = strzał w każdej klatce (jak przed dodaniem
    -- suwaka), 300 = co najmniej 300 ms przerwy między strzałami.
    local triggerDelayMs = 60
    local lastTriggerShot = 0
    local infiniteJump = false
    local bunnyHop = false
    local bhopUnlocker = false
    local speedHack = false
    local speedHackValue = 50
    -- NO WEAPON SLOW usunięty z menu (zawartość zakładki Movement wyczyszczona).
    -- Wymuś wyłączenie flagi: hak instalowany przy poprzedniej re-eksekucji wisi
    -- dalej i czyta tabelę z getgenv — bez UI trzeba zgasić go stąd, inaczej
    -- broń zostałaby bez spowolnienia na stałe, bez możliwości przełączenia.
    pcall(function()
        local g = (type(getgenv) == "function" and getgenv()) or _G
        local st = g.SzpontNoWeaponSlow
        if type(st) == "table" then
            st.enabled = false
        end
    end)
    local hitboxExpander = false
    local hitboxSize = 3
    local noRecoil = false
    local noSpread = false
    local fullbright = false
    local crosshairEnabled = false

    local aimbotFov = 50
    local aimbotSpeed = 6

    local fovCircle = nil
    local ppm = false

    -- BloxStrike: sprawdzenie teamów przez workspace.Characters
    -- Szuka folderu Characters → Terrorists / Counter-Terrorists
    local function getCharactersFolder()
        local c = workspace:FindFirstChild("Characters")
        if c then return c end
        -- Spróbuj inne lokalizacje
        for _, child in pairs(workspace:GetChildren()) do
            if child.Name:lower():find("character") or child.Name:lower():find("team") then
                if child:FindFirstChild("Terrorists") or child:FindFirstChild("Counter-Terrorists") then
                    return child
                end
            end
        end
        return nil
    end

    local Characters = getCharactersFolder()
    if not Characters then
        -- Czekaj chwilę i spróbuj ponownie (gra mogła się jeszcze ładować)
        task.wait(3)
        Characters = getCharactersFolder()
    end

    -- Funkcja: sprawdza czy gracz jest w podanym folderze teamu
    -- Sprawdza bezpośrednią obecność ORAZ czy model postaci jest dzieckiem
    local function isInTeamFolder(player, folder)
        if not folder or not player then return false end
        -- 1. Bezpośrednie dziecko (np. folder "67Tri_pleT67")
        if folder:FindFirstChild(player.Name) then return true end
        -- 2. Model postaci jest dzieckiem folderu
        if player.Character and player.Character.Parent == folder then return true end
        -- 3. Szukaj głębiej (Descendants — na wypadek zagnieżdżenia)
        for _, obj in pairs(folder:GetDescendants()) do
            if obj.Name == player.Name then return true end
            if player.Character and obj == player.Character then return true end
        end
        return false
    end

    -- Źródło teamu: dawniej TYLKO atrybut "Team" = "Terrorists"/"CT". Gdy gra
    -- zmieniła nazwę/typ atrybut (albo przeniosła go na postać), getTeamOf
    -- zwracał nil → isTeammate=false dla WSZYSTKICH → hitbox expand łapał
    -- teammatów, a silent aim przekierowywał pociski w najbliższych graczy
    -- (często teamków) zamiast w wrogów. Teraz: wiele źródeł + źródło liczone
    -- na WSZYSTKICH graczach i akceptowane TYLKO jeśli faktycznie ROZNI
    -- graczy (wspólna wartość = odrzucone). Wybrane źródło jest też
    -- REWALIDOWANE co 2s (po zmianie mapy/trybu gra może je zmienić).
    -- Brak źródła albo brak teamu u kogoś = gracz NIE jest tykany przez
    -- celowanie. Stary błąd „brak teamu = wróg": po mojej śmierci gra KASUJE
    -- mi atrybut "Team" → ja=bez teamu → WSZYSCY=wrógowie → expand łapał
    -- teamków (potwierdzone na żywo: martwy lokalny gracz nie ma Team).
    local teamSources = {
        function(p) -- atrybut "Team" dowolnego typu (string/number)
            local ok, v = pcall(function() return p:GetAttribute("Team") end)
            if ok and v ~= nil and tostring(v) ~= "" then return "attr:Team=" .. tostring(v) end
        end,
        function(p) -- inne warianty nazw atrybutów na graczu
            -- Po updacie gry lista kluczy teamu potrafi się zmienić —
            -- trzymamy szeroki zestaw wariantów (zakładka: atrybut = team).
            for _, key in ipairs({
                "TeamName", "team", "TeamId", "Side", "Faction",
                "Role", "TeamRole", "TeamNum", "TeamIndex", "TeamString",
                "PlayerTeam", "Squad", "Alliance", "TeamColor",
                "IsCT", "IsTerrorist", "CT", "T",
            }) do
                local ok, v = pcall(function() return p:GetAttribute(key) end)
                if ok and v ~= nil and tostring(v) ~= "" then return "attr:" .. key .. "=" .. tostring(v) end
            end
        end,
        function(p) -- atrybuty na POSTACI (gra mogła przenosić team przy spawnie)
            local ch = p.Character
            if ch then
                for _, key in ipairs({"Team", "TeamName", "team", "Side", "Role", "TeamId", "Faction", "TeamIndex"}) do
                    local ok, v = pcall(function() return ch:GetAttribute(key) end)
                    if ok and v ~= nil and tostring(v) ~= "" then return "cattr:" .. key .. "=" .. tostring(v) end
                end
            end
        end,
        function(p) -- klasyczne Roblox Team / TeamColor
            if p.Team then return "team:" .. p.Team.Name end
            if p.TeamColor then return "clr:" .. p.TeamColor.Name end
        end,
        function(p) -- foldery teamów (stara struktura, zwykle pusta)
            if Characters then
                local t = Characters:FindFirstChild("Terrorists")
                local ct = Characters:FindFirstChild("Counter-Terrorists")
                if t and isInTeamFolder(p, t) then return "Terrorists" end
                if ct and isInTeamFolder(p, ct) then return "Counter-Terrorists" end
            end
        end,
        function(p) -- leaderstats (klasyczne gry trzymają team w wartościach)
            local ok, ls = pcall(function() return p:FindFirstChild("leaderstats") end)
            if ok and ls then
                for _, key in ipairs({"Team", "TeamName", "team", "Role", "Side", "Faction"}) do
                    local v = ls:FindFirstChild(key)
                    if v and v.Value ~= nil and tostring(v.Value) ~= "" then
                        return "ls:" .. key .. "=" .. tostring(v.Value)
                    end
                end
            end
        end,
        -- SIEC RATUNKOWA PO UPCIE: gra zmieniła NAZWĘ klucza teamu, ale
        -- wartości dalej wyglądają po CS-owemu (T/CT/Terrorists/Red/Blue).
        -- Skanujemy atrybuty gracza i postaci i dopasowujemy po WARTOŚCI,
        -- nie po kluczu — dzięki temu nie złapiemy przypadkiem "Kills"/
        -- "Score" (też się różnią między graczami!) i celowanie dalej
        -- wie, kto jest wróg. Ostatnie źródło w kolejce.
        function(p)
            local function classify(v)
                if type(v) ~= "string" then return nil end
                local s = v:lower():gsub("^%s+", ""):gsub("%s+$", "")
                if s == "t" or s:find("terror", 1, true) then return "Terrorists" end
                if s == "ct" or s:find("counter", 1, true) then return "Counter-Terrorists" end
                if s == "red" or s == "redteam" or s:find("allies", 1, true) then return "Red" end
                if s == "blue" or s == "blueteam" or s:find("axis", 1, true) then return "Blue" end
                return nil
            end
            local okA, attrs = pcall(function() return p:GetAttributes() end)
            if okA and type(attrs) == "table" then
                for k, v in pairs(attrs) do
                    local c = classify(v)
                    if c then return "auto:" .. tostring(k) .. "=" .. c end
                end
            end
            local okC, ch = pcall(function() return p.Character end)
            if okC and ch then
                local okCA, cattrs = pcall(function() return ch:GetAttributes() end)
                if okCA and type(cattrs) == "table" then
                    for k, v in pairs(cattrs) do
                        local c = classify(v)
                        if c then return "cauto:" .. tostring(k) .. "=" .. c end
                    end
                end
            end
        end,
    }

    -- src = wybrane źródło (funkcja), nil = nieustalone, false = brak sensownego
    local chosenSource = nil
    local lastSourceScan = 0
    local warnedNoTeam = false
    -- Ostatnio znany team PER GRACZ: gdy źródło chwilowo nie działa
    -- (Intermission — gra kasuje atrybuty między rundami), ESP i celowanie
    -- jadą dalej na ostatnim znanym podziale zamiast gasnąć do zera.
    -- Świeże wartości ze źródła nadpisują cache (rewalidacja co 2s).
    local lastKnownTeams = {}

    local function resolveTeamSource()
        local now = tick()
        if chosenSource then
            if (now - lastSourceScan) < 2 then
                return chosenSource
            end
            -- REWALIDACJA co 2s: źródło musi DALEJ różnić graczy. Gdy gra
            -- po zmianie mapy/trybu zmieni albo usunie atrybut, stare źródło
            -- zwraca już nil/nieodróżnialne wartości, a wieczny cache =
            -- źródło-trup do końca sesji. Zdejmujemy je i szukamy nowego.
            local rFirst, rDiffers, rCount = nil, false, 0
            for _, p in ipairs(playersService:GetPlayers()) do
                local ok, v = pcall(chosenSource, p)
                if ok and v ~= nil then
                    rCount = rCount + 1
                    if rFirst == nil then rFirst = v
                    elseif v ~= rFirst then rDiffers = true end
                end
            end
            if rCount >= 2 and rDiffers then
                lastSourceScan = now
                return chosenSource
            end
            chosenSource = nil
            warnedNoTeam = false
            lastSourceScan = 0 -- świeży skan od razu w tej samej turze
        end
        if now - lastSourceScan < 2 then return false end -- nie skanuj co klatkę
        lastSourceScan = now
        for _, src in ipairs(teamSources) do
            local first, differs, count = nil, false, 0
            for _, p in ipairs(playersService:GetPlayers()) do
                local ok, v = pcall(src, p)
                if ok and v ~= nil then
                    count = count + 1
                    if first == nil then first = v
                    elseif v ~= first then differs = true end
                end
            end
            if count >= 2 and differs then
                chosenSource = src
                return src
            end
        end
        -- Alarm tylko gdy NIGDY nie znaliśmy teamów (prawdziwy deadlock).
        -- Chwilowa utrata źródła z zapełnionym cache = systemy jadą na
        -- lastKnownTeams — bez fałszywego „celowanie wstrzymane".
        if not warnedNoTeam and next(lastKnownTeams) == nil then
            warnedNoTeam = true
            warn("[SzpontHub] BS: brak źródła teamu różniącego graczy — celowanie (expand/silent/aimbot/trigger) wstrzymane, dopóki teamy nie wrócą")
        end
        return false
    end

    local function getTeamOf(player)
        if not player then return nil end
        local src = resolveTeamSource()
        if src then
            local ok, v = pcall(src, player)
            if ok and v ~= nil then
                lastKnownTeams[player] = v
                return v
            end
        end
        -- Brak źródła ALBO brak wartości u tego gracza (kasuje się po
        -- śmierci/Intermission) → ostatnio znany team zamiast nil. Dzięki
        -- temu isEnemy/isTeammate nie wygasają między rundami (stary błąd:
        -- źródło spadło do zera → ESP pokazywał zero wrogów, celowanie
        -- wstrzymane mimo żyjących postaci).
        return lastKnownTeams[player]
    end

    -- Cache teamu gracza (odświeża się co 0.5s żeby nie obciążać)
    -- Zapamiętujemy ostatnio znaną wartość, bo gra USUWA atrybut "Team" po śmierci
    local myTeamCache = nil
    local lastKnownMyTeam = nil
    local lastTeamCheck = 0

    local function getMyTeam()
        local now = tick()
        if lastTeamCheck > 0 and (now - lastTeamCheck) < 0.5 then
            return myTeamCache
        end
        lastTeamCheck = now
        myTeamCache = getTeamOf(plr)
        if myTeamCache then
            lastKnownMyTeam = myTeamCache
        else
            myTeamCache = lastKnownMyTeam
        end
        return myTeamCache
    end

    -- Relacja teamu musi być znana z OBU stron. Gdy którejś brak (moja śmierć
    -- kasuje mi atrybut "Team", nowy gracz jeszcze nie ma teamu, martwy cel
    -- stracił atrybut) — gracz NIE jest tykany przez żaden system celowania.
    -- Stary błąd „brak teamu = wróg": po śmierci lokalnego gracza WSZYSCY
    -- robili się wrogami i hitbox expand łapał teamków (a silent aim/aimbot/
    -- trigger strzelały w najbliższych bez względu na team).
    local function isTeammate(player)
        if player == plr then return false end
        local myTeam = getMyTeam()
        if not myTeam then return false end
        local theirTeam = getTeamOf(player)
        if not theirTeam then return false end
        return theirTeam == myTeam
    end

    local function isEnemy(player)
        if player == plr then return false end
        local myTeam = getMyTeam()
        if not myTeam then return false end
        local theirTeam = getTeamOf(player)
        if not theirTeam then return false end -- nieznany team → nie tykamy
        return theirTeam ~= myTeam
    end

    -- BloxStrike nie używa Humanoida — życie to atrybuty Health/Dead (postaci i gracza)
    -- Druga wartość zwracana = POWÓD odrzucenia (tylko do diagnostyki ESP;
    -- istniejący kod celowania ignoruje dodatkowy return bez zmian).
    local function isAliveTarget(player, char)
        -- TRUPY: Dead bywa true / 1 / "true" i siedzi na graczu ALBO na postaci
        local d1 = player:GetAttribute("Dead") or char:GetAttribute("Dead")
        local d2 = player:GetAttribute("IsDead") or char:GetAttribute("IsDead")
        if d1 == true or d1 == 1 or d1 == "true" or d2 == true or d2 == 1 or d2 == "true" then
            return false, "Dead/IsDead=" .. tostring(d1) .. "/" .. tostring(d2)
        end
        -- Humanoid: śmierć klasyczna (gdy gra go używa)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if hum.Health <= 0 then return false, "Humanoid.Health=" .. tostring(hum.Health) end
            if hum:GetState() == Enum.HumanoidStateType.Dead then return false, "HumanoidState=Dead" end
        end
        -- Źródło prawdy BS = atrybut Health (postaci, a gdy brak — gracza)
        local hp = tonumber(char:GetAttribute("Health"))
        local hpSrc = "char.Health"
        if hp == nil then
            hp = tonumber(player:GetAttribute("Health"))
            hpSrc = "player.Health"
        end
        if hp ~= nil and hp <= 0 then return false, hpSrc .. "=" .. tostring(hp) end
        return true, nil
    end

