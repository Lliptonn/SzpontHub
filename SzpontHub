    local function findAuroraTool()
        local found = nil
        pcall(function()
            local lp = game.Players.LocalPlayer
            local function scan(cont)
                if not cont or found then return end
                for _, t in ipairs(cont:GetChildren()) do
                    if t:IsA("Tool") and t.Name:lower():find("aurora", 1, true) then
                        found = t
                        return
                    end
                end
            end
            scan(lp:FindFirstChild("Backpack"))
            if not found then scan(lp.Character) end
        end)
        return found
    end

