-- FUNCTION: GAME SELECTION MENU
------------------------------------------------------------
local function showGameSelect()
    -- keyGui may already be destroyed when returning from the menu
    if keyGui and keyGui.Parent then keyGui:Destroy() end
    -- kill any OLD game-select window before making the new one (belt and
    -- braces: an old instance or a missed path could still have one alive -
    -- without this two "LiptonHub Game Select" windows stack on screen)
    pcall(function()
        local cs = {targetParent, game.CoreGui}
        local pg = game:GetService("Players").LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if pg then table.insert(cs, pg) end
        local rg = game.CoreGui:FindFirstChild("RobloxGui")
        if rg then table.insert(cs, rg) end
        for _, c in ipairs(cs) do
            for _, g in ipairs(c:GetChildren()) do
                if g:IsA("ScreenGui") and g.Name == "LiptonHubGameSelect" then g:Destroy() end
            end
        end
    end)

    gameSelectGui = Instance.new("ScreenGui")
    gameSelectGui.Name = "LiptonHubGameSelect"
    gameSelectGui.ResetOnSpawn = false
    gameSelectGui.Parent = targetParent
    gameSelectGui.IgnoreGuiInset = true
    -- IMPORTANT: by default ScreenGui has ZIndexBehavior.Global, so the children
    -- of gsFrame (default ZIndex 1) loaded UNDER the waves (ZIndex 2-3) and under
    -- the black canvas - the panel and the text looked faded. Sibling =
    -- ZIndex sorts only among siblings, so gsFrame (5) wins over
    -- gsCanvas (1) together with all of its children.
    gameSelectGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    ------------------------------------------------------------
    -- THIS FOLLOWS THE GLSL SHADER (fancy waves)
    -- Shader: y = 0.5 + _{k=1..i} sin(x*k + t + k/2)*0.1 for i = 1..5,
    -- and the wave color is vec3(f*(10-i)/10, f*i/10, f^1.5*1.5) - that is from
    -- magenta to blue. GUI has no shaders, so we draw each wave as
    -- a chain of rotated segments (frames) repositioned every frame.
    ------------------------------------------------------------
    local gsCanvas = Instance.new("Frame")
    gsCanvas.Name = "ShaderBG"
    gsCanvas.Size = UDim2.new(1, 0, 1, 0)
    gsCanvas.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    gsCanvas.BackgroundTransparency = 0.3
    gsCanvas.BorderSizePixel = 0
    gsCanvas.ClipsDescendants = true
    gsCanvas.ZIndex = 1
    gsCanvas.Parent = gameSelectGui

    local WAVE_COLORS = {
        Color3.fromRGB(255, 26, 255),   -- i=1: magenta
        Color3.fromRGB(204, 51, 255),
        Color3.fromRGB(178, 76, 255),
        Color3.fromRGB(153, 102, 255),
        Color3.fromRGB(128, 128, 255),  -- i=5: blue
    }
    local WAVES = #WAVE_COLORS
    local SEGS = 24            -- segments per wave
    local THICK = 3            -- line thickness
    local GLOW_THICK = 12      -- thickness of the "bloom" under the line (halo effect)

    -- x positions in 0..1 units (like gl_FragCoord/resolution), computed once
    local xs = {}
    for j = 0, SEGS do xs[j + 1] = j / SEGS end

    local lines, glows = {}, {}
    for w = 1, WAVES do
        lines[w], glows[w] = {}, {}
        for j = 1, SEGS do
            local glow = Instance.new("Frame")
            glow.AnchorPoint = Vector2.new(0.5, 0.5)
            glow.Size = UDim2.fromOffset(10, GLOW_THICK)
            glow.BackgroundColor3 = WAVE_COLORS[w]
            glow.BackgroundTransparency = 0.72
            glow.BorderSizePixel = 0
            glow.ZIndex = 2
            glow.Parent = gsCanvas
            glows[w][j] = glow

            local line = Instance.new("Frame")
            line.AnchorPoint = Vector2.new(0.5, 0.5)
            line.Size = UDim2.fromOffset(10, THICK)
            line.BackgroundColor3 = WAVE_COLORS[w]
            line.BorderSizePixel = 0
            line.ZIndex = 3
            line.Parent = gsCanvas
            lines[w][j] = line
        end
    end

    local gsClock = os.clock()
    local gsConn
    gsConn = runService.RenderStepped:Connect(function()
        if not gsCanvas.Parent then
            gsConn:Disconnect() -- menu closed - we clean up
            return
        end
        local W, H = gsCanvas.AbsoluteSize.X, gsCanvas.AbsoluteSize.Y
        if W <= 0 or H <= 0 then return end
        local t = (os.clock() - gsClock) * 0.9 -- time*0.9 from the shader
        local amp = 0.1 * H                    -- 0.1 from the shader
        local midY = 0.5 * H                   -- uPos.y -= 0.5

        -- heights of the points of each wave (sum of sines like in the shader)
        local ys = {}
        for w = 1, WAVES do
            local row = {}
            for j = 1, SEGS + 1 do
                local x = xs[j]
                local y = midY
                for k = 1, w do
                    y = y + math.sin(x * k + t + k / 2) * amp
                end
                row[j] = y
            end
            ys[w] = row
        end

        -- placing the segments: position at the midpoint, rotation by slope
        for w = 1, WAVES do
            local row = ys[w]
            for j = 1, SEGS do
                local x0, x1 = xs[j] * W, xs[j + 1] * W
                local y0, y1 = row[j], row[j + 1]
                local dx, dy = x1 - x0, y1 - y0
                local mid = UDim2.fromOffset((x0 + x1) * 0.5, (y0 + y1) * 0.5)
                local rot = math.deg(math.atan2(dy, dx))
                local len = math.sqrt(dx * dx + dy * dy) + 1.5 -- slight overlap, no seams
                local ln, gl = lines[w][j], glows[w][j]
                ln.Position = mid
                ln.Size = UDim2.fromOffset(len, THICK)
                ln.Rotation = rot
                gl.Position = mid
                gl.Size = UDim2.fromOffset(len, GLOW_THICK)
                gl.Rotation = rot
            end
        end
    end)

    local gsFrame = Instance.new("Frame")
    gsFrame.Size = UDim2.new(0, 300, 0, 360)
    gsFrame.ZIndex = 5 -- menu frame always above the waves
    gsFrame.Position = UDim2.new(0.5, -150, 0.5, -180)
    -- lighter than before (it was 12,5,15 and drowned in the waves),
    -- almost opaque so the text stays readable
    gsFrame.BackgroundColor3 = Color3.fromRGB(30, 15, 45)
    gsFrame.BackgroundTransparency = 0.05
    gsFrame.BorderSizePixel = 0
    gsFrame.Active = true
    gsFrame.Draggable = true
    gsFrame.Parent = gameSelectGui

    -- purple border around the panel (instead of BorderSizePixel)
    local gsStroke = Instance.new("UIStroke")
    gsStroke.Color = Color3.fromRGB(170, 50, 255)
    gsStroke.Thickness = 2
    gsStroke.Transparency = 0.1
    gsStroke.Parent = gsFrame

    local gsCorner = Instance.new("UICorner")
    gsCorner.CornerRadius = UDim.new(0, 8)
    gsCorner.Parent = gsFrame
    do
        -- Panel background gradient: lighter purple at the top -> navy at the bottom.
        -- Consistent with the main window, and the waves in the background stay visible (transparency).
        local gr = Instance.new("UIGradient")
        gr.Color = ColorSequence.new(Color3.fromRGB(52, 22, 80), Color3.fromRGB(18, 12, 42))
        gr.Rotation = 90
        gr.Parent = gsFrame
    end

    local gsTitle = Instance.new("TextLabel")
    gsTitle.Size = UDim2.new(1, 0, 0, 40)
    gsTitle.BackgroundColor3 = Color3.fromRGB(170, 50, 255)
    gsTitle.BackgroundTransparency = 0.1
    gsTitle.BorderSizePixel = 0
    gsTitle.Text = " LiptonHub Game Select "
    gsTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    gsTitle.TextSize = 16
