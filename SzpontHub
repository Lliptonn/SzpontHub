    -- No Spread: podmienia _performRaycast w module Bullet — strzał zawsze idealnie na środek
    local BulletModule = nil
    local originalPerformRaycast = nil
    local originalGetTrueSpread = nil

    local function enableNoSpread()
        pcall(function()
            BulletModule = require(game.ReplicatedStorage.Components.Weapon.Classes.Bullet)
            if not BulletModule then return end

            originalPerformRaycast = BulletModule._performRaycast
            originalGetTrueSpread = BulletModule.getTrueSpread

            -- Podmiana getTrueSpread → zawsze 0 (zapobiega akumulacji spreadu)
            BulletModule.getTrueSpread = function(_)
                return 0
            end

            -- Podmiana _performRaycast → strzał idealnie w środek celownika
            -- CAŁA logika raycastu jest przepisana, anti-hook detection NIE istnieje w naszej wersji
            BulletModule._performRaycast = function(self, _spread)
                local GetRayIgnore = require(game.ReplicatedStorage.Components.Common.GetRayIgnore)
                local SharedRaycast = require(game.ReplicatedStorage.Shared.Raycast)
                local cam = workspace.CurrentCamera
                local center = cam.ViewportSize / 2
                local ray = cam:ViewportPointToRay(center.X, center.Y)

                local direction = ray.Direction  -- IDEALNY KIERUNEK — zero spreadu
                local origin = ray.Origin
                local penetration = self.Properties.Penetration or 0
                local range = self.Properties.Range or 500

                local result = {
                    Origin = origin,
                    Direction = direction,
                    Distance = 0,
                    Hits = {}
                }

                local ignore = GetRayIgnore()
                local hit = SharedRaycast.cast(origin, direction * range, nil, ignore)

                if not hit.instance then
                    result.Distance = range
                    return result
                end

                local hitPos = hit.position
                result.Distance = (hitPos - origin).Magnitude

                local throughHits = SharedRaycast.castThrough(
                    hitPos - direction * 0.001,
                    direction * (penetration + 0.001),
                    penetration,
                    ignore
                )
                for i, hitData in ipairs(throughHits) do
                    if hitData.instance and hitData.material then
                        table.insert(result.Hits, {
                            Position = hitData.position,
                            Instance = hitData.instance,
                            Material = hitData.material.Name,
                            Normal = hitData.normal or Vector3.zero,
                            Exit = i % 2 == 0
                        })
                    end
                end

                return result
            end
        end)
    end

    local function disableNoSpread()
        pcall(function()
            if BulletModule and originalPerformRaycast then
                BulletModule._performRaycast = originalPerformRaycast
            end
            if BulletModule and originalGetTrueSpread then
                BulletModule.getTrueSpread = originalGetTrueSpread
            end
        end)
        BulletModule = nil
        originalPerformRaycast = nil
        originalGetTrueSpread = nil
    end

