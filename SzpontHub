    end
    -- DOUBLE TRAP: wymuszony cel drugiego strzału — ustawiany tuż przed
    -- drugim fireWeapon (tryb Double Tap), odczytywany przez doRedirect
    -- zamiast jego własnego wyboru najbliższego celu, czyszczony po strzale.
    -- Deklaracja PRZED doRedirect, bo wrapper ma pusty env (tylko upvalue).
    local redirectTarget, redirectAim = nil, nil
    local pcall_ = pcall
    local ipairs_ = ipairs
    local insertT = table.insert
    local sortT = table.sort
    local v3zero = Vector3.zero
    local v3new = Vector3.new
