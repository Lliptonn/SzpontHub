        local tbExp = Instance.new("TextButton")
        tbExp.Name = "ExploitsTab"
        tbExp.Size = UDim2.new(0, 134, 0, 36)
        tbExp.BackgroundColor3 = themes[currentTheme].ButtonBg
        tbExp.BackgroundTransparency = 0
        tbExp.BorderSizePixel = 0
        tbExp.Text = "Exploits"
        tbExp.TextColor3 = Color3.fromRGB(235, 235, 235)
        tbExp.TextSize = 14
        tbExp.Font = Enum.Font.GothamSemibold
        tbExp.LayoutOrder = 5
        tbExp.ZIndex = 3
        tbExp.Parent = sidebar
        tabButtons["Exploits"] = tbExp
        tbExp.MouseButton1Click:Connect(function()
            selectTab("Exploits")
        end)

        local bCandy = createButton("Candy Vacuum: OFF", 1, "Exploits")
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.95, 0, 0, 26)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = themes[currentTheme].TextCol
        lbl.TextSize = 11
        lbl.Font = Enum.Font.SourceSansBold
        lbl.Text = "Candy: (wylaczone)"
        lbl.LayoutOrder = 2
        lbl.ZIndex = 3
        lbl.Parent = pages["Exploits"]
        table.insert(allLabels, lbl)

        -- skan candy: maks raz na sekunde (pelny skan mapy co klatke = lag).
        -- zwykla moneta NIE trafia na liste (te juz zbiera farma) - candy
        -- poznamy po nazwie "cand" albo po kontenerze wlasnym na candy.
        local function scan()
            local vac = tp.candy
            vac.cache = {}
            local dodane = {}
            -- UWAGA na filtr nazwy: "cand" lapalo tez "Candle" (swieczki,
            -- ktorymi udekorowana jest mapa w Halloween) - lot do swieczki
            -- w scianie konczyl sie wjechaniem w sciane. Tylko "candy" /
            -- "candies" + wymagany TouchTransmitter (prawdziwy pickup, nie
            -- dekoracja ani element ekwipunku).
            local function wez(target, wymagajNazwy, wymagajDotyk)
                if not target then return end
                if wymagajNazwy then
                    local n = target.Name:lower()
                    if not (n:find("candy", 1, true) or n:find("candies", 1, true)) then return end
                end
                if wymagajDotyk and not target:FindFirstChildOfClass("TouchTransmitter") then return end
                if isCoinAlive(target) and not dodane[target] then
                    dodane[target] = true
                    table.insert(vac.cache, target)
                end
            end
            for _, map in ipairs(workspace:GetChildren()) do
                -- kontenery wlasne na candy = wszystko w srodku jest candy
                for _, cname in ipairs({"CandyContainer", "CandiesContainer"}) do
                    local container = map:FindFirstChild(cname)
                    if container then
                        for _, server in ipairs(container:GetChildren()) do
                            wez(findTouchPart(server), false, false)
                            if server:IsA("BasePart") then wez(server, false, false) end
                        end
                    end
                end
                -- CoinContainer: candy eventowe moze tam stac obok monet,
                -- wtedy filtrujemy po nazwie
                local coinBox = map:FindFirstChild("CoinContainer")
                if coinBox then
                    for _, server in ipairs(coinBox:GetChildren()) do
                        wez(findTouchPart(server), true, false)
                        if server:IsA("BasePart") then wez(server, true, true) end
                    end
                end
            end
            -- zapas: candy rozrzucone po mapie bez kontenera (tylko gdy
            -- kontenery nic nie daly - pelny skan mapy jest drogi).
            -- TouchTransmitter obowiazkowy: bez tego lapalibysmy swieczki,
            -- "CandyCorn" z wystawy broni i masci z ekwipunku.
            if #vac.cache == 0 then
                for _, map in ipairs(workspace:GetChildren()) do
                    for _, d in ipairs(map:GetDescendants()) do
                        if d:IsA("BasePart") then wez(d, true, true) end
                    end
                end
            end
        end

        bCandy.MouseButton1Click:Connect(function()
            local vac = tp.candy
            vac.on = not vac.on
            bCandy.Text = vac.on and "Candy Vacuum: ON" or "Candy Vacuum: OFF"
            bCandy.BackgroundColor3 = vac.on and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
            updateActiveCheatsList()
            if vac.on then
                vac.scanAt = 0  -- pierwsze skanowanie od razu
                vac.skip = {}   -- nowa proba: czyscimy liste odfiltrowanych candy
                lbl.Text = "Candy: szuka..."
            elseif plr.Character then
                -- przy wylaczeniu przywracamy domyslne stany (lot ustawia
                -- PlatformStand + wylacza kolizje wlasnych czesci)
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.AutoRotate = true
                    hum.WalkSpeed = 16
                    hum.PlatformStand = false
                end
                for _, p in ipairs(plr.Character:GetChildren()) do
                    if p:IsA("BasePart") then p.CanCollide = true end
                end
                lbl.Text = "Candy: (wylaczone)"
            end
        end)

        -- lot: mechanika identyczna jak lot Auto Farm (pod podloga, na
        -- lezaco, zerowana predkosc = brak grawitacji i brak rollbacku)
        runService.Stepped:Connect(function(_, dt)
            if not isCurrentGen() then return end
            local vac = tp.candy
            if not vac.on then return end
            -- gdy postacia rzadza inne systemy (kill/fling/farmy) - nie walczymy
            if killBusy or gunDropRef or annoyEnabled or farmBag.full or tp.on
                or (autoFarmCoins and not farmIdle) then
                return
            end
            local ch = plr.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if not (ch and hrp) then return end
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return end
            local teraz = os.clock()
            if teraz >= vac.scanAt then
                pcall(scan)
                vac.scanAt = teraz + 1.0
                lbl.Text = "Candy w zasiegu: " .. #vac.cache
            end
            -- najblizsze zywe candy (zebrane juz wychodza z listy)
            local nearest, bestDist = nil, FARM_TARGET_RANGE
            for i = #vac.cache, 1, -1 do
                local c = vac.cache[i]
                if not isCoinAlive(c) then
                    table.remove(vac.cache, i)
                elseif not vac.skip[c] then
                    local d = (hrp.Position - c.Position).Magnitude
                    if d < bestDist then
                        bestDist, nearest = d, c
                    end
                end
            end
            if not nearest then return end
            -- OCHRONA PRZED WJECHANIEM W SCIANE: jak character stoi w jednym
            -- miejscu 3 s przy tym samym candy, to cel jest nie do osiagniecia
            -- (np. urwany kawalek mapy) - skipujemy go do restartu huba
            -- zamiast wiercic sie w sciane w nieskonczonosc
            if nearest ~= vac.lastCandy then
                vac.lastCandy = nearest
                vac.lastPos = hrp.Position
                vac.lastAt = teraz
            elseif teraz - vac.lastAt >= 3 then
                if (hrp.Position - vac.lastPos).Magnitude < 1 then
                    vac.skip[nearest] = true
                    vac.lastCandy = nil
                    return
                end
                vac.lastPos = hrp.Position
                vac.lastAt = teraz
            end
            -- noclip TYLKO na czas lotu (stanie = normalna fizyka)
            for _, p in ipairs(ch:GetChildren()) do
                if p:IsA("BasePart") and p.CanCollide then
                    p.CanCollide = false
                end
            end
            -- cel lotu: 3 studsy POD podloga (ukryci), na cukierku
            -- wystajemy na lezaco - dokladnie jak Auto Farm
            local dir = (nearest.Position - Vector3.new(0, 3, 0)) - hrp.Position
            local dist = dir.Magnitude
            local punkt = nil
            if dist > 1 then
                punkt = hrp.Position + dir.Unit * math.min(dist, 45 * dt, FARM_MAX_STEP)
            else
                -- dojechalismy: wjezdzamy do 1 studa pod cukierka i lezymy
                -- az serwer zaliczy dotkniecie
                local pkt = Vector3.new(nearest.Position.X, nearest.Position.Y - 1, nearest.Position.Z)
                local kier = pkt - hrp.Position
                if kier.Magnitude > 0.1 then
                    punkt = hrp.Position + kier.Unit * math.min(kier.Magnitude, 45 * dt, FARM_MAX_STEP)
                else
                    punkt = pkt
                end
            end
            local look = (punkt - hrp.Position)
            if look.Magnitude < 0.05 then look = Vector3.new(0, 0, 1) end
            hum.PlatformStand = true
            hum.AutoRotate = false
            hrp.CFrame = CFrame.new(punkt, punkt + look) * CFrame.Angles(math.rad(90), 0, 0)
            hrp.Velocity = Vector3.new(0, 0, 0)
            hrp.RotVelocity = Vector3.new(0, 0, 0)
        end)

        return { btn = bCandy, lbl = lbl }
    end)()

    -- AUTOFARM "LEGIT" (v5): the character WALKS to the candy along the paths
    -- ----------------------------------------------------------
    -- Earlier versions moved the character via CFrame - that is a teleport:
    -- the MM2 server rejects such movement ("Invalid position"), and the character
    -- got stuck in walls and the farm stalled. Now:
    --   * we turn the character toward the candy,
    --   * we tell THE ENGINE to lead it (Humanoid:Move) - the movement is
    --     legal (the same as if the player walked there themselves),
    --   * a raycast detects an obstacle on the path and the character GOES AROUND it.
    -- Result: the character walks (does not fly), does not pass through walls,
    -- the server accepts the movement, and the candy Touched works.
    -- ============================================================
    -- NOCLIP ONLY FOR "FLIGHT" MODE: the character flies through walls like Fly, so
    -- it needs collision disabled on its own parts. When "Auto Farm Legit"
    -- (walking along paths) is enabled we do NOT touch collision - without it
    -- the character flies through the floor and falls below the map. We no longer
    -- touch MAP collision at all - previously it left holes in it for the rest of the round.
    runService.Stepped:Connect(function()
        if not isCurrentGen() then return end
        if not autoFarmCoins or farmLegit then return end
        local ch = plr.Character
        if not ch then return end
        -- NA SPAWNIE (lobby) kolizja MUSI zostac: z noclipoem gracz zapadalby
        -- sie przez podloge spawnu i konczyl "w suficie" / "na odludziu".
        -- Noclip dziala tylko na mapie, gdzie lot pod podloga go wymaga.
        local hrpNoc = ch:FindFirstChild("HumanoidRootPart")
        if hrpNoc and isInLobby(hrpNoc.Position, 25) then
            for _, part in ipairs(ch:GetChildren()) do
                if part:IsA("BasePart") and not part.CanCollide then
                    part.CanCollide = true
                end
            end
            return
        end
        for _, part in ipairs(ch:GetChildren()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)

    -- ANTI-FLING v2 - a POST-PHYSICS layer. The Stepped handler on the Utility
    -- tab zeroes velocity BEFORE physics, but an attack landing DURING the step
    -- still threw us for a whole frame (hundreds of studs = dead). Heartbeat
    -- runs AFTER physics: (1) kill the spike with Assembly* (Velocity is
    -- deprecated and the engine may ignore it), (2) SNAP-BACK - a launch means
    -- huge velocity AND a jump of tens of studs in one frame. Our own teleports
    -- zero the velocity right after the jump, and walking/falling/farming never
    -- exceeds both thresholds at once, so only a real attack trips the check.
    local antiFlingLast = nil   -- snapshot of the previous frame (persist across frames)
    runService.Heartbeat:Connect(function()
        if not isCurrentGen() then return end
        if not antiFling then return end
        local ch = plr.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then
            antiFlingLast = nil
            return
        end
        local cf = hrp.CFrame
        -- states where WE teleport on purpose: snapping back would fight our own code
        local skip = flying or flingTargetEnabled or killBusy
            or flingBack.active or flingBack.spawn
        if not skip and antiFlingLast then
            local jump = (cf.Position - antiFlingLast.Position).Magnitude
            local spike = math.max(hrp.AssemblyLinearVelocity.Magnitude,
                hrp.AssemblyAngularVelocity.Magnitude)
            if jump > 40 and spike > 250 then
                hrp.CFrame = antiFlingLast
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
                cf = antiFlingLast
            end
        end
        antiFlingLast = cf
    end)

    runService.RenderStepped:Connect(function(dt)
        if not isCurrentGen() then return end
        if not autoFarmCoins then return end
        local ch = plr.Character
        local hrp = getHRP(ch)
        local hum = getHum(ch)
        if not (hrp and hum) then return end

        -- FLING IN PROGRESS: the shared fling loop controls CFrame every frame.
        -- Two loops fighting over the position = the character jitters and the server gets
        -- an inconsistent velocity (plus a kick for Invalid position).
        if flingBack.active then
            farmIdle = false   -- we also block TP Farm: it also controls CFrame
            return
        end

        -- FULL BAG = FARM PAUSE: with a full bag the pickup
        -- server will not count it anyway, so flying after candies is just flying after
        -- "invisible" candies - and on top of that the character FIGHTS over CFrame with
        -- Auto Kill All (murderer) and with the murderer fling (innocent).
        -- Both of these control CFrame every frame, so without this pause
        -- auto-kill would teleport to the target and the farm back to
        -- the candy - result: nobody got anywhere (no kill happened).
        if farmBag.full then
            farmIdle = true
            return
        end

        -- 1) coin list: refresh once per second (a full workspace scan
        --    is too expensive for every frame)
        coinScanClock = coinScanClock + dt
        if coinScanClock >= FARM_SCAN_INTERVAL then
            coinScanClock = 0
            refreshCoinCache(false)
        end

        -- (bag detection moved up - it always works, not only while farming)
        -- 2) expiring the coin blocks
        local now = os.clock()
        for coin, untilT in pairs(coinBlacklist) do
            if now >= untilT or not coin.Parent then
                coinBlacklist[coin] = nil
            end
        end

        -- 3) TARGET: nearest live candy in range
        local target, bestDist = nil, math.huge
        for i = #coinCache, 1, -1 do
            local c = coinCache[i]
            if not isCoinAlive(c) then
                table.remove(coinCache, i)
            elseif not coinBlacklist[c] then
                local d = (c.Position - hrp.Position).Magnitude
                -- WHEN WALKING we do not cross the whole map: smaller range = more
                -- often we turn back and fewer walls to go around (legit must arrive fast)
                if d < bestDist and d <= (farmLegit and 100 or FARM_TARGET_RANGE) then
                    bestDist = d
                    target = c
                end
            end
        end

        -- 4) MURDERER WITH THE KNIFE CLOSE - we run AWAY (threshold from the slider)
        if now >= farmMurderAt then
            farmMurderAt = now + 0.5
            farmMurderClose = false
            farmBag.mpos = nil
            for _, p in ipairs(playersService:GetPlayers()) do
                if p ~= plr and p.Character and getRole(p) == "Murderer" then
                    local mh = p.Character:FindFirstChild("HumanoidRootPart")
                    if mh and (mh.Position - hrp.Position).Magnitude < farmPanicDist then
                        farmMurderClose = true
                        -- direction to flee from; farmBag field = no new local in this big chunk
                        farmBag.mpos = mh.Position
                        break
                    end
                end
            end
        end

        -- 5) INFO in the button: the farm says why it is standing
        local powod = nil
        if farmMurderClose then
            powod = "flee: murderer"
        elseif target == nil then
            if isInLobby(hrp.Position, 25) then
                powod = "lobby"
            else
                powod = "no candies"
            end
        end
        local tekst = "Auto Farm Coins: ON"
        if powod then tekst = "Auto Farm Coins: ON (" .. powod .. ")" end
        if tekst ~= b13.Text then b13.Text = tekst end

        -- 6) MOVEMENT - TWO MODES:
        --    Auto Farm Coins (farmLegit = OFF, default) = FLIGHT like in the old
        --        version: CFrame teleport every frame + noclip, flies through
        --        walls and collects everything. Auto-safety: when the server rolls back the
        --        movement we slow down (farmSpeedLimit) so we are not kicked for Invalid position.
        --    Auto Farm Legit (farmLegit = ON) = WALKS with the engine (Humanoid:Move)
        --        and AVOIDS walls: a raycast detects an obstacle and the character glides
        --        along it (wall sliding) instead of jittering in place. Low
        --        obstacles are jumped over (Jump), not walked around.
        -- SMART PANIC (was: FREEZE): the old version stopped the farm when the
        -- murderer was within farmPanicDist, so we stood STILL NEXT TO HIM while
        -- he chopped us. Now the direction = straight AWAY from him through the
        -- same flight/walk machinery - candy on the escape path still gets picked
        -- up by touch, and we start chasing candy again once he is out of range.
        -- LOBBY (SPAWN) = RUCH RECZNY: z wlaczona farma gracz ma normalnie
        -- chodzic po spawnie. Farma NIE dotyka postaci, dopoki gra nie przeniesie
        -- nas na mape - wtedy lot pod podloga wlacza sie sam (jak przy kazdym
        -- wejsciu na mape). farmIdle = false = TP Farm i candy vacuum tez maja
        -- sie odsunac: na spawnie steruje WYLACZNIE gracz.
        if isInLobby(hrp.Position, 25) then
            farmIdle = false
            -- postawe ruszamy TYLKO gdy zadna inna funkcja nie prowadzi postaci
            -- (fly/fling/kill/annoy maja wlasne PlatformStand - nie walczymy z nimi)
            if not (flying or flingTargetEnabled or killBusy or flingBack.spawn or annoyEnabled or gunDropRef) then
                if hum.PlatformStand then
                    -- KONIEC RUNDY: postac moze zostac POD podloga badz w
                    -- powietrzu (farma ja tam trzymala). STARY KOD promieniowal
                    -- W GORE i czesto trafial w SUFIT budynku w lobby - gracz
                    -- konczyl "w suficie" w glosowaniu mapy i nie dostawal sie
                    -- na mape. Teraz: (1) promien w DOL z centrum postaci =
                    -- czy w ogole STOI na czymsw; (2) gdy NIE stoi - teleport
                    -- na spawn lobby (lobbySpawns), zero promieni w gore =
                    -- zero ryzyka trafienia w sufit.
                    if farmRayParams.FilterDescendantsInstances[1] ~= ch then
                        farmRayParams.FilterDescendantsInstances = { ch }
                    end
                    local stoi = workspace:Raycast(hrp.Position, Vector3.new(0, -6, 0), farmRayParams)
                    if not stoi then
                        local sp = lobbySpawns and lobbySpawns[1]
                        if sp then
                            hrp.CFrame = CFrame.new(sp + Vector3.new(0, 6, 0))
                            hrp.Velocity = Vector3.new(0, 0, 0)
                            hrp.RotVelocity = Vector3.new(0, 0, 0)
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end
                    end
                end
                -- normalna postawa, ALE bez hum:Move(zero) - to wlasnie ono co
                -- klatke zerowalo kierunek ruchu i blokowalo WASD na spawnie
                hum.PlatformStand = false
                hum.AutoRotate = true
            end
            return
        end

        local fleeDir = nil
        if farmMurderClose and farmBag.mpos then
            fleeDir = hrp.Position - farmBag.mpos
            fleeDir = Vector3.new(fleeDir.X, 0, fleeDir.Z)
            -- < 0.5 studs = he stands ON us: escape east at force 8, because the
            -- flight gate (dist > 1) must not treat it as "already arrived"
            if fleeDir.Magnitude < 0.5 then
                fleeDir = Vector3.new(0, 0, 8)
            else
                fleeDir = fleeDir.Unit * 8
            end
        end
        if target or fleeDir then
            local dir = fleeDir or (target.Position - hrp.Position)
            local dist = dir.Magnitude
            local flat = Vector3.new(dir.X, 0, dir.Z)
            if farmLegit then
                if flat.Magnitude > 0.05 then
                    flat = flat.Unit
                    if farmRayParams.FilterDescendantsInstances[1] ~= ch then
                        farmRayParams.FilterDescendantsInstances = { ch }
                    end
                    local ray = workspace:Raycast(hrp.Position, flat * 5, farmRayParams)
                    if ray and ray.Instance.Name ~= "Coin_Server"
                        and ray.Instance.Name ~= "CoinVisual"
                        and not ray.Instance.Name:find("Coin", 1, true) then
                        -- OBSTACLE. First we ask: is it clear above?
                        -- (a cast ~4 studs above the track) = a wall/ledge/crate, so
                        -- we JUMP and keep running straight. The old code always went around
                        -- to the side, so on low ledges the character stalled in the wall.
                        local nad = workspace:Raycast(hrp.Position + Vector3.new(0, 4, 0), flat * 5, farmRayParams)
                        if not nad then
                            -- jump ONLY from the ground and with a 0.8 s gap: without this
                            -- the character hopped on every frame while standing in front of
                            -- the obstacle instead of going around it normally
                            if now >= farmJumpAt and hum.FloorMaterial ~= Enum.Material.Air then
                                farmJumpAt = now + 0.8
                                hum.Jump = true
                            end
                        else
                            -- TALL WALL: we glide ALONG it. Wall normal ->
                            -- tangent (direction along the wall) flipped toward the target.
                            -- Thanks to that the character slides down the wall and gets around the corner -
                            -- previously it turned "to the side" and changed side every 0.6 s,
                            -- so it shivered at the wall instead of passing it.
                            local n = Vector3.new(ray.Normal.X, 0, ray.Normal.Z)
                            if n.Magnitude < 0.01 then
                                n = Vector3.new(-flat.Z, 0, flat.X)
                                if n.Magnitude < 0.01 then n = Vector3.new(0, 0, 1) end
                            end
                            n = n.Unit
                            local tan = Vector3.new(-n.Z, 0, n.X)
                            if tan:Dot(flat) < 0 then tan = -tan end
                            flat = tan
                            farmSideAt = os.clock()
                        end
                    end
                    -- rotation + ENGINE (the character walks on the ground)
                    hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat)
                    hum:Move(flat, false)
                    hum.WalkSpeed = math.clamp(farmSpeed, 16, 32)
                    hum.AutoRotate = false
                    hum.PlatformStand = false
                end
            else
                -- FLIGHT LIKE THE FLY OPTION (Movement tab): we set the position via
                -- CFrame every frame and zero the Velocity - exactly like the
                -- Fly there does. Why this solves the problem: velocity zeroed
                -- = the character is NOT AFFECTED BY GRAVITY. Previously engine-based walking
                -- in a straight line to the candy led it over the edge of the map
                -- and it fell to its death; now it flies and never falls.
                -- Character collision is disabled in Stepped (see above), so it flies
                -- through walls like a normal Fly - no need to "pass through"
                -- parts of the map anymore (and therefore it leaves no holes in the floor).
                -- UNDER THE FLOOR: the flight point is the candy MINUS 3 studs,
                -- so the whole trip happens hidden UNDER the floor (collision is
                -- off in Stepped + CFrame is a teleport - the floor is no more of
                -- an obstacle than a wall). Only at the candy itself do we POKE
                -- OUT of the floor - LYING, so from above it is a sliver, not a
                -- standing target for the knife. dir/dist from the top of the
                -- block still aim at the candy (the stuck logic measures the real
                -- approach). Fleeing keeps its own direction: running away from
                -- the murderer happens above the floor.
                if target and not fleeDir then
                    -- cel: 3 study POD podlaga cukierka (lot ukryty pod podloga)
                    dir = (target.Position - Vector3.new(0, 3, 0)) - hrp.Position
                    dist = dir.Magnitude
                elseif fleeDir then
                    -- UCIECZKA TEZ POD PODLOGA. PROMIEN Z CENTRUM POSTACI (nie
                    -- z +10 nad glowa): start nad glowa w budynku trafial w
                    -- SUFIT i postac "uciekala" W GORE do sufitu. Z centrum w
                    -- dol widzimy tylko podloge POD nogami.
                    if farmRayParams.FilterDescendantsInstances[1] ~= ch then
                        farmRayParams.FilterDescendantsInstances = { ch }
                    end
                    local ray = workspace:Raycast(hrp.Position, Vector3.new(0, -30, 0), farmRayParams)
                    local dy = 0
                    if ray and hrp.Position.Y > ray.Position.Y + 0.5 then
                        dy = (ray.Position.Y - 3) - hrp.Position.Y
                    end
                    dir = Vector3.new(fleeDir.X, dy, fleeDir.Z)
                    dist = dir.Magnitude
                end
                if dist > 1 then
                    if hum then
                        hum.PlatformStand = true  -- just like Fly: freeze physics
                        hum.AutoRotate = false
                    end
                    local dir3 = dir.Unit
                    local speed = math.clamp(farmSpeed, 16, FARM_FLY_MAX_SPEED)
                    local krok = math.min(dist, speed * dt, FARM_MAX_STEP)
                    local nextPos = hrp.Position + dir3 * krok
                    -- LOOK wzdloc lotu, potem * Angles(-90) = LEZENIE NA PLECACH
                    -- (twarz do gory). Stare Angles(90) = na brzuchu, przez co
                    -- postac wykonywala salto w locie (uzytkownik: "wyginal sie").
                    hrp.CFrame = CFrame.new(nextPos, nextPos + dir3) * CFrame.Angles(math.rad(-90), 0, 0)
                    -- ZERUJ WSZYSTKIE cztery predkosci: same Velocity/RotVelocity
                    -- nie wystarczaly - fizyka liczyla Assembly* i krecila cialem
                    -- dalej (to wlasnie bylo to wyginanie/salto). Teraz cialo lezy
                    -- plasko i martwo.
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.RotVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                else
                    -- POKE OUT AT THE CANDY (within 1 stud of the under-point):
                    -- rise to 1 stud below it and stay LYING - the same pickup
                    -- distance at which the farm collected candies before (the old
                    -- gate stopped at 1 stud of the candy and collected fine), and
                    -- the lying body top sits right at the floor surface.
                    -- Velocities pinned to zero so the physics cannot tumble us
                    -- around (the old freeze-and-rotate bug at arrival).
                    -- The stuck logic below still gives up after FARM_STUCK_TIME
                    -- if the server refuses to hand it over - no camping forever.
                    if hum then
                        hum.PlatformStand = true
                        hum.AutoRotate = false
                    end
                    -- WYCHODZIMY TYLKO TUTAJ: 1 stud POD cukierkiem, na PLECACH.
                    -- To jedyny moment, gdy postac wystaje ponad podloge - reszta
                    -- lotu dzieje sie pod podloga.
                    hrp.CFrame = CFrame.new(target.Position - Vector3.new(0, 1, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.RotVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            end
            -- ANTI-STUCK: we block a coin only on NO PROGRESS, not
            -- on time alone. FARM_TARGET_RANGE = 200 studs, and while walking
            -- (WalkSpeed 16-32) the coin was often further than 3 s of travel - so
            -- the old counter blocked it BEFORE we got there. Result: everything
            -- went onto the ignore list, it showed "no candies" and the farm
            -- stood still. Now: as long as the distance to the target shrinks, it is OK;
            -- only standing still = a block, and we keep looking.
            -- while fleeing we skip the tracking: the direction points AWAY from
            -- the candy, so the clock would falsely blacklist candies
            if not fleeDir and target == farmStuckCoin then
                if dist < farmStuckDist - 0.75 then
                    farmStuckClock = 0
                    farmStuckDist = dist
                else
                    farmStuckClock = farmStuckClock + dt
                end
            else
                farmStuckCoin, farmStuckClock = target, 0
                farmStuckDist = dist
            end
            if farmStuckClock >= FARM_STUCK_TIME then
                coinBlacklist[target] = now + FARM_BLACKLIST_TIME
                farmStuckCoin, farmStuckClock = nil, 0
            end
            farmIdle = false
        else
            if farmLegit then
                -- LEGIT (chodzenie): postac stoi i czeka - nie nurkujemy, bo
                -- tryb legit MUSI stac na nogach, zeby chodzic po sciezkach.
                hum:Move(Vector3.zero, false)
                hum.AutoRotate = true
                hum.PlatformStand = false
                farmIdle = (target == nil)
            elseif tp.on or tp.candy.on then
                -- postacia rzadza juz TP Farm / Candy Vacuum (maja priorytet) -
                -- farma ich nie przypina, bo oba tez steruja CFrame
                if hum then
                    hum.PlatformStand = false
                    hum.AutoRotate = true
                end
                farmIdle = true
            else
                -- NA MAPIE, BRAK CELU (nawet gdy skan jeszcze nic nie widzial):
                -- NATYCHMIAST nurkujemy pod podloge. Wczesniej `#coinCache == 0`
                -- wypuszczal postac na powierzchnie, a pierwszy skan leci co
                -- 0.3 s - przez ten czas gracz stajal na wierzchu po teleporcie
                -- na mape = widoczny cel dla noza. Teraz chowamy sie pod
                -- podloge ZAWSZ, gdy jestesmy na mapie i nie lecimy do cukierka.
                -- Lobby obsluguje wczesniejsza bramka (nad fleeDir), wiec to
                -- `else` trafia WYLACZNIE na mape.
                if hum then
                    hum.PlatformStand = true
                    hum.AutoRotate = false
                end
                -- PROMIEN Z CENTRUM POSTACI (NIE z +10 nad glowa): start nad
                -- glowa trafial w SUFIT niskich pomieszczen (dach budynku na
                -- mapie) i postac ladowala W suficie zamiast pod podloga -
                -- stala wtedy w "odludziu" i nie siegala cukierkow. Z centrum
                -- w dol trafia tylko w to, co POD postacia.
                if farmRayParams.FilterDescendantsInstances[1] ~= ch then
                    farmRayParams.FilterDescendantsInstances = { ch }
                end
                local ray = workspace:Raycast(hrp.Position, Vector3.new(0, -30, 0), farmRayParams)
                -- nurkujemy TYLKO gdy podloga jest blisko POD nogami; gdy nic
                -- nie ma pod nami (juz pod podloga / nad przepascia) - TRZYMAJ
                -- wysokosc. Stary kod opuszczal postac o 1 stud/klatke gdy
                -- raycast pudlowal = spadanie w otchlann i koncowe "odludzie".
                local podY = hrp.Position.Y
                if ray and (hrp.Position.Y - ray.Position.Y) < 8 then
                    podY = ray.Position.Y - 3
                end
                local cel = Vector3.new(hrp.Position.X, podY, hrp.Position.Z)
                local look = hrp.CFrame.LookVector
                hrp.CFrame = CFrame.new(cel, cel + Vector3.new(look.X, 0, look.Z)) * CFrame.Angles(math.rad(-90), 0, 0)
                hrp.Velocity = Vector3.new(0, 0, 0)
                hrp.RotVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
            farmStuckCoin, farmStuckClock, farmStuckDist = nil, 0, nil
            farmIdle = (target == nil)
        end
    end)

