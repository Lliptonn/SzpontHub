    -- AUTO FARM COINS v3:
    --  * target = the part with TouchTransmitter (CoinServer.Coin_Server), i.e. the real
    --    coin pickup point. NOTE: Coin_Server is ALWAYS
    --    Transparency=1 (the visible coin is the MainCoin child), so
    --    "invisible" does NOT mean "collected"  we count the Collected
    --    (and Delete) attribute plus the presence of TouchTransmitter, both checked live.
    --  * ANTI-KICK "Invalid position" (Error 267): MM2 kicked for too big a position
    --    jump, mainly when the slider was >~25. The old code took raw dt from
    --    task.wait  after a lag spike (dt = 0.5 s) the character jumped 12-15 studs
    --    in ONE frame. Now: clamped dt + a hard step limit per tick
    --    + effective speed clamped to the safety threshold.
    --  * ANTI-STUCK: a coin we stand on that registers nothing is
    --    rejected PERMANENTLY (old code: blacklist for only 10 s, so
    --    after that time the farm went back to the same "phantom" coin
    --    in a loop). The blacklist is cleared only by a full scan on an empty
    --    map = round change (new coin instances = new keys).
    --  * NOCLIP: collisions off while farming  the character passes through
    --    walls and does not get stuck in them (CFrame drives position every frame,
    --    so collision only got in the way). Restored when turned off.
    --  * no PlatformStand  the character does not flop on the ground for coins
    --  * coin scanning is throttled: an empty list = a full workspace scan
    --    once every few seconds, not 30 times per second (80k+ instances = lag)
    -- The thresholds (FARM_*) are declared above, near the farmSpeed slider.
    local coinCache = {}
    local coinScanClock = 999
    local coinBlacklist = {}   -- Coin part -> os.clock() when the lock expires
    local farmStuckCoin = nil  -- coin we stand on that does nothing
    local farmStuckDist = nil  -- its distance from the last PROGRESS (a measurement, not a timer)
    -- movement coordination (Auto Farm / TP Farm / Auto Kill All / Auto TP Gun):
    -- they all drive the character CFrame, so when one is teleporting,
    -- the others take a break  otherwise the loops fight over position every frame
    local killBusy = false      -- true = Auto Kill All in the middle of a kill
    local gunDropRef = nil      -- last known GunDrop (only Auto TP Gun looks for it)
    -- true = Auto Farm has nothing to collect (no coin in reach)  then
    -- TP Farm may run. Thanks to this BOTH farms can be enabled
    -- at once and neither turns the other off.
    local farmIdle = false
    local farmStuckClock = 0
    local farmMurderClose = false  -- the murderer with the knife is near us (farm pauses)
    local farmMurderAt = 0         -- when we last checked for the murderer
    -- CANDY BAG STATE: full = flying after more candy makes no
    -- sense (the pickup server would not register it anyway). Then we fling
    -- the murderer. A timer, not every frame - this is GUI, not a model.
    local farmBag = { full = false, clock = 0, pelny = false, wyl = false, reczny = false, sheriffAuto = false }
    -- FLING/ANTI-VOID STATE (one table: Lua has a 200 register
    -- limit per function, and a separate local per parameter broke the compilation).
    --  * safe   = position we started the fling from (we return there)
    --  * active = fling in progress -> farms must not move the character
    --  * spawn  = we died during the fling -> after respawn go to the lobby spawn
    --  * last   = last position "on the ground" (anti-void rescue point)
    local flingBack = { safe = nil, active = false, spawn = false }
    local voidState = { last = nil, at = 0 }

    -- ============================================================
    -- ONE FLING LOOP (instead of three: manual Fling Target, the branch
    -- Auto Farm and this loop - all of them fought over the character CFrame).
    --
    -- TARGET ORDER (first match wins):
    --   1) Fling Target  - manually picked person from the player list
    --   2) Fling Murderer - anyone with a knife
    --   3) Fling Sheriff  - anyone with a revolver
    --   4) Auto Farm      - candy bag full -> murderer (the fling throws
    --      them into the void = the round ends, so it must NOT fire before
    --      the bag is full - then nothing would get farmed)
    --
    -- RETURN TELEPORT: the fling throws US just like the target, so without
    -- it we ended every fling in a random spot on the map or
    -- below it (death). Now: ALIVE returns to the map (the fling start
    -- position), DEAD gets the lobby spawn after respawn.
    --
    -- ANTI-VOID: we watch the character Y. The last position ON THE GROUND is
    -- the rescue point - dropping far below it = we pull the character back.
    -- ============================================================
    runService.Heartbeat:Connect(function(dt)
        if not isCurrentGen() then return end
        local ch = plr.Character
        local hrp = getHRP(ch)
        local hum = getHum(ch)
        if not (hrp and hum) then return end

        -- 1) ANTI-VOID: save the position when the character STANDS on the ground
        --    (FloorMaterial ~= Air) and is not in the lobby. That is our
        --    rescue point - a cheap test, zero GetDescendants.
        if roleFlags.void and hum.Health > 0 and hum.FloorMaterial ~= Enum.Material.Air
            and not isInLobby(hrp.Position, 25) then
            voidState.last = hrp.Position
        end
        -- falling: Y far below the last position on the ground, or
        -- a hard threshold below everything MM2 builds (the map starts at -201)
        if roleFlags.void and hum.Health > 0 then
            local bez = voidState.last
            if (bez and hrp.Position.Y < bez.Y - 120) or hrp.Position.Y < -250 then
                local ratuj = bez
                if not ratuj then
                    -- no saved position: the lobby spawn as a last resort
                    local boxes = getLobbyBoxes()
                    if #boxes > 0 then
                        ratuj = boxes[1].cf.Position + Vector3.new(0, 6, 0)
                    end
                end
                if ratuj then
                    hrp.CFrame = CFrame.new(ratuj)
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.RotVelocity = Vector3.new(0, 0, 0)
                    -- Assembly* too: the deprecated proxies may NOT zero the
                    -- assembly, and a leftover spike would make Anti-Fling snap
                    -- us straight back into the void
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    if hum then
                        hum.PlatformStand = false
                        hum.AutoRotate = true
                    end
                end
            end
        end

        -- 2) WHO IS THE TARGET (order matters)
        local celHrp, autoFarma = nil, false
        if flingTargetEnabled and targetPlayerName then
            local p = playersService:FindFirstChild(targetPlayerName)
            celHrp = p and getHRP(p.Character)
        end
        if not celHrp and (roleFlags.murderer or roleFlags.sheriff) then
            local rola = roleFlags.murderer and "Murderer" or "Sheriff"
            for _, p in ipairs(playersService:GetPlayers()) do
                if p ~= plr and p.Character and getRole(p) == rola then
                    local ph = getHRP(p.Character)
                    local pu = getHum(p.Character)
                    if ph and pu and pu.Health > 0 then
                        celHrp = ph
                        break
                    end
                end
            end
        end
        -- AUTO FARM FLINGS THE MURDERER ONLY WHEN THE BAG IS FULL. The fling
        -- throws them into the void, they die and the round ends AT ONCE -
        -- flinging before the bag is full would end the round with nothing
        -- farmed. A full bag = the farm has nothing left to collect anyway,
        -- so only now the round may end. farmBag.full is refreshed every 0.4 s
        -- in the bag loop (works also with the farm off).
        -- SZERYF TEZ NIE FLINGUJE: ma rewolwer, wiec ZABIJA (petla
        -- autoKillMurder), zamiast wywalac. Wczesniej oba systemy szly naraz:
        -- fling przepinal nasz hrp DO srodka mordercy (hrp.CFrame = celHrp.CFrame
        -- co klatke) i wystrzeliwal go w kosmos - a ze nasze cialo bylo do niego
        -- przypięte, LECIELISMY Z NIM w kosmos ("wywala mnie nie wiadomo gdzie").
        -- Kill probowal sie w tym samym czasie teleportowac za morderce i
        -- strzelac, ale fling co klatke nadpisywal pozycje = strzaly lecialy
        -- w pustke ("strzela nieudolnie"). Teraz: szeryf tylko strzeli.
        if not celHrp and autoFarmCoins and farmBag.full
            and getRole(plr) ~= "Murderer" and getRole(plr) ~= "Sheriff" then
            for _, p in ipairs(playersService:GetPlayers()) do
                if p ~= plr and p.Character and getRole(p) == "Murderer" then
                    local ph = getHRP(p.Character)
                    local pu = getHum(p.Character)
                    if ph and pu and pu.Health > 0 then
                        celHrp = ph
                        autoFarma = true
                        break
                    end
                end
            end
        end

        -- 3) FLING or RETURN
        if celHrp then
            if not flingBack.active then
                flingBack.active = true
                flingBack.safe = hrp.Position   -- remember where we started
                if hum then
                    hum.PlatformStand = true    -- like Fly: physics suspended
                    hum.AutoRotate = false
                end
                -- MEGA-FLING (part 1: ONCE at start): grab everything on HIS body.
                -- The collision push alone is unreliable - both sides often fly
                -- with CanCollide false (farm noclip, anti-fling), so half of the
                -- forces below must NOT need a collision at all.
                flingBack.chrp = celHrp
                flingBack.chum = celHrp.Parent and celHrp.Parent:FindFirstChildOfClass("Humanoid")
                flingBack.cplr = playersService:GetPlayerFromCharacter(celHrp.Parent)
                -- network ownership: if the server allows it, HIS physics runs on
                -- OUR machine and every force below lands without any discussion
                pcall(function() celHrp:SetNetworkOwner(plr) end)
                if flingBack.chum then
                    -- his humanoid loses control: ragdoll = nothing corrects the flight
                    pcall(function() flingBack.chum.PlatformStand = true end)
                    pcall(function() flingBack.chum:ChangeState(Enum.HumanoidStateType.Physics) end)
                end
                -- LOSOWY KIERUNEK POZIOMY (wczesniej zawsze ten sam wektor
                -- 30000/12000/30000 = lecialo w BOK, w sciane/mape i sie
                -- zatrzymywalo). Teraz kazdy fling leci w inna strone.
                local a = math.random() * math.pi * 2
                flingBack.dirX = math.cos(a)
                flingBack.dirZ = math.sin(a)
                -- INSTANT BURST: the first frame already throws him - no ramp-up.
                -- Dominuje GORA (60000 w gore vs 25000 poziomo): poziomo sciany
                -- mapy zatrzymuja lot, a w gore NIE MA nic - ofiara znika
                -- w kosmosie w ulamku sekundy. Magnitude ~70k = bezwzgledny
                -- rzut, anti-fling ofiary nie zdazy go wyzerowac.
                pcall(function()
                    celHrp.AssemblyLinearVelocity = Vector3.new(flingBack.dirX * 25000, 60000, flingBack.dirZ * 25000)
                    celHrp.AssemblyAngularVelocity = Vector3.new(20000, 20000, 20000)
                    celHrp.Velocity = Vector3.new(flingBack.dirX * 25000, 60000, flingBack.dirZ * 25000)
                    celHrp.RotVelocity = Vector3.new(20000, 20000, 20000)
                end)
            end
            -- OWNERSHIP RETRY (the second reason "it rarely worked"): the
            -- SetNetworkOwner from the start can fail (momentary server deny)
            -- or the server takes the part back after a round/teleport event -
            -- then every force below is overwritten by the victim's own client.
            -- We re-grab the ownership every 0.25 s until it sticks.
            flingBack.ownClock = (flingBack.ownClock or 0) + dt
            if flingBack.ownClock >= 0.25 then
                flingBack.ownClock = 0
                pcall(function() celHrp:SetNetworkOwner(plr) end)
            end
            -- HIS HUMANOID HOLDS: the victim's client flips PlatformStand back
            -- within a few frames, so we press Physics every frame while the
            -- fling lasts (2 property writes - the GUI costs more).
            if flingBack.chum and flingBack.chum.Parent then
                pcall(function() flingBack.chum.PlatformStand = true end)
                pcall(function() flingBack.chum:ChangeState(Enum.HumanoidStateType.Physics) end)
            end
            -- MEGA-FLING (part 2: EVERY FRAME) - 8 mechanisms at once. The orbit
            -- (2.5 studs around him) was USELESS: the impulses cancelled out and
            -- collision defenses kill every push anyway. Now we sit in his CENTER
            -- and half of the forces act directly ON HIS BODY.
            -- 1) our body in his centre, yaw spinning every frame
            flingSpinAngle = (flingSpinAngle + FLING_SPIN_SPEED) % 360
            hrp.CFrame = celHrp.CFrame * CFrame.Angles(0, math.rad(flingSpinAngle), 0)
            -- 2+3) maximum velocity and spin on OUR assembly (the server reads Assembly*)
            -- PION = 45000 (jak w burście): nasze cialo tez leci w gore, wiec
            -- cialo ofiary dostaje dodatkowy "cios w gore" z kolizji w jego srodku
            hrp.AssemblyLinearVelocity = Vector3.new(flingBack.dirX * 20000, 45000, flingBack.dirZ * 20000)
            hrp.AssemblyAngularVelocity = Vector3.new(20000, 20000, 20000)
            -- 4+5) the deprecated twins (the engine may ignore them - belt and braces)
            hrp.Velocity = Vector3.new(flingBack.dirX * 20000, 45000, flingBack.dirZ * 20000)
            hrp.RotVelocity = Vector3.new(20000, 20000, 20000)
            -- 6) BodyVelocity ON HIM: forced velocity on his assembly. PION
            --    55000 = gwaltowny rzut w gore przez caly czas trwania flingu
            --    (constraint dziala nawet gdy CanCollide false go nie zatrzyma)
            if not (flingBack.bv and flingBack.bv.Parent) then
                flingBack.bv = Instance.new("BodyVelocity")
                flingBack.bv.MaxForce = Vector3.new(100000000, 100000000, 100000000)
                flingBack.bv.P = 100000
                flingBack.bv.Velocity = Vector3.new(flingBack.dirX * 20000, 55000, flingBack.dirZ * 20000)
                flingBack.bv.Parent = celHrp
            end
            -- 7) BodyAngularVelocity ON HIM: 500 rad/s = he screws into the sky
            if not (flingBack.ba and flingBack.ba.Parent) then
                flingBack.ba = Instance.new("BodyAngularVelocity")
                flingBack.ba.MaxTorque = Vector3.new(100000000, 100000000, 100000000)
                flingBack.ba.P = 1000000
                flingBack.ba.AngularVelocity = Vector3.new(500, 500, 500)
                flingBack.ba.Parent = celHrp
            end
            -- 8) direct write to HIS assembly every frame (double tap with 6/7 -
            --    it sticks for the whole time we own his network ownership)
            celHrp.AssemblyLinearVelocity = Vector3.new(flingBack.dirX * 25000, 60000, flingBack.dirZ * 25000)
            celHrp.AssemblyAngularVelocity = Vector3.new(20000, 20000, 20000)
            if autoFarma then
                b13.Text = "Auto Farm Coins: ON (bag full - fling)"
            end
        elseif flingBack.active then
            -- target vanished (killed/changed role/left) -> we end the fling
            flingBack.active = false
            -- MEGA-FLING teardown: hand his body back - destroy the forces, give
            -- the network ownership and the standing pose to his own client.
            -- If he is already dead/gone the refs are dead too - pcall swallows it
            if flingBack.bv then pcall(function() flingBack.bv:Destroy() end) flingBack.bv = nil end
            if flingBack.ba then pcall(function() flingBack.ba:Destroy() end) flingBack.ba = nil end
            if flingBack.chum and flingBack.chum.Parent then
                pcall(function()
                    flingBack.chum.PlatformStand = false
                    flingBack.chum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
            end
            if flingBack.chrp and flingBack.chrp.Parent and flingBack.cplr then
                pcall(function() flingBack.chrp:SetNetworkOwner(flingBack.cplr) end)
            end
            flingBack.chum, flingBack.chrp, flingBack.cplr = nil, nil, nil
            -- back to the plain button text (a new round empties the bag)
            if autoFarmCoins then b13.Text = "Auto Farm Coins: ON" end
            if hum and hum.Health > 0 and flingBack.safe then
                -- ALIVE: we return to the map, where we started the fling
                hrp.CFrame = CFrame.new(flingBack.safe)
                hrp.Velocity = Vector3.new(0, 0, 0)
                hrp.RotVelocity = Vector3.new(0, 0, 0)
                -- Assembly* too: after the fling OUR velocity was 30000 on the
                -- assembly; if the proxies do not zero it, Anti-Fling v2 would
                -- treat our own return jump as an attack and snap us back
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                hum.PlatformStand = false
                hum.AutoRotate = true
            elseif hum and hum.Health <= 0 then
                -- DEAD: after respawn we land on the lobby spawn
                flingBack.spawn = true
            end
            flingBack.safe = nil
        end

        -- 4) RETURN TO SPAWN AFTER DYING DURING THE FLING
        if flingBack.spawn and hum and hum.Health > 0 then
            flingBack.spawn = false
            local boxes = getLobbyBoxes()
            local dokad = nil
            if #boxes > 0 then
                dokad = boxes[1].cf.Position + Vector3.new(0, 6, 0)
            elseif lobbySpawns and lobbySpawns[1] then
                dokad = lobbySpawns[1] + Vector3.new(0, 6, 0)
            end
            if dokad then
                hrp.CFrame = CFrame.new(dokad)
                hrp.Velocity = Vector3.new(0, 0, 0)
                hrp.RotVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end
    end)

    -- ============================================================
    -- TELEPORT TAB: quick jumps without flying across the map.
    -- Each button looks up its target LIVE (roles change every
