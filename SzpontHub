-- ESP BLOXSTRIKE v2 - WRITTEN FROM SCRATCH, because v1 did not survive the game update.
--
-- WHY v1 broke: BloxStrike has its OWN character system and after the update
-- v1 required player.Character + Head + a fresh position buffer, so
-- for everyone it printed "no Character and no fresh position"
-- and only a handful of people were left with a drawing.
--
-- THE UNCOVERED GAME SYSTEM (live probe in client PID 8052):
--   Player.Team            = "Terrorists" / "Counter-Terrorists" (STRING)
--   Player.Health/MaxHealth= 0..100 / 100
--   Player.Dead            = true/false      Player.IsCrouching
--   Player.CurrentEquipped = JSON with "Name":"AK-47" - held weapon
--   Model = player.Character, hangs in Workspace.Characters under the nickname:
--   Health/Dead/MaxHealth, PresentationOwnerUserId = UserId,
--   CharacterName - and ZERO Humanoid (only AnimationController),
--   so any read of Humanoid.Health gave 0 or nil.
--
-- NEW APPROACH:
--   1. Target = model from player.Character OR from the game folder (name = nickname,
--      or if not - by PresentationOwnerUserId). The target list
--      is rebuilt every 0.4 s, not every frame (AGENTS: no
--      scans in RenderStepped).
--   2. Label anchor: Head -> HumanoidRootPart -> PrimaryPart -> 
--      highest part. A missing Head CHANGES the anchor, it does not remove the player.
--   3. No "not alive = not drawn" filters - a dead player with a model
--      gets gray + [DOWN], without a model there is nothing to mark anyway.
--   4. Color from Player.Team (string comparison) - teammate green,
--      enemy red; no team = red (better to show than to skip).
--   5. ONE loop in _G + a getter from the hub, because _G survives reinjection - 
--      without that every insert = another RenderStepped and duplicated GUI.
------------------------------------------------------------
function startBsEspNew(getOn)
    -- The getter from the NEWEST hub installation always overwrites the old one,
    -- and we bind the loop itself only once.
    _G.__liptonBsEspGetter = getOn
    if _G.__liptonBsEspLoop then return end
    _G.__liptonBsEspLoop = true

    local Players = game:GetService("Players")
    local RS = game:GetService("RunService")
    local me = Players.LocalPlayer

    local REBUILD = 0.4   -- seconds between full target searches
    local rebuildAt = 0
    local targets = {}    -- { {p=player, m=model, a=anchor}, ... }

    -- Drawing anchor: Head is best (nickname above the head), the rest is
    -- a fallback for when the game hides/changes the character build after an update.
    -- GetDescendants runs ONLY when Head/HRP/PrimaryPart are missing.
    local function findAnchor(m)
        local a = m:FindFirstChild("Head")
            or m:FindFirstChild("HumanoidRootPart")
            or m.PrimaryPart
        if a then return a end
        local bestY, best = -math.huge, nil
        for _, d in ipairs(m:GetDescendants()) do
            if d:IsA("BasePart") and d.Position.Y > bestY then
                bestY, best = d.Position.Y, d
            end
        end
        return best
    end

    local function rebuild()
        local fresh = {}
        local cf = workspace:FindFirstChild("Characters")
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= me then
                local m = p.Character
                if not (m and m.Parent) and cf then
                    -- here v1 died completely: the model is in the game
                    -- folder, not always attached as player.Character
                    m = cf:FindFirstChild(p.Name)
                    if not m then
                        for _, c in ipairs(cf:GetChildren()) do
                            if c:IsA("Model")
                                and c:GetAttribute("PresentationOwnerUserId") == p.UserId then
                                m = c
                                break
                            end
                        end
                    end
                end
                if m then
                    fresh[#fresh + 1] = { p = p, m = m, a = findAnchor(m) }
                end
            end
        end
        targets = fresh
    end

    local function isTeammate(p)
        -- Their Team is a string in an attribute - we compare it 1:1.
        local t = p:GetAttribute("Team")
        local mine = me:GetAttribute("Team")
        if t ~= nil and mine ~= nil then return t == mine end
        if p.Team and me.Team then return p.Team == me.Team end
        return false  -- no data = enemy (red instead of an empty screen)
    end

    local function hpOf(p, m)
        -- Order: model -> player -> Humanoid: in their system the attribute counts,
        -- and enemies simply have no Humanoid (nil).
        local hp = tonumber(m:GetAttribute("Health"))
            or tonumber(p:GetAttribute("Health"))
        if hp == nil then
            local hum = m:FindFirstChildOfClass("Humanoid")
            hp = hum and hum.Health or 0
        end
        return math.floor(hp)
    end

    local function isDead(p, m)
        local d = p:GetAttribute("Dead")
        if d == nil then d = m:GetAttribute("Dead") end
        if d == true or d == 1 or d == "true" then return true end
        local hp = tonumber(m:GetAttribute("Health"))
            or tonumber(p:GetAttribute("Health"))
        return hp == 0
    end

    -- Held weapon from their JSON in the attribute - we cut out just the name,
    -- without parsing the object (cheap string.match on the attribute).
    local function weaponOf(p)
        local s = p:GetAttribute("CurrentEquipped")
        if type(s) ~= "string" then return nil end
        return s:match('"Name"%s*:%s*"([^"]+)"')
    end

    local function clearAll()
        for _, t in ipairs(targets) do
            local hl = t.m and t.m:FindFirstChild("BsEspHL")
            if hl then hl:Destroy() end
            local bb = t.a and t.a:FindFirstChild("BsEspBB")
            if bb then bb:Destroy() end
            -- the box is attached to the anchor (not the model), so separately
            local bx = t.a and t.a:FindFirstChild("BsEspBox")
            if bx then bx:Destroy() end
        end
        targets = {}
    end

    -- Start: we clean up after the previous hub installation, so that reinjection
    -- does not leave orphaned labels on characters.
    local cf0 = workspace:FindFirstChild("Characters")
    if cf0 then
        for _, c in ipairs(cf0:GetChildren()) do
            local hl = c:FindFirstChild("BsEspHL")
            if hl then hl:Destroy() end
            local h = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
            local bb = h and h:FindFirstChild("BsEspBB")
            if bb then bb:Destroy() end
            local bx = h and h:FindFirstChild("BsEspBox")
            if bx then bx:Destroy() end
        end
    end

    -- BindToRenderStep with a priority ABOVE the camera, not an ordinary
    -- RenderStepped: the ESP must write sizes/colors after the game and after
    -- the hub own loops. With an ordinary RenderStepped an older loop
    -- (e.g. from the previous injection, still alive) overwrote the values
    -- in the same frame and the box went back to the old, broken sizes.
    RS:UnbindFromRenderStep("SzpontHubBsEsp")
    RS:BindToRenderStep("SzpontHubBsEsp", Enum.RenderPriority.Camera.Value + 10, function()
        local getter = _G.__liptonBsEspGetter
        if not (getter and getter()) then
            if #targets > 0 then clearAll() end
            return
        end

        local now = tick()
        if now - rebuildAt >= REBUILD then
            rebuildAt = now
            rebuild()
        end

        local cam = workspace.CurrentCamera
        for i = #targets, 1, -1 do
            local t = targets[i]
            local m = t.m
            if not (m and m.Parent) then
                -- the model disappeared (respawn/end of round) - a full rebuild
                -- would bring it back anyway, so we only drop it from the list
                table.remove(targets, i)
            else
                local a = t.a
                if not (a and a.Parent) then
                    a = findAnchor(m)
                    t.a = a
                end
                if a then
                    local dead = isDead(t.p, m)
                    local color = dead and Color3.fromRGB(150, 150, 150)
                        or (not isTeammate(t.p)
                            and Color3.fromRGB(255, 45, 45)
                            or Color3.fromRGB(45, 255, 90))

                    -- HIGHLIGHT is created once, but attributes are forced EVERY
                    -- frame: the default Occluded hides the ESP behind walls, and the game
                    -- can overwrite DepthMode - so we come back here every tick.
                    local hl = m:FindFirstChild("BsEspHL")
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "BsEspHL"
                        hl.Parent = m
                    end
                    hl.Adornee = m
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.FillColor = color
                    -- 0.55 was invisible: with enemies 100-250 m away (and in
                    -- BloxStrike the camera is sometimes Scriptable/spectator) the fill gave
                    -- a few barely visible pixels. 0.28 = a clear silhouette
                    -- through walls, and further away you can still tell who is who.
                    hl.FillTransparency = 0.28
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.OutlineTransparency = 0

                    -- BOX AROUND THE CHARACTER (GUI, not Highlight).
                    -- Why GUI: Highlight by itself would be invisible to the user,
                    -- and BillboardGui + UIStroke draws along the same path
                    -- as our names above the heads, which work in this
                    -- game. The size is given in STUDS, so the box
                    -- sticks to the silhouette regardless of distance (the further,
                    -- the smaller - like a real box ESP), and AlwaysOnTop
                    -- gives see-through-walls visibility.
                    local bx = a:FindFirstChild("BsEspBox")
                    if not bx then
                        bx = Instance.new("BillboardGui")
                        bx.Name = "BsEspBox"
                        bx.Parent = a
                        bx.ResetOnSpawn = false
                        bx.AlwaysOnTop = true
                        bx.LightInfluence = 0
                        local fr = Instance.new("Frame")
                        fr.Name = "BsEspBoxFrame"
                        fr.Parent = bx
                        fr.BackgroundTransparency = 1
                        fr.Size = UDim2.new(1, 0, 1, 0)
                        local st = Instance.new("UIStroke")
                        st.Name = "BsEspStroke"
                        st.Parent = fr
                        st.Thickness = 2.5
                        st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    end
                    -- SIZE IN PIXELS, COMPUTED FROM DISTANCE.
                    -- IMPORTANT: the UDim2 offset in BillboardGui is PIXELS, not
                    -- studs - the earlier 3.4 x 6.4 gave a 3x6 px box, i.e.
                    -- an invisible dot (hence "ESP does not highlight"). The size
                    -- comes from a pinhole projection: px = stud * (screen height / 2) /
                    -- (tan(fov/2) * distance), so the box sticks to the silhouette both
                    -- at 5 m and at 350 m (the camera in BS is sometimes a spectator).
                    local dystans = (a.Position - cam.CFrame.Position).Magnitude
                    local pxPerStud = (cam.ViewportSize.Y * 0.5)
                        / (math.tan(math.rad(cam.FieldOfView) * 0.5) * math.max(dystans, 1))
                    bx.Size = UDim2.fromOffset(
                        math.clamp(2.6 * pxPerStud, 26, 900),
                        math.clamp(5.8 * pxPerStud, 52, 1600))
                    -- The anchor is Head (top of the silhouette), while the model pivot lies
                    -- roughly in the middle - we shift the box by the difference.
                    bx.StudsOffset = Vector3.new(
                        0, m:GetPivot().Position.Y - a.Position.Y, 0)
                    local frBox = bx:FindFirstChild("BsEspBoxFrame")
                    local stBox = frBox and frBox:FindFirstChild("BsEspStroke")
                    if stBox then stBox.Color = color end

                    local bb = a:FindFirstChild("BsEspBB")
                    if not bb then
                        bb = Instance.new("BillboardGui")
                        bb.Name = "BsEspBB"
                        bb.Parent = a
                        bb.ResetOnSpawn = false
                    end
                    bb.Size = UDim2.new(0, 180, 0, 48)
                    bb.StudsOffset = Vector3.new(0, 3.2, 0)
                    bb.AlwaysOnTop = true
                    bb.Enabled = true

                    local txt = bb:FindFirstChild("BsEspTxt")
                    if not txt then
                        txt = Instance.new("TextLabel")
                        txt.Name = "BsEspTxt"
                        txt.Parent = bb
                        txt.BackgroundTransparency = 1
                        txt.Font = Enum.Font.SourceSansBold
                        txt.TextStrokeTransparency = 0
                    end
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.TextSize = 13
                    txt.TextColor3 = color

                    local line = t.p.Name
                    if dead then line = line .. " [DOWN]" end
                    local w = weaponOf(t.p)
                    if w then line = line .. " [" .. w .. "]" end
                    if t.p:GetAttribute("IsCrouching") then
                        line = line .. " (crouching)"
                    end
                    local dist = ""
                    if cam then
                        dist = " | " .. math.floor(
                            (a.Position - cam.CFrame.Position).Magnitude) .. "m"
                    end
                    txt.Text = line .. "\nHP " .. hpOf(t.p, m) .. dist
                end
            end
        end
    end)
end

