    local allButtons = {}

    local function createButton(text, order, tab)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.95, 0, 0, 32)
        btn.BackgroundColor3 = Color3.fromRGB(20, 10, 25)
        btn.BackgroundTransparency = 0.2
        btn.BorderSizePixel = 1
        btn.BorderColor3 = Color3.fromRGB(170, 50, 255)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 13
        btn.Font = Enum.Font.SourceSansBold
        btn.Text = text
        btn.LayoutOrder = order
        btn.ZIndex = 3
        btn.Parent = pages[tab]
        table.insert(allButtons, btn)
        return btn
    end

    local function makeToggle(name, order, tab, get, set)
        local btn = createButton(name .. ": OFF", order, tab)
        btn.MouseButton1Click:Connect(function()
            local nv = not get()
            set(nv)
            btn.Text = name .. (nv and ": ON" or ": OFF")
            btn.BackgroundColor3 = nv and Color3.fromRGB(170, 50, 255) or Color3.fromRGB(20, 10, 25)
        end)
        return btn
    end

    local function createNote(text, order, tab)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.95, 0, 0, 26)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.fromRGB(210, 150, 255)
        lbl.TextSize = 11
        lbl.Font = Enum.Font.SourceSansBold
        lbl.TextWrapped = true
        lbl.Text = text
        lbl.LayoutOrder = order
        lbl.ZIndex = 3
        lbl.Parent = pages[tab]
        return lbl
    end

