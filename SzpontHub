    ------------------------------------------------------------
    -- AIMBOT MM2 (REWOLWER SZERYFA)
    -- Sterowanie 1:1 jak aimbot w BloxStrike: suwak FOV, kółko FOV,
    -- suwak prędkości i CELUJEMY NA PRZYTRZYMANYM PPM.
    -- Warunki: PPM trzymany + broń szeryfa (Gun / Revolver / Pistol)
    -- wzięta DO RĘKI — z nożem ani z pustymi rękami nic się nie dzieje.
    -- Cel = Morderca, celowanie w CIAŁO (klatka/pas, nie głowa).
    -- Kółko = GUI (UIStroke + UICorner), bo Drawing w Madium nie rysuje.
    ------------------------------------------------------------
    local mm2AimCtl = { dx = 0, yawSent = nil, sens = 0.004 }
    -- isTargetValid() robi GetDescendants() na cale workspace — bez tego
    -- bufora aimbot skanowalby mape 60x/s na kazdej klatce (jak kiedyś
    -- auto-farm monet). Walidacja celu max 4x/s, kąt liczymy co klatkę.
    local aimValidCache = {}

    local fovGui2, fovFrame2, fovStroke2 = nil, nil, nil
    pcall(function()
        fovGui2 = Instance.new("ScreenGui")
        fovGui2.Name = "MM2FovCircle"
        fovGui2.ResetOnSpawn = false
        fovGui2.IgnoreGuiInset = true
        fovGui2.DisplayOrder = 99999
        fovGui2.Parent = targetParent
        fovFrame2 = Instance.new("Frame")
        fovFrame2.Size = UDim2.fromOffset(200, 200)
        fovFrame2.BackgroundTransparency = 1
        fovFrame2.Visible = false
        fovFrame2.Parent = fovGui2
        fovStroke2 = Instance.new("UIStroke")
        fovStroke2.Color = Color3.fromRGB(170, 50, 255)
        fovStroke2.Thickness = 2
        fovStroke2.Transparency = 0.15
        fovStroke2.Parent = fovFrame2
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = fovFrame2
    end)

    -- Zwraca narzędzie szeryfa tylko gdy jest WZIĘTE DO RĘKI
    local function getEquippedRevolver()
        local ch = plr.Character
        if not ch then return nil end
        local tool = ch:FindFirstChildOfClass("Tool")
        if not tool then return nil end
        local n = tool.Name:lower()
        if n:find("gun") or n:find("revolver") or n:find("pistol") then
