    -- szuka Twojej broni danego typu: najpierw w ręce, potem w plecaku
    local function findWeapon(kind)
        local pat = (kind == "Gun") and { "gun", "revolver", "pistol" } or { "knife", "blade", "nóż" }
        local function matchName(t)
            local n = t.Name:lower()
            for _, p in ipairs(pat) do
                if n:find(p) then return true end
            end
            return false
        end
        local ch, bp = plr.Character, plr:FindFirstChildOfClass("Backpack")
        local tool = ch and ch:FindFirstChildOfClass("Tool")
        if tool and matchName(tool) then return tool end
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and matchName(t) then return t end
            end
        end
        return nil
    end

    -- podmiana siatki LOKALNIE; oryginał chowamy w atrybutach Toola,
    -- żeby dało się przywrócić i żeby przeżyło zmianę referencji
    local function applySkinToTool(tool, skin)
        local h = tool:FindFirstChild("Handle")
        if not h then return false, "brak Handle" end
        local mesh = h:FindFirstChildOfClass("DataModelMesh")
        if mesh then
            if not tool:GetAttribute("SzpSkinOld") then
                tool:SetAttribute("SzpSkinOld", mesh.MeshId)
                tool:SetAttribute("SzpSkinOldTex", mesh.TextureId)
            end
            mesh.MeshId = "http://www.roblox.com/asset/?id=" .. tostring(skin.id)
            mesh.TextureId = ""
            return true
        elseif h:IsA("MeshPart") then
            if not tool:GetAttribute("SzpSkinOld") then
                tool:SetAttribute("SzpSkinOld", h.MeshId)
                tool:SetAttribute("SzpSkinOldTex", h.TextureID)
            end
            h.MeshId = "rbxassetid://" .. tostring(skin.id)
            return true
        elseif h:IsA("BasePart") then
            -- PISTOLETY MM2 mają Handle jako ZWYKŁY Part bez żadnej siatki —
            -- dlatego wcześniej padało "nierozpoznany Handle (Part)" i nie
            -- dało się nałożyć skina na broń. Doklejamy SpecialMesh; przy
            -- przywracaniu taki mesh po prostu usuwamy (SzpSkinMeshMade).
            local nm = Instance.new("SpecialMesh")
            nm.Parent = h
            if not tool:GetAttribute("SzpSkinOld") then
                tool:SetAttribute("SzpSkinOld", "BRAK")
                tool:SetAttribute("SzpSkinOldTex", "")
                tool:SetAttribute("SzpSkinMeshMade", true)
            end
            nm.MeshId = "http://www.roblox.com/asset/?id=" .. tostring(skin.id)
            nm.TextureId = ""
            return true
        end
        return false, "nierozpoznany Handle (" .. h.ClassName .. ")"
    end

    tryApplySelected = function(quiet)
        if not selectedSkin then
            if not quiet then skinStatus.Text = "Najpierw wybierz pozycję z listy." end
            return false
        end
        local tool = findWeapon(selectedSkin.slot)
        if not tool then
            if not quiet then
                skinStatus.Text = "Brak broni (" .. tostring(selectedSkin.slot) .. ") — spróbuję przy najbliższej rundzie."
            end
            return false
        end
        local ok, err = applySkinToTool(tool, selectedSkin)
        if ok then
            skinStatus.Text = "OK: " .. tostring(selectedSkin.name) .. " → " .. tool.Name .. " (widzisz tylko Ty)"
        elseif not quiet then
            skinStatus.Text = "Błąd: " .. tostring(err)
        end
        return ok
    end

    restoreOriginals = function()
        local fixed = 0
        for _, container in ipairs({ plr.Character, plr:FindFirstChildOfClass("Backpack") }) do
            if container then
                for _, t in ipairs(container:GetChildren()) do
                    if t:IsA("Tool") then
                        local old = t:GetAttribute("SzpSkinOld")
                        if old then
                            local h = t:FindFirstChild("Handle")
                            if t:GetAttribute("SzpSkinMeshMade") and old == "BRAK" then
                                -- siatkę dokleiliśmy sami (pistolet bez siatki),
                                -- więc przywracaniem jest jej usunięcie
                                local mesh = h and h:FindFirstChildOfClass("SpecialMesh")
                                if mesh then
                                    mesh:Destroy()
                                    fixed = fixed + 1
                                end
                            else
                                local mesh = h and h:FindFirstChildOfClass("DataModelMesh")
                                if mesh then
                                    mesh.MeshId = old
                                    mesh.TextureId = t:GetAttribute("SzpSkinOldTex") or ""
                                    fixed = fixed + 1
                                elseif h and h:IsA("MeshPart") then
                                    h.MeshId = old
                                    fixed = fixed + 1
                                end
                            end
                            t:SetAttribute("SzpSkinOld", nil)
                            t:SetAttribute("SzpSkinOldTex", nil)
                            t:SetAttribute("SzpSkinMeshMade", nil)
                        end
                    end
                end
            end
        end
        skinStatus.Text = (fixed > 0) and ("Przywrócono " .. tostring(fixed) .. " broni.") or "Nie ma czego przywracać."
    end

    ------------------------------------------------------------
    -- EKWIPUNEK GRY: gra sama buduje swoje ramki przez
    -- InventoryService:CreateItemFrame("Weapons", klucz, ile) i wrzuca je do
    -- Main.Weapons.Items.ItemList. Używamy tego samego modułu, więc nasza
    -- pozycja wygląda dokładnie jak prawdziwa (ikona rbxthumb, kolor rzadkości,
    -- układ). To wyłącznie dodanie GUI po Twojej stronie — ZERO remoteów.
    ------------------------------------------------------------
    local function gameInv()
        local pg = plr:FindFirstChildOfClass("PlayerGui")
        local gui = pg and pg:FindFirstChild("MainGUI")
        local g = gui and gui:FindFirstChild("Game")
        local inv = g and g:FindFirstChild("Inventory2")
        local main = inv and inv:FindFirstChild("Main")
        local w = main and main:FindFirstChild("Weapons")
        local items = w and w:FindFirstChild("Items")
        local list = items and items:FindFirstChild("ItemList")
        local tabs = items and items:FindFirstChild("Tabs")
        local s = tabs and tabs:FindFirstChild("Search")
        s = s and s:FindFirstChild("Container")
        s = s and s:FindFirstChild("SearchText")
        -- cały łańcuch widoczności zwracamy razem: gra po respawnie potrafi
        -- nie dokończyć własnej inicjalizacji i zostawić panel Weapons UKRYTY,
        -- przez co nasza poprawnie wstawiona ramka i tak jest niewidoczna
        return list, tabs, s, { inv2 = inv, main = main, weapons = w, items = items }
    end

    -- MM2 potrafi mieć własny skrypt ekwipunku WYŁĄCZONY (Disabled=true).
    -- Wtedy gra nigdy nie buduje swoich ramek: w liście zostaje tylko
    -- placeholder "Loading...", panel Weapons zostaje ukryty, a nasza
    -- poprawnie wstawiona ramka i tak jest niewidoczna — stąd pozorne "OK".
    -- Włączenie go to wyłącznie odtworzenie normalnego UI gry (client-side).
    -- Cały blok pomocniczy siedzi w tabeli szpInv, a nie w osobnych
    -- zmiennych lokalnych: cały skrypt to JEDNA funkcja z limitem 200
    -- zmiennych lokalnych i każde kilka nowych lokalnych potrafiło ten
    -- limit przekroczyć (błąd "Out of local registers").
    local szpInv = {}
    szpInv.spawned = {}

    szpInv.ensureScript = function()
        local pg = plr:FindFirstChildOfClass("PlayerGui")
        local gui = pg and pg:FindFirstChild("MainGUI")
        local ls = gui and gui:FindFirstChild("Inventory2")
        if ls and ls:IsA("LocalScript") and ls.Disabled then
            pcall(function() ls.Disabled = false end)
            return true
        end
        return false
    end

    -- odkrywa dokładnie to, co odkrywa gra w SwitchInventoryTab("Weapons")
    szpInv.showPanel = function()
        local _, _, _, chain = gameInv()
        if not (chain and chain.inv2 and chain.main and chain.weapons and chain.items) then
            return false
        end
        pcall(function()
            for _, c in ipairs(chain.main:GetChildren()) do
                if c:IsA("GuiObject") then c.Visible = (c.Name == "Weapons") end
            end
            chain.items.Visible = true
            chain.weapons.Visible = true
            chain.main.Visible = true
            chain.inv2.Visible = true
        end)
        -- przy okazji: przemaluj kafelki, które gra zrobiła „Error" przed patchem
        pcall(function() szpInv.fixErrorFrames() end)
        return true
    end

    -- czy ramka JEST widoczna (sprawdzamy wszystkich rodziców, nie tylko jej
    -- własną flagę — to właśnie rodzic panelu bywał ukryty i „OK" było prawdą
    -- tylko na papierze)
    szpInv.frameVisible = function(fr)
        local p = fr
        while p and p:IsA("GuiObject") do
            if not p.Visible then return false end
            p = p.Parent
        end
        return p ~= nil
    end

    -- NAPRAWA „ERROR" W EKWIPUNKU GRY.
    -- Gra sama ma błąd kolejności argumentów: AddItem woła
    -- CreateItemFrame("Weapons", "DefaultKnife") → to idzie do
    -- GetItemInfo("Weapons", "DefaultKnife"), a ten czyta Sync[2][1], czyli
    -- Sync["DefaultKnife"]["Weapons"] → nil → warn + Materials.ErrorItem,
    -- czyli kafelka "Error". Wystarczy raz zamienić argumenty w module
    -- (moduł jest wspólny dla wszystkich require'ów, więc patch działa
    -- też dla kodu gry) i ekwipunek wraca do normy.
    szpInv.patchItemService = function()
        local RS = game:GetService("ReplicatedStorage")
        -- limit 5 s + require wewnątrz pcall: WaitForChild bez limitu
        -- wisiałby w nieskończoność, a jego wynik liczy się PRZED pcall
        local okIS, IS = pcall(function()
            return require(RS:WaitForChild("ClientServices", 5):WaitForChild("ItemService", 5))
        end)
        if not okIS or type(IS) ~= "table" or IS.__SzpFixed then return false end
        local okSync, Sync = pcall(function()
            return require(RS:WaitForChild("Database", 5):WaitForChild("Sync", 5))
        end)
        if not okSync or type(Sync) ~= "table" then return false end
        local function fix(fn)
            if type(fn) ~= "function" then return fn end
            return function(self, a, b)
                -- Sync[x] istnieje tylko dla TYPÓW (Weapons/Guns/Effects...),
                -- więc po tym poznajemy, który argument jest czym
                local aTyp = (type(a) == "string") and (Sync[a] ~= nil)
                local bTyp = (type(b) == "string") and (Sync[b] ~= nil)
                if aTyp and not bTyp then
                    return fn(self, b, a)
                end
                return fn(self, a, b)
            end
        end
        IS.GetItemInfo = fix(IS.GetItemInfo)
        IS.FindItemInfo = fix(IS.FindItemInfo)
        IS.__SzpFixed = true
        return true
    end
    -- od razu przy starcie: ekwipunek gry nigdy nie powinien pokazywać „Error"
    szpInv.patchItemService()

    -- TRZYMANIE W RĘCE (lokalnie).
    -- W ReplicatedStorage NIE ma szablonów Tool (bronie klonuje serwer),
    -- więc klonujemy broń, którą już trzymasz (albo cudzą z Workspace jako
    -- wzór geometrii), podmieniamy siatkę na wybrany skin i dajemy do ręki.
    -- Skrypty broni wyciszamy, żeby gra nie strzelała remoteami z naszego
    -- fałszywego Toola. Całość widoczna wyłącznie u Ciebie.
    szpInv.holdInHand = function(entry)
        if not entry then return false, "najpierw wybierz pozycję" end
        if not entry.id then return false, "pozycja bez asset ID" end
        szpInv.patchItemService()
        local ch = plr.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if not hum then return false, "brak postaci" end
        local bp = plr:FindFirstChildOfClass("Backpack")
        if not bp then return false, "brak Backpack" end

        -- sprzątamy poprzednią lokalną broń, żeby tooli nie mnożyło się
        -- z każdą zmianą skinu (serwer o tym nie wie, to nasze GUI)
        for _, cont in ipairs({ ch, bp }) do
            for _, t in ipairs(cont:GetChildren()) do
                if t:IsA("Tool") and t:GetAttribute("SzpLocalSkin") then
                    pcall(function() t:Destroy() end)
                end
            end
        end

        local function isSlot(t, pat)
            if not (t and t:IsA("Tool")) then return false end
            local n = t.Name:lower()
            for _, p in ipairs(pat) do
                if n:find(p) then return true end
            end
            return false
        end
        local pat = (entry.slot == "Gun")
            and { "gun", "revolver", "pistol" }
            or  { "knife", "blade" }

        -- 1) NAJPIERW PRAWDA: kładziemy skin na TWOJEJ prawdziwej broni.
        --    Wcześniejsze klonowanie własnego Toola ZAWSZE przegrywało z grą:
        --    ta przy starcie rundy wyposaża swoją broń, więc nasz lądował
        --    z powrotem w plecaku — stąd "niewidzialny item w ręce".
        --    Prawdziwa broń jest dana przez serwer, więc nikt jej nie cofnie,
        --    a do tego dalej nią strzelasz/cięcisz.
        local real = ch:FindFirstChildOfClass("Tool")
        if not (real and isSlot(real, pat)) then
            real = nil
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and not t:GetAttribute("SzpLocalSkin") and isSlot(t, pat) then
                    real = t
                    break
                end
            end
        end
        if real then
            local ok, err = applySkinToTool(real, entry)
            if not ok then return false, err end
            if real.Parent ~= ch then
                pcall(function() hum:EquipTool(real) end)
            end
            return true, tostring(entry.name) .. " na Twojej broni (" .. real.Name
                .. ") — widzisz tylko Ty"
        end

        -- 2) NIE MASZ BRONI (najczęściej Innocent) — wtedy budujemy własny
        --    Tool. Tu nic Ci jej nie odbierze, więc może spokojnie zostać
        --    w ręce do końca rundy.
        local pat2 = pat
        local template = nil
        for _, other in ipairs(game:GetService("Players"):GetPlayers()) do
            if other ~= plr then
                local oc = other.Character
                local ot = oc and oc:FindFirstChildOfClass("Tool")
                if isSlot(ot, pat2) then template = ot break end
                local ob = other:FindFirstChildOfClass("Backpack")
                if ob then
                    for _, t in ipairs(ob:GetChildren()) do
                        if isSlot(t, pat2) then template = t break end
                    end
                end
                if template then break end
            end
        end

        local tool
        if template then
            -- klon cudzej broni = prawidłowa geometria i chwyt (grip);
            -- logikę broni wyciszamy, bo strzelanie/cięcie to remotey serwera
            tool = template:Clone()
            for _, d in ipairs(tool:GetDescendants()) do
                if d:IsA("BaseScript") then d:Destroy() end
            end
        else
            -- brak wzorca — budujemy Toola od zera
            tool = Instance.new("Tool")
            tool.RequiresHandle = true
            local h = Instance.new("Part")
            h.Name = "Handle"
            h.Size = (entry.slot == "Gun")
                and Vector3.new(0.6, 1.2, 2.0)
                or Vector3.new(0.4, 0.4, 1.4)
            h.CanCollide = false
            h.Parent = tool
        end

        local handle = tool:FindFirstChild("Handle")
        if not handle then return false, "wzorzec bez Handle" end
        local mesh = handle:FindFirstChildOfClass("DataModelMesh")
        if not mesh then
            mesh = Instance.new("SpecialMesh")
            mesh.Parent = handle
        end
        mesh.MeshId = "http://www.roblox.com/asset/?id=" .. tostring(entry.id)
        mesh.TextureId = ""   -- siatka sama ma podpiętą teksturę (jak noże MM2)

        tool.Name = tostring(entry.name)
        tool.CanBeDropped = false
        tool:SetAttribute("SzpLocalSkin", tostring(entry.key))
        tool.Parent = bp
        hum:EquipTool(tool)

        -- pilnujemy, żeby gra nie zepchnęła toola z powrotem do plecaka;
        -- walkę przerywamy natychmiast, gdy w ręce pojawi się COŚ INNEGO —
        -- nie odbieramy Ci prawdziwej broni
        task.spawn(function()
            while tool.Parent and tool:GetAttribute("SzpLocalSkin") and ch.Parent do
                task.wait(0.5)
                if tool.Parent == bp then
                    if ch:FindFirstChildOfClass("Tool") then break end
                    pcall(function() hum:EquipTool(tool) end)
                end
            end
        end)
        return true, tostring(entry.name) .. " w ręce (tylko u Ciebie)"
    end

    -- NAPRAWA JUŻ ISTNIEJĄCYCH KAFELKÓW „Error".
    -- Po patchu gra przy kolejnym respawnie zbuduje ekwipunek poprawnie,
    -- ale te stworzone PRZED patchem mają w sobie ErrorItem. Nie wolno ich
    -- niszczyć (gra trzyma je w swojej tabeli Frames i jej filtr by się
    -- wywalił) — przemalowujemy je w miejscu. Kafelki gry rozpoznajemy po
    -- LayoutOrder, bo GetLayoutOrder zwraca 0=DefaultKnife, 1=DefaultGun.
    szpInv.fixErrorFrames = function()
        szpInv.patchItemService()
        local list = gameInv()
        if not list then return 0 end
        local RS = game:GetService("ReplicatedStorage")
        local okIS, ItemSvc = pcall(function()
            return require(RS:WaitForChild("ClientServices", 5):WaitForChild("ItemService", 5))
        end)
        if not okIS or type(ItemSvc) ~= "table" then return 0 end
        local fixed = 0
        for _, c in ipairs(list:GetChildren()) do
            if c:IsA("GuiObject") and not c.Name:find("SzpHub_", 1, true) then
                local lbl = c:FindFirstChild("ItemName", true)
                lbl = lbl and lbl:FindFirstChild("Label")
                if lbl and lbl.Text == "Error" then
                    local key
                    if c.LayoutOrder == 0 then key = "DefaultKnife"
                    elseif c.LayoutOrder == 1 then key = "DefaultGun" end
                    if key then
                        local ok, info = pcall(function() return ItemSvc:GetItemInfo("Weapons", key) end)
                        if ok and type(info) == "table" then
                            pcall(function() ItemSvc:ApplyItemToFrame(c, info, 1) end)
                            pcall(function() ItemSvc:ApplyTags(c, info) end)
                            fixed = fixed + 1
                        end
                    end
                end
            end
        end
        return fixed
    end
    -- przemalowujemy kafelki uszkodzone PRZED patchem (przy starcie i przy
    -- każdym otwarciu ekwipunku — po respawnie gra i tak zbuduje je dobrze)
    szpInv.fixErrorFrames()

    -- kliknięcie kafelka w ekwipunku gry = bierzemy go do ręki (lokalnie).
    szpInv.wireFrame = function(frame, entry)
        local cont = frame and frame:FindFirstChild("Container")
        local ab = cont and cont:FindFirstChild("ActionButton")
        if not ab or ab:GetAttribute("SzpWired") then return end
        ab:SetAttribute("SzpWired", true)
        ab.Activated:Connect(function()
            local ok, err = szpInv.holdInHand(entry)
            if skinStatus then
                skinStatus.Text = ok
                    and ("OK: " .. tostring(err))
                    or ("Nie da się: " .. tostring(err))
            end
        end)
    end

    -- gra ukrywa ramki spoza wybranej zakładki (Current/Classic/Event) i po
    -- swojej szukajce — po jej handlerach wymuszamy widoczność naszych ramek,
    -- inaczej pozycja z eventu byłaby niewidoczna przy domyślnej zakładce
    refreshInjected = function()
        local list, _, searchBox = gameInv()
        if not list then return end
        local q = (searchBox and string.lower(searchBox.Text or "")) or ""
        for fr, info in pairs(injected) do
            local ok = pcall(function()
                if fr.Parent ~= list then fr.Parent = list end
                if q == "" then
                    fr.Visible = true
                else
                    fr.Visible = (string.find(string.lower(info.name), q, 1, true) ~= nil)
                        or (string.find(string.lower(info.key), q, 1, true) ~= nil)
                end
            end)
            if not ok then injected[fr] = nil end   -- ramka padła (gra przebudowała GUI)
        end
    end

    szpInv.hookedList = nil
    szpInv.hookGameInv = function()
        local list, tabs, searchBox = gameInv()
        if not list or szpInv.hookedList == list then return end
        szpInv.hookedList = list
        for _, tabName in ipairs({ "Current", "Classic", "Event" }) do
            local tab = tabs and tabs:FindFirstChild(tabName)
            local view = tab and tab:FindFirstChild("View")
            if view then
                view.Activated:Connect(function()
                    task.wait()   -- dajemy grze wykonać jej filtr; poprawiamy po niej
                    refreshInjected()
                end)
            end
        end
        if searchBox then
            searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                task.wait()
                refreshInjected()
            end)
        end
    end

    -- klucze dodane przez użytkownika — ekwipunek gry ma ResetOnSpawn=true,
    -- więc MM2 kasuje go przy każdym odrodzeniu (a to co rundę). Bez tej
    -- listy nasze ramki znikałyby kilka sekund po SPAWN i status "OK" byłby
    -- prawdą tylko do najbliższego odrodzenia.

    szpInv.reqIS = function()
        local ok, IS = pcall(function()
            return require(game:GetService("ReplicatedStorage")
                :WaitForChild("ClientServices", 5):WaitForChild("InventoryService", 5))
        end)
        return ok and IS or nil
    end

    -- odtwarza brakujące ramki po odrodzeniu / przebudowie ekranu ekwipunku
    szpInv.ensureSpawned = function()
        szpInv.ensureScript()   -- bez tego gra nie zbuduje nawet własnych ramek
        if #szpInv.spawned == 0 then return end
        local list = gameInv()
        if not list then return end
        local IS = szpInv.reqIS()
        if not IS then return end
        local dodane = 0
        for _, e in ipairs(szpInv.spawned) do
            if not list:FindFirstChild("SzpHub_" .. e.key) then
                local ok, res = pcall(function()
                    return IS:CreateItemFrame(e.key, "Weapons", 1)
                end)
                if ok and type(res) == "table" and res.Frame then
                    res.Frame.Name = "SzpHub_" .. e.key
                    res.Frame.Parent = list
                    injected[res.Frame] = { key = e.key, name = tostring(e.name) }
                    szpInv.wireFrame(res.Frame, e)
                    dodane = dodane + 1
                end
            end
        end
        if dodane > 0 then
            szpInv.hookGameInv()
            refreshInjected()
            -- gra po respawnie potrafi zostawić cały panel Weapons ukrytym
            -- (nie dokończyła własnej inicjalizacji) — bez tego odkrycia
            -- odtworzone ramki wisiałyby, ale gracz by ich nie widział
            szpInv.showPanel()
        end
    end

    -- przycisk otwarcia ekwipunku w docku gry: po respawnie to NOWY obiekt,
    -- więc hook trzeba zakładać ponownie (atribute = znacznik "już podpięte")
    szpInv.hookOpenButton = function()
        local g = plr:FindFirstChildOfClass("PlayerGui")
        g = g and g:FindFirstChild("MainGUI")
        g = g and g:FindFirstChild("Game")
        g = g and g:FindFirstChild("Dock")
        local btn = g and g:FindFirstChild("Inventory")
        if btn and not btn:GetAttribute("SzpHooked") then
            btn:SetAttribute("SzpHooked", true)
            btn.Activated:Connect(function()
                task.wait(0.4)
                szpInv.ensureSpawned()
                -- otwarcie ekwipunku = idealny moment, żeby włączyć wyłączony
                -- przez grę skrypt ekwipunku i odsłonić panel
                if szpInv.ensureScript() then task.wait(0.5) end
                szpInv.showPanel()
                refreshInjected()
            end)
        end
    end

    addToInventory = function(entry)
        -- najpierw przywracamy grze jej WŁASNY skrypt ekwipunku (bywa
        -- Disabled=true) — inaczej po SPAWN ekran i tak wyglądałby pusto
        szpInv.ensureScript()
        local list = gameInv()
        if not list then
            return false, "nie widzę ekranu ekwipunku gry"
        end
        -- ta sama pozycja już wisi w liście? (sprawdzamy SAMĄ listę, nie
        -- pamięć huba — po respawnie pamięć jest, a ramki nie ma)
        local mamy = list:FindFirstChild("SzpHub_" .. entry.key)
        if mamy then
            pcall(function()
                mamy.Visible = true
                injected[mamy] = { key = entry.key, name = tostring(entry.name) }
            end)
            szpInv.showPanel()
            refreshInjected()
            -- adoptacja = też rejestruj do odtwarzania po respawnie
            local found = false
            for _, e in ipairs(szpInv.spawned) do
                if e.key == entry.key then found = true break end
            end
            if not found then
                table.insert(szpInv.spawned, {
                    key = entry.key, name = tostring(entry.name),
                    id = entry.id, slot = entry.slot,
                })
            end
            szpInv.wireFrame(mamy, entry)
            if szpInv.frameVisible(mamy) then return true, "już jest w ekwipunku (widoczna)" end
            return true, "w liście, ale gra ukrywa panel — odśwież ekran"
        end
        local IS = szpInv.reqIS()
        if not IS then return false, "brak modułu InventoryService" end
        local ok, res = pcall(function()
            -- KOLEJNOŚĆ PARAMETRÓW JEST ODWRÓCONA względem dekompilacji:
            -- prawdziwa sygnatura to CreateItemFrame(klucz, tabela, ile),
            -- a nie (tabela, klucz) — w złej kolejności gra zwraca "Error"
            return IS:CreateItemFrame(entry.key, "Weapons", 1)
        end)
        if not ok or type(res) ~= "table" or not res.Frame then
            return false, "CreateItemFrame: " .. tostring(res):sub(1, 60)
        end
        local fr = res.Frame
        fr.Name = "SzpHub_" .. entry.key
        fr.Parent = list
        injected[fr] = { key = entry.key, name = tostring(entry.name) }
        szpInv.wireFrame(fr, entry)   -- klik w kafelek = bierzemy do ręki
        local found = false
        for _, e in ipairs(szpInv.spawned) do
            if e.key == entry.key then found = true break end
        end
        if not found then
            -- id (asset siatki) i slot muszą przeżyć respawn, bo bez nich
            -- trzymanie w ręce nie ma czym zbudować Toola
            table.insert(szpInv.spawned, {
                key = entry.key, name = tostring(entry.name),
                id = entry.id, slot = entry.slot,
            })
        end
        szpInv.hookGameInv()
        refreshInjected()
        -- wymuszamy odsłonięcie ekranu gry i DOPiero potem raportujemy:
        -- wcześniejsze "OK" było prawdziwe tylko na papierze, bo panel
        -- Weapons potrafi być ukryty (inicjalizacja gry niedokończona)
        task.wait(0.3)   -- dajemy grze chwilę na własną inicjalizację
        szpInv.showPanel()
        refreshInjected()
        if szpInv.frameVisible(fr) then
            return true, "dodano do ekwipunku (WIDOCZNA)"
        end
        return false, "dodano, lecz ekran gry ukrywa panel"
    end

    -- łączony filtr: typ (wszystkie/skiny/bronie) + szukajka po nazwie,
    -- kluczu i rzadkości — dlatego wpisanie "godly" albo "ancient" pokazuje
    -- pozycje, których wcześniej na liście w ogóle nie było
    applyFilter = function()
        local q = string.lower((skinSearch and skinSearch.Text) or "")
        for _, e in ipairs(skins) do
            local btn = skinButtons[e.key]
            if btn then
                local okTyp = (skinFilter == "ALL") or (e.kind == skinFilter)
                local okTxt = (q == "")
                    or (string.find(string.lower(e.name), q, 1, true) ~= nil)
                    or (string.find(string.lower(e.key), q, 1, true) ~= nil)
                    or (string.find(string.lower(e.rarity), q, 1, true) ~= nil)
                btn.Visible = okTyp and okTxt
            end
        end
    end

    loadSkins = function()
        if skinsLoaded then return end
        skinsLoaded = true
        skinStatus.Text = "Wczytywanie bazy gry..."
        local ok, Sync = pcall(function()
            return require(game:GetService("ReplicatedStorage")
                :WaitForChild("Database", 5):WaitForChild("Sync", 5))
        end)
        -- Sync.Weapons to pełna baza (1004 pozycje); Item jest jej kopią,
        -- dlatego bierzemy Weapons, a Item zostaje jako zapasowe źródło
        local db = (ok and type(Sync) == "table" and (Sync.Weapons or Sync.Item)) or nil
        if not ok or type(db) ~= "table" then
            skinStatus.Text = "Błąd: brak Database.Sync"
            lbSkinCount.Text = "Baza gry niedostępna"
            return
        end
        rarityColors = (type(Sync.Rarity) == "table" and Sync.Rarity) or {}
        -- kolejność rzadkości: najrzadsze na górze listy (stąd Godly/Ancient
        -- są widoczne od razu, a nie schowane gdzieś w środku)
        local rarRank = {
            Ancient = 1, Godly = 2, Unique = 3, Legendary = 4, Rare = 5,
            Uncommon = 6, Common = 7, Classic = 8, Halloween = 9, Christmas = 10,
        }
        local nSkin, nWeapon = 0, 0
        for k, v in pairs(db) do
            if type(v) == "table" and v.ItemID and (v.ItemType == "Gun" or v.ItemType == "Knife") then
                local s = tostring(k)
                local kind = (s:find("_G_") or s:find("_K_")) and "Skin" or "Weapon"
                if kind == "Skin" then nSkin = nSkin + 1 else nWeapon = nWeapon + 1 end
                table.insert(skins, {
                    key = s,
                    id = v.ItemID,
                    kind = kind,
                    slot = v.ItemType,          -- "Gun" albo "Knife"
                    name = v.ItemName or s,
                    rarity = v.Rarity or "Common",
                    year = v.Year,
                    event = v.Event,
                })
            end
        end
        table.sort(skins, function(a, b)
            local ra = rarRank[a.rarity] or 99
            local rb = rarRank[b.rarity] or 99
            if ra ~= rb then return ra < rb end
            return tostring(a.name):lower() < tostring(b.name):lower()
        end)
        lbSkinCount.Text = "Pozycji: " .. #skins .. " (skiny " .. nSkin .. ", bronie " .. nWeapon .. ")"
        skinStatus.Text = "Wybierz pozycję i kliknij SPAWN."
