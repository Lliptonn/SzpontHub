    -- looks for your weapon of the given type: first in hand, then in the backpack
    local function findWeapon(kind)
        local pat = (kind == "Gun") and { "gun", "revolver", "pistol" } or { "knife", "blade", "n" }
        local function matchName(t)
            local n = t.Name:lower()
            for _, p in ipairs(pat) do
                if n:find(p) then return true end
            end
            return false
        end
        local ch, bp = plr.Character, plr:FindFirstChildOfClass("Backpack")
        local tool = ch and ch:FindFirstChildOfClass("Tool")
        if tool and matchName(tool) then return tool end
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and matchName(t) then return t end
            end
        end
        return nil
    end

    -- mesh swap is LOCAL; we hide the original in the Tool's attributes,
    -- so it can be restored and so it survives a change of reference
    local function applySkinToTool(tool, skin)
        local h = tool:FindFirstChild("Handle")
        if not h then return false, "no Handle" end
        local mesh = h:FindFirstChildOfClass("DataModelMesh")
        if mesh then
            if not tool:GetAttribute("SzpSkinOld") then
                tool:SetAttribute("SzpSkinOld", mesh.MeshId)
                tool:SetAttribute("SzpSkinOldTex", mesh.TextureId)
            end
            mesh.MeshId = "http://www.roblox.com/asset/?id=" .. tostring(skin.id)
            mesh.TextureId = ""
            return true
        elseif h:IsA("MeshPart") then
            if not tool:GetAttribute("SzpSkinOld") then
                tool:SetAttribute("SzpSkinOld", h.MeshId)
                tool:SetAttribute("SzpSkinOldTex", h.TextureID)
            end
            h.MeshId = "rbxassetid://" .. tostring(skin.id)
            return true
        elseif h:IsA("BasePart") then
            -- MM2 PISTOLS have their Handle as a PLAIN Part with no mesh at all,
            -- which is why it used to fail with "unrecognized Handle (Part)" and
            -- the skin could not be put on the weapon. We append a SpecialMesh;
            -- when restoring, such a mesh is simply removed (SzpSkinMeshMade).
            local nm = Instance.new("SpecialMesh")
            nm.Parent = h
            if not tool:GetAttribute("SzpSkinOld") then
                tool:SetAttribute("SzpSkinOld", "BRAK")
                tool:SetAttribute("SzpSkinOldTex", "")
                tool:SetAttribute("SzpSkinMeshMade", true)
            end
            nm.MeshId = "http://www.roblox.com/asset/?id=" .. tostring(skin.id)
            nm.TextureId = ""
            return true
        end
        return false, "unrecognized Handle (" .. h.ClassName .. ")"
    end

    tryApplySelected = function(quiet)
        if not selectedSkin then
            if not quiet then skinStatus.Text = "First select an item from the list." end
            return false
        end
        local tool = findWeapon(selectedSkin.slot)
        if not tool then
            if not quiet then
                skinStatus.Text = "No weapon (" .. tostring(selectedSkin.slot) .. ") - try again next round."
            end
            return false
        end
        local ok, err = applySkinToTool(tool, selectedSkin)
        if ok then
            skinStatus.Text = "OK: " .. tostring(selectedSkin.name) .. "  " .. tool.Name .. " (only you see it)"
        elseif not quiet then
            skinStatus.Text = "Error: " .. tostring(err)
        end
        return ok
    end

    restoreOriginals = function()
        local fixed = 0
        for _, container in ipairs({ plr.Character, plr:FindFirstChildOfClass("Backpack") }) do
            if container then
                for _, t in ipairs(container:GetChildren()) do
                    if t:IsA("Tool") then
                        local old = t:GetAttribute("SzpSkinOld")
                        if old then
                            local h = t:FindFirstChild("Handle")
                            if t:GetAttribute("SzpSkinMeshMade") and old == "BRAK" then
                                -- we appended the mesh ourselves (a pistol with no mesh),
                                -- so restoring means removing it
                                local mesh = h and h:FindFirstChildOfClass("SpecialMesh")
                                if mesh then
                                    mesh:Destroy()
                                    fixed = fixed + 1
                                end
                            else
                                local mesh = h and h:FindFirstChildOfClass("DataModelMesh")
                                if mesh then
                                    mesh.MeshId = old
                                    mesh.TextureId = t:GetAttribute("SzpSkinOldTex") or ""
                                    fixed = fixed + 1
                                elseif h and h:IsA("MeshPart") then
                                    h.MeshId = old
                                    fixed = fixed + 1
                                end
                            end
                            t:SetAttribute("SzpSkinOld", nil)
                            t:SetAttribute("SzpSkinOldTex", nil)
                            t:SetAttribute("SzpSkinMeshMade", nil)
                        end
                    end
                end
            end
        end
        skinStatus.Text = (fixed > 0) and ("Restored " .. tostring(fixed) .. " weapons.") or "Nothing to restore."
    end

    ------------------------------------------------------------
    -- GAME INVENTORY: the game builds its own frames through
    -- InventoryService:CreateItemFrame("Weapons", key, count) and drops them into
    -- Main.Weapons.Items.ItemList. We use the same module, so our
    -- entry looks exactly like a real one (rbxthumb icon, rarity color,
    -- layout). This only adds GUI on your side - ZERO remotes.
    ------------------------------------------------------------
    local function gameInv()
        local pg = plr:FindFirstChildOfClass("PlayerGui")
        local gui = pg and pg:FindFirstChild("MainGUI")
        local g = gui and gui:FindFirstChild("Game")
        local inv = g and g:FindFirstChild("Inventory2")
        local main = inv and inv:FindFirstChild("Main")
        local w = main and main:FindFirstChild("Weapons")
        local items = w and w:FindFirstChild("Items")
        local list = items and items:FindFirstChild("ItemList")
        local tabs = items and items:FindFirstChild("Tabs")
        local s = tabs and tabs:FindFirstChild("Search")
        s = s and s:FindFirstChild("Container")
        s = s and s:FindFirstChild("SearchText")
        -- we return the whole visibility chain at once: after a respawn the game can
        -- fail to finish its own initialization and leave the Weapons panel HIDDEN,
        -- which makes our correctly inserted frame invisible anyway
        return list, tabs, s, { inv2 = inv, main = main, weapons = w, items = items }
    end

    -- MM2 can have its own inventory script DISABLED (Disabled=true).
    -- Then the game never builds its frames: the list keeps only the
    -- "Loading..." placeholder, the Weapons panel stays hidden, and our
    -- correctly inserted frame is invisible anyway - hence the fake "OK".
    -- Enabling it only restores the game's normal UI (client-side).
    -- The whole helper block lives in the szpInv table instead of separate
    -- local variables: the whole script is ONE function with a limit of 200
    -- local variables, and every few new locals could push it past
    -- that limit (error "Out of local registers").
    local szpInv = {}
    szpInv.spawned = {}

    szpInv.ensureScript = function()
        local pg = plr:FindFirstChildOfClass("PlayerGui")
        local gui = pg and pg:FindFirstChild("MainGUI")
        local ls = gui and gui:FindFirstChild("Inventory2")
        if ls and ls:IsA("LocalScript") and ls.Disabled then
            pcall(function() ls.Disabled = false end)
            return true
        end
        return false
    end

    -- reveals exactly what the game reveals in SwitchInventoryTab("Weapons")
    szpInv.showPanel = function()
        local _, _, _, chain = gameInv()
        if not (chain and chain.inv2 and chain.main and chain.weapons and chain.items) then
            return false
        end
        pcall(function()
            for _, c in ipairs(chain.main:GetChildren()) do
                if c:IsA("GuiObject") then c.Visible = (c.Name == "Weapons") end
            end
            chain.items.Visible = true
            chain.weapons.Visible = true
            chain.main.Visible = true
            chain.inv2.Visible = true
        end)
        -- while at it: repaint the tiles the game had turned into "Error" before the patch
        pcall(function() szpInv.fixErrorFrames() end)
        return true
    end

    -- whether the frame IS visible (we check all parents, not just its own
    -- flag - it is the panel's parent that is often hidden, and "OK" was true
    -- only on paper)
    szpInv.frameVisible = function(fr)
        local p = fr
        while p and p:IsA("GuiObject") do
            if not p.Visible then return false end
            p = p.Parent
        end
        return p ~= nil
    end

    -- FIXING "Error" TILES IN THE GAME INVENTORY.
    -- The game itself has the argument order wrong: AddItem calls
    -- CreateItemFrame("Weapons", "DefaultKnife") - which goes into
    -- GetItemInfo("Weapons", "DefaultKnife"), and that reads Sync[2][1], i.e.
    -- Sync["DefaultKnife"]["Weapons"] - nil - warn + Materials.ErrorItem,
    -- i.e. an "Error" tile. It is enough to swap the arguments once in the module
    -- (the module is shared by all requires, so the patch also works
    -- for the game's own code) and the inventory goes back to normal.
    szpInv.patchItemService = function()
        local RS = game:GetService("ReplicatedStorage")
        -- 5 s timeout + require inside pcall: an unbounded WaitForChild
        -- would hang forever, and its result is evaluated BEFORE the pcall
        local okIS, IS = pcall(function()
            return require(RS:WaitForChild("ClientServices", 5):WaitForChild("ItemService", 5))
        end)
        if not okIS or type(IS) ~= "table" or IS.__SzpFixed then return false end
        local okSync, Sync = pcall(function()
            return require(RS:WaitForChild("Database", 5):WaitForChild("Sync", 5))
        end)
        if not okSync or type(Sync) ~= "table" then return false end
        local function fix(fn)
            if type(fn) ~= "function" then return fn end
            return function(self, a, b)
                -- Sync[x] exists only for TYPES (Weapons/Guns/Effects...),
                -- so that is how we tell which argument is which
                local aTyp = (type(a) == "string") and (Sync[a] ~= nil)
                local bTyp = (type(b) == "string") and (Sync[b] ~= nil)
                if aTyp and not bTyp then
                    return fn(self, b, a)
                end
                return fn(self, a, b)
            end
        end
        IS.GetItemInfo = fix(IS.GetItemInfo)
        IS.FindItemInfo = fix(IS.FindItemInfo)
        IS.__SzpFixed = true
        return true
    end
    -- right at startup: the game inventory should never show "Error" tiles
    szpInv.patchItemService()

    -- HOLD IN HAND (local only).
    -- ReplicatedStorage has NO Tool templates (the server clones weapons),
    -- so we clone the weapon you already hold (or someone else's from Workspace as a
    -- geometry template), swap the mesh to the chosen skin and put it in your hand.
    -- Weapon scripts are silenced so the game does not fire remotes from our
    -- fake Tool. The whole thing is visible only to you.
    szpInv.holdInHand = function(entry)
        if not entry then return false, "select an item first" end
        if not entry.id then return false, "item has no asset ID" end
        szpInv.patchItemService()
        local ch = plr.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if not hum then return false, "no character" end
        local bp = plr:FindFirstChildOfClass("Backpack")
        if not bp then return false, "no Backpack" end

        -- we clean up the previous local weapon so tools do not multiply
        -- with every skin change (the server does not know, this is our GUI)
        for _, cont in ipairs({ ch, bp }) do
            for _, t in ipairs(cont:GetChildren()) do
                if t:IsA("Tool") and t:GetAttribute("SzpLocalSkin") then
                    pcall(function() t:Destroy() end)
                end
            end
        end

        local function isSlot(t, pat)
            if not (t and t:IsA("Tool")) then return false end
            local n = t.Name:lower()
            for _, p in ipairs(pat) do
                if n:find(p) then return true end
            end
            return false
        end
        local pat = (entry.slot == "Gun")
            and { "gun", "revolver", "pistol" }
            or  { "knife", "blade" }

        -- 1) TRUTH FIRST: we put the skin on YOUR real weapon.
        --    Cloning your own Tool ALWAYS lost against the game:
        --    at round start it equips its own weapon, so ours landed
        --    back in the backpack - hence the "invisible item in hand".
        --    The real weapon is given by the server, so nobody takes it away,
        --    and it still shoots/stabs as usual.
        local real = ch:FindFirstChildOfClass("Tool")
        if not (real and isSlot(real, pat)) then
            real = nil
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and not t:GetAttribute("SzpLocalSkin") and isSlot(t, pat) then
                    real = t
                    break
                end
            end
        end
        if real then
            local ok, err = applySkinToTool(real, entry)
            if not ok then return false, err end
            if real.Parent ~= ch then
                pcall(function() hum:EquipTool(real) end)
            end
            return true, tostring(entry.name) .. " on your weapon (" .. real.Name
                .. ") - only you see it"
        end

        -- 2) YOU HAVE NO WEAPON (usually Innocent) - then we build our own
        --    Tool. Nothing takes it from you here, so it can safely stay
        --    in your hand until the round ends.
        local pat2 = pat
        local template = nil
        for _, other in ipairs(game:GetService("Players"):GetPlayers()) do
            if other ~= plr then
                local oc = other.Character
                local ot = oc and oc:FindFirstChildOfClass("Tool")
                if isSlot(ot, pat2) then template = ot break end
                local ob = other:FindFirstChildOfClass("Backpack")
                if ob then
                    for _, t in ipairs(ob:GetChildren()) do
                        if isSlot(t, pat2) then template = t break end
                    end
                end
                if template then break end
            end
        end

        local tool
        if template then
            -- cloning someone else's weapon = correct geometry and grip;
            -- weapon logic is silenced because shooting/stabbing are server remotes
            tool = template:Clone()
            for _, d in ipairs(tool:GetDescendants()) do
                if d:IsA("BaseScript") then d:Destroy() end
            end
        else
            -- no template - we build the Tool from scratch
            tool = Instance.new("Tool")
            tool.RequiresHandle = true
            local h = Instance.new("Part")
            h.Name = "Handle"
            h.Size = (entry.slot == "Gun")
                and Vector3.new(0.6, 1.2, 2.0)
                or Vector3.new(0.4, 0.4, 1.4)
            h.CanCollide = false
            h.Parent = tool
        end

        local handle = tool:FindFirstChild("Handle")
        if not handle then return false, "template has no Handle" end
        local mesh = handle:FindFirstChildOfClass("DataModelMesh")
        if not mesh then
            mesh = Instance.new("SpecialMesh")
            mesh.Parent = handle
        end
        mesh.MeshId = "http://www.roblox.com/asset/?id=" .. tostring(entry.id)
        mesh.TextureId = ""   -- the mesh itself carries the texture (like MM2 knives)

        tool.Name = tostring(entry.name)
        tool.CanBeDropped = false
        tool:SetAttribute("SzpLocalSkin", tostring(entry.key))
        tool.Parent = bp
        hum:EquipTool(tool)

        -- we watch so the game does not push the tool back into the backpack;
        -- the loop stops immediately once SOMETHING ELSE appears in hand -
        -- we never take your real weapon away
        task.spawn(function()
            if not isCurrentGen() then return end
            while tool.Parent and tool:GetAttribute("SzpLocalSkin") and ch.Parent do
                task.wait(0.5)
                if tool.Parent == bp then
                    if ch:FindFirstChildOfClass("Tool") then break end
                    pcall(function() hum:EquipTool(tool) end)
                end
            end
        end)
        return true, tostring(entry.name) .. " in hand (only you)"
    end

    -- FIXING ALREADY EXISTING "Error" TILES.
    -- After the patch the game builds the inventory correctly on the next respawn,
    -- but the ones created BEFORE the patch still contain ErrorItem. They must not be
    -- destroyed (the game keeps them in its Frames table and its filter would break)
    -- - we repaint them in place. We recognize the game's tiles by
    -- LayoutOrder, because GetLayoutOrder returns 0=DefaultKnife, 1=DefaultGun.
    szpInv.fixErrorFrames = function()
        szpInv.patchItemService()
        local list = gameInv()
        if not list then return 0 end
        local RS = game:GetService("ReplicatedStorage")
        local okIS, ItemSvc = pcall(function()
            return require(RS:WaitForChild("ClientServices", 5):WaitForChild("ItemService", 5))
        end)
        if not okIS or type(ItemSvc) ~= "table" then return 0 end
        local fixed = 0
        for _, c in ipairs(list:GetChildren()) do
            if c:IsA("GuiObject") and not c.Name:find("SzpHub_", 1, true) then
                local lbl = c:FindFirstChild("ItemName", true)
                lbl = lbl and lbl:FindFirstChild("Label")
                if lbl and lbl.Text == "Error" then
                    local key
                    if c.LayoutOrder == 0 then key = "DefaultKnife"
                    elseif c.LayoutOrder == 1 then key = "DefaultGun" end
                    if key then
                        local ok, info = pcall(function() return ItemSvc:GetItemInfo("Weapons", key) end)
                        if ok and type(info) == "table" then
                            pcall(function() ItemSvc:ApplyItemToFrame(c, info, 1) end)
                            pcall(function() ItemSvc:ApplyTags(c, info) end)
                            fixed = fixed + 1
                        end
                    end
                end
            end
        end
        return fixed
    end
    -- we repaint the tiles broken BEFORE the patch (at startup and on every
    -- inventory open - after a respawn the game builds them correctly anyway)
    szpInv.fixErrorFrames()

    -- clicking a tile in the game inventory = we pick it up (locally).
    szpInv.wireFrame = function(frame, entry)
        local cont = frame and frame:FindFirstChild("Container")
        local ab = cont and cont:FindFirstChild("ActionButton")
