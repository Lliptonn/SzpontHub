-- FIXING THE "ERROR" IN THE GAME INVENTORY - right after injection, before anyone
-- opens the menu. The game itself has an argument order bug: AddItem calls
-- CreateItemFrame("Weapons", "DefaultKnife"), and that lands in
-- GetItemInfo("Weapons", "DefaultKnife"), which reads Sync[2][1], that is
-- Sync["DefaultKnife"]["Weapons"] -> nil -> warn + Materials.ErrorItem,
-- hence the "Error" tiles. The ItemService module is shared by all
-- requires, so ONE function replacement fixes the game inventory for good.
-- Entirely client-side: we touch no remotes and no server data.
------------------------------------------------------------
do
    local RS = game:GetService("ReplicatedStorage")
    -- WAITFORCHILD WITH A TIME LIMIT - NEVER without it!
    -- ClientServices/ItemService is an MM2-ONLY structure. In BloxStrike,
    -- Rivals and Fisch those folders do not exist, and WaitForChild without the
    -- second argument waits forever. Worse, pcall arguments are evaluated
    -- BEFORE the call, so this pcall does NOT protect - the script started
    -- (two prints in the console), hung here for good and the GUI never
    -- appeared. Symptom: "inject works in MM2, not in BloxStrike".
    -- Now: missing folder = we skip the inventory fix and move on.
    local CS = RS:WaitForChild("ClientServices", 3)
    local ISmod = CS and CS:WaitForChild("ItemService", 3)
    if ISmod then
        local okIS, IS = pcall(require, ISmod)
        if okIS and type(IS) == "table" and not IS.__SzpFixed then
            local DB = RS:WaitForChild("Database", 3)
            local SyncMod = DB and DB:WaitForChild("Sync", 3)
            local okSync, Sync = false, nil
            if SyncMod then okSync, Sync = pcall(require, SyncMod) end
            if okSync and type(Sync) == "table" then
                local function fix(fn)
                    if type(fn) ~= "function" then return fn end
                    return function(self, a, b)
                        -- Sync[x] exists only for TYPES (Weapons/Effects/...),
                        -- so this is how we tell which argument is which
                        local aTyp = (type(a) == "string") and (Sync[a] ~= nil)
                        local bTyp = (type(b) == "string") and (Sync[b] ~= nil)
                        if aTyp and not bTyp then
                            return fn(self, b, a)
                        end
                        return fn(self, a, b)
                    end
                end
                IS.GetItemInfo = fix(IS.GetItemInfo)
                IS.FindItemInfo = fix(IS.FindItemInfo)
                IS.__SzpFixed = true
            end
        end
    end
end

