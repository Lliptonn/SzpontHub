    local function paintTheme()
        local t = themes[currentTheme]
        local primary = t.Primary

        mainFrame.BackgroundColor3 = t.Dark
        mainFrame.BorderColor3 = primary
        title.TextColor3 = Color3.fromRGB(250, 250, 250)
        -- linia akcentu pod tytułem (animowana razem z motywem)
