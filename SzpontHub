-- NAPRAWA „ERROR" W EKWIPUNKU GRY — od razu po injekcji, zanim ktokolwiek
-- wejdzie w menu. Gra sama ma błąd kolejności argumentów: AddItem woła
-- CreateItemFrame("Weapons", "DefaultKnife"), a to trafia do
-- GetItemInfo("Weapons", "DefaultKnife"), który czyta Sync[2][1], czyli
-- Sync["DefaultKnife"]["Weapons"] → nil → warn + Materials.ErrorItem,
-- stąd kafelki "Error". Moduł ItemService jest wspólny dla wszystkich
-- require'ów, więc JEDNA podmiana funkcji naprawia ekwipunek gry na stałe.
-- Całość client-side: nie ruszamy remoteów ani danych serwera.
------------------------------------------------------------
do
    local RS = game:GetService("ReplicatedStorage")
    -- WAITFORCHILD Z LIMITEM CZASU — NIGDY bez niego!
    -- ClientServices/ItemService to struktura TYLKO MM2. W BloxStrike,
    -- Rivals i Fisch tych folderów nie ma, a WaitForChild bez drugiego
    -- argumentu czeka w nieskończoność. Co gorsza argumenty pcall liczą
    -- się PRZED wywołaniem, więc ten pcall NIE chronił — skrypt startował
    -- (dwa printy w konsoli), wieszał się tu na amen i GUI nigdy nie
    -- powstawało. Objaw: "w MM2 inject działa, w BloxStrike nie".
    -- Teraz: brak folderu = pomijamy naprawę ekwipunku i lecimy dalej.
    local CS = RS:WaitForChild("ClientServices", 3)
    local ISmod = CS and CS:WaitForChild("ItemService", 3)
    if ISmod then
        local okIS, IS = pcall(require, ISmod)
        if okIS and type(IS) == "table" and not IS.__SzpFixed then
            local DB = RS:WaitForChild("Database", 3)
            local SyncMod = DB and DB:WaitForChild("Sync", 3)
            local okSync, Sync = false, nil
            if SyncMod then okSync, Sync = pcall(require, SyncMod) end
            if okSync and type(Sync) == "table" then
                local function fix(fn)
                    if type(fn) ~= "function" then return fn end
                    return function(self, a, b)
                        -- Sync[x] istnieje tylko dla TYPÓW (Weapons/Effects/...),
                        -- więc po tym poznajemy, który argument jest czym
                        local aTyp = (type(a) == "string") and (Sync[a] ~= nil)
                        local bTyp = (type(b) == "string") and (Sync[b] ~= nil)
                        if aTyp and not bTyp then
                            return fn(self, b, a)
                        end
                        return fn(self, a, b)
                    end
                end
                IS.GetItemInfo = fix(IS.GetItemInfo)
                IS.FindItemInfo = fix(IS.FindItemInfo)
                IS.__SzpFixed = true
            end
        end
    end
end

