    -- TPS camera application with TWO anchors: bind at the LATEST render stage
    -- + a RenderStepped connection (the game hooked its own earlier, so ours
    -- added later  runs after them). We take the direction from the current
    -- game camera (the mouse already rotated the default module), so the view reacts to the mouse,
    -- and shots (ray from the camera CFrame) go exactly where the crosshair looks.
    local function tpApply()
        if not thirdPerson then return end
        if not isCurrentGen() then return end
        -- The whole body inside a pcall + codes on the button: no stop reason is silent.
        -- BloxStrike has its OWN characters (no Humanoid)  we take viability
        -- from the Dead attribute like the game does, not from Health.
        local ok, code, visN, totN = pcall(function()
            if not tpBindOK then return "NOBIND:" .. tpBindErr end
            local ch = plr.Character
            if not ch then return "NOCHAR" end
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            if not hrp then return "NOHRP" end
            if ch:GetAttribute("Dead") then return "DEAD" end
            local cam = workspace.CurrentCamera
            if not cam then return "NOCAM" end
            if cam.CameraType ~= Enum.CameraType.Scriptable then
                cam.CameraType = Enum.CameraType.Scriptable
            end
            -- Viewmodel (hands + gun in camera) invisible in TPS  just like
            -- the game in spectate: cache the original transparency and set 1
            -- (this also catches new models after a weapon switch, because of the per-frame scan)
            for _, m in ipairs(cam:GetChildren()) do
                if m:IsA("Model") then
                    for _, v in ipairs(m:GetDescendants()) do
                        if (v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture")) and vmCache[v] == nil then
                            vmCache[v] = v.Transparency
                            v.Transparency = 1
                        end
                    end
                end
            end
            -- Character: the game hides its own body in FPS  in TPS we force visibility
            -- of parts (cache + restore like the viewmodel; except HumanoidRootPart,
            -- which is invisible by nature). Body counter on the button.
            -- Fallback: if the visual body were in a separate model (custom
            -- BS characters), we take workspace[Nick] with its own HRP.
            local vis, total = 0, 0
            local function showBody(root)
                for _, bp in ipairs(root:GetDescendants()) do
                    if bp:IsA("BasePart") and bp.Name ~= "HumanoidRootPart" then
                        total = total + 1
                        if bp.Transparency >= 1 then
                            if bodyCache[bp] == nil then bodyCache[bp] = bp.Transparency end
                            bp.Transparency = 0
                        else
                            vis = vis + 1
                        end
                    end
                end
            end
            showBody(ch)
            if total == 0 then
                local alt = workspace:FindFirstChild(plr.Name)
                if alt and alt ~= ch and alt:IsA("Model") then
                    local ahrp = alt:FindFirstChild("HumanoidRootPart")
                    if ahrp then
                        hrp = ahrp
                        showBody(alt)
                    end
                end
            end
            if total == 0 then return "NOBODY" end
            local focus = hrp.Position + Vector3.new(0, 2.2, 0)
            local look = cam.CFrame.LookVector
            -- Camera ABOVE the character: back + up, looking at it from above
            local pos = focus - look * tpDist + Vector3.new(0, tpDist * 0.4, 0)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { ch }
            local res = workspace:Raycast(focus, pos - focus, params)
            if res and not res.Instance:IsDescendantOf(cam) and (focus - res.Position).Magnitude > 0.01 then
                pos = res.Position + (focus - res.Position).Unit * 0.5
            end
            cam.CFrame = CFrame.lookAt(pos, focus)
            cam.Focus = CFrame.new(focus)
            return "OK", vis, total
