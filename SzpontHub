    -- AUTO REVOLVER  plain silent aim, but it only fires while
    -- holding the revolver (ShootingOptions == "Revolver" = R8) and only
    -- through the game's RMB: LMB = startRevolverCharge (cylinder spin,
    -- not that), RMB = startRevolverSecondaryFire (quick shot  that is how
    -- the revolver is shot). With no other silent aim flag we do not fire other
    -- weapons (revolver-only mode); with Silent Aim/Wallbang/TP Shot the
    -- regular fireWeapon works too. No auto-equip  the R8 must be in hand.
    local bAR = createButton("Auto Revolver: OFF", 15, "RageBot")
    bAR.MouseButton1Click:Connect(function()
        local on = not G.__liptonAutoRevolver
        G.__liptonAutoRevolver = on
        bAR.Text = on and "Auto Revolver: ON" or "Auto Revolver: OFF"
        bAR.BackgroundColor3 = on and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
        updateActiveCheatsList()
    end)

    -- DOUBLE TRAP  a second shot in the same activation, OUTSIDE THE WEAPON'S
    -- COOLDOWN (no waiting for FireRate)  the pair goes out in a single frame.
    -- Target for the second shot: FIRST another exposed enemy (if two are
    -- peeking  one bullet each); when there is no second target  repeat
    -- on the first one (finish off after a miss / a shot beside them). Nobody
    -- exposed = no shot goes out (zero blind fire).
    -- Works on the LMB path (SA/WB/DT alone); R8+Auto Revolver gets its
    -- own RMB pair (revolverDouble), TP blinks have their own dosage.
    local bDT = createButton("Double Tap: OFF", 16, "RageBot")
    bDT.MouseButton1Click:Connect(function()
        local on = not G.__liptonDoubleTap
        G.__liptonDoubleTap = on
        bDT.Text = on and "Double Tap: ON" or "Double Tap: OFF"
        bDT.BackgroundColor3 = on and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
        updateActiveCheatsList()
    end)

    -- A part is exposed when the bullet ray hits IT first
    -- (the game skips accessories and capsules, so a hat cannot block a headshot)
    -- INDEPENDENT wall check: vanilla workspace:Raycast (independent of
    -- the game's Shared.Raycast). We treat a target as visible only when the ray hits
    -- NOTHING or the target's OWN body (the torso while aiming at the head is not
    -- a wall); anything else in the way = covered  we skip the target.
    local function clearOfWalls(origin, part, targetChar, ignoreList)
        local toPart = part.Position - origin
        if toPart.Magnitude < 0.5 then return false end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local list = {}
        if plr.Character then insertT(list, plr.Character) end
        local camNow = workspace.CurrentCamera
        if camNow then
            for _, m in ipairs(camNow:GetChildren()) do insertT(list, m) end
        end
        if ignoreList then
            for _, e in ipairs(ignoreList) do insertT(list, e) end
        end
        params.FilterDescendantsInstances = list
        local res = workspace:Raycast(origin, toPart, params)
        if res == nil then return true end
        if targetChar and res.Instance:IsDescendantOf(targetChar) then return true end
        return false
    end

    local function partExposed(origin, part, ignoreList)
        local toPart = part.Position - origin
        if toPart.Magnitude < 0.5 then
            return false
        end
        local res = RaycastLib.cast(origin, toPart, nil, ignoreList)
        return res.instance == nil or res.instance == part
    end

    -- Head aim point: center, 6 faces and 8 CORNERS of the box (15 points,
    -- in the part's space  the head rotates together with the character). Every point
    -- is checked separately with a ray, so the expander's enlarged hitbox gets
    -- hit even when only an edge or corner sticks out while the center lies behind
    -- a wall. A shot NEVER goes through a wall  proven for
    -- exactly that point (the ray hits nothing or that very head).
    local function headAimPoint(origin, head, ignoreList)
        local hp = head.Position
        local hs = head.Size * 0.5
        local cf = head.CFrame
        local ox = cf.RightVector * hs.X
        local oy = cf.UpVector * hs.Y
        local oz = cf.LookVector * hs.Z
        local pts = {
            hp,
            hp + ox, hp - ox,
            hp + oy, hp - oy,
            hp + oz, hp - oz,
            hp + ox + oy + oz, hp + ox + oy - oz,
            hp + ox - oy + oz, hp + ox - oy - oz,
            hp - ox + oy + oz, hp - ox + oy - oz,
            hp - ox - oy + oz, hp - ox - oy - oz,
        }
        for i = 1, 15 do
            local pt = pts[i]
            local toPt = pt - origin
            if toPt.Magnitude >= 0.5 then
                local res = RaycastLib.cast(origin, toPt, nil, ignoreList)
                if res.instance == nil or res.instance == head then
                    return pt
                end
            end
        end
        return nil
    end

    -- Returns the part the bullet should fly to, or nil
    -- onlyChar / skipChar: Double Tap asks twice  "is ANYONE ELSE
    -- exposed?" (skipChar = we skip the first target) and "is A still
    -- exposed?" (onlyChar = only the first target). The rest of the phases (wallbang /
    -- visibility) are unchanged.
    local function findSilentTarget(origin, ignoreList, maxDist, onlyChar, skipChar)
        local enemies = {}
        for _, p in ipairs_(Players_svc:GetPlayers()) do
            if p ~= plr and isEnemy(p) then
                local ch = p.Character
                if ch and (onlyChar == nil or ch == onlyChar) and (skipChar == nil or ch ~= skipChar) and isAliveTarget(p, ch) then
                    local hrp = ch:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d = (hrp.Position - origin).Magnitude
                        if d <= maxDist then
                            local head, others = nil, {}
                            for _, bp in ipairs_(ch:GetDescendants()) do
                                if bp:IsA("BasePart") and bp.Name ~= "HumanoidRootPart" and bp.Transparency < 1 and not bp:FindFirstAncestorOfClass("Accessory") then
                                    if bp.Name == "Head" then
                                        head = bp
                                    else
                                        insertT(others, bp)
                                    end
                                end
                            end
                            insertT(enemies, {ch, d, head, others})
                        end
                    end
                end
            end
        end
        sortT(enemies, function(a, b) return a[2] < b[2] end)
        -- WALLBANG / TP SHOT / AUTO KNIFE: a target behind cover is allowed too
        -- we take the nearest enemy that has a head (head center; priority as
        -- in Phase1) or a torso. NO visibility tests (headAimPoint/
        -- clearOfWalls)  the ray is meant to go through the wall. The
        -- isEnemy/isAliveTarget filters stay. Silent Aim alone = visible only.
        if throughWalls() then
            for _, e in ipairs_(enemies) do
                if e[3] then
                    return e[3], e[3].Position
                end
            end
            for _, e in ipairs_(enemies) do
                local bp = e[4][1]
                if bp then
                    return bp, bp.Position
                end
            end
        end
        -- Phase1: the head hitbox (puffed up by the expander) HAS priority
        -- no gate on the box center, because the center often lies behind a wall
        -- while an edge or corner is already sticking out. Every point from headAimPoint is
        -- checked individually by a ray, so a shot only goes out at
        -- the exposed piece  never through a wall.
        for _, e in ipairs_(enemies) do
            if e[3] then
                local aim = headAimPoint(origin, e[3], ignoreList)
                if aim then
                    return e[3], aim
                end
            end
        end
        -- Phase2: nobody exposes a head -> any exposed part
        for _, e in ipairs_(enemies) do
            for _, bp in ipairs_(e[4]) do
                if clearOfWalls(origin, bp, e[1], ignoreList) and partExposed(origin, bp, ignoreList) then
                    return bp, bp.Position
                end
            end
        end
        return nil
    end

    -- Redirect of one bullet: Direction + hit rebuild the way the game does
    local function doRedirect(wself, b)
        if not (RaycastLib and GetRayIgnore) then
            return
        end
        local pr = wself.Properties
        if not pr or pr.Class ~= "Weapon" then
            return
        end
        local origin = b.Origin
        if not origin then
            return
        end
        local range = pr.Range or 500
        G.__liptonLastRange = range
        local ignoreList = GetRayIgnore()
        local part, aim
        if redirectTarget then
            -- DOUBLE TRAP: forced target for the second shot (repeat on A
            -- or B if A went down)  no re-rolling to the nearest enemy.
            part, aim = redirectTarget, redirectAim
        else
            part, aim = findSilentTarget(origin, ignoreList, range)
        end
        if not part then
            return
        end
        local dir = (aim or part.Position) - origin
        if dir.Magnitude < 0.5 then
            return
        end
        local unit = dir.Unit
        local hit = RaycastLib.cast(origin, unit * range, nil, ignoreList)
        b.Direction = unit
        if hit.instance then
            local wb = G.__liptonWallbang == true
            local toAim = (aim - origin).Magnitude
            if wb then
                b.Distance = toAim
            else
                b.Distance = (hit.position - origin).Magnitude
            end
            local pen = pr.Penetration or 0
            local reach, budget
            if wb then
                reach = toAim + 4
                budget = 1e9
            else
                reach = pen + 0.001
                budget = pen
            end
            local through = RaycastLib.castThrough(hit.position - unit * 0.001, unit * reach, budget, ignoreList)
            b.Hits = {}
            for i, h in ipairs_(through) do
                if h.instance and h.material then
                    insertT(b.Hits, {
                        Position = h.position,
                        Instance = h.instance,
                        Material = h.material.Name,
                        Normal = h.normal or v3zero,
                        Exit = i % 2 == 0
                    })
                end
            end
            if wb then
                -- Cut the pass-through behind the target's body: the loop ends on a hit
                -- into nothing or after 100 iterations, so room/terrain surfaces may remain
                -- behind the enemy  the packet must end on the enter/exit
                -- pair of the TARGET (like vanilla with the weapon's budget).
                local tmodel = part:FindFirstAncestorWhichIsA("Model")
                if tmodel then
                    for i, hh in ipairs_(b.Hits) do
                        if hh.Instance and hh.Instance:IsDescendantOf(tmodel) then
                            local keep = i + 1
                            if keep > #b.Hits then
                                keep = #b.Hits
                            end
                            for j = #b.Hits, keep + 1, -1 do
                                b.Hits[j] = nil
                            end
                            break
                        end
                    end
                end
            end
        else
            b.Distance = range
            b.Hits = {}
        end
    end

    -- Wrapper install on the Bullet class module (re-execution safe):
    -- the wrap version is kept in __liptonWrappedVer  if an OLD wrapper
    -- is already in the game (e.g. from a previous file version), we stack the new one ON
    -- TOP of the old one: the old redirect fires first, ours SECOND and overwrites
    -- the result  the newest code always applies. On the same version we do
    -- not duplicate the chain. Toggle state lives in the shared _G.
    local WRAP_VER = "wb1"
    if BulletClass and BulletClass.__liptonWrappedVer ~= WRAP_VER then
        local origCreate = BulletClass.create
        local wrapper = function(wself, ao, ia)
            local b = origCreate(wself, ao, ia)
            if b and silentAny() then
                pcall_(doRedirect, wself, b)
            end
            return b
        end
        local okEnv = pcall(function()
            setfenv(wrapper, {})
            setfenv(doRedirect, {})
            setfenv(findSilentTarget, {})
            setfenv(partExposed, {})
            setfenv(headAimPoint, {})
            setfenv(silentAny, {})
            setfenv(throughWalls, {})
            for _, f in ipairs({wrapper, doRedirect, findSilentTarget, partExposed, headAimPoint, silentAny, throughWalls}) do
                local e = getfenv(f)
                if e.getgenv or e.hookfunction then
                    error("dirty env")
                end
            end
        end)
        if okEnv then
            pcall(function()
                BulletClass.create = wrapper
                BulletClass.__liptonWrapped = true
                BulletClass.__liptonWrappedVer = WRAP_VER
            end)
        else
            warn("[SzpontHub] BS Silent Aim: env check rejected  bullet wrapper NOT installed")
        end
    end

    -- THIRD PERSON + camera distance slider from the character (Visuals)
    -- Camera placed manually in BindToRenderStep at priority Camera+100,
    -- i.e. AFTER the game's camera update  so it beats the default control. The ray from the character's back to the camera is cut off by a wall, the rotation
    -- comes from the HumanoidRootPart. With the flag off nothing is moved.
    local savedCamMode = nil
    local savedCamType = nil
    local tpBindOK = false
    local tpBindErr = ""
    local vmCache = {}
    local bodyCache = {}
    local bTP = createButton("Third Person: OFF", 17, "Visuals")
    local slTP = createSliderLabel("TP Distance: 10", 18, "Visuals")
    local sbTP, sfTP = createSliderBar(19, "Visuals")
    sfTP.Size = UDim2.new(0.2, 0, 1, 0)

    bTP.MouseButton1Click:Connect(function()
        local on = not thirdPerson
        thirdPerson = on
        bTP.Text = on and "Third Person: ON v7" or "Third Person: OFF"
        bTP.BackgroundColor3 = on and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
        pcall(function()
            local cam = workspace.CurrentCamera
            if on then
                savedCamMode = plr.CameraMode
                plr.CameraMode = Enum.CameraMode.Classic
                if cam then
                    savedCamType = cam.CameraType
                    cam.CameraType = Enum.CameraType.Scriptable
                end
            else
                if savedCamMode then plr.CameraMode = savedCamMode end
                savedCamMode = nil
                if cam and savedCamType then cam.CameraType = savedCamType end
                savedCamType = nil
                -- Restore viewmodel visibility (hands + weapon) from cache
                for part, t in pairs(vmCache) do
                    pcall(function() part.Transparency = t end)
                end
                table.clear(vmCache)
                -- Restore body visibility from cache
                for part, t in pairs(bodyCache) do
                    pcall(function() part.Transparency = t end)
                end
                table.clear(bodyCache)
            end
        end)
        updateActiveCheatsList()
    end)

    -- Distance slider: own connections, we do not interfere with the dragging* chain
    local draggingTP = false
    sbTP.MouseButton1Down:Connect(function() draggingTP = true end)
    uis.InputEnded:Connect(function(i)
        if not isCurrentGen() then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingTP = false
        end
    end)
    uis.InputChanged:Connect(function(i)
        if not isCurrentGen() then return end
        if draggingTP and i.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((i.Position.X - sbTP.AbsolutePosition.X) / sbTP.AbsoluteSize.X, 0, 1)
            sfTP.Size = UDim2.new(rel, 0, 1, 0)
            tpDist = math.floor(5 + rel * 25)
            slTP.Text = "TP Distance: " .. tpDist
            updateActiveCheatsList()
        end
    end)

    -- TPS camera application with TWO anchors: a bind on the LATEST render stage
    -- + a RenderStepped connection (the game hooked its own earlier, so ours, 
    -- added later, runs after them). We take the direction from the current game
    -- camera (the mouse has already rotated the default module), so the view reacts to the mouse,
    -- and shots (ray from the camera CFrame) fly exactly where the crosshair points.
    local function tpApply()
        if not isCurrentGen() then return end
        if not thirdPerson then return end
        -- Whole body inside a pcall + status codes on the button: no abort reason stays silent.
        -- BloxStrike has ITS OWN characters (no Humanoid)  we take the alive state
        -- from the Dead attribute the way the game does, not from Health.
        local ok, code, visN, totN = pcall(function()
            if not tpBindOK then return "NOBIND:" .. tpBindErr end
            local ch = plr.Character
            if not ch then return "NOCHAR" end
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            if not hrp then return "NOHRP" end
            if ch:GetAttribute("Dead") then return "DEAD" end
            local cam = workspace.CurrentCamera
            if not cam then return "NOCAM" end
            if cam.CameraType ~= Enum.CameraType.Scriptable then
                cam.CameraType = Enum.CameraType.Scriptable
            end
            -- Viewmodel (hands + weapon in the camera) invisible in TPS  same as
            -- the game in spectate: cache the original transparency and set 1
            -- (it also picks up new models after a weapon switch, since we scan every frame)
            for _, m in ipairs(cam:GetChildren()) do
                if m:IsA("Model") then
                    for _, v in ipairs(m:GetDescendants()) do
                        if (v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture")) and vmCache[v] == nil then
                            vmCache[v] = v.Transparency
                            v.Transparency = 1
                        end
                    end
                end
            end
            -- Character: the game hides its own body in FPS  in TPS we force the visibility
            -- of parts (cache + restore like the viewmodel; except HumanoidRootPart,
            -- which is invisible by nature). Body counter on the button.
            -- Fallback: if the visual body were in a separate model (custom
            -- BS characters), we take workspace[Nick] with its own HRP.
            local vis, total = 0, 0
            local function showBody(root)
                for _, bp in ipairs(root:GetDescendants()) do
                    if bp:IsA("BasePart") and bp.Name ~= "HumanoidRootPart" then
                        total = total + 1
                        if bp.Transparency >= 1 then
                            if bodyCache[bp] == nil then bodyCache[bp] = bp.Transparency end
                            bp.Transparency = 0
                        else
                            vis = vis + 1
                        end
                    end
                end
            end
            showBody(ch)
            if total == 0 then
                local alt = workspace:FindFirstChild(plr.Name)
                if alt and alt ~= ch and alt:IsA("Model") then
                    local ahrp = alt:FindFirstChild("HumanoidRootPart")
                    if ahrp then
                        hrp = ahrp
                        showBody(alt)
                    end
                end
            end
            if total == 0 then return "NOBODY" end
            local focus = hrp.Position + Vector3.new(0, 2.2, 0)
            local look = cam.CFrame.LookVector
            -- Camera ABOVE the character: back + up, looking down at them
            local pos = focus - look * tpDist + Vector3.new(0, tpDist * 0.4, 0)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { ch }
            local res = workspace:Raycast(focus, pos - focus, params)
            if res and not res.Instance:IsDescendantOf(cam) and (focus - res.Position).Magnitude > 0.01 then
                pos = res.Position + (focus - res.Position).Unit * 0.5
            end
            cam.CFrame = CFrame.lookAt(pos, focus)
            cam.Focus = CFrame.new(focus)
            return "OK", vis, total
        end)
        if not ok then
            bTP.Text = "TP ERR:" .. tostring(code):sub(1, 25)
            return
        end
        if code == "OK" then
            _G.__liptonTPFrames = (_G.__liptonTPFrames or 0) + 1
            bTP.Text = "TP v7 BODY " .. tostring(visN) .. "/" .. tostring(totN) .. " #" .. _G.__liptonTPFrames
        else
            bTP.Text = "TP v7 " .. tostring(code)
        end
    end

    -- Reset after a re-run: if the previous session left a hidden viewmodel,
    -- restore the game defaults (parts invisible: HumanoidRootPart/ViewmodelLight)
    pcall(function()
        local cam0 = workspace.CurrentCamera
        if cam0 then
            for _, m in ipairs(cam0:GetChildren()) do
                if m:IsA("Model") then
                    for _, v in ipairs(m:GetDescendants()) do
                        if v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture") then
                            if v.Name == "HumanoidRootPart" or v.Name == "ViewmodelLight" then
                                v.Transparency = 1
                            else
                                v.Transparency = 0
                            end
                        end
                    end
                end
            end
        end
    end)

    pcall(function() runService:UnbindToRenderStep("LiptonThirdPerson") end)
    local okB, errB = pcall(function()
        runService:BindToRenderStep("LiptonThirdPerson", Enum.RenderPriority.Camera.Value + 1000, tpApply)
    end)
    tpBindOK = okB
    if not okB then tpBindErr = tostring(errB):sub(1, 30) end
    runService.RenderStepped:Connect(tpApply)

    -- SILENT AIM AUTOFIRE (based on a triggerbot): when there is an exposed target,
    -- it fires directly with the InventoryController method w:shoot()  no GUI
    -- clicking, so the menu MAY stay open. The shot still goes through the
    -- bullet redirect (snap to the peeking head).
    -- Does not fire: chat focused, dead, no target.
    local InvCtl = nil
    pcall(function()
        InvCtl = require(game:GetService("ReplicatedStorage").Controllers.InventoryController)
    end)

    if not InvCtl then
        warn("[SzpontHub] BS Silent Aim: InventoryController unavailable  autofire will not run (manual shots still redirected)")
    end
    local ws = workspace
    local tick_ = tick
    local trigClean = false
    local function fireWeapon(w)
        if InvCtl == nil then return end
        if w == nil then return end
        local pr = w.Properties
        if not pr or pr.Class ~= "Weapon" then return end
        w:shoot()
    end
    local lastTrig = 0
    local lastSt = ""
    local function setSt(s)
        if s ~= lastSt then
            lastSt = s
            -- Writing to the GUI from the Heartbeat thread may not have the Plugin
            -- capability (executor)  pcall so it does not spam errors; the shots go first.
            pcall(function() bSilent.Text = s end)
        end
    end

    -- TP SHOT  EXECUTION BLINK (helper; it joins the setfenv list next to the others,
    -- so its whole environment is locals as upvalues). Works ONLY when
    -- Silent Aim + Wallbang are ON (then findSilentTarget reaches for a target behind
    -- cover) and the chosen target is genuinely covered. Flow: save the
    -- position  teleport ~3 studs from the victim (behind her back from our side, at
    -- torso height) 0.05 s for the position to replicate  FORCED camera
    -- on the victim's point (packet Origin = camera ViewportPointToRay; without the ~0.06 s the camera would still fly from the old place,
    -- while the server computes the ray from Origin)  shot (target = head, no wall 
    -- full damage, AK143 = oneshot) 0.05 s to process the packet 
    -- return. Window ~0.1 s: other players MAY see the intermediate position
    -- (replication ~20-60 Hz)  no guarantee of invisibility; the server
    -- may kick for a big position jump  which is why we test first.
    -- Returns true = blink executed (we skip the regular shot from range).
    local taskWait = task.wait
    local cfLookAt = CFrame.lookAt
    local v3new = Vector3.new
    local tonumber_ = tonumber
    local tostring_ = tostring
    local tpBusy = false
    -- Blink stats (read: _G.__liptonTPStat)  measure whether the blink
    -- even fires and where it possibly stops (err = last reason).
    local tpStat = { try = 0, vis = 0, blink = 0, ok = 0, fail = 0, shots = 0, err = "" }
    G.__liptonTPStat = tpStat
    -- Auto Revolver stats (read: _G.__liptonRevStat) + constants
    -- captured as locals: revolverShot gets an empty env through
    -- setfenv, so Enum/Vector2 must be upvalues, not globals.
    local revStat = { shot = 0, err = "" }
    G.__liptonRevStat = revStat
    local lastRevShot = 0
    local utMouseButton2 = Enum.UserInputType.MouseButton2
    local v2new = Vector2.new
    local function tpShotBlink(part, w)
        tpStat.blink = tpStat.blink + 1
        if tpBusy then tpStat.err = "busy" return false end
        local ch = plr.Character
        if not ch or ch:GetAttribute("Dead") then tpStat.err = "dead" return false end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then tpStat.err = "nohrp" return false end
        local saved = hrp.CFrame
        local tpos = part.Position
        -- Anchor = the victim's torso (we stand on the floor next to her, not at
        -- head height); no root  the target point itself.
        local vch = part:FindFirstAncestorWhichIsA("Model")
        local vroot = vch and vch:FindFirstChild("HumanoidRootPart")
        local anchor = vroot and vroot.Position or tpos
        -- Direction: from the victim toward our old spot (we stand
        -- behind her back from our side, at least 3 studs  not inside her).
        local d = saved.Position - anchor
        local h = v3new(d.X, 0, d.Z)
        if h.Magnitude < 1 then h = v3new(0, 0, -3) end
        h = h.Unit
        local dest = anchor + h * 3
        tpBusy = true
        local ok, err = pcall_(function()
            hrp.CFrame = cfLookAt(dest, tpos)
            taskWait(0.05)
            local cam = ws.CurrentCamera
            if cam then cam.CFrame = cfLookAt(dest, tpos) end
            fireWeapon(w)
            tpStat.shots = tpStat.shots + 1
            -- SECOND DOSE at the weapon's cadence (Negev FireRate = 0.075 s):
            -- a 115 head with helmet (ArmorPen 0.75  ~86) does NOT kill in one
            -- shot  a second head inside the blink window guarantees the oneshot.
            -- Slow weapons (interval > 0.12 s, e.g. AWP) are skipped  their head
            -- kills anyway, and waiting would stretch the blink window. The interval
            -- = FireRate = the same cadence as a shot from the hands, so
            -- the server sees no accelerated fire.
            local fr = 0.075
            pcall_(function() fr = tonumber_(w.Properties.FireRate) or fr end)
            if fr + 0.01 <= 0.12 then
                taskWait(fr + 0.01)
                if cam then cam.CFrame = cfLookAt(dest, tpos) end
                fireWeapon(w)
                tpStat.shots = tpStat.shots + 1
            end
            taskWait(0.05)
        end)
        pcall_(function()
            hrp.CFrame = saved
        end)
        tpBusy = false
        if ok then
            tpStat.ok = tpStat.ok + 1
        else
            tpStat.fail = tpStat.fail + 1
            tpStat.err = tostring_(err)
        end
        return ok
    end

    -- AUTO KNIFE  forced knife equipping: equip(slot, index) has the game
    -- itself send WeaponEquipped to the server. Knife loadout index = the first
    -- key of the "Melee" slot (default 1); on a problem the trigger retries
    -- (self-heal). pairs_ as a local, because the helper has an empty environment.
    local pairs_ = pairs
    local function equipKnife()
        pcall_(function()
            local inv = InvCtl.getCurrentInventory()
            local slotT = inv and inv.Melee
            local items = slotT and slotT._items
            local idx = 1
            if items then
                for k in pairs_(items) do
                    idx = k
                    break
                end
            end
            InvCtl.equip("Melee", idx)
        end)
    end

    -- AUTO KNIFE v2  BLINK BEHIND THE BACK + RMB (heavy). The game does exactly
    -- what it does with RMB held: Melee:shoot(true)  "Heavy Swing", and an angle
    -- > 100 behind the victim's back (test v_u_24)  "BackStab" = server-side
    -- one-shot. Dest = victim minus her LookVector * 2.5 (knife Range = 3 
    -- the camera ray hits the back, the angle comes out 180). v2: hold 0.2 s
    -- before the swing  the server validates the angle/distance on ITS OWN copy of
    -- our position, so the position must have time to replicate (0.05 s was too
    -- little: the packet flew but the server still saw us from far away 
    -- rejection = "it lags but does nothing"). The character's and camera's CFrame
    -- is FORCED AGAIN here before the ray (local MovementV2 can overwrite
    -- the position during the hold). Diagnostics: kray = a copy of the
    -- Melee ray (a hit = the MeleeAttack.Send condition  without it the
    -- animation plays but no packet goes out), khp = victim HP before  after
    -- (read on the next swing, because hp returns from the server
    -- delayed; > -1 = the model vanished = usually a kill).
    local RaycastParams_ = RaycastParams
    local kLastV, kLastHp = nil, nil
    local function knifeBlink(part, w, ignore)
        tpStat.blink = tpStat.blink + 1
        if kLastV and kLastHp ~= nil then
            local hum0 = kLastV:FindFirstChildOfClass("Humanoid")
            tpStat.khp = tostring_(kLastHp) .. ">" .. tostring_(hum0 and hum0.Health or -1)
            kLastV, kLastHp = nil, nil
        end
        if tpBusy then tpStat.err = "busy" return false end
        local ch = plr.Character
        if not ch or ch:GetAttribute("Dead") then tpStat.err = "dead" return false end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then tpStat.err = "nohrp" return false end
        local vch = part:FindFirstAncestorWhichIsA("Model")
        local vroot = vch and vch:FindFirstChild("HumanoidRootPart")
        if not vroot then tpStat.err = "novictimroot" return false end
        local saved = hrp.CFrame
        local aim = vroot.Position
        local behind = aim - vroot.CFrame.LookVector * 2.5
        tpBusy = true
        local ok, err = pcall_(function()
            hrp.CFrame = cfLookAt(behind, aim)
            taskWait(0.2)
            hrp.CFrame = cfLookAt(behind, aim)
            local cam = ws.CurrentCamera
            if cam then cam.CFrame = cfLookAt(behind, aim) end
            local rng = 3
            pcall_(function() rng = tonumber_(w.Properties.Range) or rng end)
            if cam and ignore then
                local rp = RaycastParams_.new()
                rp.FilterDescendantsInstances = ignore
                local r = ws:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * rng, rp)
                if r then
                    tpStat.kray = r.Instance.Name .. "/" .. (r.Instance.Parent and r.Instance.Parent.Name or "?")
                else
                    tpStat.kray = "MISS"
                end
            else
                tpStat.kray = "nocam"
            end
            local hum = vch:FindFirstChildOfClass("Humanoid")
            kLastV, kLastHp = vch, (hum and hum.Health or -1)
            w:shoot(true)
            tpStat.shots = tpStat.shots + 1
            taskWait(0.15)
        end)
        pcall_(function()
            hrp.CFrame = saved
        end)
        tpBusy = false
        if ok then
            tpStat.ok = tpStat.ok + 1
        else
            tpStat.fail = tpStat.fail + 1
            tpStat.err = tostring_(err)
        end
        return ok
    end

    -- AUTO REVOLVER  shot through the game's RMB path: the Secondary Fire action calls
    -- v6:startRevolverSecondaryFire(getInputBinding(u4))  for the right
    -- button the binding = Enum.UserInputType.MouseButton2, so here we make the same
    -- call directly (no input simulation, no delay). Own cooldown
    -- = the weapon's FireRate + skipping while a shot is in progress  no R8 state spam.
    -- Fallback: a natural RMB click via VirtualUser (triggerbot pattern,
    -- Button2 only), in case the method does not exist.
    local function revolverShot(w, pr)
        local now = tick_()
        local cd = tonumber_(pr and pr.FireRate) or 0.706
        if now - lastRevShot < cd then
            revStat.err = "cd"
            return false
        end
        if w.IsShooting then
            revStat.err = "shooting"
            return false
        end
        if w.IsReloading then
            revStat.err = "reload"
            return false
        end
        lastRevShot = now
        local ok, err = pcall_(w.startRevolverSecondaryFire, w, utMouseButton2)
        if ok then
            -- The shot happens synchronously in start (shoot("Secondary"));
            -- stop = the second half of the RMB tap like a real click
            -- (clearing IsAlternativeFireHeld/Binding  the game would do that
            -- anyway without physically holding RMB, but it is safer).
            pcall_(w.stopRevolverSecondaryFire, w)
            revStat.shot = revStat.shot + 1
            revStat.err = ""
            return true
        end
        revStat.err = "direct:" .. tostring_(err)
        local ok2, err2 = pcall_(function()
            vu:CaptureController()
            local c = ws.CurrentCamera or cam
            vu:ClickButton2(v2new(c.ViewportSize.X / 2, c.ViewportSize.Y / 2))
        end)
        if ok2 then
            revStat.shot = revStat.shot + 1
            revStat.err = "fallback"
            return true
        end
        revStat.err = "click:" .. tostring_(err2)
        return false
    end

    -- DOUBLE TRAP  stats (read: _G.__liptonDTStat) + helper for the second
    -- shot OUTSIDE THE COOLDOWN: shoot() blocks fire only with the
    -- IsShooting flag (until the game's internal FireRate delay), so before the second
    -- shot we force readiness (IsShooting = false) and restore it in case the
    -- shot does not go off  the game clears the flag with its own delay anyway. Shot 2
    -- therefore goes out in the same frame as shot 1.
    -- Target: FIRST another exposed enemy (if two are peeking  one bullet
    -- each); with no second one  repeat on the first target. With no target no shot
    -- goes out.
    local dtStat = { shot = 0, skip = 0, err = "" }
    G.__liptonDTStat = dtStat
    -- Target of the second shot (shared by the LMB and R8 paths): FIRST another
    -- exposed enemy (skip the first target  if two are peeking, one bullet
    -- each); no second one  repeat on the first target (finish off after a miss /
    -- a shot beside them); nobody  nil (zero blind fire).
    local function doubleTapTarget(origin, ignoreList, range, char1)
        local t2, a2 = findSilentTarget(origin, ignoreList, range, nil, char1)
        if not t2 then
            t2, a2 = findSilentTarget(origin, ignoreList, range, char1)
        end
        return t2, a2
    end
    local function doubleTap(w, part1, ignoreList)
        local pr = w.Properties
        if not pr or pr.Class ~= "Weapon" then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "noweapon"
            return
        end
        local char1 = part1 and part1:FindFirstAncestorWhichIsA("Model")
        if not char1 then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "nochar"
            return
        end
        if w.IsReloading then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "reload"
            return
        end
        if (tonumber_(w.Rounds) or 1) <= 0 then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "norounds"
            return
        end
        local myCh = plr.Character
        if not myCh or myCh:GetAttribute("Dead") then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "dead"
            return
        end
        if InvCtl == nil or InvCtl.getCurrentEquipped() ~= w then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "switch"
            return
        end
        local camT = ws.CurrentCamera
        if not camT then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "nocam"
            return
        end
        local origin = camT.CFrame.Position
        local range = G.__liptonLastRange or 1000
        local t2, a2 = doubleTapTarget(origin, ignoreList, range, char1)
        if not t2 then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "notarget"
            return
        end
        -- OUTSIDE THE COOLDOWN: we clear readiness, the shot goes in the same frame,
        -- and we restore the flag only if the shot did not go off (if it did 
        -- shoot sets IsShooting = true itself and its FireRate delay will
        -- clear it). pcall: even if shoot throws, redirectTarget still
        -- goes back to nil (the old target does not follow the later bullets).
        redirectTarget, redirectAim = t2, a2
        local wasShooting = w.IsShooting
        w.IsShooting = false
        pcall_(fireWeapon, w)
        if not w.IsShooting and wasShooting then
            w.IsShooting = true
        end
        redirectTarget, redirectAim = nil, nil
        dtStat.shot = dtStat.shot + 1
        dtStat.err = ""
    end

    -- DOUBLE TRAP under R8 (Auto Revolver path): second RMB OUTSIDE THE
    -- COOLDOWN  own revStat cd zeroed and the game's IsShooting forced
    -- to false  two revolver bullets in one frame. Target as above;
    -- failed attempt = restore the cd and the revStat counter with no harm.
    local function revolverDouble(w, prR, part1, ignoreList)
        local char1 = part1 and part1:FindFirstAncestorWhichIsA("Model")
        if not char1 then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "nochar"
            return
        end
        if w.IsReloading then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "reload"
            return
        end
        if (tonumber_(w.Rounds) or 1) <= 0 then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "norounds"
            return
        end
        local camT = ws.CurrentCamera
        if not camT then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "nocam"
            return
        end
        local origin = camT.CFrame.Position
        local range = G.__liptonLastRange or 1000
        local t2, a2 = doubleTapTarget(origin, ignoreList, range, char1)
        if not t2 then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "notarget"
            return
        end
        redirectTarget, redirectAim = t2, a2
        local wasShooting = w.IsShooting
        local prevRev = lastRevShot
        w.IsShooting = false
        lastRevShot = 0
        local ok2 = revolverShot(w, prR)
        if not w.IsShooting and wasShooting then
            w.IsShooting = true
        end
        if not ok2 then
            lastRevShot = prevRev
        end
        redirectTarget, redirectAim = nil, nil
        if ok2 then
            dtStat.shot = dtStat.shot + 1
            dtStat.err = ""
        else
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "rev:" .. (revStat.err or "")
        end
    end

    local function silentTrigger()
        if not trigClean then return end
        if not silentAny() then return end
        if InvCtl == nil then return end
        if RaycastLib == nil or GetRayIgnore == nil then return end
        if uis:GetFocusedTextBox() ~= nil then return end
        local ch = plr.Character
        if not ch or ch:GetAttribute("Dead") then return end
        local camT = ws.CurrentCamera
        if not camT then return end
        local now = tick_()
        if now - lastTrig < 0.15 then return end
        lastTrig = now
        local ignoreList = GetRayIgnore()
        if not ignoreList then return end
        local part = findSilentTarget(camT.CFrame.Position, ignoreList, G.__liptonLastRange or 1000)
        if not part then return end
        local w = InvCtl.getCurrentEquipped()
        -- ROUND GATE: blink (TP Shot and Auto Knife) only while
        -- "Round In Progress"  during "Buy Period"/"Warmup" we stay
        -- calm (buying without teleports); the blink returns by itself at the round
        -- start, once GameState flips.
        local roundLive = ws:GetAttribute("GameState") == "Round In Progress"
        if roundLive and not tpBusy then
            -- AUTO KNIFE (priority): blink behind the back + heavy = BackStab.
            if G.__liptonAutoKnife then
                local isMelee = w and w.Properties and w.Properties.Class == "Melee"
                if not isMelee then
                    equipKnife()
                    tpStat.err = "knife-equip"
                elseif tick_() - (w.WeaponEquippedTick or 0) <= 1 then
                    tpStat.err = "knife-cd"
                elseif w.IsShooting then
                    tpStat.err = "knife-swing"
                else
                    tpStat.try = tpStat.try + 1
                    if knifeBlink(part, w, ignoreList) then return end
                end
            end
            -- TP SHOT: target behind cover  blink up close; if n took
            -- the path (weapon = Melee and Auto Knife ON), TP Shot does not blink
            -- with a knife in hand  it waits to get back to a firearm.
            if G.__liptonTPShot and not (G.__liptonAutoKnife and w and w.Properties and w.Properties.Class == "Melee") then
                tpStat.try = tpStat.try + 1
                local vch = part:FindFirstAncestorWhichIsA("Model")
                if not clearOfWalls(camT.CFrame.Position, part, vch, ignoreList) then
                    if tpShotBlink(part, w) then return end
                else
                    tpStat.vis = tpStat.vis + 1
                end
            end
        end
        -- AUTO REVOLVER  fires only with the revolver and through the game's RMB;
        -- with just this flag no other weapon fires (revolver-only mode),
        -- with Silent Aim/Wallbang/TP Shot  the regular fireWeapon (LMB).
        local prR = w and w.Properties
        if G.__liptonAutoRevolver then
            if prR and prR.ShootingOptions == "Revolver" then
                -- RMB pair outside the cooldown when Double Tap is ON  otherwise a
                -- single R8 as before.
                if revolverShot(w, prR) and G.__liptonDoubleTap then
                    revolverDouble(w, prR, part, ignoreList)
                end
                return
            end
            if not (G.__liptonSilentAim or G.__liptonWallbang or G.__liptonTPShot or G.__liptonDoubleTap) then
                return
            end
        end
        fireWeapon(w)
        -- DOUBLE TRAP: second shot OUTSIDE THE COOLDOWN (same frame)  the
        -- other peeking enemy (one bullet each), or a repeat on
        -- the first target when there is no second one.
        if G.__liptonDoubleTap and prR and prR.Class == "Weapon" then
            doubleTap(w, part, ignoreList)
        end
    end
    trigClean = pcall(function()
        setfenv(silentTrigger, {})
        setfenv(fireWeapon, {})
        setfenv(tpShotBlink, {})
        setfenv(knifeBlink, {})
        setfenv(equipKnife, {})
        setfenv(silentAny, {})
        setfenv(throughWalls, {})
        setfenv(revolverShot, {})
        setfenv(doubleTap, {})
        setfenv(doubleTapTarget, {})
        setfenv(revolverDouble, {})
        for _, f in ipairs({silentTrigger, fireWeapon, tpShotBlink, knifeBlink, equipKnife, silentAny, throughWalls, revolverShot, doubleTap, doubleTapTarget, revolverDouble}) do
            local e = getfenv(f)
            if e.getgenv or e.hookfunction then
                error("dirty env")
            end
        end
    end)
    if trigClean then
        runService.Heartbeat:Connect(silentTrigger)
    else
        warn("[SzpontHub] BS Silent Aim: autofire env check failed  Heartbeat trigger NOT connected")
    end
    end -- end of the SILENT AIM block (releases the local registers)

    -- BUNNY HOP v5  the only source of jumping in BloxStrike.
    -- The game does NOT use Humanoid states: the character is driven by its own
    -- MovementV2 simulation (tick 64 Hz = 15.625 ms). The decompiled ProvenSimulator
    -- accepts a jump only when:
    --   OnGround AND (edge: input.Jump AND NOT the previous JumpHeld)
    --   AND (Tick - LastJumpTick > 1)
    -- The bhop buffer (JumpBufferTicks) works only in Casual mode,
    -- Competitive has BunnyHopInputBufferTicks = 0 => edge only.
    -- The only jump input path: CharacterController.jump() with no argument
    -- => SetJumpInput(nil) => JumpPulsePending = true => exactly ONE tick
    -- with Buttons.Jump = true (SampleInput eats the pulse immediately).
    local CharacterController = nil
    pcall(function()
        CharacterController = require(game.ReplicatedStorage.Controllers.CharacterController)
    end)

    -- BHOP UNLOCKER  removes the HARD speed cap of 24.5 from the game BloxStrike.
    -- In the dump (ReplicatedStorage/Classes/Character.luau) MoveFunction does:
    --   if 24.5 < horizontalMag(GlobalVelocity) then GlobalVelocity = scale down to 24.5
    -- and below that Humanoid.WalkSpeed = |LocalVelocity| (computed from GlobalVelocity)
    -- carries that cap onto physics. AirAccelerate adds only 2.5 of the given
    -- speed per tick  so a per-tick clamp eats the whole air-strafe gain.
    -- We give the Character instance its own metatable: reads and writes of the
    -- GlobalVelocity field pass through us and we skip the "scale down to 24.5" write.
    -- Friction, wall bounces and the game's acceleration stay stock  only
    -- the cap disappears, so bhop gains speed without a limit.
    local function ensureBhopUnlock()
        if not bhopUnlocker or not CharacterController then
            return
        end
        local ok, ch = pcall(function()
            return CharacterController.getCurrentCharacter()
        end)
        if not ok or type(ch) ~= "table" or rawget(ch, "__szBhopHook") then
            return
        end
        local origMT = getmetatable(ch)
        if not origMT then
            return
        end
        local baseIndex = rawget(origMT, "__index")
        local proxy = {}
        for k, v in pairs(origMT) do
            if type(k) == "string" and string.sub(k, 1, 2) == "__" and k ~= "__index" and k ~= "__newindex" then
                proxy[k] = v
            end
        end
        proxy.__index = function(t, k)
            if k == "GlobalVelocity" then
                return rawget(t, "__szGV")
            end
            if baseIndex == nil then
                return origMT[k]
            elseif type(baseIndex) == "function" then
                return baseIndex(t, k)
            end
            return baseIndex[k]
        end
        proxy.__newindex = function(t, k, v)
            if k == "GlobalVelocity" then
                local cur = rawget(t, "__szGV")
                if bhopUnlocker and cur ~= nil and v ~= nil then
                    local newH = math.sqrt(v.X * v.X + v.Z * v.Z)
                    local curH = math.sqrt(cur.X * cur.X + cur.Z * cur.Z)
                    -- the game's clamp always lands on ~24.5 horizontally while falling -> we skip it
                    if math.abs(newH - 24.5) < 0.02 and curH > newH + 0.05 then
                        rawset(t, "__szGV", Vector3.new(cur.X, v.Y, cur.Z))
                        return
                    end
                end
                rawset(t, "__szGV", v)
                return
            end
            rawset(t, k, v)
        end
        local gv = rawget(ch, "GlobalVelocity")
        if gv ~= nil then
            rawset(ch, "__szGV", gv)
            rawset(ch, "GlobalVelocity", nil)
        end
        rawset(ch, "__szBhopHook", true)
        setmetatable(ch, proxy)
    end

    runService.Heartbeat:Connect(function()
        if not isCurrentGen() then return end
        if bhopUnlocker then
            ensureBhopUnlock()
        end
    end)

    -- SPEED HACK (slider)  forces the speed with TWO layers, because the game keeps
    -- it in two places (Character.luau dump):
    --   air (L653):   AssemblyLinearVelocity = GlobalVelocity -> we scale the sim,
    --   ground (L681): Humanoid.WalkSpeed = |LocalVelocity|  -> we overwrite the
    --     engine; on top of that Accelerate has min(...,24.5) (L666) and clamps
    --     GlobalVelocity to 24.5 (L673-680), so without the sim WalkSpeed alone
    --     would only speed things up until landing.
    -- Writes in Stepped (before physics) and Heartbeat (after the game tick)  whatever
    -- the game sets in its loop, the last word before physics is ours.
    -- The direction stays from the game's sim and only ever increases (it never removes
    -- speed built up by bhop), so the two cheats do not conflict.
    local function speedHackTick()
        if not speedHack then
            return
        end
        -- layer 1: the game's sim (GlobalVelocity) -> air + WalkSpeed through |LocalVelocity|
        if CharacterController then
            local ok, ch = pcall(function()
                return CharacterController.getCurrentCharacter()
            end)
            if ok and type(ch) == "table" then
                local ok2, gv = pcall(function()
                    return ch.GlobalVelocity
                end)
                if ok2 and typeof(gv) == "Vector3" then
                    local h = math.sqrt(gv.X * gv.X + gv.Z * gv.Z)
                    if h > 1 then
                        local target = math.max(h, speedHackValue)
                        local k = target / h
                        pcall(function()
                            ch.GlobalVelocity = Vector3.new(gv.X * k, gv.Y, gv.Z * k)
                        end)
                    end
                end
            end
        end
        -- layer 2: the engine -> hard WalkSpeed overwrite with the slider's value
        if plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                pcall(function()
                    hum.WalkSpeed = speedHackValue
                end)
            end
        end
    end
    runService.Stepped:Connect(speedHackTick)
    runService.Heartbeat:Connect(speedHackTick)

    -- INSTANT PLANT + INSTANT DEFUSE (one button, both C4 actions).
    -- Defuse: the server answers with the IsDefusingBomb/DefuseStartTime attributes, and
    --   the game's own bar only sends C4.Defused.Send() after 5/10 s  we fire
    --   the same packet right after defusing starts. If the server trusts the
    --   client's time = instant defuse; if it enforces the time,
    --   the packet lands in vain and the normal bar runs unhindered.
    -- Plant: starting the plant flags IsPlantingBomb on the LocalPlayer 
    --   likewise we fire C4.Planted.Send() at the moment of start.
    -- We do not touch any game state, we only inject an early packet, so
    -- in the worst case both actions simply behave normally.
    local instantBomb = false
    local bInstant = createButton("Instant Plant+Defuse: OFF", 20, "Utility")
    bInstant.MouseButton1Click:Connect(function()
        instantBomb = not instantBomb
        bInstant.Text = instantBomb and "Instant Plant+Defuse: ON" or "Instant Plant+Defuse: OFF"
        bInstant.BackgroundColor3 = instantBomb and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
        updateActiveCheatsList()
    end)

    local RemotesBS = nil
    pcall(function()
        RemotesBS = require(game:GetService("ReplicatedStorage").Database.Security.Remotes)
    end)
    local instDefSent, instPlantSent = false, false

    runService.Heartbeat:Connect(function()
        if not isCurrentGen() then return end
        if not (instantBomb and RemotesBS) then
            instDefSent, instPlantSent = false, false
            return
        end
        -- DEFUSE: the server started defusing -> one early Defused fire
        local defusing = plr:GetAttribute("IsDefusingBomb") == true
        if defusing and not instDefSent then
            instDefSent = true
            pcall(function() RemotesBS.C4.Defused.Send() end)
        elseif not defusing then
            instDefSent = false
        end
        -- PLANT: the plant start attribute -> one early Planted fire
        local planting = plr:GetAttribute("IsPlantingBomb") == true
        pcall(function()
            if not planting and plr.Character and plr.Character:GetAttribute("IsPlantingBomb") == true then
                planting = true
            end
        end)
        if planting and not instPlantSent then
            instPlantSent = true
            pcall(function() RemotesBS.C4.Planted.Send() end)
        elseif not planting then
            instPlantSent = false
        end
    end)

    -- Why v4 did not work: (a) the "ground" check hung on Humanoid states
    -- (GetState/StateChanged/AssemblyLinearVelocity/raycast) which the
    -- MovementV2 simulation IGNORES  only the internal OnGround flag matters; (b) VIM
    -- Space and Hum.Jump = true KEPT the Jump key held, so after the first
    -- jump the simulation had JumpHeld = true forever and the required edge
    -- (input.Jump AND NOT the previous JumpHeld) never happens again 
    -- further jumps were never produced. v5 pulses the jump queue itself, with
    -- no landing detection and no pressing Space.

    -- Loop v6: bhop works ONLY while Space is held. Without it there is zero
    -- interference  you can comfortably build up speed first and jump afterwards.
    -- Two reasons for moving on from v5:
    --  1) v5 pulsed regardless of the key => the character jumped on its own
    --     right after enabling, and speed could not be built;
    --  2) with Space held the game keeps JumpInputDown = true, so
    --     Buttons.Jump = true on EVERY tick, JumpHeld = true and the solver never
    --     gets the required edge (input.Jump AND NOT the previous JumpHeld).
    --     Therefore a held input has to be silenced (jump(false)) and the pulse
    --     dosed by us: pulse = exactly one tick with Jump = true, and between
    --     pulses there is a tick with false => an edge appears every ~40 ms.
    -- Our Heartbeat writes JumpInputDown last (the game sets true only on
    -- InputBegan, and it had registered before the injection anyway), so the
    -- silencing persists until the key is released; when the cheat is
    -- switched off the state is restored (jump(true)) so that a held Space
    -- works on the game side again.
    -- Cadence 40 ms > 2 ticks (31.25 ms at 64 Hz) with headroom for jitter;
    -- landing detection is unnecessary  in the air the solver ignores pulses
    -- (no OnGround), and on the ground it fires the jump on the first possible tick.
    local bhopLastPulse = 0
    local BHOP_PULSE_PERIOD = 0.040
    local bhopUis = game:GetService("UserInputService")
    local bhopSuppressed = false
    runService.Heartbeat:Connect(function()
        if not isCurrentGen() then return end
        if not CharacterController then
            return
        end
        local spaceHeld = bhopUis:IsKeyDown(Enum.KeyCode.Space)
        if not bunnyHop then
            -- cheat off: hand Space control back to the game (no side
            -- effects for someone holding the key while toggling)
            if bhopSuppressed then
                bhopSuppressed = false
                pcall(function() CharacterController.jump(spaceHeld) end)
            end
            return
        end
        if not spaceHeld then
            -- Space released: we do not jump, the player is running up speed.
            if bhopSuppressed then
                bhopSuppressed = false
                pcall(function() CharacterController.jump(false) end)
            end
            bhopLastPulse = 0
            return
        end
        -- Space held: we mute its state (so as not to kill the edge) and
        -- pulse every > 2 ticks. false is idempotent  while the game does not
        -- refresh it cyclically, it stays until the key is released.
        pcall(function() CharacterController.jump(false) end)
        bhopSuppressed = true
        local now = tick()
        if now - bhopLastPulse < BHOP_PULSE_PERIOD then
            return
        end
        bhopLastPulse = now
        pcall(function() CharacterController.jump() end)
    end)

    -- No Recoil: reset CameraOffset (backup  the main blocking lives in enableNoRecoil)
    runService.RenderStepped:Connect(function()
        if not isCurrentGen() then return end
        if noRecoil and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.CameraOffset = Vector3.new(0, 0, 0)
            end
        end
    end)

    -- Hitbox Expander (enlarges ONLY the enemies' head hitbox, not the whole body)
    runService.Heartbeat:Connect(function()
        if not isCurrentGen() then return end
        if hitboxExpander then
            for _, p in pairs(playersService:GetPlayers()) do
                if p ~= plr and p.Character and isEnemy(p) then
                    local head = p.Character:FindFirstChild("Head")
                    if head and head:IsA("BasePart") then
                        if not head:GetAttribute("OrigHeadSize") then
                            head:SetAttribute("OrigHeadSize", head.Size)
                            head:SetAttribute("OrigHeadTrans", head.Transparency)
                        end
                        if head.Size.X < hitboxSize then
                            head.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                            head.Transparency = 0.7
                            head.CanCollide = false
                        end
                    end
                end
            end
        end
    end)

    -- Fullbright
    runService.RenderStepped:Connect(function()
        if not isCurrentGen() then return end
        if fullbright then
            lighting.Brightness = 2
            lighting.ClockTime = 14
            lighting.GlobalShadows = false
            lighting.FogEnd = 999999
        else
            lighting.GlobalShadows = true
        end
    end)

    -- BloxStrike ESP moved into startBsEspNew() (v2)  the full description
    -- of the cracked game system and the reasons v1 failed is in the comment
    -- above that function's definition. Here only the warning state
    -- initialization stays (used generally, regardless of the ESP version).
    _G.__liptonESPWarns = _G.__liptonESPWarns or {}
    -- OLD ESP THROWN OUT (v1 read player.Character + Head + a position
    -- buffer and after a game update dropped everyone: "no Character and no
    -- fresh position"). Now startBsEspNew() draws  based only on the
    -- attributes of BloxStrike's own system (Team/Health/Dead), see the
    -- comment next to the function.
    startBsEspNew(function() return espEnabled end)

    updateActiveCheatsList()
    -- TEARDOWN of the BloxStrike instance: same as in MM2 - all options
    -- OFF, world state restored, old GUI destroyed.
    if type(getgenv) == "function" then
        getgenv().SzpontHubTeardown = function()
            pcall(function()
                aimbotEnabled = false
                espEnabled = false
                triggerbot = false
                bunnyHop = false
                bhopUnlocker = false
                speedHack = false
                hitboxExpander = false
                noRecoil = false
                noSpread = false
                fullbright = false
                crosshairEnabled = false
                thirdPerson = false
                instantBomb = false
                restoreWorldState()
                if bsGui then bsGui:Destroy() end
                if bsCheatsGui then bsCheatsGui:Destroy() end
            end)
        end
    end
end

------------------------------------------------------------
-- HACKS: FISCH (fishing game)
-- Own Fishing / Exploit / Utility tabs  without the combat ones
-- from BloxStrike. Fishing: the Auto Cast / Auto Shake /
-- Auto Reel toggles save their state to getgenv().SzpontFisch; the logic
-- was hooked live after analyzing Fisch's remotes/minigames:
-- cast = RemoteFunction "FishingRod/Cast" (0..100, perfect),
-- shake = firesignal on the shakeui.safezone button (the game's own
-- throttle), reel = a boost of core.minigame._progressModifier
-- (end of the haul at progress >= 100).
-- Exploit/Utility: stay EMPTY (no cheats inside  the
-- user's decision; functions only in the Fishing tab).
------------------------------------------------------------
function startFischScript()
    -- Already loaded? Show it again instead of building a second GUI
    if fischGui and fischGui.Parent then
        fischGui.Enabled = true
        if fischCheatsGui then fischCheatsGui.Enabled = true end
        return
    end

    if gameSelectGui then gameSelectGui:Destroy() end

    -- FLAGS (Fishing only)
    local autoCast = false
    local autoShake = false
    local autoReel = false
    local autoAppraise = false

    -- AUTOMATIC FISHING LOOP (stage 2  live in Fisch).
    -- Order within a tick: shake first (the minigame ticks), then
    -- reel, cast last (InvokeServer can hang).
    -- Tick every 0.05 s  see the comment in ensureFishingLoop.
    local fishingLoopAlive = false
    local castBackoff = 0
    -- cache of the shake handler (upvalue `now` + the v14 window)  resolved
    -- once per minigame button, drifted every tick (see AUTO SHAKE)
    local shakeCacheBtn, shakeCacheFn, shakeCacheIdx = nil, nil, nil
    local shakeCacheDrift = 0

    local function fishingTick()
        local plr = game:GetService("Players").LocalPlayer
        local RS = game:GetService("ReplicatedStorage")
        local char = plr.Character
        local tool = char and char:FindFirstChildWhichIsA("Tool")

        -- AUTO SHAKE: click the active minigame button; the game does
        -- its own throttle (the v14 window = 0.25/ShakeScale on the `now`
        -- upvalue) and counts progress; the handler sends LureShake/Shake
        -- to the server with no arguments  the server only sees the packet
        -- rate.
        -- SPEED-UP (user's decision): the `now` drift is computed
        -- adaptively toward a TARGET of 0.10 s/click (10/s): d = (window-0.10)/2
        -- + margin. Fully smashing `now` (= 20/s) used to break the fishing, so
        -- the ceiling is 0.10 s. Criterion: >= 1 fish caught;
        -- if it stops catching  roll back (drift = 0).
        if autoShake then
            local shakeGui = plr.PlayerGui:FindFirstChild("shakeui")
            if shakeGui then
                local zone = shakeGui:FindFirstChild("safezone")
                local btn = zone and zone:FindFirstChildWhichIsA("GuiButton", true)
                if btn then
                    -- the minigame handler (upvalue `now`, the `v14` window)
                    -- is resolved once per button; a new shake = a new
                    -- button, so the window is computed from the fresh session
                    if btn ~= shakeCacheBtn then
                        shakeCacheBtn = btn
                        shakeCacheFn = nil
                        shakeCacheIdx = nil
                        shakeCacheDrift = 0
                        pcall(function()
                            for _, cn in ipairs(getconnections(btn.Activated)) do
                                local f = cn.Function
                                if type(f) == "function" then
                                    local nowIdx, win, i = nil, nil, 1
                                    while true do
                                        local nm, val = debug.getupvalue(f, i)
                                        if not nm then break end
                                        if nm == "now" and type(val) == "number" then
                                            nowIdx = i
                                        end
                                        -- the game's window: a number in (0, 0.5]; the upvalue
                                        -- order (v14 = idx 2) wins over v11
                                        -- (InitialTimer), which theoretically can
                                        -- drop low near the end of the minigame
                                        if not win and type(val) == "number"
                                            and val > 0 and val <= 0.5
                                            and nm ~= "now" then
                                            win = val
                                        end
                                        i = i + 1
                                    end
                                    if not nowIdx then
                                        -- fallback: `now` = the only big "tick()"
                                        i = 1
                                        while true do
                                            local nm, val = debug.getupvalue(f, i)
                                            if not nm then break end
                                            if type(val) == "number" and val > 1e9
                                                and val < tick() + 10 then
                                                nowIdx = i
                                                break
                                            end
                                            i = i + 1
                                        end
                                    end
                                    if nowIdx then
                                        shakeCacheFn = f
                                        shakeCacheIdx = nowIdx
                                        if win then
                                            shakeCacheDrift =
                                                math.max(win - 0.10, 0) / 2 + 0.001
                                        end
                                        break
                                    end
                                end
                            end
                        end)
                    end
                    if shakeCacheFn and shakeCacheDrift > 0 then
                        pcall(function()
                            local nm, val = debug.getupvalue(shakeCacheFn, shakeCacheIdx)
                            if nm and type(val) == "number" then
                                debug.setupvalue(shakeCacheFn, shakeCacheIdx,
                                    val - shakeCacheDrift)
                            end
                        end)
                    end
                    pcall(function() firesignal(btn.Activated) end)
                end
            end
        end

        -- AUTO REEL: boost progress to 10000 so the
        -- Core.Minigame.Tick sees >= 100 and calls EndMinigame
        -- (which sends Reel/Finish to the server).
        -- INSTANT AFTER SHAKING: StartReel waits an artificial task.wait(2)
        -- for the character attribute "Reeling" (start signal from
        -- the server) before setting active/ready, and the minigame Tick has
        -- a gate `if not current.active then return`, so without it
        -- nothing happens. When the attribute is ALREADY set, we fire
        -- ready immediately (every tick = 0.05 s) instead of waiting for
        -- the end of the 2 s; only real server time + replication remains
        -- (~ping). We respect Preload like the original
        -- (_awaiting_preload sets ready itself after preload).
        -- Criterion still: >=1 caught fish.
        if autoReel then
            pcall(function()
                local RC = require(RS.client.legacyControllers.ReelController)
                local reel = RC.ActiveReel
                if reel then
                    local mg = reel.core and reel.core.minigame
                    if mg and mg._progressModifier then
                        mg._progressModifier.Value = 10000
                    end
                    if not reel.ready then
                        local char = plr.Character
                        if char and char:GetAttribute("Reeling") then
                            if (reel._preload_tasks or 0) > 0 then
                                reel._awaiting_preload = true
                            else
                                reel.active = true
                                reel.ready = true
                                pcall(function() reel.OnReady:Fire() end)
                            end
                        end
                    end
                end
            end)
        end

        -- AUTO CAST: only when the rod is ready (state < Casting = 4,
        -- casted = false, no bobber, character alive).
        -- Power = 100 = full casting bar (user's choice;
        -- previously random 55-95).
        if autoCast and tick() >= castBackoff then
            if tool and tool:FindFirstChild("values") then
                local v = tool.values
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if v.state.Value < 4 and not v.casted.Value
                    and not tool:FindFirstChild("bobber")
                    and hum and hum.Health > 0 then
                    local ok, res = pcall(function()
                        local Net = require(RS.packages.Net)
                        return Net:RemoteFunction("FishingRod/Cast")
                            :InvokeServer(100, false)
                    end)
                    if not ok or res ~= true then
                        -- rejected by the server: do not spam, back off
                        castBackoff = tick() + 3
                    end
                end
            end
        end
    end

    local function ensureFishingLoop()
        if fishingLoopAlive then return end
        if not (autoCast or autoShake or autoReel) then return end
        fishingLoopAlive = true
        task.spawn(function()
            if not isCurrentGen() then return end
            -- getgenv().SzpontFischStop = true => urgent stop of the
            -- loop from the console (no GUI). Every 0.05 s = shake
            -- clicks in every allowed window of the game's throttle
            -- (0.25/ShakeScale) - earlier with ShakeScale > 1
            -- a 0.25 s loop let half the windows slip by.
            while autoCast or autoShake or autoReel do
                local stop = false
                pcall(function()
                    local env = (type(getgenv) == "function" and getgenv()) or _G
                    stop = env.SzpontFischStop == true
                end)
                if stop then break end
                pcall(fishingTick)
                task.wait(0.05)
            end
            fishingLoopAlive = false
        end)
    end

    local function pushFishingState()
        pcall(function()
