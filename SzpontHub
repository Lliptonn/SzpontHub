    -- ZAKŁADKA UTILITY: FLY / NOCLIP / SPEED HACK — układ i mechanika
    -- jak w MM2 (przełączniki + suwaki Fly Speed / Walk Speed).
    -- Stany w getgenv().SzpontUtility (współdzielone między iniekcjami):
    -- noclip/speed = co-klatkowe połączenia RunService (idempotentne),
    -- fly = jedna pętla samo-gasnąca; getgenv().SzpontUtilityStop = true
    -- zabija ją na amen. Pierwszy push na starcie zeruje fly, więc
    -- stare pętle gasną same przy re-iniekcji.
    local uFly = false
    local uNoclip = false
    local uSpeed = false
    local uFullbright = false
    local uInstant = false
    local uStuck = false
    local uFlySpeed = 60
    local uWalkSpeed = 32

    local function envOf()
        return (type(getgenv) == "function" and getgenv()) or _G
    end

    local function pushUtilityState()
        pcall(function()
            local env = envOf()
            env.SzpontUtility = {
                fly = uFly,
                noclip = uNoclip,
                speed = uSpeed,
                fullbright = uFullbright,
                instant = uInstant,
                stuck = uStuck,
                flySpeed = uFlySpeed,
                walkSpeed = uWalkSpeed
            }
        end)
    end

    -- FULLBRIGHT: oryginały Lighting trzymamy w getgenv (współdzielone
    -- między iniekcjami), żeby re-iniekcja przy włączonym fullbrightu
    -- umiała je przywrócić, a nie zapisać już rozjaśnione wartości.
    local function saveLighting()
        pcall(function()
            local env = envOf()
            if env.SzpontLightingSaved then return end
            local l = game:GetService("Lighting")
            env.SzpontLightingSaved = {
                Brightness = l.Brightness,
                Ambient = l.Ambient,
                OutdoorAmbient = l.OutdoorAmbient,
                FogStart = l.FogStart,
                FogEnd = l.FogEnd
            }
        end)
    end
    local function restoreLighting()
        pcall(function()
            local env = envOf()
            local saved = env.SzpontLightingSaved
            if not saved then return end
            local l = game:GetService("Lighting")
            l.Brightness = saved.Brightness
            l.Ambient = saved.Ambient
            l.OutdoorAmbient = saved.OutdoorAmbient
            l.FogStart = saved.FogStart
            l.FogEnd = saved.FogEnd
            env.SzpontLightingSaved = nil
        end)
    end
    restoreLighting() -- poprzednia wersja zostawiła włączony fullbright?
    pushUtilityState() -- zeruje fly/fullbright = stare pętle gasną same

