-- KEYBINDS + SEARCH (shared by every hub)
-- Every cheat tile gets a "Bind:" field on its right edge: click it, then
-- press a key and the tile is bound - one key press = one tile click.
-- getconnections(btn.MouseButton1Click):Fire() replays the tile handler,
-- so none of the ~96 toggle handlers has to be duplicated.
-- The search box next to the title filters tiles by name.
-- The added elements use neutral dark colors on purpose: they look right
-- in every theme, so no repaint hook inside paintTheme is needed.
------------------------------------------------------------
local bindSys = {
    keys = {},     -- [button] = Enum.KeyCode
    waiting = nil, -- { lab = bindLabel, btn = tile } = waiting for a key
    hooked = false,
}

-- "Enum.KeyCode.LeftShift" -> "LShift"
function bindSys.keyName(code)
    local n = tostring(code):gsub("Enum.KeyCode%.", "")
    n = n:gsub("^Left", "L")
    n = n:gsub("^Right", "R")
    n = n:gsub("Control", "Ctrl")
    n = n:gsub("Return", "Enter")
    return n
end

-- Puts the text back after cancelling the binding
function bindSys.restore(w)
    if not w then return end
    local k = bindSys.keys[w.btn]
    w.lab.Text = k and ("Bind: " .. bindSys.keyName(k)) or "Bind:"
    w.lab.TextColor3 = Color3.fromRGB(150, 152, 170)
end

-- "Bind:" field on the right side of a tile. It is a TextButton (not a
-- Label) on purpose: an active child swallows the mouse click, so clicking
-- Bind: does NOT toggle the cheat itself.
function bindSys.addLabel(btn)
    if btn:FindFirstChild("BindLabel") then return end
    local lab = Instance.new("TextButton")
    lab.Name = "BindLabel"
    lab.AnchorPoint = Vector2.new(1, 0)
    lab.Position = UDim2.new(1, -6, 0, 0)
    lab.Size = UDim2.new(0, 80, 1, 0)
    lab.BackgroundTransparency = 1
    lab.BorderSizePixel = 0
    lab.AutoButtonColor = false
    lab.Text = "Bind:"
    lab.TextColor3 = Color3.fromRGB(150, 152, 170)
    lab.TextXAlignment = Enum.TextXAlignment.Right
    lab.Font = Enum.Font.GothamSemibold
    lab.TextSize = 12
    lab.ZIndex = 6
    lab.Parent = btn
    lab.MouseButton1Click:Connect(function()
        local w = bindSys.waiting
        if w and w.lab == lab then
            bindSys.waiting = nil      -- second click on the same tile = cancel
            bindSys.restore(w)
            return
        end
        bindSys.restore(w)             -- a different tile was waiting: back to normal
        bindSys.waiting = { lab = lab, btn = btn }
        lab.Text = "Press key..."
        lab.TextColor3 = Color3.fromRGB(0, 255, 225)
    end)
end

-- One global InputBegan for the whole script: either a key assigns a bind
-- (while waiting) or it fires every tile bound to that key. Connected once.
function bindSys.hook()
    if bindSys.hooked then return end
    bindSys.hooked = true
    uis.InputBegan:Connect(function(input, gp)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local w = bindSys.waiting
        if w then
            bindSys.waiting = nil
            if input.KeyCode == Enum.KeyCode.Escape then
                bindSys.restore(w)     -- cancel: the old bind stays
            else
                bindSys.keys[w.btn] = input.KeyCode
                w.lab.Text = "Bind: " .. bindSys.keyName(input.KeyCode)
                w.lab.TextColor3 = Color3.fromRGB(0, 255, 225)
            end
            return
        end
        if gp then return end          -- chat and search typing must not fire
        local key = input.KeyCode
        for btn, k in pairs(bindSys.keys) do
            if k == key and btn.Parent then
                for _, c in ipairs(getconnections(btn.MouseButton1Click)) do
                    pcall(function() c:Fire() end)
                end
            end
        end
    end)
end

-- The search box next to the title (position counted from the back button,
-- so it fits every hub layout). Slider labels and slider bars carry no
-- cheat name: they simply hide while searching, otherwise orphan rows
-- would stay under the results.
function bindSys.addSearch(frame, anchorBtn, buttons, labels, sliders)
    local box = Instance.new("TextBox")
    box.Name = "CheatSearch"
    box.AnchorPoint = Vector2.new(1, 0)
    box.Size = UDim2.new(0, 150, 0, 26)
    -- the box is right-anchored, so Position.X is its RIGHT edge
    local xoff = anchorBtn and (anchorBtn.Position.X.Offset - 10) or -70
    box.Position = UDim2.new(1, xoff, 0, 9)
    box.BackgroundColor3 = Color3.fromRGB(24, 24, 38)
    box.BackgroundTransparency = 0.1
    box.BorderSizePixel = 1
    box.BorderColor3 = Color3.fromRGB(80, 84, 110)
    box.ClearTextOnFocus = false
    box.Text = ""
    box.PlaceholderText = "Search..."
    box.PlaceholderColor3 = Color3.fromRGB(130, 132, 150)
    box.TextColor3 = Color3.fromRGB(235, 235, 240)
    box.Font = Enum.Font.GothamSemibold
    box.TextSize = 12
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.ZIndex = 6
    box.Parent = frame
    do
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = box
    end
    local function applyFilter()
        local q = box.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
        local on = (#q > 0)
        for _, b in ipairs(buttons) do
            b.Visible = (not on) or (b.Text:lower():find(q, 1, true) ~= nil)
        end
        for _, l in ipairs(labels) do l.Visible = not on end
        for _, s in ipairs(sliders) do s.Visible = not on end
    end
    box:GetPropertyChangedSignal("Text"):Connect(applyFilter)
end

-- Called by a hub once all of its tiles exist.
function bindSys.install(frame, anchorBtn, buttons, labels, sliders)
    bindSys.keys = {}
    bindSys.waiting = nil
    for _, b in ipairs(buttons) do
        bindSys.addLabel(b)
    end
    bindSys.addSearch(frame, anchorBtn, buttons, labels, sliders)
    bindSys.hook()
end

