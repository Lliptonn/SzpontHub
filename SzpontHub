    -- Bunny Hop v3 — auto-skok po lądowaniu gdy trzymasz Space
    -- BloxStrike: Jump() gry odrzuca skok w stanie Freefall/Jumping i blokuje
    -- re-jump <0.15s po lądowaniu. Więc gramy TYLKO z podłoża (Running/Landed),
    -- bez wymuszania ChangeState(Jumping) (to łamało maszynę stanów gry).
    local bhopLastJump = 0
    local CharacterController = nil
    pcall(function()
        CharacterController = require(game.ReplicatedStorage.Controllers.CharacterController)
    end)

    local function isGroundedBhop(state)
        return state == Enum.HumanoidStateType.Running
            or state == Enum.HumanoidStateType.RunningNoPhysics
            or state == Enum.HumanoidStateType.Landed
    end

    runService.Heartbeat:Connect(function()
        if not (bunnyHop and uis:IsKeyDown(Enum.KeyCode.Space) and plr.Character) then
            return
        end
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if not (hum and hum.Health > 0) then
            return
        end
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then
            return
        end
        local now = tick()
        local state = hum:GetState()

        -- Awaryjna kontrola: skok został wydany, ale postać nie odbiła się
        -- od ziemi (velocity.Y <= 1) -> twardy impuls fizyczny, działa zawsze.
        if isGroundedBhop(state) and now - bhopLastJump < 0.2 then
            local vel = hrp.AssemblyLinearVelocity
            if vel.Y <= 1 then
                hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 22, vel.Z)
                bhopLastJump = now
            end
        end

        -- Skok tylko z podłoża, co 0.12s (silnik gry ma blokadę <0.15s)
        if isGroundedBhop(state) and now - bhopLastJump >= 0.12 then
            bhopLastJump = now
            -- Metoda 1: natywny system gry (IsJumpRequested + Jump -> JumpPower 19.5)
            if CharacterController then
                pcall(function() CharacterController.jump() end)
            end
            -- Metoda 2: bezpośredni impuls Humanoida (gwarancja odbicia)
            hum.Jump = true
        end
    end)

