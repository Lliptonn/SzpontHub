                        -- Lua ma limit 200 rejestrów na chunk)

    -- AUTO FARM: progi bezpieczeństwa (opis w sekcji AUTO FARM COINS v3)
    -- FARM_SAFE_SPEED_CAP: górna granica suwaka prędkości farmy. Wcześniej
    -- stała tu 24 i dlatego suwak "Farm Speed" NIC NIE ROBIŁ powyżej 25 —
    -- farma i tak jechała 24 studs/s. Teraz suwak jest HONOROWANY w całym
    -- zakresie 5-100.
    -- UWAGA: ruch farmy idzie przez CFrame, a MM2 odrzuca ("Invalid position",
    -- Error 267) skoki powyżej ~25-30 studs/s. Dlatego:
    --   * powyżej 30 studs/s dostajesz ostrzeżenie w etykiecie suwaka,
    --   * FARM_MAX_STEP limituje krok na tick, żeby po lagu nie było skoku,
    --   * jeśli dostaniesz kicka — obniż suwak albo użyj TP Farm (on jedzie
    --     WalkSpeed'em i ~200 studs/s przechodzi bez problemu).
    local FARM_SAFE_SPEED_CAP = 100
    local FARM_KICK_RISK_SPEED = 30   -- od tej wartości serwer może odmówić
    local FARM_MAX_STEP = 2.0         -- twardy limit kroku na tick (studs)
    local FARM_DT_CLAMP = 0.05      -- lag > 50 ms liczymy jako 50 ms
    local FARM_STUCK_TIME = 3       -- sekundy stania przy monecie bez efektu
    local FARM_BLACKLIST_TIME = 20  -- jak długo moneta jest ignorowana po "stuck"
    -- PANIKA: bliżej niż ta odległość (studów) morderca jest ZA BLISKO —
    -- farma rzuca cukierki i ucieka. Dalej (aż do suwaka "Murder Dist")
    -- farma dalej ZBIERA, tylko kierunek ruchu jest mieszany z ucieczką.
