    -- loading the config from disk (no file = no changes)
    function cfg.apply(data)
        if type(data) ~= "table" then return false end
        autoFarmCoins = data.autoFarmCoins == true
        farmSpeed = data.farmSpeed or farmSpeed
        farmLegit = data.farmLegit == true
        espEnabled = data.espEnabled == true
        antiAfk = data.antiAfk == true
        -- ANTI-FLING = OCHRONA, wiec brak pola w STARYM configie NIE moze jej
        -- wylaczac. Kiedys configi nie mialy "antiFling" i ladowanie takiego
        -- configu (nil == true -> false) zdejmowalo ochronę za kazdym razem.
        -- Teraz: stary config zostawia stan jaki jest; configy z polem (nowe
        -- zapisy) steruja ochrona normalnie.
        if data.antiFling ~= nil then antiFling = data.antiFling end
        fullbrightEnabled = data.fullbrightEnabled == true
        flying = data.flying == true
        noclip = data.noclip == true
        speedHack = data.speedHack == true
        walkSpeedVal = data.walkSpeedVal or walkSpeedVal
        spinbotEnabled = data.spinbotEnabled == true
        spinSpeedVal = data.spinSpeedVal or spinSpeedVal
        triggerbot = data.triggerbot == true
        autoGunTP = data.autoGunTP == true
        autoKillAll = data.autoKillAll == true
        autoKillMurder = data.autoKillMurder == true
        flingTargetEnabled = data.flingTargetEnabled == true
        targetPlayerName = data.targetPlayerName
        annoyEnabled = data.annoyEnabled == true
        annoyTargetName = data.annoyTargetName
        annoyUi.speed = data.annoySpeed or annoyUi.speed
        hitboxExpander = data.hitboxExpander == true
        hitboxSizeVal = data.hitboxSizeVal or hitboxSizeVal
        aimbotEnabled = data.aimbotEnabled == true
        aimbotFov = data.aimbotFov or aimbotFov
        aimbotSpeed = data.aimbotSpeed or aimbotSpeed
        thirdPerson = data.thirdPerson == true
        tpDist = data.tpDist or tpDist
        farmPanicDist = data.farmPanicDist or farmPanicDist
        flingMurderFull = data.flingMurderFull ~= false
        -- "= false" instead of "== true": old configs do not have these fields,
        -- and treating a missing value as ON would enable flinging everywhere after loading.
        roleFlags.sheriff = data.flingSheriff == true
        roleFlags.murderer = data.flingMurderer == true
        roleFlags.void = data.antiVoid == true
        tp.on = data.tpOn == true
        tp.sec = data.tpSec or tp.sec
        cfg.refresh()
        return true
    end

