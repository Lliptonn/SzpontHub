-- FPS: liczymy klatki RenderStepped; ping: Stats.Network "Data Ping" (ms).
-- Odświeżanie 2 razy na sekundę, żeby nie składać stringów co klatkę.
local wmFrames, wmLast, wmFps = 0, tick(), 0
local function wmPingMs()
    local ok, v = pcall(function()
        return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and type(v) == "number" then
        return tostring(math.floor(v + 0.5))
    end
    return "?"
end
runService.RenderStepped:Connect(function()
    wmFrames = wmFrames + 1
    local now = tick()
    if now - wmLast >= 0.5 then
        wmFps = math.floor(wmFrames / (now - wmLast) + 0.5)
        wmFrames = 0
        wmLast = now
        wmLabel.Text = "🔥 LiptonHub 🔥  |  FPS: " .. wmFps .. "  |  Ping: " .. wmPingMs() .. " ms"
    end
end)

