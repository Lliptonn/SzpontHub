    -- position of any element: BasePart > model pivot
    -- > first BasePart in descendants (waypoint folders)
    local function posOf(c)
        if c:IsA("BasePart") then return c.Position end
        if c:IsA("Model") then
            local ok, cf = pcall(function() return c:GetPivot() end)
            if ok and cf then return cf.Position end
        end
        local p = c:FindFirstChildWhichIsA("BasePart", true)
        if p then return p.Position end
        local m = c:FindFirstChildWhichIsA("Model", true)
        if m then
            local ok, cf = pcall(function() return m:GetPivot() end)
            if ok and cf then return cf.Position end
        end
        return nil
    end

    local function scanEvents()
        local out, seen = {}, {}
        local function add(name, pos)
            if not pos then return end
            if pos.X ~= pos.X or pos.Y ~= pos.Y then return end -- NaN
            local key = name .. "|" .. math.floor(pos.X) .. "," .. math.floor(pos.Z)
            if seen[key] then return end
            seen[key] = true
            out[#out + 1] = { name = name, x = pos.X, y = pos.Y, z = pos.Z }
        end
        local function addFolder(folder, prefix, cap)
            pcall(function()
                local n = 0
                for _, c in ipairs(folder:GetChildren()) do
                    if n >= (cap or 6) then break end
                    local p = posOf(c)
                    if p then
                        add(prefix .. c.Name, p)
                        n = n + 1
                    end
                end
            end)
        end
        local function lower(n) return string.lower(n) end
        -- 1) active world events (Whirlpool appears here among others)
        pcall(function() addFolder(workspace.world.events, "", 10) end)
        -- 2) active weather (Blizzard, Sandstorm...)
        pcall(function() addFolder(workspace.world.weather, "Weather: ", 6) end)
        -- 3) bosses and water/meteor phenomena
        pcall(function() addFolder(workspace.active.bosses, "Boss: ", 6) end)
        pcall(function() addFolder(workspace.active.watertraps, "Water: ", 4) end)
        pcall(function() addFolder(workspace.active.meteorItems, "Meteor: ", 4) end)
        pcall(function() addFolder(workspace.active["OceanPOI's"], "POI: ", 6) end)
        -- 4) event interactables (Aurora Totem, NorthMeteors)
        pcall(function()
            for _, c in ipairs(workspace.world.interactables:GetChildren()) do
                local nm = lower(c.Name)
                if nm:find("meteor") or nm:find("totem") or nm:find("aurora")
                    or nm:find("event") then
                    add(c.Name, posOf(c))
                end
            end
        end)
        -- 5) roaming boss paths (Megamouth, Livyatan, Dreadfin...)
        pcall(function()
            for _, c in ipairs(workspace.EventParts:GetChildren()) do
                local nm = lower(c.Name)
                if nm:find("megamouth") or nm:find("livyatan") or nm:find("cusk")
                    or nm:find("dreadfin") or nm:find("starfall")
                    or nm:find("migration") then
                    add("Spawn: " .. c.Name, posOf(c))
                end
            end
        end)
        -- 6) event zones (Kraken Lair, Atlantean Storm, trials...)
        pcall(function()
            for _, c in ipairs(workspace.zones.player:GetChildren()) do
                local nm = lower(c.Name)
                if nm:find("kraken") or nm:find("storm") or nm:find("trial")
                    or nm:find("abyss") or nm:find("whirlpool")
                    or nm:find("meteor") or nm:find("event") then
                    add("Zone: " .. c.Name, posOf(c))
                end
            end
        end)
        -- 7) static Whirlpools on the map (e.g. WrathOfOlympus)
        pcall(function()
            local n = 0
            for _, d in ipairs(workspace.world.map:GetDescendants()) do
                if n >= 6 then break end
                if lower(d.Name):find("whirlpool", 1, true) then
                    local p = posOf(d)
                    if p then
                        add("Whirlpool: " .. ((d.Parent and d.Parent.Name) or d.Name), p)
                        n = n + 1
                    end
                end
            end
        end)
        return out
    end

