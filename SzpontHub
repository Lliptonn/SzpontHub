    -- AIMBOT CONTROL (adaptive loop): every frame we measure the actual
    -- camera rotation after sending pixels -> rad/pixel of the mouse. The old formula
    -- px = rad * (speed*50) gave a gain >2 at high slider values
    -- (overshooting the target and swinging to another spot"); now the slider controls
    -- ONLY the fraction of the error per frame (0.15-0.95) -> always lands on the head.
    local aimCtl = { dx = 0, yawSent = nil, sens = 0.004 }

    -- FOV Circle + Crosshair + Aimbot -> runs on RenderStepped (AFTER CameraController)
    runService.RenderStepped:Connect(function()
        if not isCurrentGen() then return end
        -- FOV Circle update
        if aimbotEnabled then
            local viewportSize = cam.ViewportSize
            -- The circle = a true selection cone (tan), not a linear proportion:
            -- the old version at FOV 50 really showed ~26, so the crosshair
            -- went for targets outside the circle = snapping where nobody is".
            local fovDraw = math.min(aimbotFov, 85)
            local tanHalf = math.tan(math.rad(math.max(cam.FieldOfView, 1) / 2))
            local screenRadius = (viewportSize.Y / 2) * math.tan(math.rad(fovDraw)) / math.max(tanHalf, 1e-4)
            -- The OLD limit (min(W,H)/2 - 24 = 420 px) stopped the circle at FOV ~24:
            -- cam. FOV 50 => at slider FOV 24 the circle already touched top/bottom and further
            -- turning of the slider changed nothing. Now: the true cone works as long as it
            -- fits in the old limit (24 -> 420 px), and above that the radius grows
            -- linearly up to half of the longer screen side (768 px = touching the left/right
            -- edge = MAX visible size). The "stuck at 24" cap is gone.
            local edgeR = math.min(viewportSize.X, viewportSize.Y) / 2 - 24
            local maxR = math.max(viewportSize.X, viewportSize.Y) / 2
            local fovEdge = math.deg(math.atan(edgeR * math.max(tanHalf, 1e-4) / math.max(viewportSize.Y / 2, 1)))
            local growthCap = edgeR + math.clamp((aimbotFov - fovEdge) / math.max(100 - fovEdge, 1), 0, 1) * (maxR - edgeR)
            screenRadius = math.clamp(math.min(screenRadius, growthCap), 24, maxR)
            local cx = viewportSize.X / 2
            -- Aligned to the game crosshair (measured in BloxStrike: crosshair abs y=386.5,
            -- i.e. H/2 - inset 58; our circle at H/2+21 sat 20 px LOWER).
            -- GUI (IgnoreGuiInset=true) -> center = H/2, exactly like the game crosshair.
            local cy = viewportSize.Y / 2
            -- Drawing (emergency fallback) keeps the older +21 correction.
            local cyDraw = viewportSize.Y / 2 + 21
            local col = ppm and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(170, 50, 255)
            if fovCircle then
                fovCircle.Radius = screenRadius
                fovCircle.Position = Vector2.new(cx, cyDraw)
                fovCircle.Visible = true
                fovCircle.Color = col
            elseif fovFrame then
                -- GUI circle: position computed the same way as the game crosshair
                local d = math.floor(screenRadius * 2 + 0.5)
                fovFrame.Size = UDim2.fromOffset(d, d)
                fovFrame.Position = UDim2.fromOffset(math.floor(cx - screenRadius + 0.5), math.floor(cy - screenRadius + 0.5))
                fovFrame.Visible = true
                if fovStroke then
                    fovStroke.Color = col
                    fovStroke.Enabled = true
                end
            end
        else
            if fovCircle then fovCircle.Visible = false end
            if fovFrame then
                fovFrame.Visible = false
                if fovStroke then fovStroke.Enabled = false end
            end
        end

        -- Crosshair (red plus like the AWP) -> arms = GUI frames
        if crosshairLines[1] then
            local viewportSize = cam.ViewportSize
            local cx = viewportSize.X / 2
            -- H/2 (without +21): same as the game crosshair, measured at abs y=386.5
            -- at H=888.8 with inset 58 -> the red crosshair overlaps the green one.
            local cy = viewportSize.Y / 2
            local gap, len, t = 4, 10, 2
            -- same order as when created: top, bottom, left, right
            local arms = {
                { cx - t / 2, cy - gap - len, t, len },
                { cx - t / 2, cy + gap, t, len },
                { cx - gap - len, cy - t / 2, len, t },
                { cx + gap, cy - t / 2, len, t },
            }
            for i, line in ipairs(crosshairLines) do
                line.Visible = crosshairEnabled
                if crosshairEnabled then
                    local a = arms[i]
                    line.Position = UDim2.fromOffset(math.floor(a[1] + 0.5), math.floor(a[2] + 0.5))
                    line.Size = UDim2.fromOffset(a[3], a[4])
                end
            end
        end

        -- Aimbot -> snaps to the crosshair while RMB is held
        if aimbotEnabled and ppm and plr.Character then
            local camPos = cam.CFrame.Position
            local camDir = cam.CFrame.LookVector
            local best = nil
            local bestAngle = aimbotFov

            for _, p in pairs(playersService:GetPlayers()) do
                if p ~= plr and p.Character and isEnemy(p) then
                    if isAliveTarget(p, p.Character) then
                        -- Look for the best point: Head > UpperTorso > HumanoidRootPart
                        local parts = {"Head", "UpperTorso", "HumanoidRootPart"}
                        for _, partName in ipairs(parts) do
                            local part = p.Character:FindFirstChild(partName)
                            if part then
                                local toTarget = part.Position - camPos
                                local dist = toTarget.Magnitude
                                if dist > 0 and dist < 800 then
                                    local ang = math.deg(math.acos(math.clamp(camDir:Dot(toTarget.Unit), -1, 1)))
                                    if ang < bestAngle then
                                        bestAngle = ang
                                        best = part.Position
                                    end
                                end
                                break -- the first found part is enough
                            end
                        end
                    end
                end
            end

            if best then
                -- Mouse movement simulation: the game's own controller turns the camera AND the character,
                -- shots land on the target and the view does not snap back after releasing RMB.
                local dir = (best - camPos).Unit
                local look = cam.CFrame.LookVector
                local ang = math.acos(math.clamp(look:Dot(dir), -1, 1))
                if ang > math.rad(0.3) and mousemoverel and iswindowactive() then
                    -- ADAPTATION: we measure by how many degrees the camera actually
                    -- turned after the last pixels -> rad/pixel of the mouse.
                    local yawNow = math.atan2(look.X, -look.Z)
                    if aimCtl.yawSent ~= nil and aimCtl.dx ~= 0 then
                        local d = yawNow - aimCtl.yawSent
                        while d > math.pi do d = d - 2 * math.pi end
                        while d < -math.pi do d = d + 2 * math.pi end
                        local s = math.abs(d) / math.abs(aimCtl.dx)
                        if s > 0.0002 and s < 0.05 then
                            aimCtl.sens = aimCtl.sens * 0.6 + s * 0.4
                        end
                    end
                    aimCtl.yawSent = yawNow
                    local yawErr, pitchErr = 0, 0
                    local flatLook = Vector3.new(look.X, 0, look.Z)
                    local flatDir = Vector3.new(dir.X, 0, dir.Z)
                    if flatLook.Magnitude > 1e-4 and flatDir.Magnitude > 1e-4 then
                        flatLook = flatLook.Unit
                        flatDir = flatDir.Unit
                        yawErr = math.atan2(flatDir:Cross(flatLook).Y, flatLook:Dot(flatDir))
                    end
                    -- Pitch relative to the CAMERA AXIS (not the horizon): the old formula
                    -- asin(dir.Y)-asin(look.Y) gave the REVERSED SIGN for targets
                    -- off center (measured live: +10.3 instead of -14)
                    -- -> the crosshair moved up instead of down.
                    pitchErr = math.asin(math.clamp(dir:Dot(cam.CFrame.UpVector), -1, 1))
                    local k = 0.15 + (math.clamp(aimbotSpeed, 1, 125) - 1) / 124 * 0.8
                    local degPerPx = math.max(aimCtl.sens * (180 / math.pi), 1e-5)
                    local dx = math.clamp(math.floor(math.deg(yawErr) * k / degPerPx + 0.5), -500, 500)
                    local dy = math.clamp(math.floor(-math.deg(pitchErr) * k / degPerPx + 0.5), -500, 500)
                    aimCtl.dx = dx
                    if dx ~= 0 or dy ~= 0 then
                        pcall(mousemoverel, dx, dy)
                    end
                elseif not mousemoverel then
                    -- fallback when mousemoverel is missing: rotate the camera itself
                    local goal = CFrame.new(camPos, best)
                    local alpha = math.clamp(aimbotSpeed / 30, 0.05, 1)
                    cam.CFrame = cam.CFrame:Lerp(goal, alpha)
                end
            end
        end
    end)

    -- Target under the crosshair: a live enemy on the line of sight.
    -- THROUGH SMOKE/FIRE: the game fires bullets in the "Bullet" collision group
    -- (Shared.Raycast), while our bare raycast swallowed chunks of effects 
    -- InnerFire/OuterFire from GrenadeParticles have CanQuery=true (live
    -- scan), so the trigger stayed silent in molotov fire. Fix: the ray uses the
    -- same "Bullet" group + a loop that skips grenade effects
    -- (names Smoke/InnerFire/OuterFire/Molotov..., ancestors
    -- GrenadeParticles, plus semi-transparent/non-colliding ones) until it reaches
    -- a character or a real wall.
    local function passableFx(inst)
        if not inst:IsA("BasePart") then return false end
        local n = (inst.Name or ""):lower()
        if n == "fire" or n == "innerfire" or n == "outerfire"
            or n:find("smoke", 1, true) or n:find("molotov", 1, true)
            or n:find("inferno", 1, true) or n:find("flame", 1, true)
            or n:find("cloud", 1, true) then
            return true
        end
        -- ancestor = the effects container (a live part is often named "Part");
        -- no bare "fire" check on ancestors, because a player model = their nickname.
        local a = inst.Parent
        for _ = 1, 3 do
            if not a then break end
            local an = (a.Name or ""):lower()
            if an:find("grenadeparticles", 1, true) or an:find("smoke", 1, true)
                or an:find("molotov", 1, true) or an:find("inferno", 1, true) then
                return true
            end
            a = a.Parent
        end
        return (not inst.CanCollide) or inst.Transparency >= 0.5
    end

    local function crosshairEnemy()
        local ray = cam:ViewportPointToRay(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {plr.Character}
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.CollisionGroup = "Bullet"
        local org = ray.Origin
        local dir = ray.Direction * 1000
        local result = workspace:Raycast(org, dir, params)
        local guard = 0
        while result and guard < 8 do
            local inst = result.Instance
            local hitChar = inst:FindFirstAncestorOfClass("Model")
            local target = hitChar and playersService:GetPlayerFromCharacter(hitChar)
            if target then
                if target ~= plr and isEnemy(target) and isAliveTarget(target, hitChar) then
                    return true
                end
                return false
            end
            if passableFx(inst) then
                params:AddToFilter(inst)
                result = workspace:Raycast(org, dir, params)
                guard = guard + 1
            else
                return false
            end
        end
        return false
    end

    -- Triggerbot (fires when the crosshair is on a live enemy) + DELAY:
    -- triggerDelayMs = minimum gap between shots in ms (0 = every frame,
    -- i.e. as before the slider was added). tick() gives seconds, we compute a cooldown.
    runService.RenderStepped:Connect(function()
        if not isCurrentGen() then return end
        if triggerbot and plr.Character and crosshairEnemy() then
            local now = tick()
            if now - lastTriggerShot >= triggerDelayMs / 1000 then
                lastTriggerShot = now
                local tool = plr.Character:FindFirstChildOfClass("Tool")
                if tool then
                    pcall(function() tool:Activate() end)
                end
                pcall(function()
                    vu:CaptureController()
                    vu:ClickButton1(Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2))
                end)
            end
        end
    end)

    -- SILENT AIM -> the bullet SNAPS to the player who peeks out
    -- (exposed body part), and by default the shot goes into their HEAD.
    -- Dump: Weapon:shoot() captures Bullet:create() -> _performRaycast
    -- (Origin/Direction/Distance/Hits) and builds Inventory.ShootWeapon.Send from it.
    -- We override the create method on the Bullet class module: the original still computes
    -- spread/recoil, and then - when the option is on - we redirect the Direction
    -- and rebuild the Hit with the SAME game functions (Shared.Raycast.cast +
    -- castThrough + GetRayIgnore) => a packet identical to vanilla, only the target
    -- differs. The server gets a normal raycast, hence a normal headshot.
    -- Target order: (1) NEAREST enemy with an exposed head = "peeking" 
    -- the bullet ray hits the head exactly; (2) if nobody exposes a head,
    -- the nearest enemy with any sticking-out body part (arm/leg/torso).
    -- The game's own raycast skips accessories/hats, so we aim at the part's center
    -- and count it as exposed only when IT is the first hit.
    -- Anticheat: _performRaycast scans getfenv() up to 10 levels up and at
    -- getgenv/hookfunction does v_u_1 = {} (breaks the metatable of FUTURE weapons).
    -- So the wrapper/redirect use setfenv to an EMPTY env (everything is upvalues),
    -- at startup we verify the env; if setfenv did not work -> we
    -- install nothing (zero risk for the game).
    -- LOCAL BLOCK (do ... end): Luau's limit is 200 local registers per
    -- function. This SILENT AIM machine declares ~55 locals and startBloxStrikeScript
    -- pushes it over the limit -> "Out of local registers ... exceeded limit 200".
    -- The block frees the registers when it ends; logic and setfenv unchanged.
    do
    local G = _G
    -- THREE INDEPENDENT SILENT AIM modes: each toggle works on its own
    -- (without forcing Silent Aim -> Wallbang -> TP Shot in order),
    -- combinations still stack. silentAny = whether the machine should run
    -- (redirect + autofire + blinks + knife + revolver + double tap);
    -- throughWalls = whether we may pick a target BEHIND cover (Wallbang / TP Shot /
    -- Auto Knife -> plain Silent Aim only aims at visible ones, as before;
    -- Double Tap without other flags also only hits visible ones).
    local function silentAny()
        return G.__liptonSilentAim or G.__liptonWallbang or G.__liptonTPShot or G.__liptonAutoKnife or G.__liptonAutoRevolver or G.__liptonDoubleTap
    end
    local function throughWalls()
        return G.__liptonWallbang or G.__liptonTPShot or G.__liptonAutoKnife
    end
    -- DOUBLE TRAP: forced target for the second shot -> set here before
    -- the second fireWeapon (Double Tap mode), read by doRedirect
    -- instead of its own nearest-target choice, cleared after the shot.
    -- Declared BEFORE doRedirect because the wrapper has an empty env (upvalues only).
    local redirectTarget, redirectAim = nil, nil
    local pcall_ = pcall
    local ipairs_ = ipairs
    local insertT = table.insert
    local sortT = table.sort
    local v3zero = Vector3.zero
    local v3new = Vector3.new
    local Players_svc = game:GetService("Players")
    local BulletClass, RaycastLib, GetRayIgnore
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        BulletClass = require(rs.Components.Weapon.Classes.Bullet)
        RaycastLib = require(rs.Shared.Raycast)
        GetRayIgnore = require(rs.Components.Common.GetRayIgnore)
    end)

    if not (BulletClass and RaycastLib and GetRayIgnore) then
        warn("[SzpontHub] BS Silent Aim: missing game modules (Bullet/Raycast/GetRayIgnore) -> bullet redirection will not work")
    end

    local bSilent = createButton("Silent Aim: OFF", 10, "RageBot")
    bSilent.MouseButton1Click:Connect(function()
        local on = not G.__liptonSilentAim
        G.__liptonSilentAim = on
        bSilent.Text = on and "Silent Aim: ON" or "Silent Aim: OFF"
        bSilent.BackgroundColor3 = on and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
        updateActiveCheatsList()
    end)

    -- WALLBANG (a separate silent aim, no Silent Aim required): a target behind
    -- ANY cover is allowed too,
    -- and the penetration budget is forced to 1e9 -> in the game's v_u_40 the stop condition is
    -- `accumulated thickness > material threshold + budget`, so 1e9 is never
    -- exceeded and the castThrough loop goes through the wall
    -- regardless of thickness/material. The GEOMETRY data stays real
    -- (positions/instances/normals from the game's raycasts, entry/exit pairs computed
    -- by a reverse raycast as in vanilla) -> only the reach
    -- of the pass and the tracer distance change (to the target, not to the wall). The game has a native
    -- wallbang (AK: Penetration 0.5, WallbangMultiplier 0.75 = 75% damage through
    -- walls); our variant should also handle thick walls -> final
    -- check: the server may recompute the budget (live test).
    local bWB = createButton("Wallbang: OFF", 11, "RageBot")
    bWB.MouseButton1Click:Connect(function()
        local on = not G.__liptonWallbang
        G.__liptonWallbang = on
        bWB.Text = on and "Wallbang: ON" or "Wallbang: OFF"
        bWB.BackgroundColor3 = on and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
        updateActiveCheatsList()
    end)

    -- TP SHOT -> a separate silent aim (needs neither Silent Aim nor Wallbang):
    -- target behind cover chosen via throughWalls, blink next to the victim -> 
    -- point-blank shot to the head (full damage, always a headshot - without the wallbang
    -- multiplier of 0.75) -> back. Window ~0.1 s -> invisibility to others is NOT
    -- guaranteed (replication ~20-60 Hz), the server may also kick you
    -- for the position jump -> test it.
    local bTP = createButton("TP Shot: OFF", 12, "RageBot")
    bTP.MouseButton1Click:Connect(function()
        local on = not G.__liptonTPShot
        G.__liptonTPShot = on
        bTP.Text = on and "TP Shot: ON" or "TP Shot: OFF"
        bTP.BackgroundColor3 = on and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
        updateActiveCheatsList()
    end)

    -- AUTO KNIFE -> blink behind the back + RMB (heavy -> BackStab). Enabling =
    -- instantly equips the knife (slot "Melee"; InvCtl is still not
    -- catchable as a local here, so require -> the cache returns the same
    -- singleton anyway). A target behind a wall chosen via throughWalls -> plain Auto
    -- Knife is enough (no Wallbang). Disabling = the weapon stays as it is.
    local bAK = createButton("Auto Knife: OFF", 14, "RageBot")
    bAK.MouseButton1Click:Connect(function()
        local on = not G.__liptonAutoKnife
        G.__liptonAutoKnife = on
        bAK.Text = on and "Auto Knife: ON" or "Auto Knife: OFF"
        bAK.BackgroundColor3 = on and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
        if on then
            pcall(function()
