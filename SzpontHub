    -- TP SHOT — BLINK EGZEKUCJI (helper; wchodzi na listę setfenv obok,
    -- więc całe środowisko to local-e jako upvalues). Działa TYLKO gdy
    -- Silent Aim + Wallbang ON (wtedy findSilentTarget sięga po cel zza
    -- zasłony) i wybrany cel jest realnie zasłonięty. Przebieg: zapis
    -- pozycji → teleport ~3 j. od ofiary (za jej plecami od nas, na
    -- wysokości torsu) →0.05 s na replikację pozycji → WYMUSZONA kamera
    -- na punkcie ofiary (Origin pakietu = ViewportPointToRay kamery; z wygładzeniem ~0.06 s kamera jeszcze leciałaby ze starego miejsca,
    -- a serwer liczy ray od Origin) → strzał (cel = głowa, bez ściany →
    -- pełny dmg, AK143 = oneshot) →0.05 s na przetworzenie pakietu →
    -- powrót. Okno ~0.1 s: inni gracze MOGĄ zobaczyć pośrednią pozycję
    -- (replikacja ~20-60 Hz) — brak gwarancji niewidoczności; serwer
    -- może zkickać za nagły skok pozycji — dlatego najpierw test.
    -- Zwraca true = blink wykonany (pomijamy zwykły strzał z dystansu).
    local taskWait = task.wait
    local cfLookAt = CFrame.lookAt
    local v3new = Vector3.new
    local tonumber_ = tonumber
    local tostring_ = tostring
    local tpBusy = false
    -- Statystyki blinku (odczyt: _G.__liptonTPStat) — mierzą, czy blink
    -- w ogóle odpala i gdzie ewentualnie staje (err = ostatni powód).
    local tpStat = { try = 0, vis = 0, blink = 0, ok = 0, fail = 0, shots = 0, err = "" }
    G.__liptonTPStat = tpStat
    -- Statystyka Auto Revolvera (odczyt: _G.__liptonRevStat) + stałe
    -- przechwycone jako local-e: revolverShot dostaje pusty env przez
    -- setfenv, więc Enum/Vector2 muszą być upvalue, nie globaly.
    local revStat = { shot = 0, err = "" }
    G.__liptonRevStat = revStat
    local lastRevShot = 0
    local utMouseButton2 = Enum.UserInputType.MouseButton2
    local v2new = Vector2.new
    local function tpShotBlink(part, w)
        tpStat.blink = tpStat.blink + 1
        if tpBusy then tpStat.err = "busy" return false end
        local ch = plr.Character
        if not ch or ch:GetAttribute("Dead") then tpStat.err = "dead" return false end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then tpStat.err = "nohrp" return false end
        local saved = hrp.CFrame
        local tpos = part.Position
        -- Kotwica = tors ofiary (stoimy na podłożu obok niej, nie na
        -- wysokości głowy); brak roota → sam punkt celu.
        local vch = part:FindFirstAncestorWhichIsA("Model")
        local vroot = vch and vch:FindFirstChild("HumanoidRootPart")
        local anchor = vroot and vroot.Position or tpos
        -- Kierunek: od ofiary w stronę swojego starego miejsca (stajemy
        -- za jej plecami względem nas, minimalnie3 j. — nie w niej).
        local d = saved.Position - anchor
        local h = v3new(d.X, 0, d.Z)
        if h.Magnitude < 1 then h = v3new(0, 0, -3) end
        h = h.Unit
        local dest = anchor + h * 3
        tpBusy = true
        local ok, err = pcall_(function()
            hrp.CFrame = cfLookAt(dest, tpos)
            taskWait(0.05)
            local cam = ws.CurrentCamera
            if cam then cam.CFrame = cfLookAt(dest, tpos) end
            fireWeapon(w)
            tpStat.shots = tpStat.shots + 1
            -- DRUGA DAWKA w kadencji broni (Negev FireRate =0.075 s):
            -- head115 z hełmem (ArmorPen0.75 → ~86) NIE zabija z jednego
            -- strzału — drugi head w oknie blinku = gwarancja oneshota.
            -- Wolne bronie (interwał >0.12 s, np. AWP) pomijamy — ich head
            -- i tak zabija, a czekanie rozciągnęłoby okno blinku. Interwał
            -- ≥ FireRate = ta sama kadencja co przy strzale z ręki, więc
            -- serwer nie widzi przyspieszonego ognia.
            local fr = 0.075
            pcall_(function() fr = tonumber_(w.Properties.FireRate) or fr end)
            if fr + 0.01 <= 0.12 then
                taskWait(fr + 0.01)
                if cam then cam.CFrame = cfLookAt(dest, tpos) end
                fireWeapon(w)
                tpStat.shots = tpStat.shots + 1
            end
            taskWait(0.05)
        end)
        pcall_(function()
            hrp.CFrame = saved
        end)
        tpBusy = false
        if ok then
            tpStat.ok = tpStat.ok + 1
        else
            tpStat.fail = tpStat.fail + 1
            tpStat.err = tostring_(err)
        end
        return ok
    end

    -- AUTO KNIFE — wymuszone wyposażenie noża: equip(slot, index) gra
    -- sama wysyła WeaponEquipped do serwera. Indeks loadoutu noża = pierwszy
    -- klucz slotu "Melee" (domyślnie1); przy problemie trigger powtórzy
    -- (self-heal). pairs_ jako local, bo helper ma puste środowisko.
    local pairs_ = pairs
    local function equipKnife()
        pcall_(function()
            local inv = InvCtl.getCurrentInventory()
            local slotT = inv and inv.Melee
            local items = slotT and slotT._items
            local idx = 1
            if items then
                for k in pairs_(items) do
                    idx = k
                    break
                end
            end
            InvCtl.equip("Melee", idx)
        end)
    end

    -- AUTO KNIFE v2 — BLINK ZA PLECY + PPM (heavy). Gra robi dokładnie
    -- to, co przy trzymanym PPM: Melee:shoot(true) → "Heavy Swing", a kąt
    -- >100° za plecami ofiary (test v_u_24) → "BackStab" = serwerowe
    -- one-shot. Dest = ofiara minus jej LookVector ×2.5 (Range noża =3 →
    -- ray z kamery trafia w plecy, kąt wychodzi 180°). v2: hold0.2 s
    -- przed ciosem — serwer waliduje kąt/dystans po SWOJEJ kopii naszej
    -- pozycji, więc pozycja musi zdążyć się zreplikować (0.05 s było za
    -- mało: pakiet leciał, serwer widział nas jeszcze z daleka →
    -- odrzucenie = "nawala ale nie robi nic"). CFrame postaci i kamery
    -- wymuszany PONOWNIE tuż przed rayem (lokalny MovementV2 potrafi
    -- nadpisać pozycję w trakcie holdu). Diagnostyka: kray = kopia
    -- promienia Melea (trafienie = warunek MeleeAttack.Send — bez niego
    -- animacja leci, a pakiet nie wychodzi), khp = HP ofiary przed → po
    -- (odczytywane przy kolejnym ciosie, bo hp wraca z serwera z
    -- opóźnieniem; >-1 = model zniknął = zwykle zabójstwo).
    local RaycastParams_ = RaycastParams
    local kLastV, kLastHp = nil, nil
    local function knifeBlink(part, w, ignore)
        tpStat.blink = tpStat.blink + 1
        if kLastV and kLastHp ~= nil then
            local hum0 = kLastV:FindFirstChildOfClass("Humanoid")
            tpStat.khp = tostring_(kLastHp) .. ">" .. tostring_(hum0 and hum0.Health or -1)
            kLastV, kLastHp = nil, nil
        end
        if tpBusy then tpStat.err = "busy" return false end
        local ch = plr.Character
        if not ch or ch:GetAttribute("Dead") then tpStat.err = "dead" return false end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then tpStat.err = "nohrp" return false end
        local vch = part:FindFirstAncestorWhichIsA("Model")
        local vroot = vch and vch:FindFirstChild("HumanoidRootPart")
        if not vroot then tpStat.err = "novictimroot" return false end
        local saved = hrp.CFrame
        local aim = vroot.Position
        local behind = aim - vroot.CFrame.LookVector * 2.5
        tpBusy = true
        local ok, err = pcall_(function()
            hrp.CFrame = cfLookAt(behind, aim)
            taskWait(0.2)
            hrp.CFrame = cfLookAt(behind, aim)
            local cam = ws.CurrentCamera
            if cam then cam.CFrame = cfLookAt(behind, aim) end
            local rng = 3
            pcall_(function() rng = tonumber_(w.Properties.Range) or rng end)
            if cam and ignore then
                local rp = RaycastParams_.new()
                rp.FilterDescendantsInstances = ignore
                local r = ws:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * rng, rp)
                if r then
                    tpStat.kray = r.Instance.Name .. "/" .. (r.Instance.Parent and r.Instance.Parent.Name or "?")
                else
                    tpStat.kray = "MISS"
                end
            else
                tpStat.kray = "nocam"
            end
            local hum = vch:FindFirstChildOfClass("Humanoid")
            kLastV, kLastHp = vch, (hum and hum.Health or -1)
            w:shoot(true)
            tpStat.shots = tpStat.shots + 1
            taskWait(0.15)
        end)
        pcall_(function()
            hrp.CFrame = saved
        end)
        tpBusy = false
        if ok then
            tpStat.ok = tpStat.ok + 1
        else
            tpStat.fail = tpStat.fail + 1
            tpStat.err = tostring_(err)
        end
        return ok
    end

    -- AUTO REVOLVER — strzał ścieżką PPM gry: akcja Secondary Fire woła
    -- v6:startRevolverSecondaryFire(getInputBinding(u4)) — dla prawego
    -- klawisza binding = Enum.UserInputType.MouseButton2, więc tu to samo
    -- wywołanie wprost (bez symulacji wejścia, bez okna). Własny cooldown
    -- = FireRate broni + pominięcie gdy trwa strzał — bez spamu stanu R8.
    -- Fallback: naturalny klik PPM przez VirtualUser (wzorzec triggerbota,
    -- tylko Button2), gdyby metoda nie istniała.
    local function revolverShot(w, pr)
        local now = tick_()
        local cd = tonumber_(pr and pr.FireRate) or 0.706
        if now - lastRevShot < cd then
            revStat.err = "cd"
            return false
        end
        if w.IsShooting then
            revStat.err = "shooting"
            return false
        end
        if w.IsReloading then
            revStat.err = "reload"
            return false
        end
        lastRevShot = now
        local ok, err = pcall_(w.startRevolverSecondaryFire, w, utMouseButton2)
        if ok then
            -- Strzał dzieje się synchronicznie w start (shoot("Secondary"));
            -- stop = druga połowa tapa PPM jak przy realnym kliknięciu
            -- (czyszczenie IsAlternativeFireHeld/Binding — gra i tak by to
            -- zrobiła przy braku fizycznego trzymania PPM, ale bezpieczniej).
            pcall_(w.stopRevolverSecondaryFire, w)
            revStat.shot = revStat.shot + 1
            revStat.err = ""
            return true
        end
        revStat.err = "direct:" .. tostring_(err)
        local ok2, err2 = pcall_(function()
            vu:CaptureController()
            local c = ws.CurrentCamera or cam
            vu:ClickButton2(v2new(c.ViewportSize.X / 2, c.ViewportSize.Y / 2))
        end)
        if ok2 then
            revStat.shot = revStat.shot + 1
            revStat.err = "fallback"
            return true
        end
        revStat.err = "click:" .. tostring_(err2)
        return false
    end

    -- DOUBLE TRAP — statystyka (odczyt: _G.__liptonDTStat) + helper drugiego
    -- strzału POZA COOLDOOWNEM: shoot() blokuje ogień wyłącznie flagą
    -- IsShooting (do czasu delaya FireRate wewnątrz gry), więc przed drugim
    -- strzałem wymuszamy gotowość (IsShooting = false) i przywracamy, gdyby
    -- strzał nie wypalił — gra i tak skasuje flagę swoim delayem. Strzał2
    -- wychodzi więc w tej samej klatce co strzał1.
    -- Cel: najpierw DRUGI wystający wróg (przy dwóch wychylonych — po kuli
    -- na każdego); bez drugiego — powtórka w pierwszy cel. Bez celu strzał
    -- nie wychodzi.
    local dtStat = { shot = 0, skip = 0, err = "" }
    G.__liptonDTStat = dtStat
    -- Cel drugiego strzału (wspólny dla ścieżek LPM i R8): NAJPIERW inny
    -- wystający wróg (skip pierwszego celu — przy dwóch wychylonych po kuli
    -- na każde); bez drugiego → powtórka w pierwszy cel (dobicie po pudle /
    -- strzale obok); nikogo → nil (zero ślepego ognia).
    local function doubleTapTarget(origin, ignoreList, range, char1)
        local t2, a2 = findSilentTarget(origin, ignoreList, range, nil, char1)
        if not t2 then
            t2, a2 = findSilentTarget(origin, ignoreList, range, char1)
        end
        return t2, a2
    end
    local function doubleTap(w, part1, ignoreList)
        local pr = w.Properties
        if not pr or pr.Class ~= "Weapon" then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "noweapon"
            return
        end
        local char1 = part1 and part1:FindFirstAncestorWhichIsA("Model")
        if not char1 then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "nochar"
            return
        end
        if w.IsReloading then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "reload"
            return
        end
        if (tonumber_(w.Rounds) or 1) <= 0 then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "norounds"
            return
        end
        local myCh = plr.Character
        if not myCh or myCh:GetAttribute("Dead") then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "dead"
            return
        end
        if InvCtl == nil or InvCtl.getCurrentEquipped() ~= w then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "switch"
            return
        end
        local camT = ws.CurrentCamera
        if not camT then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "nocam"
            return
        end
        local origin = camT.CFrame.Position
        local range = G.__liptonLastRange or 1000
        local t2, a2 = doubleTapTarget(origin, ignoreList, range, char1)
        if not t2 then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "notarget"
            return
        end
        -- POZA COOLDOOWNEM: czyścimy gotowość, strzał w tej samej klatce,
        -- przywracamy flagę tylko gdyby strzał nie wypalił (gdy wypalił —
        -- shoot sam ustawia IsShooting = true i jego delay FireRate to
        -- skasuje). pcall: nawet gdyby shoot rzucił, redirectTarget i tak
        -- wraca do nil (stary cel nie śledzi kolejnych pocisków).
        redirectTarget, redirectAim = t2, a2
        local wasShooting = w.IsShooting
        w.IsShooting = false
        pcall_(fireWeapon, w)
        if not w.IsShooting and wasShooting then
            w.IsShooting = true
        end
        redirectTarget, redirectAim = nil, nil
        dtStat.shot = dtStat.shot + 1
        dtStat.err = ""
    end

    -- DOUBLE TRAP pod R8 (ścieżka Auto Revolvera): drugi PPM POZA
    -- COOLDOOWNEM — własny cd revStat zerowany i IsShooting gry wymuszony
    -- na false → dwie kule z revolvera w jednej klatce. Cel jak wyżej;
    -- nieudana próba = przywrócenie cd i licznika revStat bez szkody.
    local function revolverDouble(w, prR, part1, ignoreList)
        local char1 = part1 and part1:FindFirstAncestorWhichIsA("Model")
        if not char1 then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "nochar"
            return
        end
        if w.IsReloading then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "reload"
            return
        end
        if (tonumber_(w.Rounds) or 1) <= 0 then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "norounds"
            return
        end
        local camT = ws.CurrentCamera
        if not camT then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "nocam"
            return
        end
        local origin = camT.CFrame.Position
        local range = G.__liptonLastRange or 1000
        local t2, a2 = doubleTapTarget(origin, ignoreList, range, char1)
        if not t2 then
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "notarget"
            return
        end
        redirectTarget, redirectAim = t2, a2
        local wasShooting = w.IsShooting
        local prevRev = lastRevShot
        w.IsShooting = false
        lastRevShot = 0
        local ok2 = revolverShot(w, prR)
        if not w.IsShooting and wasShooting then
            w.IsShooting = true
        end
        if not ok2 then
            lastRevShot = prevRev
        end
        redirectTarget, redirectAim = nil, nil
        if ok2 then
            dtStat.shot = dtStat.shot + 1
            dtStat.err = ""
        else
            dtStat.skip = dtStat.skip + 1
            dtStat.err = "rev:" .. (revStat.err or "")
        end
    end

    local function silentTrigger()
        if not trigClean then return end
        if not silentAny() then return end
        if InvCtl == nil then return end
        if RaycastLib == nil or GetRayIgnore == nil then return end
        if uis:GetFocusedTextBox() ~= nil then return end
        local ch = plr.Character
        if not ch or ch:GetAttribute("Dead") then return end
        local camT = ws.CurrentCamera
        if not camT then return end
        local now = tick_()
        if now - lastTrig < 0.15 then return end
        lastTrig = now
        local ignoreList = GetRayIgnore()
        if not ignoreList then return end
        local part = findSilentTarget(camT.CFrame.Position, ignoreList, G.__liptonLastRange or 1000)
        if not part then return end
        local w = InvCtl.getCurrentEquipped()
        -- BRAMKA RUNDY: blink (TP Shot i Auto Knife) wyłącznie przy
        -- "Round In Progress" — przy "Buy Period"/"Warmup" stoimy
        -- spokojnie (kupowanie bez teleportów); blink wraca sam w start
        -- rundy, gdy GameState się przełączy.
        local roundLive = ws:GetAttribute("GameState") == "Round In Progress"
        if roundLive and not tpBusy then
            -- AUTO KNIFE (priorytet): blink za plecy + heavy = BackStab.
            if G.__liptonAutoKnife then
                local isMelee = w and w.Properties and w.Properties.Class == "Melee"
                if not isMelee then
                    equipKnife()
                    tpStat.err = "knife-equip"
                elseif tick_() - (w.WeaponEquippedTick or 0) <= 1 then
                    tpStat.err = "knife-cd"
                elseif w.IsShooting then
                    tpStat.err = "knife-swing"
                else
                    tpStat.try = tpStat.try + 1
                    if knifeBlink(part, w, ignoreList) then return end
                end
            end
            -- TP SHOT: cel zza zasłoną → blink z bliska; gdy nóż przejął
            -- ścieżkę (broń = Melee i Auto Knife ON), TP Shot nie mruga
            -- z nożem w ręku — czeka na powrót do bronii palnej.
            if G.__liptonTPShot and not (G.__liptonAutoKnife and w and w.Properties and w.Properties.Class == "Melee") then
                tpStat.try = tpStat.try + 1
                local vch = part:FindFirstAncestorWhichIsA("Model")
                if not clearOfWalls(camT.CFrame.Position, part, vch, ignoreList) then
                    if tpShotBlink(part, w) then return end
                else
                    tpStat.vis = tpStat.vis + 1
                end
            end
        end
        -- AUTO REVOLVER — strzela wyłącznie z revolverem i przez PPM gry;
        -- z samą tą flagą inne bronie nie strzelają (tryb tylko-revolver),
        -- z Silent Aim/Wallbang/TP Shot → zwykły fireWeapon (LPM).
        local prR = w and w.Properties
        if G.__liptonAutoRevolver then
            if prR and prR.ShootingOptions == "Revolver" then
                -- Para PPM poza cooldownem, gdy Double TapON — inaczej
                -- singiel R8 jak dotychczas.
                if revolverShot(w, prR) and G.__liptonDoubleTap then
                    revolverDouble(w, prR, part, ignoreList)
                end
                return
            end
            if not (G.__liptonSilentAim or G.__liptonWallbang or G.__liptonTPShot or G.__liptonDoubleTap) then
                return
            end
        end
        fireWeapon(w)
        -- DOUBLE TRAP: drugi strzał POZA COOLDOOWNEM (ta sama klatka) —
        -- drugi wychylony wróg (po kuli na każde), albo powtórka w
        -- pierwszy cel, gdy nikogo drugiego nie ma.
        if G.__liptonDoubleTap and prR and prR.Class == "Weapon" then
            doubleTap(w, part, ignoreList)
        end
    end
    trigClean = pcall(function()
        setfenv(silentTrigger, {})
        setfenv(fireWeapon, {})
        setfenv(tpShotBlink, {})
        setfenv(knifeBlink, {})
        setfenv(equipKnife, {})
        setfenv(silentAny, {})
        setfenv(throughWalls, {})
        setfenv(revolverShot, {})
        setfenv(doubleTap, {})
        setfenv(doubleTapTarget, {})
        setfenv(revolverDouble, {})
        for _, f in ipairs({silentTrigger, fireWeapon, tpShotBlink, knifeBlink, equipKnife, silentAny, throughWalls, revolverShot, doubleTap, doubleTapTarget, revolverDouble}) do
            local e = getfenv(f)
            if e.getgenv or e.hookfunction then
                error("dirty env")
            end
        end
    end)
    if trigClean then
        runService.Heartbeat:Connect(silentTrigger)
    else
        warn("[SzpontHub] BS Silent Aim: env check autofire nie przeszedł — Heartbeat trigger NIE podłączony")
    end
    end -- koniec bloku SILENT AIM (zwalnia lokalne rejestry)

    -- BUNNY HOP v5 — jedyne źródło skoku w BloxStrike.
    -- Gra NIE używa stanów Humanoida: postacią steruje własna symulacja
    -- MovementV2 (tick 64 Hz = 15.625 ms). Zdekompilowany ProvenSimulator
    -- akceptuje skok tylko wtedy, gdy:
    --   OnGround AND (edge: input.Jump AND NIE poprzedni JumpHeld)
    --   AND (Tick - LastJumpTick > 1)
    -- Bufor bhopa (JumpBufferTicks) działa wyłącznie w trybie Casual,
    -- Competitive ma BunnyHopInputBufferTicks = 0 => tylko edge.
    -- Jedyna ścieżka wejścia skoku: CharacterController.jump() bez argumentu
    -- => SetJumpInput(nil) => JumpPulsePending = true => dokładnie JEDEN tick
    -- z Buttons.Jump = true (SampleInput zjada pulę natychmiast).
    local CharacterController = nil
    pcall(function()
        CharacterController = require(game.ReplicatedStorage.Controllers.CharacterController)
    end)

    -- BHOP UNLOCKER — zdejmuje TWARDY cap prędkości24.5 z gry BloxStrike.
    -- W dumpie (ReplicatedStorage/Classes/Character.luau) MoveFunction robi:
    --   if24.5 < horizontalMag(GlobalVelocity) then GlobalVelocity = skaluj do24.5
    -- a niżej Humanoid.WalkSpeed = |LocalVelocity| (liczone z GlobalVelocity)
    -- przenosi ten cap na fizykę. AirAccelerate dokłada tylko2.5 pożądanej
    -- prędkości na tick — więc clamp co tick zjadał cały zysk z air-strafe.
    -- Nadajemy instancji Character własną metatable: odczyty i zapisy pola
    -- GlobalVelocity przechodzą przez nas i zapis "skaluj do24.5" pomijamy.
    -- Tarcie, odbicia od ścian i przyspieszenia gry zostają fabryczne —
    -- znika wyłącznie cap, więc bhop nabiera prędkości bez limitu.
    local function ensureBhopUnlock()
        if not bhopUnlocker or not CharacterController then
            return
        end
        local ok, ch = pcall(function()
            return CharacterController.getCurrentCharacter()
        end)
        if not ok or type(ch) ~= "table" or rawget(ch, "__szBhopHook") then
            return
        end
        local origMT = getmetatable(ch)
        if not origMT then
            return
        end
        local baseIndex = rawget(origMT, "__index")
        local proxy = {}
        for k, v in pairs(origMT) do
            if type(k) == "string" and string.sub(k, 1, 2) == "__" and k ~= "__index" and k ~= "__newindex" then
                proxy[k] = v
            end
        end
        proxy.__index = function(t, k)
            if k == "GlobalVelocity" then
                return rawget(t, "__szGV")
            end
            if baseIndex == nil then
                return origMT[k]
            elseif type(baseIndex) == "function" then
                return baseIndex(t, k)
            end
            return baseIndex[k]
        end
        proxy.__newindex = function(t, k, v)
            if k == "GlobalVelocity" then
                local cur = rawget(t, "__szGV")
                if bhopUnlocker and cur ~= nil and v ~= nil then
                    local newH = math.sqrt(v.X * v.X + v.Z * v.Z)
                    local curH = math.sqrt(cur.X * cur.X + cur.Z * cur.Z)
                    -- clamp gry zawsze trafia w ~24.5 w poziomie ze spadkiem -> pomijamy
                    if math.abs(newH - 24.5) < 0.02 and curH > newH + 0.05 then
                        rawset(t, "__szGV", Vector3.new(cur.X, v.Y, cur.Z))
                        return
                    end
                end
                rawset(t, "__szGV", v)
                return
            end
            rawset(t, k, v)
        end
        local gv = rawget(ch, "GlobalVelocity")
        if gv ~= nil then
            rawset(ch, "__szGV", gv)
            rawset(ch, "GlobalVelocity", nil)
        end
        rawset(ch, "__szBhopHook", true)
        setmetatable(ch, proxy)
    end

    runService.Heartbeat:Connect(function()
        if bhopUnlocker then
            ensureBhopUnlock()
        end
    end)

    -- SPEED HACK (suwak) — wymusza prędkość DWOMA warstwami, bo gra trzyma
    -- ją w dwóch miejscach (dump Character.luau):
    --   lot (L653):   AssemblyLinearVelocity = GlobalVelocity -> skalujemy sim,
    --   ziemia (L681): Humanoid.WalkSpeed = |LocalVelocity|   -> nadpisujemy
    --     silnik; do tego Accelerate ma min(...,24.5) (L666) i clamp
    --     GlobalVelocity do24.5 (L673-680), więc bez simu sam WalkSpeed
    --     przyspieszałby tylko do lądowania.
    -- Zapisy w Stepped (przed fizyką) i Heartbeat (po ticku gry) — cokolwiek
    -- gra ustawi w swojej pętli, ostatnim słowem przed fizyką jest nasze.
    -- Kierunek zostaje z simu gry, idzie TYLKO w górę (nigdy nie zdejmuje
    -- prędkości nabitej bhopem), więc oba cheaty się nie gryzą.
    local function speedHackTick()
        if not speedHack then
            return
        end
        -- warstwa1: sim gry (GlobalVelocity) -> lot + WalkSpeed przez |LocalVelocity|
        if CharacterController then
            local ok, ch = pcall(function()
                return CharacterController.getCurrentCharacter()
            end)
            if ok and type(ch) == "table" then
                local ok2, gv = pcall(function()
                    return ch.GlobalVelocity
                end)
                if ok2 and typeof(gv) == "Vector3" then
                    local h = math.sqrt(gv.X * gv.X + gv.Z * gv.Z)
                    if h > 1 then
                        local target = math.max(h, speedHackValue)
                        local k = target / h
                        pcall(function()
                            ch.GlobalVelocity = Vector3.new(gv.X * k, gv.Y, gv.Z * k)
                        end)
                    end
                end
            end
        end
        -- warstwa2: silnik -> twardy nadpis WalkSpeed wartością suwaka
        if plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                pcall(function()
                    hum.WalkSpeed = speedHackValue
                end)
            end
        end
    end
    runService.Stepped:Connect(speedHackTick)
    runService.Heartbeat:Connect(speedHackTick)

    -- INSTANT PLANT + INSTANT DEFUSE (jeden przycisk, obie akcje C4).
    -- Defuse: serwer odpowiada atrybutami IsDefusingBomb/DefuseStartTime, a
    --   pasek gry sam wysyła C4.Defused.Send() dopiero po5/10 s — odpalamy
    --   ten sam pakiet od razu po starcie rozbrajania. Jeśli serwer ufa
    --   czasowi klienta = natychmiastowe rozbrojenie; jeśli pilnuje czasu,
    --   pakiet wpada w próżnię i normalny pasek leci bez przeszkód.
    -- Plant: start sadzenia flaguje IsPlantingBomb na LocalPlayer —
    --   analogicznie strzelamy C4.Planted.Send() w momencie startu.
    -- Nie ruszamy żadnego stanu gry, tylko dorzucamy wczesny pakiet, więc
    -- w najgorszym razie obie akcje po prostu działają normalnie.
    local instantBomb = false
    local bInstant = createButton("Instant Plant+Defuse: OFF", 20, "Utility")
    bInstant.MouseButton1Click:Connect(function()
        instantBomb = not instantBomb
        bInstant.Text = instantBomb and "Instant Plant+Defuse: ON" or "Instant Plant+Defuse: OFF"
        bInstant.BackgroundColor3 = instantBomb and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
        updateActiveCheatsList()
    end)

    local RemotesBS = nil
    pcall(function()
        RemotesBS = require(game:GetService("ReplicatedStorage").Database.Security.Remotes)
    end)
    local instDefSent, instPlantSent = false, false

    runService.Heartbeat:Connect(function()
        if not (instantBomb and RemotesBS) then
            instDefSent, instPlantSent = false, false
            return
        end
        -- DEFUSE: serwer zaczął rozbrajanie -> jeden wczesny strzał Defused
        local defusing = plr:GetAttribute("IsDefusingBomb") == true
        if defusing and not instDefSent then
            instDefSent = true
            pcall(function() RemotesBS.C4.Defused.Send() end)
        elseif not defusing then
            instDefSent = false
        end
        -- PLANT: atrybit startu sadzenia -> jeden wczesny strzał Planted
        local planting = plr:GetAttribute("IsPlantingBomb") == true
        pcall(function()
            if not planting and plr.Character and plr.Character:GetAttribute("IsPlantingBomb") == true then
                planting = true
            end
        end)
        if planting and not instPlantSent then
            instPlantSent = true
            pcall(function() RemotesBS.C4.Planted.Send() end)
        elseif not planting then
            instPlantSent = false
        end
    end)

    -- Dlaczego v4 nie działał: (a) "ziemię" łapało się po stanach Humanoida
    -- (GetState/StateChanged/AssemblyLinearVelocity/raycast), które symulacja
    -- MovementV2 IGNORUJE — liczy się tylko wewnętrzna flaga OnGround; (b) VIM
    -- Space i Hum.Jump = true PODTRZYMYWAŁY wciśnięty Jump, więc po pierwszym
    -- skoku symulacja miała JumpHeld = true na stałe i wymagany edge
    -- (input.Jump AND NIE poprzedni JumpHeld) nigdy już nie zachodził —
    -- kolejne skoki nie powstawały. v5 pulse'uje samą pulę skoku, bez
    -- wykrywania lądowania i bez wcinania Spacji.

    -- Pętla v6: bhop działa TYLKO przy przytrzymanej Spacji. Bez niej zero
    -- ingerencji — można się spokojnie rozbiec i dopiero potem skakać.
    -- Dwa powody przejścia z v5:
    --  1) v5 pulse'ował niezależnie od klawisza => postać skakała sama od
    --     razu po włączeniu i nie dało się nabrać prędkości;
    --  2) przy przytrzymanej Spacji gra trzyma JumpInputDown = true, więc
    --     Buttons.Jump = true w KAŻDYM ticku, JumpHeld = true i solver nigdy
    --     nie dostaje wymaganego edge (input.Jump AND NIE poprzedni JumpHeld).
    --     Dlatego trzymany input trzeba wyciszyć (jump(false)) i samemu
    --     dawkować pulę: pulse = dokładnie jeden tick z Jump = true, między
    --     pulami zostaje tick z false => edge powstaje co ~40 ms.
    -- Nasz Heartbeat zapisuje JumpInputDown ostatni (gra ustawia true tylko
    -- na InputBegan, a i tak zarejestrowała się przed wstrzyknięciem), więc
    -- wyciszenie utrzymuje się do puszczenia klawisza; przy wyłączeniu
    -- cheata stan jest przywracany (jump(true)), żeby trzymana Spacja znowu
    -- działała po stronie gry.
    -- Kadencja 40 ms > 2 ticków (31.25 ms przy 64 Hz) z zapasem na jitter;
    -- detekcja lądowania zbyteczna — w powietrzu solver pulę ignoruje
    -- (brak OnGround), a na ziemi odpala skok przy pierwszym możliwym ticku.
    local bhopLastPulse = 0
    local BHOP_PULSE_PERIOD = 0.040
    local bhopUis = game:GetService("UserInputService")
    local bhopSuppressed = false
    runService.Heartbeat:Connect(function()
        if not CharacterController then
            return
        end
        local spaceHeld = bhopUis:IsKeyDown(Enum.KeyCode.Space)
        if not bunnyHop then
            -- cheater wyłączony: oddaj kontrolę Spacji grze (bez skutków
            -- ubocznych dla kogoś, kto trzymał klawisz podczas przełączania)
            if bhopSuppressed then
                bhopSuppressed = false
                pcall(function() CharacterController.jump(spaceHeld) end)
            end
            return
        end
        if not spaceHeld then
            -- Spacja puszczona: nie skaczemy, gracz się rozbiega.
            if bhopSuppressed then
                bhopSuppressed = false
                pcall(function() CharacterController.jump(false) end)
            end
            bhopLastPulse = 0
            return
        end
        -- Spacja trzymana: wygaszamy jej stan (żeby nie zabił edge) i
        -- pulse'ujemy co >2 ticki. false jest idempotentne — gdy gra nie
        -- odświeża go cyklicznie, zostaje do puszczenia klawisza.
        pcall(function() CharacterController.jump(false) end)
        bhopSuppressed = true
        local now = tick()
        if now - bhopLastPulse < BHOP_PULSE_PERIOD then
            return
        end
        bhopLastPulse = now
        pcall(function() CharacterController.jump() end)
    end)

    -- No Recoil: reset CameraOffset (backup — główne blokowanie jest w enableNoRecoil)
    runService.RenderStepped:Connect(function()
        if noRecoil and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.CameraOffset = Vector3.new(0, 0, 0)
            end
        end
    end)

    -- Hitbox Expander (powiększa TYLKO hitbox głowy wrogów, nie całego ciała)
    runService.Heartbeat:Connect(function()
        if hitboxExpander then
            for _, p in pairs(playersService:GetPlayers()) do
                if p ~= plr and p.Character and isEnemy(p) then
                    local head = p.Character:FindFirstChild("Head")
                    if head and head:IsA("BasePart") then
                        if not head:GetAttribute("OrigHeadSize") then
                            head:SetAttribute("OrigHeadSize", head.Size)
                            head:SetAttribute("OrigHeadTrans", head.Transparency)
                        end
                        if head.Size.X < hitboxSize then
                            head.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                            head.Transparency = 0.7
                            head.CanCollide = false
                        end
                    end
                end
            end
        end
    end)

    -- Fullbright
    runService.RenderStepped:Connect(function()
        if fullbright then
            lighting.Brightness = 2
            lighting.ClockTime = 14
            lighting.GlobalShadows = false
            lighting.FogEnd = 999999
        else
            lighting.GlobalShadows = true
        end
    end)

    -- ESP BloxStrike przeniesione do startBsEspNew() (v2) — cały opis
    -- rozgryzionego systemu gry i przyczyn porażki v1 jest w komentarzu
    -- nad definicją tej funkcji. Tu zostaje tylko inicjalizacja stanu
    -- ostrzeżeń (używana ogólnie, niezależnie od wersji ESP).
    _G.__liptonESPWarns = _G.__liptonESPWarns or {}
    -- STARE ESP WYRZUCONE (v1 czytalo player.Character + Head + bufor
    -- pozycji i po updacie gry wyrzucalo wszystkich: "brak Character i brak
    -- swiezej pozycji"). Teraz rysuje startBsEspNew() — oparte wylacznie na
    -- atrybutach wlasnego systemu BloxStrike (Team/Health/Dead), patrz
    -- komentarz przy funkcji.
    startBsEspNew(function() return espEnabled end)

    updateActiveCheatsList()
end

