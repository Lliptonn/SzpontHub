    -- Pętla TP Farma: co tp.sec sekund teleport do najbliższej monety.
    -- Cała logika WEWNĄTRZ pętli celowo — Lua ma limit 200 rejestrów
    -- lokalnych na chunk, a osobny local na helper wywalał kompilację pliku.
    task.spawn(function()
        while true do
            local ok, err = pcall(function()
                task.wait(0.02)
                if tp.on then
                    -- reset na początku ticku: gdyby poprzedni tick padł
                    -- w trakcie chodzenia, flaga nie blokowałaby Auto Farm
                    tp.walking = false
                    local now = os.clock()

                    -- własny odświeżacz listy monet — NIE tykamy coinScanClock,
                    -- bo to licznik starej farmy i wspólny go psułby
                    if now >= tp.scanAt then
                        refreshCoinCache(false)
                        tp.scanAt = now + (#coinCache > 0 and 1.5 or 0.75)
                    end

                    if now >= tp.nextAt then
                        -- KOORDYNACJA farm: Auto Farm ma pierwszeństwo, ALE gdy nie ma
                        -- co zbierać (farmIdle), to TP Farm przejmuje postać. Żadna
                        -- farma nie wyłącza drugiej — obie mogą być włączone naraz.
                        if killBusy or gunDropRef or (autoFarmCoins and not farmIdle) then
                            tp.nextAt = now + 0.3  -- odpuść teraz, sprawdź za chwilę
                        else
                        local char = plr.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        local hum = char and char:FindFirstChildOfClass("Humanoid")

                        if hrp and hum and hum.Health > 0 then
                            local nearest, bestDist = nil, tp.range
                            for i = #coinCache, 1, -1 do
                                local c = coinCache[i]
                                if not isCoinAlive(c) then
                                    table.remove(coinCache, i)
                                elseif not coinBlacklist[c] then
                                    local d = (hrp.Position - c.Position).Magnitude
                                    if d < bestDist then
                                        bestDist, nearest = d, c
                                    end
                                end
                            end

                            if nearest then
                                local target = nearest.Position

                                -- ANTI-KICK "Invalid position" (Error 267): teleport
                                -- przez CFrame kopał NAWET po kawałku i nawet na
                                -- "najbezpieczniejszych" ustawieniach — MM2 pilnuje
                                -- surowej prędkości postaci, a nie sposobu ruchu.
                                -- Dlatego "teleport" robimy ZWYKŁYM CHODZENIEM przy
                                -- podniesionym WalkSpeed: ruch idzie przez silnik gry,
                                -- więc serwer go akceptuje, a i tak lecimy błyskawicznie
                                -- (200 stud/s = 12× normalny chód). Sterujemy TYLKO
                                -- obrotem — CFrame bez translacji nie jest walidowany
                                -- jako zmiana pozycji, więc nie kopa.
                                local starySpeed = hum.WalkSpeed
                                local staryRot = hum.AutoRotate
                                hum.WalkSpeed = tp.walk
                                hum.AutoRotate = false

                                local koniec = os.clock() + 4
                                tp.walking = true
                                while os.clock() < koniec do
                                    task.wait(0.05)
                                    -- po task.wait postać mogła umrzeć / respawnąć:
                                    -- model jest ZNISZCZONY, a .Position/.CFrame na
                                    -- zniszczonej instancji = wyjątek, który dawniej
                                    -- zabijał CAŁĄ pętlę farmy (farma milczała
                                    -- do restartu skryptu). Dlatego bierzemy
                                    -- świeżą postać po każdym czekaniu.
                                    char = plr.Character
                                    hrp = char and char:FindFirstChild("HumanoidRootPart")
                                    hum = char and char:FindFirstChildOfClass("Humanoid")
                                    if not (hrp and hum) then break end
                                    if not tp.on or hum.Health <= 0 then break end
                                    local off = target - hrp.Position
                                    if off.Magnitude <= 3.2 then break end
                                    hrp.CFrame = CFrame.lookAt(
                                        hrp.Position,
                                        Vector3.new(target.X, hrp.Position.Y, target.Z))
                                end
                                tp.walking = false

                                -- prędkość/obrót przywracamy tylko przy żywej
                                -- postaci (po respawnie hum to nowa instancja)
                                if hum and hum.Parent then
                                    hum.WalkSpeed = starySpeed
                                    hum.AutoRotate = staryRot
                                end

                                -- Touched odpala się przy STARCIE kolizji, więc samo
                                -- stanie przy monecie nic nie zalicza: odskakujemy
                                -- i wracamy (kilkanaście studów = bezpieczne)
                                if hrp and hrp.Parent then
                                    local pos = hrp.Position
                                    hrp.CFrame = CFrame.new(pos + Vector3.new(2.4, 0.3, 0))
                                    task.wait(0.08)
                                    hrp = getHRP(plr.Character) -- świeży HRP po respawnie
                                    if hrp and hrp.Parent then
                                        hrp.CFrame = CFrame.new(pos)
                                    end
                                    task.wait(0.08)
                                end

                                tp.nextAt = os.clock() + math.max(tp.sec, tp.minGap)
                            else
                                tp.nextAt = now + 0.5 -- brak monet: sprawdzaj częściej
                            end
                        else
                            tp.nextAt = now + 0.5
                        end
                        end -- koniec gałęzi "można się ruszać" (killBusy/gunDropRef)
                    end
                end
            end)
            if not ok then
                -- BŁĄD W JEDNYM TICKU NIE MOŻE ZABIĆ PĘTLI FARMA:
                -- bez pcall wyjątek kończył task.spawn i farma
                -- milczała do restartu skryptu
                warn("[SzpontHub] TP Farm tick error: " .. tostring(err))
                task.wait(0.5)
            end
        end
    end)

    task.spawn(function()
        while true do
            local ok, err = pcall(function()
                local rawDt = task.wait(0.02)
                -- ANTI-KICK: dt przycięte — po lag spike'u postać NIE robi dużego
                -- skoku (stary kod: speed * 0.5 s = 12-15 studów w jedną klatkę,
                -- serwer MM2 kopał za "Invalid position")
                local dt = math.min(rawDt, FARM_DT_CLAMP)

                -- wygasanie blokad na monety
                local now = os.clock()
                for coin, untilT in pairs(coinBlacklist) do
                    if now >= untilT or not coin.Parent then
                        coinBlacklist[coin] = nil
                    end
                end

                -- HRP na bieżąco: po respawnie nowy model nie ma jeszcze
                -- HumanoidRootPart, a .HumanoidRootPart by rzucił wyjątek
                local hrp = getHRP(plr.Character)
                if autoFarmCoins and hrp then
                    local hum = getHum(plr.Character)

                    -- NOCLIP NA CZAS FARMY: pozycją sterujemy co klatkę CFrame'em,
                    -- a kolizja tylko blokowała postać w ścianach (stanie w miejscu).
                    -- Humanoid potrafi sam odblokować kolizję części, więc ustawiamy
                    -- co tick. Włączający i wyłączający farmę przywracają kolizję.
                    for _, p in ipairs(plr.Character:GetChildren()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end

                    coinScanClock = coinScanClock + dt
                    local empty = #coinCache == 0
                    if coinScanClock >= (empty and FARM_EMPTY_SCAN_INTERVAL or FARM_SCAN_INTERVAL) then
                        coinScanClock = 0
                        -- pełny skan workspace tylko co 4 odświeżenie, gdy lista pusta
                        farmFullScanTick = farmFullScanTick + 1
                        refreshCoinCache(empty and farmFullScanTick % 4 == 0)
                    end

                    -- MORDERCA: wykrywamy go ZAWSZE (potrzebujemy kierunku
                    -- ucieczki także wtedy, gdy zbieramy cukierki), ale sama
                    -- ucieczka w czystą stronę włącza się dopiero, gdy nóż
                    -- jest naprawdę blisko (FARM_PANIC_DIST).
                    local murHrp = nil
                    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                        if p ~= plr and p.Character and getRole(p) == "Murderer" then
                            local m = p.Character:FindFirstChild("HumanoidRootPart")
                            local mh = p.Character:FindFirstChildOfClass("Humanoid")
                            -- gracz stojący w LOBBY to nie morderca na mapie —
                            -- nie uciekamy od nikogo poza mapą. Sprawdzamy to
                            -- tylko jak morderca jest blisko (isInLobby potrafi
                            -- być drogie, więc nie wołamy go co klatkę).
                            if m and mh and mh.Health > 0 then
                                local dMur = (hrp.Position - m.Position).Magnitude
                                if dMur < farmAvoidDist + 15 and not isInLobby(m.Position, 25) then
                                    murHrp = m
                                    break
                                end
                            end
                        end
                    end
                    -- kierunek ucieczki: prosto OD mordercy, tylko poziomo
                    -- (schodzimy w bok, nie w podłogę/sufit)
                    local awayFromMur, murDist = nil, math.huge
                    if murHrp then
                        local a = hrp.Position - murHrp.Position
                        a = Vector3.new(a.X, 0, a.Z)
                        murDist = a.Magnitude
                        if murDist < 0.5 then
                            a = hrp.CFrame.LookVector  -- stoimy na nim: uciekamy przed siebie
                            murDist = 0.5
                        end
                        awayFromMur = a
                    end
                    -- WAGA UCIECZKI: 0 = morderca daleko (zbieramy normalnie),
                    -- 1 = nóż tuż przy nas (ucieczka ma pierwszeństwo).
                    -- Między tymi wartościami farma zbiera, ale skręca w bok
                    -- od noża — dzięki temu nie gubi wszystkich cukierków.
                    local fleeWeight = 0
                    if awayFromMur then
                        -- próg paniki to min(FARM_PANIC_DIST, suwak): suwak
                        -- "Murder Dist" na 1 = ucieczka tylko jak nóż jest
                        -- na NAS (farma zbiera praktycznie zawsze)
                        local panicDist = math.min(FARM_PANIC_DIST, farmAvoidDist)
                        if murDist >= farmAvoidDist then
                            fleeWeight = 0
                        elseif murDist <= panicDist then
                            fleeWeight = 1
                        elseif farmAvoidDist > panicDist then
                            fleeWeight = (farmAvoidDist - murDist) / (farmAvoidDist - panicDist)
                        else
                            fleeWeight = 1
                        end
                    end
                    local panic = fleeWeight >= 1

                    local nearestCoin, shortestDistance = nil, math.huge
                    for i = #coinCache, 1, -1 do
                        local coin = coinCache[i]
                        if not isCoinAlive(coin) then
                            table.remove(coinCache, i)
                        elseif not coinBlacklist[coin] then
                            local dist = (hrp.Position - coin.Position).Magnitude
                            -- pomijamy monety spoza zasięgu (np. na innej mapie)
                            if dist <= FARM_TARGET_RANGE and dist < shortestDistance then
                                shortestDistance = dist
                                nearestCoin = coin
                            end
                        end
                    end

                    -- stan "nie mam co zbierać" → TP Farm może w tym czasie
                    -- teleportować do monety (obie farmy mogą być ON naraz)
                    farmIdle = (nearestCoin == nil)

                    if killBusy or gunDropRef or tp.walking then
                        -- KOORDYNACJA: Auto Kill All (killBusy), Auto TP Gun
                        -- (broń leży na ziemi, gunDropRef) albo TP Farm właśnie
                        -- idzie do monety — ktoś steruje CFrame postaci, więc
                        -- farma stoi w miejscu i nie walczy o pozycję.
                        if hum then hum.AutoRotate = true end
                        farmStuckCoin, farmStuckClock = nil, 0
                        farmIdle = false
                    elseif panic and (not hum or hum.Health > 0) then
                        -- MORDERCA PRZY NAS (panika): ucieczka — ale NIE przestajemy
                        -- zbierać. Stary kod uciekał w czystą stronę i czekał, aż
                        -- morderca odejdzie: przez to gracz tracił cukierki/monety
                        -- leżące po drodze, a morderca i tak dogonił (chód ~16 vs
                        -- farma 24, więc dystans i tak się odbudowywał). Teraz w
                        -- trakcie ucieczki farma łapie pickupy, o ile nie prowadzą
                        -- prosto na nóż:
                        --  * cel leży "od mordercy" (cos >= FARM_ESCAPE_SAFE_DOT), albo
                        --  * cel jest bardzo blisko (<= FARM_ESCAPE_GRAB_NEAR)
                        -- Kierunek ruchu to mieszanka ucieczki + celu, więc wypadkowy
                        -- wektor dalej "ucieka" (dot >= bezpieczny próg), a my
                        -- jednocześnie docieramy do pickupa.
                        if hum then
                            hum.PlatformStand = false
                            hum.AutoRotate = false
                        end
                        hrp.Velocity = Vector3.new(0, 0, 0)
                        hrp.RotVelocity = Vector3.new(0, 0, 0)

                        local escDir = awayFromMur.Unit
                        local moveDir = escDir
                        local grabTarget = nil

                        -- Wybór celu: NIE bierzemy po prostu najbliższej monety, bo
                        -- może leżeć za nami (czyli w stronę mordercy). Szukamy
                        -- najbliższej monety, do której pójście NIE zmniejsza
                        -- odległości od noża (dot >= próg), albo bardzo bliskiej
                        -- (tę łapiemy mimo wszystko — 3 study to ułamek sekundy).
                        if #coinCache > 0 then
                            local bestDist = math.huge
                            for i = #coinCache, 1, -1 do
                                local c = coinCache[i]
                                if not isCoinAlive(c) then
                                    table.remove(coinCache, i)
                                elseif not coinBlacklist[c] then
                                    local cDelta = c.Position - hrp.Position
                                    local flat = Vector3.new(cDelta.X, 0, cDelta.Z)
                                    local flatLen = flat.Magnitude
                                    if flatLen <= FARM_ESCAPE_GRAB_RANGE and flatLen < bestDist then
                                        local safe = false
                                        if flatLen > 0.05 then
                                            safe = (escDir:Dot(flat.Unit)) >= FARM_ESCAPE_SAFE_DOT
                                        end
                                        if safe or flatLen <= FARM_ESCAPE_GRAB_NEAR then
                                            bestDist = flatLen
                                            grabTarget = c
                                        end
                                    end
                                end
                            end
                        end

                        if grabTarget then
                            -- NOWY cel → zegar od nowa (inna moneta = świeży start).
                            -- Dzięki temu po udanym zebraniu farma wraca do łapania,
                            -- zamiast po 1,2 s przestać łapać w ogóle.
                            if grabTarget ~= farmEscapeGrabTarget then
                                farmEscapeGrabTarget = grabTarget
                                farmEscapeGrabClock = 0
                            end
                            -- zegar dobiegania: nie goniemy w kółko za jednym celem,
                            -- bo morderca by nas dogonił. Po FARM_ESCAPE_GRAB_TIME
                            -- przerywamy łapanie (zegar przestaje rosnąć, ale się nie
                            -- zeruje — wrócimy do łapania, gdy cel zniknie/zmieni się).
                            if farmEscapeGrabClock < FARM_ESCAPE_GRAB_TIME then
                                farmEscapeGrabClock = farmEscapeGrabClock + dt
                                local cDelta = grabTarget.Position - hrp.Position
                                local flat = Vector3.new(cDelta.X, 0, cDelta.Z)
                                if flat.Magnitude > 0.05 then
                                    -- mieszanka: ucieczka ma pierwszeństwo, cel tylko
                                    -- dokłada trochę — wypadkowy kierunek wciąż ucieka
                                    moveDir = (escDir + flat.Unit * 0.6).Unit
                                end
                            else
                                grabTarget = nil
                            end
                        else
                            -- brak bezpiecznego celu → sama ucieczka, zegar od nowa
                            farmEscapeGrabClock = 0
                            farmEscapeGrabTarget = nil
                        end

                        if grabTarget then
                            -- cel: środek pickupa; blisko niego kręcimy się w kółko,
                            -- bo Touched odpala się na POCZĄTKU kolizji (samo stanie
                            -- w monecie nie gwarantuje zbioru) — tak samo jak w farmie
                            local goal = grabTarget.Position
                            if (hrp.Position - goal).Magnitude < 1.5 then
                                local a = now * 8
                                goal = goal + Vector3.new(math.cos(a), 0, math.sin(a)) * 1.4
                            end
                            local offset = goal - hrp.Position
                            if offset.Magnitude > 0.05 then
                                local escSpeed = math.clamp(farmSpeed, 5, FARM_SAFE_SPEED_CAP)
                                local escStep = math.min(offset.Magnitude, escSpeed * dt, FARM_MAX_STEP)
                                -- ruch po MIESZANCE (ucieczka + cel), nie prosto na cel:
                                -- dzięki temu wciąż oddalamy się od mordercy, a
                                -- jednocześnie docieramy do pickupa
                                local step = (offset.Unit + moveDir) * 0.5
                                if step.Magnitude < 0.01 then step = moveDir end
                                hrp.CFrame = CFrame.new(hrp.Position + step.Unit * escStep)
                                    * (hrp.CFrame - hrp.CFrame.Position)
                            end
                        else
                            local escGoal = hrp.Position + escDir * (farmAvoidDist + 2)
                            local escOffset = escGoal - hrp.Position
                            if escOffset.Magnitude > 0.05 then
                                local escSpeed = math.clamp(farmSpeed, 5, FARM_SAFE_SPEED_CAP)
                                local escStep = math.min(escOffset.Magnitude, escSpeed * dt, FARM_MAX_STEP)
                                hrp.CFrame = CFrame.new(hrp.Position + escOffset.Unit * escStep)
                                    * (hrp.CFrame - hrp.CFrame.Position)
                            end
                        end
                    elseif nearestCoin and (not hum or hum.Health > 0) then
                        if hum then
                            hum.PlatformStand = false
                            hum.AutoRotate = false
                        end

                        -- ANTI-STUCK: dotarliśmy do monety i nic się nie dzieje →
                        -- po FARM_STUCK_TIME czarna lista i lecimy do następnej
                        if shortestDistance < 3 then
                            if nearestCoin == farmStuckCoin then
                                farmStuckClock = farmStuckClock + dt
                            else
                                farmStuckCoin, farmStuckClock = nearestCoin, 0
                            end
                            if farmStuckClock >= FARM_STUCK_TIME then
                                -- odrzucamy monetę na KILKA SEKUND, nie na zawsze:
                                -- stary kod dawał math.huge = moneta ignorowana do
                                -- końca rundy, a farma przez to wyglądała na
                                -- zepsutą (nie brała nawet monet, które dało się
                                -- zebrać). Po 20 s wracamy do niej.
                                coinBlacklist[nearestCoin] = now + FARM_BLACKLIST_TIME
                                farmStuckCoin, farmStuckClock = nil, 0
                            end
                        else
                            farmStuckCoin, farmStuckClock = nil, 0
                        end

                        hrp.Velocity = Vector3.new(0, 0, 0)
                        hrp.RotVelocity = Vector3.new(0, 0, 0)

                        -- cel: środek monety; gdy już jesteśmy w środku, jeździmy
                        -- kółko wokół niej — Touched odpala się na POCZĄTKU
                        -- kolizji, więc samo stanie w monety nie gwarantuje zbioru
                        local goal = nearestCoin.Position
                        if shortestDistance < 1.5 then
                            local a = now * 8
                            goal = nearestCoin.Position + Vector3.new(math.cos(a), 0, math.sin(a)) * 1.4
                        end

                        local offset = goal - hrp.Position
                        local dist = offset.Magnitude
                        if dist > 0.05 then
                            -- ruch co klatkę: suwak przycięty do progu + twardy
                            -- limit kroku, którego nie da się przekroczyć nawet po lagu
                            local speed = math.clamp(farmSpeed, 5, FARM_SAFE_SPEED_CAP)
                            local step = math.min(dist, speed * dt, FARM_MAX_STEP)
                            local dir = offset.Unit
                            if fleeWeight > 0 and awayFromMur then
                                -- MIESZANKA: cel + ucieczka. Waga rośnie wraz ze
                                -- zbliżaniem mordercy, ale farma NIE PRZESTAJE
                                -- ZBIERAĆ — tylko skręca w bok od noża.
                                -- (stary kod w tym miejscu w ogóle nie ruszał się
                                -- do cukierka, tylko uciekał = zero cukierków)
                                local w = fleeWeight * 0.6
                                local bl = dir * (1 - w) + awayFromMur.Unit * w
                                if bl.Magnitude > 0.01 then dir = bl.Unit end
                            end
                            local newPos = hrp.Position + dir * step
                            local rot = hrp.CFrame - hrp.CFrame.Position
                            hrp.CFrame = CFrame.new(newPos) * rot
                        end
                    else
                        if hum then hum.AutoRotate = true end
                        farmStuckCoin, farmStuckClock = nil, 0
                    end
                end
            end)
            if not ok then
                -- BŁĄD W JEDNYM TICKU NIE MOŻE ZABIĆ PĘTLI FARMA:
                -- bez pcall wyjątek kończył task.spawn i farma
                -- milczała do restartu skryptu
                warn("[SzpontHub] Auto Farm tick error: " .. tostring(err))
                task.wait(0.5)
            end
        end
    end)

