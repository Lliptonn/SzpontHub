    end

    -- center of the ROUND MAP: the largest model in workspace that is NOT
    -- a lobby or a player character. Refreshed every 5 s (the bounding box
    -- GetBoundingBox is cheap, but we do not want to compute it on every click).
    local mapCenter, mapCenterSize, mapCenterAt = nil, nil, 0
    local function getMapCenter()
        if mapCenter and tick() - mapCenterAt < 5 then return mapCenter, mapCenterSize end
        -- "Largest model by force" broke way out in the middle of nowhere: the lobby has no
        -- round map, so it took some random big model. Now we first
        -- ask whether anyone is outside the lobby at all (if not - there is no
        -- round), then we prefer the model the players are STANDING on.
        local ktosNaMapie = false
        for _, p in ipairs(playersService:GetPlayers()) do
            local c = p.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if h and not isInLobby(h.Position, 40) then ktosNaMapie = true break end
        end
        if not ktosNaMapie then
            mapCenter, mapCenterAt = nil, tick()
            return nil
        end
        local boxes = getLobbyBoxes()
        local best, bestScore, bestSize = nil, -1, nil
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj ~= workspace.CurrentCamera then
                local n = obj.Name:lower()
                if not n:find("lobby") and not n:find("camera")
                    and not playersService:GetPlayerFromCharacter(obj) then
                    local ok, cf, size = pcall(function() return obj:GetBoundingBox() end)
                    -- >= 40 studs: not dust; <= 1500: not the whole world/skybox
                    if ok and cf and size
                        and size.X >= 40 and size.Z >= 40
                        and size.X <= 1500 and size.Z <= 1500 then
                        local wLobby = false
                        for _, lb in ipairs(boxes) do
                            local d = cf.Position - lb.cf.Position
                            if math.abs(d.X) < lb.size.X / 2 + 60
                                and math.abs(d.Z) < lb.size.Z / 2 + 60 then
                                wLobby = true
                                break
                            end
                        end
                        if not wLobby then
                            -- +10 for every character standing on this model
                            -- (this IS the map the round is played on)
                            local pkt = 0
                            for _, p in ipairs(playersService:GetPlayers()) do
                                local c = p.Character
                                local h = c and c:FindFirstChild("HumanoidRootPart")
                                if h then
                                    local v = h.Position - cf.Position
                                    if math.abs(v.X) <= size.X / 2
                                        and math.abs(v.Y) <= size.Y / 2
                                        and math.abs(v.Z) <= size.Z / 2 then
                                        pkt = pkt + 10
                                    end
                                end
                            end
                            pkt = pkt + math.min(size.X * size.Z, 400000) / 10000
                            if pkt > bestScore then
                                bestScore = pkt
                                best = cf
                                -- WITHOUT THIS bestSize stays nil and Safe Place
                                -- crashes on size.Y ("index nil with Y")
                                bestSize = size
                            end
                        end
                    end
                end
            end
        end
        -- Cache as a CFrame plus size: the safe place needs the bbox corner
        -- of the map to know where the geometry ends.
        mapCenter, mapCenterSize, mapCenterAt = best, bestSize, tick()
        return best, bestSize
    end

    local function tpDo(pos, co)
