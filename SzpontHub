    end)

    -- Fullbright
    runService.RenderStepped:Connect(function()
        if fullbright then
            lighting.Brightness = 2
            lighting.ClockTime = 14
            lighting.GlobalShadows = false
            lighting.FogEnd = 999999
        else
            lighting.GlobalShadows = true
        end
    end)

    -- ESP (Highlight + tabliczka: wrogowie na czerwono, team na zielono)
    runService.RenderStepped:Connect(function()
        for _, player in pairs(playersService:GetPlayers()) do
            if player ~= plr and player.Character then
                local char = player.Character
                local head = char:FindFirstChild("Head")
                local enemy = isEnemy(player)
                local teammate = isTeammate(player)
                if espEnabled and head and (enemy or teammate) then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local espColor = teammate and Color3.fromRGB(40, 255, 80) or Color3.fromRGB(255, 40, 40)

                    local highlight = char:FindFirstChild("BSHighlight") or Instance.new("Highlight", char)
                    highlight.Name = "BSHighlight"
                    highlight.Adornee = char
                    highlight.FillColor = espColor
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0

                    local billboard = head:FindFirstChild("BSBillboard") or Instance.new("BillboardGui", head)
                    billboard.Name = "BSBillboard"
                    billboard.Size = UDim2.new(0, 120, 0, 50)
                    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                    billboard.AlwaysOnTop = true

                    local txt = billboard:FindFirstChild("BSText") or Instance.new("TextLabel", billboard)
                    txt.Name = "BSText"
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.TextColor3 = espColor
                    txt.TextStrokeTransparency = 0
                    txt.TextSize = 13
                    txt.Font = Enum.Font.SourceSansBold
                    local hp = math.floor((hum and hum.Health) or tonumber(char:GetAttribute("Health")) or 0)
                    local dist = math.floor((head.Position - cam.CFrame.Position).Magnitude)
                    txt.Text = player.Name .. "\nHP: " .. hp .. " | " .. dist .. "m"
                else
                    local highlight = char:FindFirstChild("BSHighlight")
                    if highlight then highlight:Destroy() end
                    if head then
                        local billboard = head:FindFirstChild("BSBillboard")
                        if billboard then billboard:Destroy() end
                    end
                end
            end
        end
    end)

    updateActiveCheatsList()
end

