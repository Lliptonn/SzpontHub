        plListOpen = true
        plList.Visible = true
        plBtn.ZIndex = 8
        for i, p in ipairs(list) do
            local lv = "?"
            pcall(function()
                local ls = p:FindFirstChild("leaderstats")
                local L = ls and ls:FindFirstChild("Level")
                if L then lv = tostring(L.Value) end
            end)
            local label = p.DisplayName
            if p.DisplayName ~= p.Name then
                label = label .. " (@" .. p.Name .. ")"
            end
            local ob = Instance.new("TextButton")
            ob.Size = UDim2.new(1, -6, 0, 22)
            ob.BackgroundColor3 = Color3.fromRGB(20, 10, 25)
            ob.BackgroundTransparency = 0.1
            ob.BorderSizePixel = 1
            ob.BorderColor3 = Color3.fromRGB(170, 50, 255)
            ob.Text = label .. " - Lv." .. lv
            ob.TextColor3 = Color3.fromRGB(255, 255, 255)
            ob.TextSize = 12
            ob.Font = Enum.Font.SourceSansBold
            ob.TextTruncate = Enum.TextTruncate.AtEnd
            ob.LayoutOrder = i
            ob.ZIndex = 9
            ob.Parent = plList
            ob.MouseButton1Click:Connect(function()
                local pos = nil
                pcall(function()
                    local ch = p.Character
                    if ch then
                        local hrp = ch:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            pos = hrp.Position
                        else
                            local ok, pv = pcall(function() return ch:GetPivot() end)
                            if ok and pv then pos = pv.Position end
                        end
                    end
                end)
                if not pos then
                    plStatus.Text = p.DisplayName .. " has no character (death/menu)."
                    return
                end
                plStatus.Text = "Teleporting to " .. p.DisplayName .. "..."
                plCloseList()
                -- exact mode: 1:1 under the buddy (also in caves,
                -- corridors and on islands - no jump onto the "roof")
                tpCore(pos.X, pos.Y, pos.Z, p.DisplayName, plStatus, true)
            end)
        end
    end)
    -- UTILITY TAB: FLY / NOCLIP / SPEED HACK - layout and mechanics
    -- like in MM2 (toggles + sliders for Fly Speed / Walk Speed).
    -- State in getgenv().SzpontUtility (shared between injections):
    -- noclip/speed = per-frame RunService connections (idempotent),
    -- fly = one self-terminating loop; getgenv().SzpontUtilityStop = true
    -- kills it for good. The first push at start zeroes fly, so
    -- old loops die on their own after re-injection.
    local uFly = false
    local uNoclip = false
    local uSpeed = false
    local uFullbright = false
    local uInstant = false
    local uStuck = false
    local uFlySpeed = 60
    local uWalkSpeed = 32

    local function envOf()
        return (type(getgenv) == "function" and getgenv()) or _G
    end

    local function pushUtilityState()
        pcall(function()
            local env = envOf()
            env.SzpontUtility = {
                fly = uFly,
                noclip = uNoclip,
                speed = uSpeed,
                fullbright = uFullbright,
                instant = uInstant,
                stuck = uStuck,
                flySpeed = uFlySpeed,
                walkSpeed = uWalkSpeed
            }
        end)
    end

    -- FULLBRIGHT: we keep the original Lighting in getgenv (shared
    -- between injections) so that a re-injection with fullbright on
    -- can restore it instead of saving already-brightened values.
    local function saveLighting()
        pcall(function()
            local env = envOf()
            if env.SzpontLightingSaved then return end
            local l = game:GetService("Lighting")
            env.SzpontLightingSaved = {
                Brightness = l.Brightness,
                Ambient = l.Ambient,
                OutdoorAmbient = l.OutdoorAmbient,
                FogStart = l.FogStart,
                FogEnd = l.FogEnd
            }
        end)
    end
    local function restoreLighting()
        pcall(function()
            local env = envOf()
            local saved = env.SzpontLightingSaved
            if not saved then return end
            local l = game:GetService("Lighting")
            l.Brightness = saved.Brightness
            l.Ambient = saved.Ambient
            l.OutdoorAmbient = saved.OutdoorAmbient
            l.FogStart = saved.FogStart
            l.FogEnd = saved.FogEnd
            env.SzpontLightingSaved = nil
        end)
    end
    restoreLighting() -- did the previous version leave fullbright on?
    pushUtilityState() -- zeroes fly/fullbright = old loops die on their own

    -- SPEED: on enable remember the original, on disable restore it;
    -- target value = Walk Speed slider (as in MM2).
    local savedSpeed = nil
    local function setSpeed(on)
        pcall(function()
            local plr = game:GetService("Players").LocalPlayer
            local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            if on then
                if not savedSpeed then savedSpeed = hum.WalkSpeed end
                hum.WalkSpeed = uWalkSpeed
            else
                if savedSpeed then hum.WalkSpeed = savedSpeed end
                savedSpeed = nil
            end
        end)
    end

    -- restore character collision (character children = limbs + HRP)
    local function restoreCollide()
        pcall(function()
            local plr = game:GetService("Players").LocalPlayer
            local ch = plr.Character
            if ch then
                for _, p in ipairs(ch:GetChildren()) do
                    if p:IsA("BasePart") then p.CanCollide = true end
                end
            end
        end)
    end

    -- INSTANT INTERACT (no hold): ProximityPrompt.HoldDuration = 0,
    -- so E works right away, no holding (the game keeps hold
    -- on 13 of 79 prompts - Collect/Activate). Originals saved
    -- on ON - OFF restores them. Sweep on enable + a
    -- DescendantAdded event (streaming creates new prompts) + a loop every 1 s
    -- (server/local script may swap HoldDuration).
    -- Handler and loop read the SHARED state env.SzpontUtility.instant
    -- AND SzpontUtilityStop - old copies after re-injection or after
    -- "removing the script" die on their own (pushUtilityState on start
    -- zeroes the state).
    local instantConn = nil
    local instantLoopAlive = false
    local instantSaved = {}
    local function instantSweep()
        pcall(function()
            for _, d in ipairs(workspace:GetDescendants()) do
                if d:IsA("ProximityPrompt") and (d.HoldDuration or 0) > 0 then
                    if instantSaved[d] == nil then instantSaved[d] = d.HoldDuration end
                    d.HoldDuration = 0
                end
            end
        end)
    end
    local function setInstantInteract(on)
        pcall(function()
            if on then
                if not instantConn then
                    instantConn = workspace.DescendantAdded:Connect(function(d)
                        if not d:IsA("ProximityPrompt") then return end
                        local env = envOf()
                        if env.SzpontUtilityStop == true then return end
                        local st = env.SzpontUtility
                        if not (st and st.instant) then return end
                        if (d.HoldDuration or 0) > 0 then
                            instantSaved[d] = d.HoldDuration
                            d.HoldDuration = 0
                        end
                    end)
                end
                instantSweep()
                if not instantLoopAlive then
                    instantLoopAlive = true
                    task.spawn(function()
                        while true do
                            if not isCurrentGen() then return end
                            task.wait(1)
                            local env = envOf()
                            if env.SzpontUtilityStop == true then break end
                            local st = env.SzpontUtility
                            if not (st and st.instant) then break end
                            instantSweep()
                        end
                        instantLoopAlive = false
                    end)
                end
            else
                if instantConn then
                    instantConn:Disconnect()
                    instantConn = nil
                end
                for d, h in pairs(instantSaved) do
                    pcall(function()
                        if d.Parent then d.HoldDuration = h end
                    end)
                end
                table.clear(instantSaved)
            end
        end)
    end

    -- FLY like MM2: PlatformStand + AutoRotate, CFrame movement with WASD
    -- at the speed from the slider, Velocity zeroed. One loop per VM
    -- and self-terminating when fly is OFF.
    local utilityLoopAlive = false
    local function ensureUtilityLoop()
        if utilityLoopAlive then return end
        utilityLoopAlive = true
        task.spawn(function()
            while true do
                if not isCurrentGen() then return end
                local dt = task.wait(0.01)
                local env = envOf()
                if env.SzpontUtilityStop == true then break end
                local st = env.SzpontUtility or {}
                if not st.fly then break end
                pcall(function()
                    local ch = playersService.LocalPlayer.Character
                    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                    if not (hrp and hum and hum.Health > 0) then return end
                    hum.PlatformStand = true
                    hum.AutoRotate = false
                    local moveDir = Vector3.new(0, 0, 0)
                    local camera = workspace.CurrentCamera
                    if camera then
                        if uis:IsKeyDown(Enum.KeyCode.W) then
                            moveDir = moveDir + camera.CFrame.LookVector
                        end
                        if uis:IsKeyDown(Enum.KeyCode.S) then
                            moveDir = moveDir - camera.CFrame.LookVector
                        end
                        if uis:IsKeyDown(Enum.KeyCode.A) then
                            moveDir = moveDir - camera.CFrame.RightVector
                        end
                        if uis:IsKeyDown(Enum.KeyCode.D) then
                            moveDir = moveDir + camera.CFrame.RightVector
                        end
                    end
                    if uis:IsKeyDown(Enum.KeyCode.Space) then
                        moveDir = moveDir + Vector3.new(0, 1, 0)
                    end
                    if uis:IsKeyDown(Enum.KeyCode.LeftShift) then
                        moveDir = moveDir - Vector3.new(0, 1, 0)
                    end
                    local nextPos = hrp.Position
                    if moveDir.Magnitude > 0 then
                        nextPos = hrp.Position + (moveDir.Unit * (st.flySpeed or 60) * dt)
                    end
                    local lookDir = camera and camera.CFrame.LookVector or hrp.CFrame.LookVector
                    hrp.CFrame = CFrame.new(nextPos, nextPos + lookDir)
                    hrp.Velocity = Vector3.new(0, 0, 0)
                end)
            end
            pcall(function()
                local hum = playersService.LocalPlayer.Character
                    and playersService.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.PlatformStand = false
                    hum.AutoRotate = true
                end
            end)
            utilityLoopAlive = false
        end)
    end

    -- SPEED like MM2: enforced every frame while ON (the game cannot
    -- overwrite WalkSpeed in time); OFF = original saved on enable.
    runService.RenderStepped:Connect(function()
        if not isCurrentGen() then return end
        local st = envOf().SzpontUtility
        if st and st.speed then
            pcall(function()
                local hum = playersService.LocalPlayer.Character
                    and playersService.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.WalkSpeed = st.walkSpeed or 32 end
            end)
        end
    end)

    -- NOCLIP like MM2: every physics frame remove character collision.
    runService.Stepped:Connect(function()
        if not isCurrentGen() then return end
        local st = envOf().SzpontUtility
        if st and st.noclip then
            pcall(function()
                local ch = playersService.LocalPlayer.Character
                if ch then
                    for _, part in ipairs(ch:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end)
        end
    end)

    -- FULLBRIGHT: enforced every frame (the game may change lighting
    -- with a day/night cycle or depending on the zone).
    runService.RenderStepped:Connect(function()
        if not isCurrentGen() then return end
        local st = envOf().SzpontUtility
        if st and st.fullbright then
            pcall(function()
                local l = game:GetService("Lighting")
                l.Brightness = 5
                l.Ambient = Color3.fromRGB(255, 255, 255)
                l.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
                l.FogStart = 0
                l.FogEnd = 1000000
            end)
        end
    end)

    -- AIRSTUCK: position lock every frame (CFrame lock + zeroing
    -- velocity) - the character stays in ONE spot the whole time: no
    -- gravity, water current, event push or keyboard input.
    -- LIVE DIAGNOSIS (user verdict): the Anchored version was NOT fit
    -- for fishing - the game server rejects FishingRod/Cast while
    -- anchored (res=false, user: "with airstuck enabled you cannot
    -- cast"). The server sees the character anchored => rejects the cast, so
    -- instead of anchoring, we PIN the CFrame: the client owns the
    -- character physics, so a fixed position + zero velocity = we stand
    -- like a normal player (Anchored=NEVER true) and the cast goes through.
    -- Loop: Off / SzpontUtilityStop / SzpontFischStop / destroyed
    -- GUI => it simply stops pinning (there is no anchor to
    -- unstick = no risk of the character getting stuck after a stop).
    -- Re-injection zeroes stuck in pushUtilityState => old loops
    -- die out on their own. Respawn: a new character = frozen at ITS
    -- spot (spawn), not teleported to the old place.
    local stuckConn = nil
    local stuckChar = nil
    local stuckCF = nil
    local function setAirStuck(on)
        if on then
            local ch = playersService.LocalPlayer.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hrp then
                stuckChar = ch
                stuckCF = hrp.CFrame
            end
            if not stuckConn then
                stuckConn = runService.Heartbeat:Connect(function()
                    local env = envOf()
                    local st = env.SzpontUtility
                    local guiAlive = fischGui and fischGui.Parent ~= nil
                    if env.SzpontUtilityStop == true or env.SzpontFischStop == true
                        or not (st and st.stuck) or not guiAlive then
                        stuckConn:Disconnect()
                        stuckConn = nil
                        stuckCF = nil
                        stuckChar = nil
                        return
                    end
                    local ch2 = playersService.LocalPlayer.Character
                    local hrp2 = ch2 and ch2:FindFirstChild("HumanoidRootPart")
                    if not hrp2 then return end
                    if ch2 ~= stuckChar then
                        stuckChar = ch2
                        stuckCF = hrp2.CFrame
                    end
                    if stuckCF then hrp2.CFrame = stuckCF end
                    hrp2.AssemblyLinearVelocity = Vector3.zero
                    hrp2.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        else
            if stuckConn then
                stuckConn:Disconnect()
                stuckConn = nil
            end
            stuckCF = nil
            stuckChar = nil
        end
    end

    -- TOGGLES (like MM2: Fly / Noclip / Speed Hack)
    makeToggle("Fly", 1, "Utility",
        function() return uFly end,
        function(v)
            uFly = v
            pcall(function()
                local hum = playersService.LocalPlayer.Character
                    and playersService.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum and not v then
                    hum.PlatformStand = false
                    hum.AutoRotate = true
                end
            end)
            pushUtilityState()
            if v then ensureUtilityLoop() end
        end)
    makeToggle("Noclip", 2, "Utility",
        function() return uNoclip end,
        function(v)
            uNoclip = v
            pushUtilityState()
            if not v then restoreCollide() end
        end)
    makeToggle("Speed Hack", 3, "Utility",
        function() return uSpeed end,
        function(v) uSpeed = v setSpeed(v) pushUtilityState() end)
    makeToggle("Fullbright", 4, "Utility",
        function() return uFullbright end,
        function(v)
            uFullbright = v
            if v then saveLighting() else restoreLighting() end
            pushUtilityState()
        end)
    makeToggle("Instant Interact", 5, "Utility",
        function() return uInstant end,
        function(v)
            uInstant = v
            pushUtilityState()
            setInstantInteract(v)
        end)
    createNote("Instant Interact: press E right away, no holding (hold=0).", 6, "Utility")
    makeToggle("AirStuck", 10, "Utility",
        function() return uStuck end,
        function(v)
            uStuck = v
            -- AirStuck wins over Fly: disable it so the character
            -- does not fly upwards (Space held = fly would pull it up)
            if v and uFly then
                uFly = false
                pcall(function()
                    local hum = playersService.LocalPlayer.Character
                        and playersService.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.PlatformStand = false
                        hum.AutoRotate = true
                    end
                end)
            end
            pushUtilityState()
            setAirStuck(v)
        end)
    createNote("AirStuck: character frozen in place - no gravity, current or movement (also in the air). Fly turns itself off. Click OFF = movement returns.", 11, "Utility")

    -- SLIDERS like MM2: Fly Speed 10-5000 (start 60), Walk Speed 16-150 (start 32)
    local function makeSlider(text, order, fillW)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.95, 0, 0, 12)
