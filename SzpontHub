------------------------------------------------------------
-- PROTECTION AGAINST "ZOMBIES" (old script instances)
-- Every re-run of the script LEAVES old loops running in the background
-- (farm, TP farm, spinbot, annoy, third person...) and they control
-- the same character as the new instance - they fight each other and everything
-- looks "random" (the farm stands still, the character flies around, etc.).
-- Generation counter in getgenv: the new instance bumps the counter, and the old
-- loops see that they are no longer current and switch themselves off.
------------------------------------------------------------
local SCRIPT_GEN = 0
local function isCurrentGen()
    if type(getgenv) ~= "function" then return true end
    return getgenv().SzpontHubGen == SCRIPT_GEN
end

------------------------------------------------------------
-- TEARDOWN: running the script twice should leave only one copy behind
-- instance. The new instance FIRST calls the teardown of the previous one
-- (the old one): there we switch off all options, restore the world state
-- (WalkSpeed, collisions, rotation, lighting, ESP highlights) and
-- destroy the old GUI. Only then do we bump the generation counter,
-- so the old loops get one last moment to clean up.
------------------------------------------------------------
local function restoreWorldState()
    pcall(function()
        local ch = plr and plr.Character
        if ch then
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 16      -- speed hack off
                hum.AutoRotate = true   -- spinbot/fly disabled
                hum.PlatformStand = false
            end
            for _, p in ipairs(ch:GetChildren()) do
                if p:IsA("BasePart") then p.CanCollide = true end -- end of noclip
            end
        end
        -- full brightness (fullbright) returns to what it was before the script
        if type(getgenv) == "function" then
            local orig = getgenv().SzpontHubOrigLight
            if orig then
                lighting.Brightness = orig.brightness
                lighting.ClockTime = orig.clock
            end
        end
        -- ESP highlights
        for _, p in ipairs(playersService:GetPlayers()) do
            if p.Character then
                local hl = p.Character:FindFirstChild("SzpontESPHighlight")
                if hl then hl:Destroy() end
            end
        end
    end)
end

if type(getgenv) == "function" then
    -- remember the original lighting (once, on the first run)
    if not getgenv().SzpontHubOrigLight then
        getgenv().SzpontHubOrigLight = { brightness = lighting.Brightness, clock = lighting.ClockTime }
    end
    -- 1) first tear down the previous instance (cleanup)
    local oldTeardown = getgenv().SzpontHubTeardown
    if type(oldTeardown) == "function" then pcall(oldTeardown) end
    getgenv().SzpontHubTeardown = nil
    -- 2) only now do we kill the old loops (generation counter)
    SCRIPT_GEN = (getgenv().SzpontHubGen or 0) + 1
    getgenv().SzpontHubGen = SCRIPT_GEN
end

