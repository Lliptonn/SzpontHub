    -- PAINTING COLORS: separate from modernize(), because the accent animation
    -- repaints the GUI every 0.1 s and must not touch sizes every frame.
    local function paintTheme()
        local t = themes[currentTheme]
        local primary = t.Primary

        mainFrame.BackgroundColor3 = t.Dark
        mainFrame.BorderColor3 = primary
        local mst = mainFrame:FindFirstChildOfClass("UIStroke")
        if mst then mst.Color = primary end
        -- The title flows with the accent: primary changes hue every 0.1 s, so
        -- LIPTONHUB goes cyan -> purple -> magenta like the whole frame.
        -- In Mono primary is almost white, so the title stays white.
        -- The UIGradient on the title multiplies with that color and gives a
        -- color gradient across the text.
        title.TextColor3 = primary
        -- accent line under the title (animated together with the theme)
        local titleLine = mainFrame:FindFirstChild("TitleLine")
        if titleLine then titleLine.BackgroundColor3 = primary end
        scrollFrame.ScrollBarImageColor3 = primary

        cheatsPanel.BackgroundColor3 = t.Dark
        cheatsPanel.BorderColor3 = primary
        cheatsTitle.BackgroundColor3 = primary
        cheatsTitle.TextColor3 = t.Dark
        cheatsScroll.ScrollBarImageColor3 = primary

        for _, btn in ipairs(allButtons) do
            btn.BorderColor3 = primary
            -- Neon outline: Border can only do corners, UIStroke does it smoothly
            -- and changes color together with the accent (paintTheme repaints every 0.1 s).
            local st = btn:FindFirstChildOfClass("UIStroke")
            if st then st.Color = primary end
            -- a button in the ON state has the accent color (we detect it by
            -- the color, because the toggles set it manually)
            local c = btn.BackgroundColor3
            local isOn = math.abs(c.R - primary.R) < 0.1
                and math.abs(c.G - primary.G) < 0.1
