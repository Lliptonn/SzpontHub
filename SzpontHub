    -- AUTO FARM COINS v3:
    --  * cel = część z TouchTransmitter (CoinServer.Coin_Server), czyli realny
    --    punkt podniesienia monety. UWAGA: Coin_Server jest ZAWSZE
    --    Transparency=1 (widoczną monetę robi dziecko MainCoin), więc
    --    "niewidoczna" NIE znaczy "zebrana" — liczymy atrybut Collected
    --    (oraz Delete) i obecność TouchTransmitter, oba sprawdzone na żywo.
    --  * ANTI-KICK "Invalid position" (Error 267): MM2 kopało za nagły skok
    --    pozycji, głównie gdy suwak >~25. Stary kod brał surowe dt z
    --    task.wait — po lag spike'u (dt = 0.5 s) postać skakała 12-15 studów
    --    w JEDNEJ klatce. Teraz: dt przycięty + twardy limit kroku na tick
    --    + efektywna prędkość przycięta do progu bezpieczeństwa.
    --  * ANTI-STUCK: moneta, przy której stoimy i która nic nie zalicza,
    --    jest odrzucana NA STAŁE (stary kod: blacklist tylko na10 s, więc
    --    farma po tym czasie wracała do tej samej "fantomowej" monety
    --    w kółko). Czarną listę czyści dopiero pełny skan przy pustej
    --    mapie = zmiana rundy (nowe instancje monet = nowe klucze).
    --  * NOCLIP: na czas farmy kolizja wyłączona — postać przechodzi przez
    --    ściany i nie buguje się w nich (pozycją steruje CFrame co klatkę,
    --    więc kolizja tylko przeszkadzała). Przywracamy przy wyłączeniu.
    --  * bez PlatformStand — postać nie kładzie się na ziemi po monety
    --  * skanowanie monet przycięte: pusta lista = pełny skan workspace
    --    raz na kilka sekund, nie 30 razy na sekundę (80k+ instancji = lag)
    -- Progi (FARM_*) są zadeklarowane wyżej, przy suwaku farmSpeed.
    local coinCache = {}
    local coinScanClock = 999
    local coinBlacklist = {}   -- Part monety -> os.clock() końca blokady
    local farmStuckCoin = nil  -- moneta, przy której stoimy bez efektu
    -- koordynacja ruchu (Auto Farm / TP Farm / Auto Kill All / Auto TP Gun):
    -- wszystkie sterują CFrame postaci, więc gdy któreś właśnie teleportuje,
    -- pozostałe robią przerwę — inaczej pętle walczą o pozycję co klatkę
    local killBusy = false      -- true = Auto Kill All w trakcie zabójstwa
    local gunDropRef = nil      -- ostatni znany GunDrop (szuka tylko Auto TP Gun)
    -- true = Auto Farm nie ma co zbierać (brak monety w zasięgu) → wtedy
    -- TP Farm może działać. Dzięki temu OBIE farmy mogą być włączone
    -- naraz i żadna nie wyłącza drugiej.
    local farmIdle = false
    local farmStuckClock = 0
    local farmFullScanTick = 0
    -- zegar "dobiegania do celu" podczas ucieczki: trzymamy go, żeby farma
    -- nie goniła w kółko za jednym nieosiągalnym pickupem (morderca by nas
    -- dogonił). Gdy cel zniknie / przerwa, zegar się zeruje.
    local farmEscapeGrabClock = 0
    -- aktualnie goniowany pickup w trybie ucieczki: gdy cel sie zmieni
    -- (nowa moneta), zegar startuje od nowa — inaczej po 1,2 s przestalibyśmy
    -- łapać w ogóle, nawet gdy zbieranie działa
    local farmEscapeGrabTarget = nil

    local function isCoinAlive(part)
        if not part or not part.Parent then return false end
        -- gra oznacza zebraną monetę atrybutem Collected (CoinVisualizer tego używa),
        -- a część dotykowa bywa niewidoczna (Transparency=1) nawet gdy moneta żyje
        if part:GetAttribute("Collected") or part:GetAttribute("Delete") then return false end
        for _, d in ipairs(part:GetDescendants()) do
            if d:GetAttribute("Collected") or d:GetAttribute("Delete") then return false end
        end
        -- WIDOCZNY KAWAŁEK MONETY = dowód życia: widok robi dziecko MainCoin,
        -- a po zbiciu serwer je chowa (Transparency=1 lub kasuje) i CZĘSTO nie
        -- stawia atrybutu Collected — bez tego checku farma widziała "fantomową"
        -- monetę i po wygaśnięciu blacklisty celowała w nią znowu.
        -- Rodzeństwo szukamy TYLKO jako bezpośrednie dziecko (bez recursive),
        -- bo przy płaskiej strukturze recursive znalazłby MainCoin INNEJ monety.
        local vis = part:FindFirstChild("MainCoin", true)
            or (part.Parent and part.Parent:FindFirstChild("MainCoin"))
        if vis then
            if vis:IsA("BasePart") then
                if vis.Transparency >= 1 then return false end
            else
                -- MainCoin bywa Modelem: liczy się czy jakakolwiek jego część jest widoczna
                local widoczna = false
                for _, vp in ipairs(vis:GetDescendants()) do
                    if vp:IsA("BasePart") and vp.Transparency < 1 then
                        widoczna = true
                        break
                    end
                end
                if not widoczna then return false end
            end
        end
        return true
    end

    local function findTouchPart(server)
        -- bywa tak, że Coin_Server (Part z TouchTransmitter) jest bezpośrednim
        -- dzieckiem CoinContainer, a bywa zagnieżdżony w Modelu — sprawdzamy oba
        if server:IsA("BasePart") and server:FindFirstChildOfClass("TouchTransmitter") then
            return server
        end
        for _, d in ipairs(server:GetDescendants()) do
            if d:IsA("BasePart") and d:FindFirstChildOfClass("TouchTransmitter") then
                return d
            end
        end
        return nil
    end

    local function collectCoinsFrom(container)
        for _, server in ipairs(container:GetChildren()) do
            local touchPart = findTouchPart(server)
            if touchPart and isCoinAlive(touchPart) then
                table.insert(coinCache, touchPart)
            end
        end
    end

    -- Rodzaje kontenerów z pickupami. "CoinContainer" to monety (sprawdzone
    -- na żywo), pozostałe nazwy zgadujemy po cukierkach — jeśli gra ich nie
    -- używa, FindFirstChild zwraca nil i nic się nie zmienia (koszt: jeden
    -- FindFirstChild na mapę, czyli praktycznie zero).
    local FARM_PICKUP_CONTAINERS = {
        "CoinContainer", "CandyContainer", "SweetsContainer", "SweetContainer",
    }

    local function refreshCoinCache(full)
        coinCache = {}
        -- mapy leżą jako bezpośredni children workspace, więc szukamy szybko
        for _, map in ipairs(workspace:GetChildren()) do
            for _, cname in ipairs(FARM_PICKUP_CONTAINERS) do
                local container = map:FindFirstChild(cname)
                if container then
                    collectCoinsFrom(container)
                elseif map.Name == cname then
                    collectCoinsFrom(map)
                end
            end
        end
        -- pełny skan workspace (80k+ instancji) tylko od święta: stary kod
        -- robił go 30 razy na sekundę, gdy nie było żywych monet → straszny lag
        if full and #coinCache == 0 then
            -- mapa pusta = zmiana rundy: stare monety (razem z odrzuceniami)
            -- zniknęły, a nowe dostają nowe instancje — czyścimy czarną listę
            coinBlacklist = {}
            -- fallback: monety w nietypowym miejscu
            for _, d in ipairs(workspace:GetDescendants()) do
                for _, cname in ipairs(FARM_PICKUP_CONTAINERS) do
                    if d.Name == cname then
                        collectCoinsFrom(d)
                    end
                end
            end
        end
    end

