function startBloxStrikeScript()
    -- Already loaded? Show it again instead of building a second GUI
    if bsGui and bsGui.Parent then
        bsGui.Enabled = true
        if bsCheatsGui then bsCheatsGui.Enabled = true end
        return
    end

    if gameSelectGui then gameSelectGui:Destroy() end

    local aimbotEnabled = false
    local espEnabled = false
    local triggerbot = false
    -- Triggerbot delay (ms): 0 = a shot on every frame (like before adding the
    -- slider), 300 = at least 300 ms between shots.
    local triggerDelayMs = 60
    local lastTriggerShot = 0
    local infiniteJump = false
    local bunnyHop = false
    local bhopUnlocker = false
    local speedHack = false
    local speedHackValue = 50
    -- NO WEAPON SLOW removed from the menu (the Movement tab content was cleared).
    -- Force the flag off: the hook installed at the previous re-execution still hangs
    -- around and reads a table from getgenv - without UI we must turn it off from here, otherwise
    -- the weapon would stay slowed down forever, with no way to toggle it.
    pcall(function()
        local g = (type(getgenv) == "function" and getgenv()) or _G
        local st = g.SzpontNoWeaponSlow
        if type(st) == "table" then
            st.enabled = false
        end
    end)
    local hitboxExpander = false
