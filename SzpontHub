    task.spawn(function()
        while true do
            task.wait(0.05)
            if autoFarmCoins and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                local hum = plr.Character:FindFirstChild("Humanoid")
                local nearestCoin = nil
                local shortestDistance = math.huge

                for _, v in pairs(workspace:GetDescendants()) do
                    if v:IsA("BasePart") and (v.Name == "Coin_Server" or v.Name == "Coin" or v.Name:lower():find("coin")) then
                        if v.Transparency < 1 and v.Parent then
                            local dist = (hrp.Position - v.Position).Magnitude
                            if dist < shortestDistance then
                                shortestDistance = dist
                                nearestCoin = v
                            end
                        end
                    end
                end

                if nearestCoin and autoFarmCoins then
                    if hum then hum.PlatformStand = true end
                    for _, part in pairs(plr.Character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.RotVelocity = Vector3.new(0, 0, 0)

                    local distToCoin = (nearestCoin.Position - hrp.Position).Magnitude
                    local travelTime = distToCoin / math.clamp(farmSpeed, 5, 25)
                    local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
                    currentTween = tweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(nearestCoin.Position)})
                    currentTween:Play()

                    local completed = false
                    local conn
                    conn = currentTween.Completed:Connect(function()
                        completed = true
                        conn:Disconnect()
                    end)

                    while not completed and autoFarmCoins and nearestCoin.Parent and nearestCoin.Transparency < 1 do
                        task.wait(0.05)
                    end
                    if currentTween then currentTween:Cancel() end
                    task.wait(0.02)
                else
                    if hum then hum.PlatformStand = false end
                end
            end
        end
    end)

