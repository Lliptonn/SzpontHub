-- HACKS: RIVALS (FPS)
-- Same framework as in the other games (tabs, themes, active
-- cheats list, back button) + aimbot ported from
-- BloxStrike (RMB snap + FOV circle + sliders).
------------------------------------------------------------
function startRivalsScript()
    -- Already loaded? Show it again instead of building a second GUI
    if rivalsGui and rivalsGui.Parent then
        rivalsGui.Enabled = true
        if rivalsCheatsGui then rivalsCheatsGui.Enabled = true end
        return
    end

    if gameSelectGui then gameSelectGui:Destroy() end

    -- AIMBOT (state)
    local aimbotEnabled = false
    local aimbotFov = 50
    local aimbotSpeed = 6
    local ppm = false
    local fovCircle = nil
    local espEnabled = false
    local noSpread = false
    local triggerbot = false

    -- TEAM: Rivals does not use Roblox Team objects (= nil), the team lives
    -- in attributes / leaderstats. Problem with the old version: the source could
    -- return the SAME value for both players (e.g. default TeamColor, a shared
    -- attribute in training) - a fake "teammate" - a green enemy and the aimbot
    -- skipped "teammates" = nothing worked. Now we compute the team source
    -- across ALL players and accept ONLY sources that actually
    -- DIFFER between players. No such source = everyone is an enemy (red).
    local teamSources = {
        function(p) if p.Team then return "team:" .. p.Team.Name end end,
        function(p)
            for _, key in ipairs({"Team", "TeamName", "team", "TeamId", "TeamNumber", "Side", "Ally", "Faction"}) do
                local ok, v = pcall(function() return p:GetAttribute(key) end)
                if ok and v ~= nil and tostring(v) ~= "" then return "attr:" .. key .. "=" .. tostring(v) end
            end
        end,
        function(p)
            local ch = p.Character
            if ch then
                for _, key in ipairs({"Team", "TeamName", "team", "TeamId", "Side"}) do
                    local ok, v = pcall(function() return ch:GetAttribute(key) end)
                    if ok and v ~= nil and tostring(v) ~= "" then return "cattr:" .. key .. "=" .. tostring(v) end
                end
            end
        end,
        function(p)
            local ls = p:FindFirstChild("leaderstats")
            if ls then
                for _, v in ipairs(ls:GetChildren()) do
                    local n = v.Name:lower()
                    if n:find("team") or n:find("side") or n:find("faction") or n:find("clan") then
                        local val = tostring(v.Value)
                        if val ~= "" and val ~= "0" then return "ls:" .. v.Name .. "=" .. val end
                    end
                end
            end
        end,
        function(p) if p.TeamColor then return "clr:" .. p.TeamColor.Name end end,
    }

    -- src = chosen source, nil = not determined yet, false = no usable one
    local chosenSource = nil
    local lastSourceScan = 0

    local function resolveTeamSource()
        if chosenSource then return chosenSource end
        local now = tick()
        if now - lastSourceScan < 2 then return false end -- do not scan every frame
        lastSourceScan = now
        for _, src in ipairs(teamSources) do
            local first, differs, count = nil, false, 0
            for _, p in ipairs(playersService:GetPlayers()) do
                local ok, v = pcall(src, p)
                if ok and v ~= nil then
                    count = count + 1
                    if first == nil then first = v
                    elseif v ~= first then differs = true end
                end
            end
            if count >= 2 and differs then
                chosenSource = src
                return src
            end
        end
        return false
    end

    local function getTeamId(player)
        local src = resolveTeamSource()
        if not src then return nil end
        local ok, v = pcall(src, player)
        if ok then return v end
        return nil
    end

    -- Same team = teammate (green); no data = enemy (red)
    local function isTeammate(player)
        if player == plr then return false end
        local mine = getTeamId(plr)
        if not mine then return false end
        return getTeamId(player) == mine
    end

    local function isEnemy(player)
        if player == plr then return false end
        return not isTeammate(player)
    end

    -- Life: Humanoid (classic characters) or Dead/Health attributes
    -- (games without a Humanoid) - as in BloxStrike, but without team folders.
    local function isAliveTarget(player, char)
        if player:GetAttribute("Dead") == true then return false end
        if char:GetAttribute("Dead") == true then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then return hum.Health > 0 end
        local hp = tonumber(char:GetAttribute("Health"))
        if hp ~= nil then return hp > 0 end
        return true
    end

